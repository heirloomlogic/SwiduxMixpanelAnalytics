{"sections":[],"abstract":[{"text":"Mixpanel adapter for Swidux’s ","type":"text"},{"code":"AnalyticsPlugin","type":"codeVoice"},{"type":"text","text":". Implements "},{"code":"AnalyticsService","type":"codeVoice"},{"type":"text","text":" against "},{"code":"Mixpanel.mainInstance()","type":"codeVoice"},{"type":"text","text":" and ships a recording mock for previews and tests."}],"topicSections":[{"identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/GettingStarted"],"anchor":"Quickstart","title":"Quickstart"},{"identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest"],"anchor":"How-to-Guides","title":"How-to Guides"},{"identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ServiceReference","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockServiceReference"],"anchor":"Reference","title":"Reference"},{"identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ValueTranslation"],"anchor":"Explanation","title":"Explanation"},{"identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService"],"anchor":"Service-Layer","title":"Service Layer"},{"identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService"],"anchor":"Testing","title":"Testing"},{"identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/SwiduxAnalytics","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/Swift"],"generated":true,"anchor":"Extended-Modules","title":"Extended Modules"}],"kind":"symbol","primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"codeVoice","code":"SwiduxMixpanelAnalytics"},{"type":"text","text":" is the bridge between Mixpanel’s iOS SDK and Swidux’s provider-agnostic analytics plugin. The plugin owns analytics state (opt-out flag, current screen, last-identified user) and converts your domain actions into typed "},{"type":"codeVoice","code":"AnalyticsEvent"},{"type":"text","text":" values; this package translates those events into Mixpanel SDK calls and maps "},{"type":"codeVoice","code":"AnalyticsValue"},{"type":"text","text":" into Mixpanel’s "},{"type":"codeVoice","code":"Properties"},{"type":"text","text":" payload."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Two types ship in a single product:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService"},{"type":"text","text":" — the live "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" conformer that wraps a "},{"type":"codeVoice","code":"MixpanelInstance"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService"},{"type":"text","text":" — a recording actor for SwiftUI "},{"type":"codeVoice","code":"#Preview"},{"type":"text","text":" blocks and Swift Testing suites."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"The flow:"}],"type":"paragraph"},{"syntax":null,"type":"codeListing","code":["store.send(.counter(.increment(5)))","  → AnalyticsPlugin runs the mapper in afterReduce","  → mapper emits AnalyticsEvent(\"counter_added\", [\"amount\": .int(5)])","  → MixpanelAnalyticsService.track(_:) forwards to MixpanelInstance.track(event:properties:)","  → Mixpanel SDK queues the event and flushes per its own schedule"]},{"inlineContent":[{"type":"text","text":"The plugin and the adapter stay decoupled: the plugin doesn’t know about Mixpanel, and the adapter doesn’t know about your action tree."}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[[]]},"metadata":{"modules":[{"name":"SwiduxMixpanelAnalytics"}],"role":"collection","roleHeading":"Framework","externalID":"SwiduxMixpanelAnalytics","symbolKind":"module","title":"SwiduxMixpanelAnalytics"},"variants":[{"paths":["\/documentation\/swiduxmixpanelanalytics"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/SwiduxAnalytics":{"abstract":[],"url":"\/documentation\/swiduxmixpanelanalytics\/swiduxanalytics","kind":"symbol","title":"SwiduxAnalytics","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/SwiduxAnalytics","role":"collection","type":"topic"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics":{"abstract":[{"text":"Mixpanel adapter for Swidux’s ","type":"text"},{"code":"AnalyticsPlugin","type":"codeVoice"},{"text":". Implements ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" against ","type":"text"},{"code":"Mixpanel.mainInstance()","type":"codeVoice"},{"text":" and ships a recording mock for previews and tests.","type":"text"}],"url":"\/documentation\/swiduxmixpanelanalytics","kind":"symbol","title":"SwiduxMixpanelAnalytics","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics","role":"collection","type":"topic"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/HowToPreviewAndTest":{"abstract":[{"text":"Drive ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" from SwiftUI previews and Swift Testing suites without touching Mixpanel’s network.","type":"text"}],"url":"\/documentati
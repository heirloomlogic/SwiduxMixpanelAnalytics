pe":"text"},{"code":"import Mixpanel","type":"codeVoice"},{"text":". Ships a recording mock for previews and tests.","type":"text"}],"metadata":{"roleHeading":"Framework","title":"SwiduxMixpanelAnalytics","modules":[{"name":"SwiduxMixpanelAnalytics"}],"role":"collection","externalID":"SwiduxMixpanelAnalytics","symbolKind":"module"},"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"SwiduxMixpanelAnalytics"},{"type":"text","text":" is the bridge between Mixpanel’s iOS SDK and Swidux’s provider-agnostic analytics plugin. The plugin owns analytics state (opt-out flag, current screen, last-identified user) and converts your domain actions into typed "},{"type":"codeVoice","code":"AnalyticsEvent"},{"type":"text","text":" values; this package translates those events into Mixpanel SDK calls and maps "},{"type":"codeVoice","code":"AnalyticsValue"},{"type":"text","text":" into Mixpanel’s "},{"type":"codeVoice","code":"Properties"},{"type":"text","text":" payload."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Two types ship in a single product:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService"},{"type":"text","text":" — the live "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" conformer that constructs and wraps a "},{"type":"codeVoice","code":"MixpanelInstance"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService"},{"type":"text","text":" — a recording actor for SwiftUI "},{"type":"codeVoice","code":"#Preview"},{"type":"text","text":" blocks and Swift Testing suites."}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"The flow:"}],"type":"paragraph"},{"code":["store.send(.counter(.increment(5)))","  → AnalyticsPlugin runs the mapper in afterReduce","  → mapper emits AnalyticsEvent(\"counter_added\", [\"amount\": .int(5)])","  → MixpanelAnalyticsService.track(_:) forwards to MixpanelInstance.track(event:properties:)","  → Mixpanel SDK queues the event and flushes per its own schedule"],"type":"codeListing","syntax":null},{"inlineContent":[{"type":"text","text":"The plugin and the adapter stay decoupled: the plugin doesn’t know about Mixpanel, and the adapter doesn’t know about your action tree."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swiduxmixpanelanalytics"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[[]]},"references":{"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/ServiceReference":{"type":"topic","abstract":[{"text":"API reference for ","type":"text"},{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService","isActive":true,"type":"reference"},{"text":" — the Mixpanel-backed ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" conformer that the analytics plugin consumes.","type":"text"}],"role":"article","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ServiceReference","title":"Service Reference","url":"\/documentation\/swiduxmixpanelanalytics\/servicereference","kind":"article"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/GettingStarted":{"type":"topic","abstract":[{"text":"Add the package, build ","type":"text"},{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"type":"text","text":" with your token, register the analytics plugin, and start dispatching events."}],"role":"article","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/GettingStarted","title
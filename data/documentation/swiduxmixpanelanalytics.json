{"kind":"symbol","topicSections":[{"anchor":"Quickstart","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/GettingStarted"],"title":"Quickstart"},{"anchor":"How-to-Guides","title":"How-to Guides","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest"]},{"anchor":"Reference","title":"Reference","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ServiceReference","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockServiceReference"]},{"anchor":"Explanation","title":"Explanation","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ValueTranslation"]},{"anchor":"Service-Layer","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService"],"title":"Service Layer"},{"anchor":"Testing","title":"Testing","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService"]},{"generated":true,"anchor":"Extended-Modules","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/SwiduxAnalytics","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/Swift"],"title":"Extended Modules"}],"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"code":"SwiduxMixpanelAnalytics","type":"codeVoice"},{"text":" is the bridge between Mixpanel’s iOS SDK and Swidux’s provider-agnostic analytics plugin. The plugin owns analytics state (opt-out flag, current screen, last-identified user) and converts your domain actions into typed ","type":"text"},{"code":"AnalyticsEvent","type":"codeVoice"},{"text":" values; this package translates those events into Mixpanel SDK calls and maps ","type":"text"},{"code":"AnalyticsValue","type":"codeVoice"},{"text":" into Mixpanel’s ","type":"text"},{"code":"Properties","type":"codeVoice"},{"text":" payload.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Two types ship in a single product:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService","isActive":true},{"text":" — the live ","type":"text"},{"type":"codeVoice","code":"AnalyticsService"},{"text":" conformer that constructs and wraps a ","type":"text"},{"type":"codeVoice","code":"MixpanelInstance"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService","isActive":true,"type":"reference"},{"text":" — a recording actor for SwiftUI ","type":"text"},{"type":"codeVoice","code":"#Preview"},{"text":" blocks and Swift Testing suites.","type":"text"}]}]}]},{"inlineContent":[{"text":"The flow:","type":"text"}],"type":"paragraph"},{"code":["store.send(.counter(.increment(5)))","  → AnalyticsPlugin runs the mapper in afterReduce","  → mapper emits AnalyticsEvent(\"counter_added\", [\"amount\": .int(5)])","  → MixpanelAnalyticsService.track(_:) forwards to MixpanelInstance.track(event:properties:)","  → Mixpanel SDK queues the event and flushes per its own schedule"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"text":"The plugin and the adapter stay decoupled: the plugin doesn’t know about Mixpanel, and the adapter doesn’t know about your action tree.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxmixpanelanalytics"]}],"hierarchy":{"paths":[[]]},"metadata":{"modules":[{"name":"SwiduxMixpanelAnalytics"}],"symbolKind":"m
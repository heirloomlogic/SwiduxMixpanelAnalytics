{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxmixpanelanalytics"]}],"abstract":[{"type":"text","text":"Mixpanel adapter for Swidux’s "},{"type":"codeVoice","code":"AnalyticsPlugin"},{"type":"text","text":". Owns the Mixpanel SDK on the app’s behalf — "},{"type":"codeVoice","code":"MixpanelAnalyticsService(token:)"},{"type":"text","text":" calls "},{"type":"codeVoice","code":"Mixpanel.initialize"},{"type":"text","text":" internally so apps never need to "},{"type":"codeVoice","code":"import Mixpanel"},{"type":"text","text":". Ships a recording mock for previews and tests."}],"identifier":{"url":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics","interfaceLanguage":"swift"},"hierarchy":{"paths":[[]]},"topicSections":[{"anchor":"Quickstart","title":"Quickstart","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/GettingStarted"]},{"anchor":"How-to-Guides","title":"How-to Guides","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest"]},{"anchor":"Reference","title":"Reference","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ServiceReference","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockServiceReference"]},{"anchor":"Explanation","title":"Explanation","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ValueTranslation"]},{"anchor":"Service-Layer","title":"Service Layer","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService"]},{"anchor":"Testing","title":"Testing","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService"]},{"identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/SwiduxAnalytics","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/Swift"],"generated":true,"title":"Extended Modules","anchor":"Extended-Modules"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"inlineContent":[{"type":"codeVoice","code":"SwiduxMixpanelAnalytics"},{"type":"text","text":" is the bridge between Mixpanel’s iOS SDK and Swidux’s provider-agnostic analytics plugin. The plugin owns analytics state (opt-out flag, current screen, last-identified user) and converts your domain actions into typed "},{"type":"codeVoice","code":"AnalyticsEvent"},{"type":"text","text":" values; this package translates those events into Mixpanel SDK calls and maps "},{"type":"codeVoice","code":"AnalyticsValue"},{"type":"text","text":" into Mixpanel’s "},{"type":"codeVoice","code":"Properties"},{"type":"text","text":" payload."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Two types ship in a single product:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService"},{"type":"text","text":" — the live "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" conformer that constructs and wraps a "},{"type":"codeVoice","code":"MixpanelInstance"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService"},{"type":"text","text":" — a recording actor for SwiftUI "},{"type":"codeVoice","code":"#Preview"},{"type":"text","text":" blocks and Swift Testing suites."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"The flow:"}],"type":"paragraph"},{"syntax":null,"code":["store.send(.counter(.increment(5)))","  → AnalyticsPlugin runs the mapper in afterReduce","  → mapper emits AnalyticsEvent(\"counter_added\", [\"amount\": .int(5)])","  → MixpanelAnalyticsService.track(_:) forwards to MixpanelInstance.track(event:properties:)","  → Mixpanel SDK queues the event and flushes per its own schedule"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The plugin and the adapter stay decoupled: the plugin doesn’t know about Mixpanel, and the adapter doesn’t know about your action tree."}],"type":"paragraph"}],"kind":"content"}],"sections":[],"kind":"symbol","metadata":{"symbolKind":"module","title":"SwiduxMixpanelAnalytics","modules":[{"name":"SwiduxMixpanelAnalytics"}],"roleHeading":"Framework","role":"collection","externalID":"SwiduxMixpanelAnalytics"},"references":{"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/HowToPreviewAndTest":{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest","url":"\/documentation\/swiduxmixpanelanalytics\/howtopreviewandtest","title":"How to Preview and Test","type":"topic","role":"article","abstract":[{"text":"Drive ","type":"text"},{"type":"codeVoice","code":"AnalyticsService"},{"text":" from SwiftUI previews and Swift Testing suites without touching Mixpanel’s network.","type":"text"}],"kind":"article"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/GettingStarted":{"role":"article","abstract":[{"type":"text","text":"Add the package, build "},{"type":"codeVoice","code":"MixpanelAnalyticsService"},{"type":"text","text":" with your token, register the analytics plugin, and start dispatching events."}],"type":"topic","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/GettingStarted","title":"Getting Started with SwiduxMixpanelAnalytics","kind":"article","url":"\/documentation\/swiduxmixpanelanalytics\/gettingstarted"},"doc://SwiduxMixpanelAnaly
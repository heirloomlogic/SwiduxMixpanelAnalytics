{"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"abstract":[{"type":"text","text":"Mixpanel adapter for Swidux’s "},{"type":"codeVoice","code":"AnalyticsPlugin"},{"text":". Owns the Mixpanel SDK on the app’s behalf — ","type":"text"},{"type":"codeVoice","code":"MixpanelAnalyticsService(token:)"},{"text":" calls ","type":"text"},{"type":"codeVoice","code":"Mixpanel.initialize"},{"text":" internally so apps never need to ","type":"text"},{"type":"codeVoice","code":"import Mixpanel"},{"text":". Ships a recording mock for previews and tests.","type":"text"}],"topicSections":[{"title":"Quickstart","anchor":"Quickstart","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/GettingStarted"]},{"title":"How-to Guides","anchor":"How-to-Guides","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest"]},{"title":"Reference","anchor":"Reference","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ServiceReference","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockServiceReference"]},{"title":"Explanation","anchor":"Explanation","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ValueTranslation"]},{"anchor":"Service-Layer","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService"],"title":"Service Layer"},{"anchor":"Testing","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService"],"title":"Testing"},{"anchor":"Extended-Modules","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/SwiduxAnalytics","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/Swift"],"generated":true,"title":"Extended Modules"}],"metadata":{"title":"SwiduxMixpanelAnalytics","modules":[{"name":"SwiduxMixpanelAnalytics"}],"externalID":"SwiduxMixpanelAnalytics","symbolKind":"module","roleHeading":"Framework","role":"collection"},"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"code":"SwiduxMixpanelAnalytics","type":"codeVoice"},{"text":" is the bridge between Mixpanel’s iOS SDK and Swidux’s provider-agnostic analytics plugin. The plugin owns analytics state (opt-out flag, current screen, last-identified user) and converts your domain actions into typed ","type":"text"},{"type":"codeVoice","code":"AnalyticsEvent"},{"text":" values; this package translates those events into Mixpanel SDK calls and maps ","type":"text"},{"code":"AnalyticsValue","type":"codeVoice"},{"text":" into Mixpanel’s ","type":"text"},{"type":"codeVoice","code":"Properties"},{"text":" payload.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Two types ship in a single product:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService","isActive":true},{"text":" — the live ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" conformer that constructs and wraps a ","type":"text"},{"code":"MixpanelInstance","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService","isActive":true},{"text":" — a recording actor for SwiftUI ","type":"text"},{"code":"#Preview","type":"codeVoice"},{"text":" blocks and Swift Testing suites.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"The flow:","type":"text"}],"type":"paragraph"},{"syntax":null,"type":"codeList
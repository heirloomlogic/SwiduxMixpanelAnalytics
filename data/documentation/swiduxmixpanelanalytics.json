{"identifier":{"url":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Mixpanel adapter for Swidux’s "},{"type":"codeVoice","code":"AnalyticsPlugin"},{"type":"text","text":". Owns the Mixpanel SDK on the app’s behalf — "},{"type":"codeVoice","code":"MixpanelAnalyticsService(token:)"},{"type":"text","text":" calls "},{"type":"codeVoice","code":"Mixpanel.initialize"},{"type":"text","text":" internally so apps never need to "},{"type":"codeVoice","code":"import Mixpanel"},{"type":"text","text":". Ships a recording mock for previews and tests."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxmixpanelanalytics"]}],"kind":"symbol","hierarchy":{"paths":[[]]},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"codeVoice","code":"SwiduxMixpanelAnalytics"},{"type":"text","text":" is the bridge between Mixpanel’s iOS SDK and Swidux’s provider-agnostic analytics plugin. The plugin owns analytics state (opt-out flag, current screen, last-identified user) and converts your domain actions into typed "},{"type":"codeVoice","code":"AnalyticsEvent"},{"type":"text","text":" values; this package translates those events into Mixpanel SDK calls and maps "},{"type":"codeVoice","code":"AnalyticsValue"},{"type":"text","text":" into Mixpanel’s "},{"type":"codeVoice","code":"Properties"},{"type":"text","text":" payload."}],"type":"paragraph"},{"inlineContent":[{"text":"Two types ship in a single product:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService","type":"reference"},{"text":" — the live ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" conformer that constructs and wraps a ","type":"text"},{"code":"MixpanelInstance","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService","isActive":true,"type":"reference"},{"text":" — a recording actor for SwiftUI ","type":"text"},{"code":"#Preview","type":"codeVoice"},{"text":" blocks and Swift Testing suites.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"The flow:","type":"text"}]},{"type":"codeListing","syntax":null,"code":["store.send(.counter(.increment(5)))","  → AnalyticsPlugin runs the mapper in afterReduce","  → mapper emits AnalyticsEvent(\"counter_added\", [\"amount\": .int(5)])","  → MixpanelAnalyticsService.track(_:) forwards to MixpanelInstance.track(event:properties:)","  → Mixpanel SDK queues the event and flushes per its own schedule"]},{"type":"paragraph","inlineContent":[{"text":"The plugin and the adapter stay decoupled: the plugin doesn’t know about Mixpanel, and the adapter doesn’t know about your action tree.","type":"text"}]}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"title":"SwiduxMixpanelAnalytics","externalID":"SwiduxMixpanelAnalytics","roleHeading":"Framework","role":"collection","symbolKind":"module","modules":[{"name":"SwiduxMixpanelAnalytics"}]},"topicSections":[{"anchor":"Quickstart","title":"Quickstart","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/GettingStarted"]},{"anchor":"How-to-Guides","title":"How-to Guides","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest"]},{"anchor":"Reference","title":"Reference","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ServiceReference","doc:\/\/SwiduxMixpanelAnalytic
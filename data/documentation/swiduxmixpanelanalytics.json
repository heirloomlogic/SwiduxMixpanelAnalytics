wift Testing suites.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The flow:"}]},{"type":"codeListing","code":["store.send(.counter(.increment(5)))","  → AnalyticsPlugin runs the mapper in afterReduce","  → mapper emits AnalyticsEvent(\"counter_added\", [\"amount\": .int(5)])","  → MixpanelAnalyticsService.track(_:) forwards to MixpanelInstance.track(event:properties:)","  → Mixpanel SDK queues the event and flushes per its own schedule"],"syntax":null},{"type":"paragraph","inlineContent":[{"text":"The plugin and the adapter stay decoupled: the plugin doesn’t know about Mixpanel, and the adapter doesn’t know about your action tree.","type":"text"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxmixpanelanalytics"]}],"references":{"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics":{"url":"\/documentation\/swiduxmixpanelanalytics","title":"SwiduxMixpanelAnalytics","type":"topic","abstract":[{"type":"text","text":"Mixpanel adapter for Swidux’s "},{"type":"codeVoice","code":"AnalyticsPlugin"},{"type":"text","text":". Owns the Mixpanel SDK on the app’s behalf — "},{"code":"MixpanelAnalyticsService(token:)","type":"codeVoice"},{"type":"text","text":" calls "},{"code":"Mixpanel.initialize","type":"codeVoice"},{"type":"text","text":" internally so apps never need to "},{"type":"codeVoice","code":"import Mixpanel"},{"type":"text","text":". Ships a recording mock for previews and tests."}],"kind":"symbol","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics","role":"collection"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/HowToImplementService":{"role":"article","kind":"article","title":"How to Implement the Service","type":"topic","url":"\/documentation\/swiduxmixpanelanalytics\/howtoimplementservice","abstract":[{"type":"text","text":"Configure "},{"code":"MixpanelAnalyticsService","type":"codeVoice"}
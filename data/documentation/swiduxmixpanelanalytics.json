{"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"kind":"symbol","abstract":[{"type":"text","text":"Mixpanel adapter for Swidux’s "},{"type":"codeVoice","code":"AnalyticsPlugin"},{"type":"text","text":". Owns the Mixpanel SDK on the app’s behalf — "},{"type":"codeVoice","code":"MixpanelAnalyticsService(token:)"},{"type":"text","text":" calls "},{"code":"Mixpanel.initialize","type":"codeVoice"},{"type":"text","text":" internally so apps never need to "},{"type":"codeVoice","code":"import Mixpanel"},{"type":"text","text":". Ships a recording mock for previews and tests."}],"topicSections":[{"identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/GettingStarted"],"title":"Quickstart","anchor":"Quickstart"},{"identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest"],"title":"How-to Guides","anchor":"How-to-Guides"},{"identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ServiceReference","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockServiceReference"],"title":"Reference","anchor":"Reference"},{"identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ValueTranslation"],"title":"Explanation","anchor":"Explanation"},{"identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService"],"title":"Service Layer","anchor":"Service-Layer"},{"identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService"],"title":"Testing","anchor":"Testing"},{"identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/SwiduxAnalytics","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/Swift"],"title":"Extended Modules","anchor":"Extended-Modules","generated":true}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxMixpanelAnalytics"},{"type":"text","text":" is the bridge between Mixpanel’s iOS SDK and Swidux’s provider-agnostic analytics plugin. The plugin owns analytics state (opt-out flag, current screen, last-identified user) and converts your domain actions into typed "},{"type":"codeVoice","code":"AnalyticsEvent"},{"type":"text","text":" values; this package translates those events into Mixpanel SDK calls and maps "},{"type":"codeVoice","code":"AnalyticsValue"},{"type":"text","text":" into Mixpanel’s "},{"code":"Properties","type":"codeVoice"},{"type":"text","text":" payload."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two types ship in a single product:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService"},{"type":"text","text":" — the live "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" conformer that constructs and wraps a "},{"type":"codeVoice","code":"MixpanelInstance"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService"},{"type":"text","text":" — a recording actor for SwiftUI "},{"type":"codeVoice","code":"#Preview"},{"type":"text","text":" blocks and Swift Testing suites."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The flow:"}]},{"syntax":null,"type":"codeListing","code":["store.send(.counter(.increment(5)))","  → AnalyticsPlugin runs the mapper in afterReduce","  → mapper emits AnalyticsEvent(\"counter_added\", [\"amount\": .int(5)])","  → MixpanelAnalyticsService.track(_:) forwards to MixpanelInstance.track(event:properties:)","  → Mixpanel SDK queues the event and flushes per its own schedule"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin and the adapter stay decoupled: the plugin doesn’t know about Mixpanel, and the adapter doesn’t know about your action tree."}]}]}],"hierarchy":{"paths":[[]]},"identifier":{"url":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics","interfaceLanguage":"swift"},"metadata":{"symbolKind":"module","roleHeading":"Framework","modules":[{"name":"SwiduxMixpanelAnalytics"}],"role":"collection","title":"SwiduxMixpanelAnalytics","externalID":"SwiduxMixpanelAnalytics"},"variants":[{"paths":["\/documentation\/swiduxmixpanelanalytics"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MixpanelAnalyticsService":{"navigatorTitle":[{"text":"MixpanelAnalyticsService","kind":"identifier"}],"abstract":[{"code":"AnalyticsService","type":"codeVoice"},{"type":"text","text":" conformer that owns and forwards to a Mixpanel SDK"},{"type":"text","text":" "},{"type":"text","text":"instance."}],"kind":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MixpanelAnalyticsService","kind":"identifier"}],"url":"\/documentation\/swiduxmixpanelanalytics\/mixpanelanalyticsservice","title":"MixpanelAnalyticsService","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService","role":"symbol"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MockServiceReference":{"abstract":[{"type":"text","text":"API reference for "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService"},{"type":"text","text":" — a recording "},{"code":"AnalyticsService","type":"codeVoice"},{"type":"text","text":" for SwiftUI previews and Swift Testing suites."}],"kind":"article","type":"topic","url":"\/documentation\/swiduxmixpanelanalytics\/mockservicereference","title":"Mock Service Reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockServiceReference","role":"article"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/HowToImplementService":{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","kind":"article","abstract":[{"text":"Configure ","type":"text"},{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"text":" to match your privacy, residency, and batching needs — without ","type":"text"},{"code":"import Mixpanel","type":"codeVoice"},{"text":" in your app.","type":"text"}],"title":"How to Implement the Service","type":"topic","url":"\/documentation\/swiduxmixpanelanalytics\/howtoimplementservice","role":"article"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/HowToPreviewAndTest":{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest","kind":"article","abstract":[{"type":"text","text":"Drive "},{"code":"AnalyticsService","type":"codeVoice"},{"type":"text","text":" from SwiftUI previews and Swift Testing suites without touching Mixpanel’s network."}],"title":"How to Preview and Test","type":"topic","url":"\/documentation\/swiduxmixpanelanalytics\/howtopreviewandtest","role":"article"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/SwiduxAnalytics":{"abstract":[],"kind":"symbol","type":"topic","url":"\/documentation\/swiduxmixpanelanalytics\/swiduxanalytics","title":"SwiduxAnalytics","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/SwiduxAnalytics","role":"collection"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/ServiceReference":{"identifier":"doc:\/\/Swid
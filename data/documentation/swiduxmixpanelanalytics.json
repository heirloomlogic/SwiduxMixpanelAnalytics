{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxmixpanelanalytics"]}],"hierarchy":{"paths":[[]]},"abstract":[{"type":"text","text":"Mixpanel adapter for Swidux’s "},{"type":"codeVoice","code":"AnalyticsPlugin"},{"type":"text","text":". Owns the Mixpanel SDK on the app’s behalf — "},{"type":"codeVoice","code":"MixpanelAnalyticsService(token:)"},{"type":"text","text":" calls "},{"type":"codeVoice","code":"Mixpanel.initialize"},{"type":"text","text":" internally so apps never need to "},{"type":"codeVoice","code":"import Mixpanel"},{"type":"text","text":". Ships a recording mock for previews and tests."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics"},"topicSections":[{"identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/GettingStarted"],"anchor":"Quickstart","title":"Quickstart"},{"identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest"],"anchor":"How-to-Guides","title":"How-to Guides"},{"identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ServiceReference","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockServiceReference"],"anchor":"Reference","title":"Reference"},{"identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ValueTranslation"],"anchor":"Explanation","title":"Explanation"},{"identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService"],"anchor":"Service-Layer","title":"Service Layer"},{"identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService"],"anchor":"Testing","title":"Testing"},{"identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/SwiduxAnalytics","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/Swift"],"anchor":"Extended-Modules","title":"Extended Modules","generated":true}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxMixpanelAnalytics"},{"type":"text","text":" is the bridge between Mixpanel’s iOS SDK and Swidux’s provider-agnostic analytics plugin. The plugin owns analytics state (opt-out flag, current screen, last-identified user) and converts your domain actions into typed "},{"type":"codeVoice","code":"AnalyticsEvent"},{"type":"text","text":" values; this package translates those events into Mixpanel SDK calls and maps "},{"type":"codeVoice","code":"AnalyticsValue"},{"type":"text","text":" into Mixpanel’s "},{"type":"codeVoice","code":"Properties"},{"type":"text","text":" payload."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two types ship in a single product:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService","type":"reference","isActive":true},{"type":"text","text":" — the live "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" conformer that constructs and wraps a "},{"type":"codeVoice","code":"MixpanelInstance"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService","type":"reference","isActive":true},{"type":"text","text":" — a recording actor for SwiftUI "},{"type":"codeVoice","code":"#Preview"},{"type":"text","text":" blocks and Swift Testing suites."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The flow:"}]},{"syntax":null,"type":"codeListing","code":["store.send(.counter(.increment(5)))","  → AnalyticsPlugin runs the mapper in afterReduce","  → mapper emits AnalyticsEvent(\"counter_added\", [\"amount\": .int(5)])","  → MixpanelAnalyticsService.track(_:) forwards to MixpanelInstance.track(event:properties:)","  → Mixpanel SDK queues the event and flushes per its own schedule"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin and the adapter stay decoupled: the plugin doesn’t know about Mixpanel, and the adapter doesn’t know about your action tree."}]}]}],"kind":"symbol","sections":[],"metadata":{"title":"SwiduxMixpanelAnalytics","symbolKind":"module","externalID":"SwiduxMixpanelAnalytics","role":"collection","modules":[{"name":"SwiduxMixpanelAnalytics"}],"roleHeading":"Framework"},"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/HowToPreviewAndTest":{"role":"article","abstract":[{"type":"text","text":"Drive "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" from SwiftUI previews and Swift Testing suites without touching Mixpanel’s network."}],"url":"\/documentation\/swiduxmixpanelanalytics\/howtopreviewandtest","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest","kind":"article","title":"How to Preview and Test","type":"topic"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/ValueTranslation":{"kind":"article","abstract":[{"type":"text","text":"How "},{"type":"codeVoice","code":"AnalyticsValue"},{"type":"text","text":" cases map onto Mixpanel’s "},{"type":"codeVoice","code":"MixpanelType"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Properties"},{"type":"text","text":"."}],"type":"topic","title":"Value Translation","role":"article","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ValueTranslation","url":"\/documentation\/swiduxmixpanelanalytics\/valu
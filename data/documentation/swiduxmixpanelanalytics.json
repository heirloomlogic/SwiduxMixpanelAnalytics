{"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"symbolKind":"module","roleHeading":"Framework","externalID":"SwiduxMixpanelAnalytics","modules":[{"name":"SwiduxMixpanelAnalytics"}],"role":"collection","title":"SwiduxMixpanelAnalytics"},"hierarchy":{"paths":[[]]},"abstract":[{"type":"text","text":"Mixpanel adapter for Swidux’s "},{"type":"codeVoice","code":"AnalyticsPlugin"},{"type":"text","text":". Owns the Mixpanel SDK on the app’s behalf — "},{"type":"codeVoice","code":"MixpanelAnalyticsService(token:)"},{"type":"text","text":" calls "},{"type":"codeVoice","code":"Mixpanel.initialize"},{"type":"text","text":" internally so apps never need to "},{"type":"codeVoice","code":"import Mixpanel"},{"type":"text","text":". Ships a recording mock for previews and tests."}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"code":"SwiduxMixpanelAnalytics","type":"codeVoice"},{"type":"text","text":" is the bridge between Mixpanel’s iOS SDK and Swidux’s provider-agnostic analytics plugin. The plugin owns analytics state (opt-out flag, current screen, last-identified user) and converts your domain actions into typed "},{"code":"AnalyticsEvent","type":"codeVoice"},{"type":"text","text":" values; this package translates those events into Mixpanel SDK calls and maps "},{"code":"AnalyticsValue","type":"codeVoice"},{"type":"text","text":" into Mixpanel’s "},{"code":"Properties","type":"codeVoice"},{"type":"text","text":" payload."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two types ship in a single product:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService","isActive":true},{"text":" — the live ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" conformer that constructs and wraps a ","typ
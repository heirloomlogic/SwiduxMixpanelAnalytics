{"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"This guide is the shortest path from a wired Swidux app with ","type":"text"},{"type":"codeVoice","code":"SwiduxAnalytics"},{"text":" registered to events landing in Mixpanel. It assumes you have already followed Swidux’s ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/heirloomlogic.github.io\/Swidux\/documentation\/swidux\/howtoaddanalytics"},{"text":" guide through Step 5 — that is, your ","type":"text"},{"type":"codeVoice","code":"AppState"},{"text":" has an ","type":"text"},{"type":"codeVoice","code":"analytics"},{"text":" slice, your ","type":"text"},{"type":"codeVoice","code":"AppAction"},{"text":" routes ","type":"text"},{"type":"codeVoice","code":".analytics(_:)"},{"text":", and you have an ","type":"text"},{"type":"codeVoice","code":"AnalyticsMapper"},{"text":" declared.","type":"text"}]},{"level":2,"type":"heading","text":"Add the package","anchor":"Add-the-package"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Xcode:","type":"text"}],"type":"strong"},{"type":"text","text":" File > Add Package Dependencies, paste "},{"type":"codeVoice","code":"https:\/\/github.com\/HeirloomLogic\/SwiduxMixpanelAnalytics"},{"type":"text","text":". Add the "},{"type":"codeVoice","code":"SwiduxMixpanelAnalytics"},{"type":"text","text":" product to your target."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Package.swift:","type":"text"}],"type":"strong"}]},{"syntax":"swift","type":"codeListing","code":[".package(url: \"https:\/\/github.com\/HeirloomLogic\/SwiduxMixpanelAnalytics\", from: \"1.0.0\"),"]},{"syntax":"swift","type":"codeListing","code":[".product(name: \"SwiduxMixpanelAnalytics\", package: \"SwiduxMixpanelAnalytics\"),"]},{"level":2,"type":"heading","text":"Build the service at launch","anchor":"Build-the-service-at-launch"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MixpanelAnalyticsService"},{"type":"text","text":" owns "},{"type":"codeVoice","code":"Mixpanel.initialize"},{"type":"text","text":" internally — you do not need to "},{"type":"codeVoice","code":"import Mixpanel"},{"type":"text","text":". Construct the service with your token (and any Mixpanel knobs you care about) before configuring the store:"}]},{"syntax":"swift","type":"codeListing","code":["import SwiduxMixpanelAnalytics","import SwiftUI","","@main","struct MyApp: App {","    @State private var store: AppStore","","    init() {","        let analyticsService = MixpanelAnalyticsService(","            token: \"your-mixpanel-token\",","            optOutTrackingByDefault: true","        )","        _store = State(","            wrappedValue: AppStore.configured(","                analyticsService: analyticsService,","                onConsentChange: { await analyticsService.setOptedOut($0) }","            ))","    }","","    var body: some Scene {","        WindowGroup { ContentView().environment(store) }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"The initializer takes most of the settings the app would otherwise pass to ","type":"text"},{"code":"Mixpanel.initialize","type":"codeVoice"},{"text":" (EU ","type":"text"},{"code":"serverURL","type":"codeVoice"},{"text":", ","type":"text"},{"code":"optOutTrackingByDefault","type":"codeVoice"},{"type":"text","text":", "},{"code":"flushInterval","type":"codeVoice"},{"type":"text","text":", "},{"code":"instanceName","type":"codeVoice"},{"type":"text","text":", "},{"type":"codeVoice","code":"superProperties"},{"text":", ","type":"text"},{"type":"codeVoice","code":"useGzipCompression"},{"text":", ","type":"text"},{"type":"codeVoice","code":"trackAutomaticEvents"},{"text":", ","type":"text"},{"type":"codeVoice","code":"excludeProperties"},{"text":", ","type":"text"},{"code":"useUniqueDistinctId","type":"codeVoice"},{"type":"text","text":", "},{"code":"deviceIdProvider","type":"codeVoice"},{"text":"), plus ","type":"text"},{"type":"codeVoice","code":"loggingEnabled"},{"type":"text","text":" and "},{"type":"codeVoice","code":"useIPAddressForGeoLocation"},{"type":"text","text":", which the SDK only offers as instance properties. It is identical on every platform. Pick what you need; everything else has a sensible default. See "},{"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","isActive":true},{"type":"text","text":" for the longer treatment."}]},{"type":"heading","level":2,"text":"Register the plugin with `MixpanelAnalyticsService`","anchor":"Register-the-plugin-with-MixpanelAnalyticsService"},{"inlineContent":[{"text":"Pass the service to ","type":"text"},{"code":"AnalyticsPlugin","type":"codeVoice"},{"text":" in your ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":" factory:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["import Swidux","import SwiduxAnalytics","import SwiduxMixpanelAnalytics","","extension Store where State == AppState, Action == AppAction {","    static func configured(","        analyticsService: some AnalyticsService,","        onConsentChange: (@Sendable (Bool) async -> Void)? = nil","    ) -> AppStore {","        let plugins = PluginHost<AppState, AppAction>()","","        plugins.register(","            AnalyticsPlugin<AppState, AppAction>(","                state: \\.analytics,","                action: AppAction.analytics,","                extractAction: { if case .analytics(let a) = $0 { return a }; return nil },","                service: analyticsService,","                mapper: analyticsMapper,","                identity: analyticsIdentity,","                onConsentChange: onConsentChange","            )","        )","","        var initialState = AppState()","        initialState.analytics = AnalyticsState(isOptedOut: ConsentStore.isOptedOut)","","        return Store(","            initialState: initialState,","            reducer: AppReducer().reduce,","            plugins: plugins","        )","    }","}"],"syntax":"swift"},{"inlineContent":[{"text":"That’s it — the plugin will route mapped events through the service, re-fire ","type":"text"},{"code":"identify","type":"codeVoice"},{"text":" whenever the ","type":"text"},{"code":"(userID, userProperties)","type":"codeVoice"},{"text":" pair derived from state changes, and flush on your call to ","type":"text"},{"code":"store.analyticsPlugin.flush()","type":"codeVoice"},{"text":" from ","type":"text"},{"code":"scenePhase == .background","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"text":"Keep consent in one place","anchor":"Keep-consent-in-one-place"},{"inlineContent":[{"text":"The plugin’s ","type":"text"},{"code":"isOptedOut","type":"codeVoice"},{"text":" flag and Mixpanel’s own opt-out must agree. ","type":"text"},{"code":"onConsentChange","type":"codeVoice"},{"text":" keeps them in step whenever the app dispatches ","type":"text"},{"code":".analytics(.setOptedOut(_:))","type":"codeVoice"},{"text":", but the plugin’s flag starts from whatever ","type":"text"},{"code":"AppState()","type":"codeVoice"},{"text":" gives it — ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" by default — while ","type":"text"},{"code":"optOutTrackingByDefault: true","type":"codeVoice"},{"text":" starts Mixpanel opted out. Left like that, the plugin identifies the user at launch, Mixpanel drops the call, and the plugin never retries it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"So keep the user’s consent choice in your own storage (","type":"text"},{"code":"ConsentStore","type":"codeVoice"},{"text":" above stands in for it — ","type":"text"},{"code":"UserDefaults","type":"codeVoice"},{"text":" is fine), seed ","type":"text"},{"code":"AnalyticsState(isOptedOut:)","type":"codeVoice"},{"text":" from it as shown, and dispatch the stored value once at launch — from your root view’s ","type":"text"},{"code":".task","type":"codeVoice"},{"text":" — so Mixpanel matches it:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":[".task { store.send(.analytics(.setOptedOut(ConsentStore.isOptedOut))) }"],"syntax":"swift"},{"inlineContent":[{"text":"If Mixpanel’s own record of the choice is enough, seed the flag from the service’s synchronous ","type":"text"},{"code":"isOptedOut","type":"codeVoice"},{"text":" instead. The two then agree from the start, and no launch dispatch is needed; see ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","isActive":true},{"text":". Consent changes and ","type":"text"},{"code":"reset()","type":"codeVoice"},{"text":" do erase Mixpanel’s stored choice for a moment before writing it back. An app killed in that moment starts the next launch from ","type":"text"},{"code":"optOutTrackingByDefault","type":"codeVoice"},{"text":". Keeping your own copy and dispatching it at launch, as above, covers that case.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Repeating a consent value is harmless: opting in a user who already consented sends nothing, and opting out an opted-out user does nothing.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Verify the wiring","type":"heading","anchor":"Verify-the-wiring"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Dispatch a screen view from your root view’s "},{"type":"codeVoice","code":".onAppear"},{"type":"text","text":" and confirm the event arrives in Mixpanel’s Live View:"}]},{"code":["struct ContentView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        RootContent()","            .onAppear { store.send(.analytics(.screenView(\"Home\"))) }","    }","}"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"Next Steps","type":"heading","anchor":"Next-Steps"},{"items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","type":"reference","isActive":true},{"type":"text","text":" — EU residency, opt-out by default, multiple Mixpanel projects, the "},{"type":"codeVoice","code":"MixpanelInstance"},{"type":"text","text":" escape hatch."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest"},{"text":" — Drive analytics state from previews and tests using ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ValueTranslation","type":"reference","isActive":true},{"type":"text","text":" — How "},{"code":"AnalyticsValue","type":"codeVoice"},{"type":"text","text":" cases map onto Mixpanel "},{"code":"Properties","type":"codeVoice"},{"type":"text","text":"."}]}]}],"type":"unorderedList"}],"kind":"content"}],"identifier":{"url":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/GettingStarted","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"text":"Add the package, build ","type":"text"},{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"text":" with your token, register the analytics plugin, and start dispatching events.","type":"text"}],"variants":[{"paths":["\/documentation\/swiduxmixpanelanalytics\/gettingstarted"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"role":"article","modules":[{"name":"SwiduxMixpanelAnalytics"}],"title":"Getting Started with SwiduxMixpanelAnalytics","roleHeading":"Article"},"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics"]]},"kind":"article","references":{"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/HowToImplementService":{"type":"topic","kind":"article","title":"How to Implement the Service","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","url":"\/documentation\/swiduxmixpanelanalytics\/howtoimplementservice","abstract":[{"text":"Configure ","type":"text"},{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"text":" to match your privacy, residency, and batching needs — without ","type":"text"},{"code":"import Mixpanel","type":"codeVoice"},{"text":" in your app.","type":"text"}],"role":"article"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MockMixpanelAnalyticsService":{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService","title":"MockMixpanelAnalyticsService","type":"topic","role":"symbol","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MockMixpanelAnalyticsService","kind":"identifier"}],"navigatorTitle":[{"text":"MockMixpanelAnalyticsService","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"Recording ","type":"text"},{"type":"codeVoice","code":"AnalyticsService"},{"text":" for previews and Swift Testing suites.","type":"text"}],"url":"\/documentation\/swiduxmixpanelanalytics\/mockmixpanelanalyticsservice"},"https://heirloomlogic.github.io/Swidux/documentation/swidux/howtoaddanalytics":{"title":"Add Analytics","type":"link","url":"https:\/\/heirloomlogic.github.io\/Swidux\/documentation\/swidux\/howtoaddanalytics","identifier":"https:\/\/heirloomlogic.github.io\/Swidux\/documentation\/swidux\/howtoaddanalytics","titleInlineContent":[{"text":"Add Analytics","type":"text"}]},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics":{"abstract":[{"text":"Mixpanel adapter for Swidux’s ","type":"text"},{"code":"AnalyticsPlugin","type":"codeVoice"},{"text":". Owns the Mixpanel SDK on the app’s behalf — ","type":"text"},{"code":"MixpanelAnalyticsService(token:)","type":"codeVoice"},{"text":" calls ","type":"text"},{"code":"Mixpanel.initialize","type":"codeVoice"},{"text":" internally so apps never need to ","type":"text"},{"code":"import Mixpanel","type":"codeVoice"},{"text":". Ships a recording mock for previews and tests.","type":"text"}],"url":"\/documentation\/swiduxmixpanelanalytics","type":"topic","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics","title":"SwiduxMixpanelAnalytics","role":"collection","kind":"symbol"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/HowToPreviewAndTest":{"type":"topic","kind":"article","title":"How to Preview and Test","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest","url":"\/documentation\/swiduxmixpanelanalytics\/howtopreviewandtest","abstract":[{"type":"text","text":"Drive "},{"code":"AnalyticsService","type":"codeVoice"},{"type":"text","text":" from SwiftUI previews and Swift Testing suites without touching Mixpanel’s network."}],"role":"article"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/ValueTranslation":{"type":"topic","kind":"article","title":"Value Translation","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ValueTranslation","url":"\/documentation\/swiduxmixpanelanalytics\/valuetranslation","abstract":[{"text":"How ","type":"text"},{"type":"codeVoice","code":"AnalyticsValue"},{"text":" cases map onto Mixpanel’s ","type":"text"},{"code":"MixpanelType","type":"codeVoice"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Properties"},{"text":".","type":"text"}],"role":"article"}}}
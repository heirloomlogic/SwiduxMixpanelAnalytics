{"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This guide is the shortest path from a wired Swidux app with "},{"code":"SwiduxAnalytics","type":"codeVoice"},{"type":"text","text":" registered to events landing in Mixpanel. It assumes you have already followed Swidux’s "},{"isActive":true,"type":"reference","identifier":"https:\/\/heirloomlogic.github.io\/Swidux\/documentation\/swidux\/howtoaddanalytics"},{"type":"text","text":" guide through Step 5 — that is, your "},{"code":"AppState","type":"codeVoice"},{"type":"text","text":" has an "},{"code":"analytics","type":"codeVoice"},{"type":"text","text":" slice, your "},{"code":"AppAction","type":"codeVoice"},{"type":"text","text":" routes "},{"code":".analytics(_:)","type":"codeVoice"},{"type":"text","text":", and you have an "},{"code":"AnalyticsMapper","type":"codeVoice"},{"type":"text","text":" declared."}]},{"type":"heading","level":2,"anchor":"Add-the-package","text":"Add the package"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Xcode:","type":"text"}],"type":"strong"},{"type":"text","text":" File > Add Package Dependencies, paste "},{"code":"https:\/\/github.com\/HeirloomLogic\/SwiduxMixpanelAnalytics","type":"codeVoice"},{"type":"text","text":". Add the "},{"code":"SwiduxMixpanelAnalytics","type":"codeVoice"},{"type":"text","text":" product to your target."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Package.swift:","type":"text"}],"type":"strong"}]},{"type":"codeListing","code":[".package(url: \"https:\/\/github.com\/HeirloomLogic\/SwiduxMixpanelAnalytics\", branch: \"main\"),"],"syntax":"swift"},{"type":"codeListing","code":[".product(name: \"SwiduxMixpanelAnalytics\", package: \"SwiduxMixpanelAnalytics\"),"],"syntax":"swift"},{"type":"heading","level":2,"anchor":"Initialize-Mixpanel-at-launch","text":"Initialize Mixpanel at launch"},{"type":"paragraph","inlineContent":[{"code":"MixpanelAnalyticsService()","type":"codeVoice"},{"text":" wraps ","type":"text"},{"code":"Mixpanel.mainInstance()","type":"codeVoice"},{"text":". Initialize Mixpanel before constructing the store so the main instance is ready:","type":"text"}]},{"type":"codeListing","code":["import Mixpanel","import SwiftUI","","@main","struct MyApp: App {","    @State private var store: AppStore","","    init() {","        Mixpanel.initialize(token: \"your-mixpanel-token\", trackAutomaticEvents: false)","        _store = State(wrappedValue: AppStore.configured())","    }","","    var body: some Scene {","        WindowGroup { ContentView().environment(store) }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"Mixpanel.initialize","type":"codeVoice"},{"text":" exposes additional knobs (EU server URL, opt-out by default, super properties); pick the overload that fits your app and call it once. See the ","type":"text"},{"identifier":"https:\/\/github.com\/mixpanel\/mixpanel-swift","isActive":true,"type":"reference"},{"text":" for the full list.","type":"text"}]},{"type":"heading","level":2,"anchor":"Register-the-plugin-with-MixpanelAnalyticsService","text":"Register the plugin with `MixpanelAnalyticsService`"},{"type":"paragraph","inlineContent":[{"text":"Pass ","type":"text"},{"code":"MixpanelAnalyticsService()","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"AnalyticsPlugin","type":"codeVoice"},{"text":" in your ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":" factory:","type":"text"}]},{"type":"codeListing","code":["import Swidux","import SwiduxAnalytics","import SwiduxMixpanelAnalytics","","extension Store where State == AppState, Action == AppAction {","    static func configured() -> AppStore {","        let plugins = PluginHost<AppState, AppAction>()","","        plugins.register(","            AnalyticsPlugin<AppState, AppAction>(","                state: \\.analytics,","                action: AppAction.analytics,","                extractAction: { if case .analytics(let a) = $0 { return a }; return nil },","                service: MixpanelAnalyticsService(),","                mapper: analyticsMapper,","                identity: analyticsIdentity","            )","        )","","        return Store(","            initialState: AppState(),","            reducer: AppReducer().reduce,","            plugins: plugins","        )","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"That’s it — the plugin will route mapped events through the service, auto-identify the user when ","type":"text"},{"code":"analyticsIdentity.userID","type":"codeVoice"},{"text":" returns a value, and flush on your call to ","type":"text"},{"code":"store.analyticsPlugin.flush()","type":"codeVoice"},{"text":" from ","type":"text"},{"code":"scenePhase == .background","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"heading","level":2,"anchor":"Verify-the-wiring","text":"Verify the wiring"},{"type":"paragraph","inlineContent":[{"text":"Dispatch a screen view from your root view’s ","type":"text"},{"code":".onAppear","type":"codeVoice"},{"text":" and confirm the event arrives in Mixpanel’s Live View:","type":"text"}]},{"type":"codeListing","code":["struct ContentView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        RootContent()","            .onAppear { store.send(.analytics(.screenView(\"Home\"))) }","    }","}"],"syntax":"swift"},{"type":"heading","level":2,"anchor":"Next-Steps","text":"Next Steps"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService"},{"text":" — ","type":"text"},{"code":"Mixpanel.initialize","type":"codeVoice"},{"type":"text","text":" overloads, EU residency, opt-out by default."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest"},{"type":"text","text":" — Drive analytics state from previews and tests using "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ValueTranslation"},{"text":" — How ","type":"text"},{"code":"AnalyticsValue","type":"codeVoice"},{"text":" cases map onto Mixpanel ","type":"text"},{"code":"Properties","type":"codeVoice"},{"text":".","type":"text"}]}]}]}],"kind":"content"}],"kind":"article","hierarchy":{"paths":[["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics"]]},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxmixpanelanalytics\/gettingstarted"]}],"metadata":{"modules":[{"name":"SwiduxMixpanelAnalytics"}],"role":"article","roleHeading":"Article","title":"Getting Started with SwiduxMixpanelAnalytics"},"identifier":{"url":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/GettingStarted","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Add the package, initialize Mixpanel, register the analytics plugin with "},{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"type":"text","text":", and start dispatching events."}],"references":{"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MockMixpanelAnalyticsService":{"abstract":[{"text":"Recording ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" for previews and Swift Testing suites.","type":"text"}],"url":"\/documentation\/swiduxmixpanelan
type":"text"},{"code":"SwiduxMixpanelAnalytics","type":"codeVoice"},{"text":" product to your target.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Package.swift:","type":"text"}]}],"type":"paragraph"},{"syntax":"swift","code":[".package(url: \"https:\/\/github.com\/HeirloomLogic\/SwiduxMixpanelAnalytics\", branch: \"main\"),"],"type":"codeListing"},{"syntax":"swift","code":[".product(name: \"SwiduxMixpanelAnalytics\", package: \"SwiduxMixpanelAnalytics\"),"],"type":"codeListing"},{"level":2,"anchor":"Build-the-service-at-launch","text":"Build the service at launch","type":"heading"},{"inlineContent":[{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"text":" owns ","type":"text"},{"code":"Mixpanel.initialize","type":"codeVoice"},{"type":"text","text":" internally — you do not need to "},{"type":"codeVoice","code":"import Mixpanel"},{"text":". Construct the service with your token (and any Mixpanel knobs you care about) before configuring the store:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import SwiduxMixpanelAnalytics","import SwiftUI","","@main","struct MyApp: App {","    @State private var store: AppStore","","    init() {","        let analyticsService = MixpanelAnalyticsService(","            token: \"your-mixpanel-token\",","            optOutTrackingByDefault: true","        )","        _store = State(wrappedValue: AppStore.configured(analyticsService: analyticsService))","    }","","    var body: some Scene {","        WindowGroup { ContentView().environment(store) }","    }","}"]},{"inlineContent":[{"type":"text","text":"The initializer surfaces every Mixpanel knob the app would otherwise need to set on "},{"type":"codeVoice","code":"Mixpanel.initialize"},{"type":"text","text":" (EU "},{"type":"codeVoice","code":"serverURL"},{"text":", ","type":"text"},{"code":"optOutTrackingByDefault","type":"codeVoice"},{"text":", ","type":"text"},{"code":"flushInterval","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"instanceName"},{"type":"text","text":", "},{"type":"codeVoice","code":"superProperties"},{"type":"text","text":", "},{"type":"codeVoice","code":"useGzipCompression"},{"type":"text","text":", and — on non-macOS — "},{"type":"codeVoice","code":"trackAutomaticEvents"},{"type":"text","text":"). Pick what you need; everything else has a sensible default. See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService"},{"type":"text","text":" for the longer treatment."}],"type":"paragraph"},{"level":2,"anchor":"Register-the-plugin-with-MixpanelAnalyticsService","text":"Register the plugin with `MixpanelAnalyticsService`","type":"heading"},{"inlineContent":[{"type":"text","text":"Pass the service to "},{"type":"codeVoice","code":"AnalyticsPlugin"},{"type":"text","text":" in your "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":" factory:"}],"type":"paragraph"},{"syntax":"swift","code":["import Swidux","import SwiduxAnalytics","import SwiduxMixpanelAnalytics","","extension Store where State == AppState, Action == AppAction {","    static func configured(analyticsService: some AnalyticsService) -> AppStore {","        let plugins = PluginHost<AppState, AppAction>()","","        plugins.register(","            AnalyticsPlugin<AppState, AppAction>(","                state: \\.analytics,","                action: AppAction.analytics,","                extractAction: { if case .analytics(let a) = $0 { return a }; return nil },","                service: analyticsService,","                mapper: analyticsMapper,","                identity: analyticsIdentity","            )","        )","","        return Store(","            initialState: AppState(),","            reducer: AppReducer().reduce,","            plugins: plugins","        )","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"That’s it — the plugin will route mapped events through the service, auto-identify the user when "},{"type":"codeVoice","code":"analyticsIdentity.userID"},{"type":"text","text":" returns a value, and flush on your call to "},{"type":"codeVoice","code":"store.analyticsPlugin.flush()"},{"type":"text","text":" from "},{"type":"codeVoice","code":"scenePhase == .background"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"anchor":"Verify-the-wiring","text":"Verify the wiring","type":"heading"},{"inlineContent":[{"type":"text","text":"Dispatch a screen view from your root view’s "},{"type":"codeVoice","code":".onAppear"},{"type":"text","text":" and confirm the event arrives in Mixpanel’s Live View:"}],"type":"paragraph"},{"syntax":"swift","code":["struct ContentView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        RootContent()","            .onAppear { store.send(.analytics(.screenView(\"Home\"))) }","    }","}"],"type":"codeListing"},{"level":2,"anchor":"Next-Steps","text":"Next Steps","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","isActive":true,"type":"reference"},{"text":" — EU residency, opt-out by default, multiple Mixpanel projects, the ","type":"text"},{"code":"MixpanelInstance","type":"codeVoice"},{"text":" escape hatch.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest","isActive":true,"type":"reference"},{"text":" — Drive analytics state from previews and tests using ","type":"text"},{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService","isActive":true,"type":"reference"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent"
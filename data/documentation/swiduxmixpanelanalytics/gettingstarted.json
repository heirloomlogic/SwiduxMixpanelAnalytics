\", package: \"SwiduxMixpanelAnalytics\"),"]},{"text":"Build the service at launch","type":"heading","level":2,"anchor":"Build-the-service-at-launch"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MixpanelAnalyticsService"},{"text":" owns ","type":"text"},{"type":"codeVoice","code":"Mixpanel.initialize"},{"text":" internally — you do not need to ","type":"text"},{"type":"codeVoice","code":"import Mixpanel"},{"text":". Construct the service with your token (and any Mixpanel knobs you care about) before configuring the store:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import SwiduxMixpanelAnalytics","import SwiftUI","","@main","struct MyApp: App {","    @State private var store: AppStore","","    init() {","        let analyticsService = MixpanelAnalyticsService(","            token: \"your-mixpanel-token\",","            optOutTrackingByDefault: true","        )","        _store = State(wrappedValue: AppStore.configured(analyticsService: analyticsService))","    }","","    var body: some Scene {","        WindowGroup { ContentView().environment(store) }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The initializer surfaces every Mixpanel knob the app would otherwise need to set on "},{"type":"codeVoice","code":"Mixpanel.initialize"},{"type":"text","text":" (EU "},{"type":"codeVoice","code":"serverURL"},{"type":"text","text":", "},{"type":"codeVoice","code":"optOutTrackingByDefault"},{"type":"text","text":", "},{"type":"codeVoice","code":"flushInterval"},{"type":"text","text":", "},{"type":"codeVoice","code":"instanceName"},{"type":"text","text":", "},{"type":"codeVoice","code":"superProperties"},{"type":"text","text":", "},{"type":"codeVoice","code":"useGzipCompression"},{"type":"text","text":", "},{"type":"codeVoice","code":"trackAutomaticEvents"},{"type":"text","text":", "},{"type":"codeVoice","code":"excludeProperties"},{"type":"text","text":") and is identical on every platform. Pick what you 
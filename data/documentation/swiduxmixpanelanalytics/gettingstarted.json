{"abstract":[{"text":"Add the package, build ","type":"text"},{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"text":" with your token, register the analytics plugin, and start dispatching events.","type":"text"}],"sections":[],"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"text":"This guide is the shortest path from a wired Swidux app with ","type":"text"},{"code":"SwiduxAnalytics","type":"codeVoice"},{"text":" registered to events landing in Mixpanel. It assumes you have already followed Swidux’s ","type":"text"},{"identifier":"https:\/\/heirloomlogic.github.io\/Swidux\/documentation\/swidux\/howtoaddanalytics","isActive":true,"type":"reference"},{"text":" guide through Step 5 — that is, your ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":" has an ","type":"text"},{"code":"analytics","type":"codeVoice"},{"text":" slice, your ","type":"text"},{"code":"AppAction","type":"codeVoice"},{"text":" routes ","type":"text"},{"code":".analytics(_:)","type":"codeVoice"},{"text":", and you have an ","type":"text"},{"code":"AnalyticsMapper","type":"codeVoice"},{"text":" declared.","type":"text"}],"type":"paragraph"},{"text":"Add the package","anchor":"Add-the-package","type":"heading","level":2},{"inlineContent":[{"inlineContent":[{"text":"Xcode:","type":"text"}],"type":"strong"},{"text":" File > Add Package Dependencies, paste ","type":"text"},{"code":"https:\/\/github.com\/HeirloomLogic\/SwiduxMixpanelAnalytics","type":"codeVoice"},{"text":". Add the ","type":"text"},{"code":"SwiduxMixpanelAnalytics","type":"codeVoice"},{"text":" product to your target.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Package.swift:","type":"text"}],"type":"strong"}],"type":"paragraph"},{"syntax":"swift","code":[".package(url: \"https:\/\/github.com\/HeirloomLogic\/SwiduxMixpanelAnalytics\", from: \"1.0.0\"),"],"type":"codeListing"},{"syntax":"swift","code":[".product(name: \"SwiduxMixpanelAnalytics\", package: \"SwiduxMixpanelAnalytics\"),"],"type":"codeListing"},{"text":"Build the service at launch","anchor":"Build-the-service-at-launch","type":"heading","level":2},{"inlineContent":[{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"text":" owns ","type":"text"},{"code":"Mixpanel.initialize","type":"codeVoice"},{"text":" internally — you do not need to ","type":"text"},{"code":"import Mixpanel","type":"codeVoice"},{"text":". Construct the service with your token (and any Mixpanel knobs you care about) before configuring the store:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import SwiduxMixpanelAnalytics","import SwiftUI","","@main","struct MyApp: App {","    @State private var store: AppStore","","    init() {","        let analyticsService = MixpanelAnalyticsService(","            token: \"your-mixpanel-token\",","            optOutTrackingByDefault: true","        )","        _store = State(","            wrappedValue: AppStore.configured(","                analyticsService: analyticsService,","                onConsentChange: { await analyticsService.setOptedOut($0) }","            ))","    }","","    var body: some Scene {","        WindowGroup { ContentView().environment(store) }","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"The initializer surfaces every Mixpanel knob the app would otherwise need to set on ","type":"text"},{"code":"Mixpanel.initialize","type":"codeVoice"},{"text":" (EU ","type":"text"},{"code":"serverURL","type":"codeVoice"},{"text":", ","type":"text"},{"code":"optOutTrackingByDefault","type":"codeVoice"},{"text":", ","type":"text"},{"code":"flushInterval","type":"codeVoice"},{"text":", ","type":"text"},{"code":"instanceName","type":"codeVoice"},{"text":", ","type":"text"},{"code":"superProperties","type":"codeVoice"},{"text":", ","type":"text"},{"code":"useGzipCompression","type":"codeVoice"},{"text":", ","type":"text"},{"code":"trackAutomaticEvents","type":"codeVoice"},{"text":", ","type":"text"},{"code":"excludeProperties","type":"codeVoice"},{"text":") and is identical on every platform. Pick what you need; everything else has a sensible default. See ","type":"text"},{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","isActive":true,"type":"reference"},{"text":" for the longer treatment.","type":"text"}],"type":"paragraph"},{"text":"Register the plugin with `MixpanelAnalyticsService`","anchor":"Register-the-plugin-with-MixpanelAnalyticsService","type":"heading","level":2},{"inlineContent":[{"text":"Pass the service to ","type":"text"},{"code":"AnalyticsPlugin","type":"codeVoice"},{"text":" in your ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":" factory:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import Swidux","import SwiduxAnalytics","import SwiduxMixpanelAnalytics","","extension Store where State == AppState, Action == AppAction {","    static func configured(","        analyticsService: some AnalyticsService,","        onConsentChange: (@Sendable (Bool) async -> Void)? = nil","    ) -> AppStore {","        let plugins = PluginHost<AppState, AppAction>()","","        plugins.register(","            AnalyticsPlugin<AppState, AppAction>(","                state: \\.analytics,","                action: AppAction.analytics,","                extractAction: { if case .analytics(let a) = $0 { return a }; return nil },","                service: analyticsService,","                mapper: analyticsMapper,","                identity: analyticsIdentity,","                onConsentChange: onConsentChange","            )","        )","","        var initialState = AppState()","        initialState.analytics = AnalyticsState(isOptedOut: ConsentStore.isOptedOut)","","        return Store(","            initialState: initialState,","            reducer: AppReducer().reduce,","            plugins: plugins","        )","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"That’s it — the plugin will route mapped events through the service, re-fire ","type":"text"},{"code":"identify","type":"codeVoice"},{"text":" whenever the ","type":"text"},{"code":"(userID, userProperties)","type":"codeVoice"},{"text":" pair derived from state changes, and flush on your call to ","type":"text"},{"code":"store.analyticsPlugin.flush()","type":"codeVoice"},{"text":" from ","type":"text"},{"code":"scenePhase == .background","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Keep consent in one place","anchor":"Keep-consent-in-one-place","type":"heading","level":2},{"inlineContent":[{"text":"The plugin’s ","type":"text"},{"code":"isOptedOut","type":"codeVoice"},{"text":" flag and Mixpanel’s own opt-out must agree. ","type":"text"},{"code":"onConsentChange","type":"codeVoice"},{"text":" keeps them in step whenever the app dispatches ","type":"text"},{"code":".analytics(.setOptedOut(_:))","type":"codeVoice"},{"text":", but the plugin’s flag starts from whatever ","type":"text"},{"code":"AppState()","type":"codeVoice"},{"text":" gives it — ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" by default — while ","type":"text"},{"code":"optOutTrackingByDefault: true","type":"codeVoice"},{"text":" starts Mixpanel opted out. Left like that, the plugin identifies the user at launch, Mixpanel drops the call, and the plugin never retries it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"So keep the user’s consent choice in your own storage (","type":"text"},{"code":"ConsentStore","type":"codeVoice"},{"text":" above stands in for it — ","type":"text"},{"code":"UserDefaults","type":"codeVoice"},{"text":" is fine), seed ","type":"text"},{"code":"AnalyticsState(isOptedOut:)","type":"codeVoice"},{"text":" from it as shown, and dispatch the stored value once at launch — from your root view’s ","type":"text"},{"code":".task","type":"codeVoice"},{"text":" — so Mixpanel matches it:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":[".task { store.send(.analytics(.setOptedOut(ConsentStore.isOptedOut))) }"],"type":"codeListing"},{"inlineContent":[{"text":"Repeating a consent value is harmless: opting in a user who already consented sends nothing, and opting out an opted-out user does nothing.","type":"text"}],"type":"paragraph"},{"text":"Verify the wiring","anchor":"Verify-the-wiring","type":"heading","level":2},{"inlineContent":[{"text":"Dispatch a screen view from your root view’s ","type":"text"},{"code":".onAppear","type":"codeVoice"},{"text":" and confirm the event arrives in Mixpanel’s Live View:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct ContentView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        RootContent()","            .onAppear { store.send(.analytics(.screenView(\"Home\"))) }","    }","}"],"type":"codeListing"},{"text":"Next Steps","anchor":"Next-Steps","type":"heading","level":2},{"items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","isActive":true},{"type":"text","text":" — EU residency, opt-out by default, multiple Mixpanel projects, the "},{"type":"codeVoice","code":"MixpanelInstance"},{"type":"text","text":" escape hatch."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest","isActive":true},{"type":"text","text":" — Drive analytics state from previews and tests using "},{"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ValueTranslation","isActive":true},{"type":"text","text":" — How "},{"type":"codeVoice","code":"AnalyticsValue"},{"type":"text","text":" cases map onto Mixpanel "},{"type":"codeVoice","code":"Properties"},{"type":"text","text":"."}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"identifier":{"url":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/GettingStarted","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/swiduxmixpanelanalytics\/gettingstarted"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics"]]},"metadata":{"modules":[{"name":"SwiduxMixpanelAnalytics"}],"roleHeading":"Article","role":"article","title":"Getting Started with SwiduxMixpanelAnalytics"},"kind":"article","references":{"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics":{"kind":"symbol","role":"collection","title":"SwiduxMixpanelAnalytics","abstract":[{"text":"Mixpanel adapter for Swidux’s ","type":"text"},{"code":"AnalyticsPlugin","type":"codeVoice"},{"text":". Owns the Mixpanel SDK on the app’s behalf — ","type":"text"},{"code":"MixpanelAnalyticsService(token:)","type":"codeVoice"},{"text":" calls ","type":"text"},{"type":"codeVoice","code":"Mixpanel.initialize"},{"type":"text","text":" internally so apps never need to "},{"type":"codeVoice","code":"import Mixpanel"},{"type":"text","text":". Ships a recording mock for previews and tests."}],"url":"\/documentation\/swiduxmixpanelanalytics","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics","type":"topic"},"https://heirloomlogic.github.io/Swidux/documentation/swidux/howtoaddanalytics":{"titleInlineContent":[{"text":"Add Analytics","type":"text"}],"type":"link","url":"https:\/\/heirloomlogic.github.io\/Swidux\/documentation\/swidux\/howtoaddanalytics","title":"Add Analytics","identifier":"https:\/\/heirloomlogic.github.io\/Swidux\/documentation\/swidux\/howtoaddanalytics"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/HowToPreviewAndTest":{"type":"topic","abstract":[{"text":"Drive ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" from SwiftUI previews and Swift Testing suites without touching Mixpanel’s network.","type":"text"}],"role":"article","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest","title":"How to Preview and Test","url":"\/documentation\/swiduxmixpanelanalytics\/howtopreviewandtest","kind":"article"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/HowToImplementService":{"type":"topic","abstract":[{"text":"Configure ","type":"text"},{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"text":" to match your privacy, residency, and batching needs — without ","type":"text"},{"code":"import Mixpanel","type":"codeVoice"},{"text":" in your app.","type":"text"}],"role":"article","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","title":"How to Implement the Service","url":"\/documentation\/swiduxmixpanelanalytics\/howtoimplementservice","kind":"article"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/ValueTranslation":{"type":"topic","abstract":[{"text":"How ","type":"text"},{"code":"AnalyticsValue","type":"codeVoice"},{"text":" cases map onto Mixpanel’s ","type":"text"},{"code":"MixpanelType","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Properties","type":"codeVoice"},{"text":".","type":"text"}],"role":"article","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ValueTranslation","title":"Value Translation","url":"\/documentation\/swiduxmixpanelanalytics\/valuetranslation","kind":"article"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MockMixpanelAnalyticsService":{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"MockMixpanelAnalyticsService"}],"kind":"symbol","abstract":[{"text":"Recording ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" for previews and Swift Testing suites.","type":"text"}],"url":"\/documentation\/swiduxmixpanelanalytics\/mockmixpanelanalyticsservice","role":"symbol","title":"MockMixpanelAnalyticsService","navigatorTitle":[{"kind":"identifier","text":"MockMixpanelAnalyticsService"}],"type":"topic"}}}
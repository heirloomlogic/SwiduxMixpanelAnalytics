{"sections":[],"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This guide is the shortest path from a wired Swidux app with "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" registered to events landing in Mixpanel. It assumes you have already followed Swidux’s "},{"isActive":true,"type":"reference","identifier":"https:\/\/heirloomlogic.github.io\/Swidux\/documentation\/swidux\/howtoaddanalytics"},{"type":"text","text":" guide through Step 5 — that is, your "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":" has an "},{"type":"codeVoice","code":"analytics"},{"type":"text","text":" slice, your "},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":" routes "},{"type":"codeVoice","code":".analytics(_:)"},{"type":"text","text":", and you have an "},{"type":"codeVoice","code":"AnalyticsMapper"},{"type":"text","text":" declared."}]},{"text":"Add the package","type":"heading","level":2,"anchor":"Add-the-package"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Xcode:","type":"text"}],"type":"strong"},{"type":"text","text":" File > Add Package Dependencies, paste "},{"type":"codeVoice","code":"https:\/\/github.com\/HeirloomLogic\/SwiduxMixpanelAnalytics"},{"type":"text","text":". Add the "},{"type":"codeVoice","code":"SwiduxMixpanelAnalytics"},{"type":"text","text":" product to your target."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Package.swift:","type":"text"}],"type":"strong"}]},{"syntax":"swift","type":"codeListing","code":[".package(url: \"https:\/\/github.com\/HeirloomLogic\/SwiduxMixpanelAnalytics\", branch: \"main\"),"]},{"syntax":"swift","type":"codeListing","code":[".product(name: \"SwiduxMixpanelAnalytics\", package: \"SwiduxMixpanelAnalytics\"),"]},{"text":"Build the service at launch","type":"heading","level":2,"anchor":"Build-the-service-at-launch"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MixpanelAnalyticsService"},{"type":"text","text":" owns "},{"type":"codeVoice","code":"Mixpanel.initialize"},{"type":"text","text":" internally — you do not need to "},{"type":"codeVoice","code":"import Mixpanel"},{"type":"text","text":". Construct the service with your token (and any Mixpanel knobs you care about) before configuring the store:"}]},{"syntax":"swift","type":"codeListing","code":["import SwiduxMixpanelAnalytics","import SwiftUI","","@main","struct MyApp: App {","    @State private var store: AppStore","","    init() {","        let analyticsService = MixpanelAnalyticsService(","            token: \"your-mixpanel-token\",","            optOutTrackingByDefault: true","        )","        _store = State(wrappedValue: AppStore.configured(analyticsService: analyticsService))","    }","","    var body: some Scene {","        WindowGroup { ContentView().environment(store) }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The initializer surfaces every Mixpanel knob the app would otherwise need to set on "},{"type":"codeVoice","code":"Mixpanel.initialize"},{"type":"text","text":" (EU "},{"type":"codeVoice","code":"serverURL"},{"type":"text","text":", "},{"type":"codeVoice","code":"optOutTrackingByDefault"},{"type":"text","text":", "},{"type":"codeVoice","code":"flushInterval"},{"type":"text","text":", "},{"type":"codeVoice","code":"instanceName"},{"type":"text","text":", "},{"type":"codeVoice","code":"superProperties"},{"type":"text","text":", "},{"type":"codeVoice","code":"useGzipCompression"},{"type":"text","text":", and — on non-macOS — "},{"type":"codeVoice","code":"trackAutomaticEvents"},{"type":"text","text":"). Pick what you need; everything else has a sensible default. See "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService"},{"type":"text","text":" for the longer treatment."}]},{"text":"Register the plugin with `MixpanelAnalyticsService`","type":"heading","level":2,"anchor":"Register-the-plugin-with-MixpanelAnalyticsService"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass the service to "},{"type":"codeVoice","code":"AnalyticsPlugin"},{"type":"text","text":" in your "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":" factory:"}]},{"syntax":"swift","type":"codeListing","code":["import Swidux","import SwiduxAnalytics","import SwiduxMixpanelAnalytics","","extension Store where State == AppState, Action == AppAction {","    static func configured(analyticsService: some AnalyticsService) -> AppStore {","        let plugins = PluginHost<AppState, AppAction>()","","        plugins.register(","            AnalyticsPlugin<AppState, AppAction>(","                state: \\.analytics,","                action: AppAction.analytics,","                extractAction: { if case .analytics(let a) = $0 { return a }; return nil },","                service: analyticsService,","                mapper: analyticsMapper,","                identity: analyticsIdentity","            )","        )","","        return Store(","            initialState: AppState(),","            reducer: AppReducer().reduce,","            plugins: plugins","        )","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"That’s it — the plugin will route mapped events through the service, re-fire "},{"type":"codeVoice","code":"identify"},{"type":"text","text":" whenever the "},{"type":"codeVoice","code":"(userID, userProperties)"},{"type":"text","text":" pair derived from state changes, and flush on your call to "},{"type":"codeVoice","code":"store.analyticsPlugin.flush()"},{"type":"text","text":" from "},{"type":"codeVoice","code":"scenePhase == .background"},{"type":"text","text":"."}]},{"text":"Verify the wiring","type":"heading","level":2,"anchor":"Verify-the-wiring"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Dispatch a screen view from your root view’s "},{"type":"codeVoice","code":".onAppear"},{"type":"text","text":" and confirm the event arrives in Mixpanel’s Live View:"}]},{"syntax":"swift","type":"codeListing","code":["struct ContentView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        RootContent()","            .onAppear { store.send(.analytics(.screenView(\"Home\"))) }","    }","}"]},{"text":"Next Steps","type":"heading","level":2,"anchor":"Next-Steps"},{"items":[{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService"},{"text":" — EU residency, opt-out by default, multiple Mixpanel projects, the ","type":"text"},{"code":"MixpanelInstance","type":"codeVoice"},{"text":" escape hatch.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest"},{"text":" — Drive analytics state from previews and tests using ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ValueTranslation"},{"text":" — How ","type":"text"},{"code":"AnalyticsValue","type":"codeVoice"},{"text":" cases map onto Mixpanel ","type":"text"},{"code":"Properties","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxmixpanelanalytics\/gettingstarted"]}],"hierarchy":{"paths":[["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics"]]},"identifier":{"url":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/GettingStarted","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"Add the package, build ","type":"text"},{"type":"codeVoice","code":"MixpanelAnalyticsService"},{"text":" with your token, register the analytics plugin, and start dispatching events.","type":"text"}],"metadata":{"roleHeading":"Article","modules":[{"name":"SwiduxMixpanelAnalytics"}],"title":"Getting Started with SwiduxMixpanelAnalytics","role":"article"},"kind":"article","references":{"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/HowToImplementService":{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","url":"\/documentation\/swiduxmixpanelanalytics\/howtoimplementservice","title":"How to Implement the Service","type":"topic","role":"article","abstract":[{"text":"Configure ","type":"text"},{"type":"codeVoice","code":"MixpanelAnalyticsService"},{"text":" to match your privacy, residency, and batching needs — without ","type":"text"},{"type":"codeVoice","code":"import Mixpanel"},{"text":" in your app.","type":"text"}],"kind":"article"},"https://heirloomlogic.github.io/Swidux/documentation/swidux/howtoaddanalytics":{"type":"link","identifier":"https:\/\/heirloomlogic.github.io\/Swidux\/documentation\/swidux\/howtoaddanalytics","url":"https:\/\/heirloomlogic.github.io\/Swidux\/documentation\/swidux\/howtoaddanalytics","title":"Add Analytics","titleInlineContent":[{"text":"Add Analytics","type":"text"}]},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/ValueTranslation":{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ValueTranslation","url":"\/documentation\/swiduxmixpanelanalytics\/valuetranslation","title":"Value Translation","type":"topic","role":"article","abstract":[{"text":"How ","type":"text"},{"type":"codeVoice","code":"AnalyticsValue"},{"text":" cases map onto Mixpanel’s ","type":"text"},{"type":"codeVoice","code":"MixpanelType"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Properties"},{"text":".","type":"text"}],"kind":"article"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MockMixpanelAnalyticsService":{"navigatorTitle":[{"text":"MockMixpanelAnalyticsService","kind":"identifier"}],"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService","url":"\/documentation\/swiduxmixpanelanalytics\/mockmixpanelanalyticsservice","title":"MockMixpanelAnalyticsService","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MockMixpanelAnalyticsService","kind":"identifier"}],"type":"topic","role":"symbol","abstract":[{"type":"text","text":"Recording "},{"type":"codeVoice","code":"AnalyticsService"},{"text":" for previews and Swift Testing suites.","type":"text"}],"kind":"symbol"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/HowToPreviewAndTest":{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest","url":"\/documentation\/swiduxmixpanelanalytics\/howtopreviewandtest","title":"How to Preview and Test","type":"topic","role":"article","abstract":[{"text":"Drive ","type":"text"},{"type":"codeVoice","code":"AnalyticsService"},{"text":" from SwiftUI previews and Swift Testing suites without touching Mixpanel’s network.","type":"text"}],"kind":"article"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics":{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics","url":"\/documentation\/swiduxmixpanelanalytics","title":"SwiduxMixpanelAnalytics","type":"topic","role":"collection","abstract":[{"type":"text","text":"Mixpanel adapter for Swidux’s "},{"type":"codeVoice","code":"AnalyticsPlugin"},{"type":"text","text":". Owns the Mixpanel SDK on the app’s behalf — "},{"type":"codeVoice","code":"MixpanelAnalyticsService(token:)"},{"type":"text","text":" calls "},{"type":"codeVoice","code":"Mixpanel.initialize"},{"type":"text","text":" internally so apps never need to "},{"type":"codeVoice","code":"import Mixpanel"},{"type":"text","text":". Ships a recording mock for previews and tests."}],"kind":"symbol"}}}
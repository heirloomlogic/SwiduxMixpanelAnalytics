{"kind":"article","identifier":{"url":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/GettingStarted","interfaceLanguage":"swift"},"metadata":{"role":"article","modules":[{"name":"SwiduxMixpanelAnalytics"}],"title":"Getting Started with SwiduxMixpanelAnalytics","roleHeading":"Article"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxmixpanelanalytics\/gettingstarted"]}],"abstract":[{"type":"text","text":"Add the package, build "},{"type":"codeVoice","code":"MixpanelAnalyticsService"},{"type":"text","text":" with your token, register the analytics plugin, and start dispatching events."}],"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"This guide is the shortest path from a wired Swidux app with "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" registered to events landing in Mixpanel. It assumes you have already followed Swidux’s "},{"type":"reference","identifier":"https:\/\/heirloomlogic.github.io\/Swidux\/documentation\/swidux\/howtoaddanalytics","isActive":true},{"type":"text","text":" guide through Step 5 — that is, your "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":" has an "},{"type":"codeVoice","code":"analytics"},{"type":"text","text":" slice, your "},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":" routes "},{"type":"codeVoice","code":".analytics(_:)"},{"type":"text","text":", and you have an "},{"type":"codeVoice","code":"AnalyticsMapper"},{"type":"text","text":" declared."}],"type":"paragraph"},{"anchor":"Add-the-package","level":2,"type":"heading","text":"Add the package"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Xcode:"}]},{"type":"text","text":" File > Add Package Dependencies, paste "},{"type":"codeVoice","code":"https:\/\/github.com\/HeirloomLogic\/SwiduxMixpanelAnalytics"},{"type":"text","text":". Add the "},{"type":"codeVoice","code":"SwiduxMixpanelAnalytics"},{"type":"text","text":" product to your target."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Package.swift:"}]}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":[".package(url: \"https:\/\/github.com\/HeirloomLogic\/SwiduxMixpanelAnalytics\", from: \"1.0.0\"),"]},{"syntax":"swift","type":"codeListing","code":[".product(name: \"SwiduxMixpanelAnalytics\", package: \"SwiduxMixpanelAnalytics\"),"]},{"anchor":"Build-the-service-at-launch","level":2,"type":"heading","text":"Build the service at launch"},{"inlineContent":[{"type":"codeVoice","code":"MixpanelAnalyticsService"},{"type":"text","text":" owns "},{"type":"codeVoice","code":"Mixpanel.initialize"},{"type":"text","text":" internally — you do not need to "},{"type":"codeVoice","code":"import Mixpanel"},{"type":"text","text":". Construct the service with your token (and any Mixpanel knobs you care about) before configuring the store:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import SwiduxMixpanelAnalytics","import SwiftUI","","@main","struct MyApp: App {","    @State private var store: AppStore","","    init() {","        let analyticsService = MixpanelAnalyticsService(","            token: \"your-mixpanel-token\",","            optOutTrackingByDefault: true","        )","        _store = State(wrappedValue: AppStore.configured(analyticsService: analyticsService))","    }","","    var body: some Scene {","        WindowGroup { ContentView().environment(store) }","    }","}"]},{"inlineContent":[{"type":"text","text":"The initializer surfaces every Mixpanel knob the app would otherwise need to set on "},{"type":"codeVoice","code":"Mixpanel.initialize"},{"type":"text","text":" (EU "},{"type":"codeVoice","code":"serverURL"},{"type":"text","text":", "},{"type":"codeVoice","code":"optOutTrackingByDefault"},{"type":"text","text":", "},{"type":"codeVoice","code":"flushInterval"},{"type":"text","text":", "},{"type":"codeVoice","code":"instanceName"},{"type":"text","text":", "},{"type":"codeVoice","code":"superProperties"},{"type":"text","text":", "},{"type":"codeVoice","code":"useGzipCompression"},{"type":"text","text":", "},{"type":"codeVoice","code":"trackAutomaticEvents"},{"type":"text","text":", "},{"type":"codeVoice","code":"excludeProperties"},{"type":"text","text":") and is identical on every platform. Pick what you need; everything else has a sensible default. See "},{"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","isActive":true},{"type":"text","text":" for the longer treatment."}],"type":"paragraph"},{"anchor":"Register-the-plugin-with-MixpanelAnalyticsService","level":2,"type":"heading","text":"Register the plugin with `MixpanelAnalyticsService`"},{"inlineContent":[{"type":"text","text":"Pass the service to "},{"type":"codeVoice","code":"AnalyticsPlugin"},{"type":"text","text":" in your "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":" factory:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import Swidux","import SwiduxAnalytics","import SwiduxMixpanelAnalytics","","extension Store where State == AppState, Action == AppAction {","    static func configured(analyticsService: some AnalyticsService) -> AppStore {","        let plugins = PluginHost<AppState, AppAction>()","","        plugins.register(","            AnalyticsPlugin<AppState, AppAction>(","                state: \\.analytics,","                action: AppAction.analytics,","                extractAction: { if case .analytics(let a) = $0 { return a }; return nil },","                service: analyticsService,","                mapper: analyticsMapper,","                identity: analyticsIdentity","            )","        )","","        return Store(","            initialState: AppState(),","            reducer: AppReducer().reduce,","            plugins: plugins","        )","    }","}"]},{"inlineContent":[{"type":"text","text":"That’s it — the plugin will route mapped events through the service, re-fire "},{"type":"codeVoice","code":"identify"},{"type":"text","text":" whenever the "},{"type":"codeVoice","code":"(userID, userProperties)"},{"type":"text","text":" pair derived from state changes, and flush on your call to "},{"type":"codeVoice","code":"store.analyticsPlugin.flush()"},{"type":"text","text":" from "},{"type":"codeVoice","code":"scenePhase == .background"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Verify-the-wiring","level":2,"type":"heading","text":"Verify the wiring"},{"inlineContent":[{"type":"text","text":"Dispatch a screen view from your root view’s "},{"type":"codeVoice","code":".onAppear"},{"type":"text","text":" and confirm the event arrives in Mixpanel’s Live View:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct ContentView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        RootContent()","            .onAppear { store.send(.analytics(.screenView(\"Home\"))) }","    }","}"]},{"anchor":"Next-Steps","level":2,"type":"heading","text":"Next Steps"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService"},{"type":"text","text":" — EU residency, opt-out by default, multiple Mixpanel projects, the "},{"code":"MixpanelInstance","type":"codeVoice"},{"type":"text","text":" escape hatch."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest"},{"type":"text","text":" — Drive analytics state from previews and tests using "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ValueTranslation"},{"type":"text","text":" — How "},{"code":"AnalyticsValue","type":"codeVoice"},{"type":"text","text":" cases map onto Mixpanel "},{"code":"Properties","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]}]}],"kind":"content"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/ValueTranslation":{"kind":"article","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ValueTranslation","role":"article","abstract":[{"type":"text","text":"How "},{"type":"codeVoice","code":"AnalyticsValue"},{"type":"text","text":" cases map onto Mixpanel’s "},{"type":"codeVoice","code":"MixpanelType"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Properties"},{"type":"text","text":"."}],"url":"\/documentation\/swiduxmixpanelanalytics\/valuetranslation","title":"Value Translation","type":"topic"},"https://heirloomlogic.github.io/Swidux/documentation/swidux/howtoaddanalytics":{"identifier":"https:\/\/heirloomlogic.github.io\/Swidux\/documentation\/swidux\/howtoaddanalytics","title":"Add Analytics","type":"link","url":"https:\/\/heirloomlogic.github.io\/Swidux\/documentation\/swidux\/howtoaddanalytics","titleInlineContent":[{"type":"text","text":"Add Analytics"}]},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics":{"type":"topic","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics","role":"collection","abstract":[{"type":"text","text":"Mixpanel adapter for Swidux’s "},{"type":"codeVoice","code":"AnalyticsPlugin"},{"type":"text","text":". Owns the Mixpanel SDK on the app’s behalf — "},{"type":"codeVoice","code":"MixpanelAnalyticsService(token:)"},{"type":"text","text":" calls "},{"type":"codeVoice","code":"Mixpanel.initialize"},{"type":"text","text":" internally so apps never need to "},{"code":"import Mixpanel","type":"codeVoice"},{"type":"text","text":". Ships a recording mock for previews and tests."}],"title":"SwiduxMixpanelAnalytics","url":"\/documentation\/swiduxmixpanelanalytics","kind":"symbol"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/HowToPreviewAndTest":{"kind":"article","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest","role":"article","abstract":[{"text":"Drive ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" from SwiftUI previews and Swift Testing suites without touching Mixpanel’s network.","type":"text"}],"url":"\/documentation\/swiduxmixpanelanalytics\/howtopreviewandtest","title":"How to Preview and Test","type":"topic"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/HowToImplementService":{"kind":"article","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","role":"article","abstract":[{"type":"text","text":"Configure "},{"type":"codeVoice","code":"MixpanelAnalyticsService"},{"type":"text","text":" to match your privacy, residency, and batching needs — without "},{"type":"codeVoice","code":"import Mixpanel"},{"type":"text","text":" in your app."}],"url":"\/documentation\/swiduxmixpanelanalytics\/howtoimplementservice","title":"How to Implement the Service","type":"topic"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MockMixpanelAnalyticsService":{"navigatorTitle":[{"kind":"identifier","text":"MockMixpanelAnalyticsService"}],"kind":"symbol","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService","role":"symbol","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"MockMixpanelAnalyticsService"}],"abstract":[{"type":"text","text":"Recording "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" for previews and Swift Testing suites."}],"url":"\/documentation\/swiduxmixpanelanalytics\/mockmixpanelanalyticsservice","title":"MockMixpanelAnalyticsService","type":"topic"}}}
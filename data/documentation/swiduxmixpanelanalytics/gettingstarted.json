{"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"article","hierarchy":{"paths":[["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/GettingStarted"},"metadata":{"modules":[{"name":"SwiduxMixpanelAnalytics"}],"role":"article","title":"Getting Started with SwiduxMixpanelAnalytics","roleHeading":"Article"},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"text":"This guide is the shortest path from a wired Swidux app with ","type":"text"},{"code":"SwiduxAnalytics","type":"codeVoice"},{"text":" registered to events landing in Mixpanel. It assumes you have already followed Swidux’s ","type":"text"},{"identifier":"https:\/\/heirloomlogic.github.io\/Swidux\/documentation\/swidux\/howtoaddanalytics","isActive":true,"type":"reference"},{"text":" guide through Step 5 — that is, your ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":" has an ","type":"text"},{"code":"analytics","type":"codeVoice"},{"text":" slice, your ","type":"text"},{"code":"AppAction","type":"codeVoice"},{"text":" routes ","type":"text"},{"code":".analytics(_:)","type":"codeVoice"},{"text":", and you have an ","type":"text"},{"code":"AnalyticsMapper","type":"codeVoice"},{"text":" declared.","type":"text"}],"type":"paragraph"},{"anchor":"Add-the-package","level":2,"type":"heading","text":"Add the package"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Xcode:"}],"type":"strong"},{"text":" File > Add Package Dependencies, paste ","type":"text"},{"code":"https:\/\/github.com\/HeirloomLogic\/SwiduxMixpanelAnalytics","type":"codeVoice"},{"text":". Add the ","type":"text"},{"code":"SwiduxMixpanelAnalytics","type":"codeVoice"},{"text":" product to your target.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Package.swift:"}],"type":"strong"}],"type":"paragraph"},{"syntax":"swift","code":[".package(url: \"https:\/\/github.com\/HeirloomLogic\/SwiduxMixpanelAnalytics\", branch: \"main\"),"],"type":"codeListing"},{"syntax":"swift","code":[".product(name: \"SwiduxMixpanelAnalytics\", package: \"SwiduxMixpanelAnalytics\"),"],"type":"codeListing"},{"anchor":"Initialize-Mixpanel-at-launch","level":2,"type":"heading","text":"Initialize Mixpanel at launch"},{"inlineContent":[{"code":"MixpanelAnalyticsService()","type":"codeVoice"},{"text":" wraps ","type":"text"},{"code":"Mixpanel.mainInstance()","type":"codeVoice"},{"text":". Initialize Mixpanel before constructing the store so the main instance is ready:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import Mixpanel","import SwiftUI","","@main","struct MyApp: App {","    @State private var store: AppStore","","    init() {","        Mixpanel.initialize(token: \"your-mixpanel-token\", trackAutomaticEvents: false)","        _store = State(wrappedValue: AppStore.configured())","    }","","    var body: some Scene {","        WindowGroup { ContentView().environment(store) }","    }","}"],"type":"codeListing"},{"inlineContent":[{"code":"Mixpanel.initialize","type":"codeVoice"},{"text":" exposes additional knobs (EU server URL, opt-out by default, super properties); pick the overload that fits your app and call it once. See the ","type":"text"},{"identifier":"https:\/\/github.com\/mixpanel\/mixpanel-swift","isActive":true,"type":"reference"},{"text":" for the full list.","type":"text"}],"type":"paragraph"},{"anchor":"Register-the-plugin-with-MixpanelAnalyticsService","level":2,"type":"heading","text":"Register the plugin with `MixpanelAnalyticsService`"},{"inlineContent":[{"text":"Pass ","type":"text"},{"code":"MixpanelAnalyticsService()","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"AnalyticsPlugin","type":"codeVoice"},{"text":" in your ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":" factory:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import Swidux","import SwiduxAnalytics","import SwiduxMixpanelAnalytics","","extension Store where State == AppState, Action == AppAction {","    static func configured() -> AppStore {","        let plugins = PluginHost<AppState, AppAction>()","","        plugins.register(","            AnalyticsPlugin<AppState, AppAction>(","                state: \\.analytics,","                action: AppAction.analytics,","                extractAction: { if case .analytics(let a) = $0 { return a }; return nil },","                service: MixpanelAnalyticsService(),","                mapper: analyticsMapper,","                identity: analyticsIdentity","            )","        )","","        return Store(","            initialState: AppState(),","            reducer: AppReducer().reduce,","            plugins: plugins","        )","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"That’s it — the plugin will route mapped events through the service, auto-identify the user when ","type":"text"},{"code":"analyticsIdentity.userID","type":"codeVoice"},{"text":" returns a value, and flush on your call to ","type":"text"},{"code":"store.analyticsPlugin.flush()","type":"codeVoice"},{"text":" from ","type":"text"},{"code":"scenePhase == .background","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Verify-the-wiring","level":2,"type":"heading","text":"Verify the wiring"},{"inlineContent":[{"text":"Dispatch a screen view from your root view’s ","type":"text"},{"code":".onAppear","type":"codeVoice"},{"text":" and confirm the event arrives in Mixpanel’s Live View:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct ContentView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        RootContent()","            .onAppear { store.send(.analytics(.screenView(\"Home\"))) }","    }","}
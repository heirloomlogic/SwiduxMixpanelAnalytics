{"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/GettingStarted","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This guide is the shortest path from a wired Swidux app with "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" registered to events landing in Mixpanel. It assumes you have already followed Swidux’s "},{"type":"reference","identifier":"https:\/\/heirloomlogic.github.io\/Swidux\/documentation\/swidux\/howtoaddanalytics","isActive":true},{"type":"text","text":" guide through Step 5 — that is, your "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":" has an "},{"type":"codeVoice","code":"analytics"},{"type":"text","text":" slice, your "},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":" routes "},{"type":"codeVoice","code":".analytics(_:)"},{"type":"text","text":", and you have an "},{"type":"codeVoice","code":"AnalyticsMapper"},{"type":"text","text":" declared."}]},{"text":"Add the package","level":2,"type":"heading","anchor":"Add-the-package"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Xcode:","type":"text"}]},{"type":"text","text":" File > Add Package Dependencies, paste "},{"type":"codeVoice","code":"https:\/\/github.com\/HeirloomLogic\/SwiduxMixpanelAnalytics"},{"type":"text","text":". Add the "},{"type":"codeVoice","code":"SwiduxMixpanelAnalytics"},{"type":"text","text":" product to your target."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Package.swift:","type":"text"}]}]},{"code":[".package(url: \"https:\/\/github.com\/HeirloomLogic\/SwiduxMixpanelAnalytics\", from: \"1.0.0\"),"],"syntax":"swift","type":"codeListing"},{"code":[".product(name: \"SwiduxMixpanelAnalytics\", package: \"SwiduxMixpanelAnalytics\"),"],"syntax":"swift","type":"codeListing"},{"text":"Build the service at launch","level":2,"type":"heading","anchor":"Build-the-service-at-launch"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MixpanelAnalyticsService"},{"type":"text","text":" owns "},{"type":"codeVoice","code":"Mixpanel.initialize"},{"type":"text","text":" internally — you do not need to "},{"type":"codeVoice","code":"import Mixpanel"},{"type":"text","text":". Construct the service with your token (and any Mixpanel knobs you care about) before configuring the store:"}]},{"code":["import SwiduxMixpanelAnalytics","import SwiftUI","","@main","struct MyApp: App {","    @State private var store: AppStore","","    init() {","        let analyticsService = MixpanelAnalyticsService(","            token: \"your-mixpanel-token\",","            optOutTrackingByDefault: true","        )","        _store = State(","            wrappedValue: AppStore.configured(","                analyticsService: analyticsService,","                onConsentChange: { await analyticsService.setOptedOut($0) }","            ))","    }","","    var body: some Scene {","        WindowGroup { ContentView().environment(store) }","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The initializer takes most of the settings the app would otherwise pass to "},{"type":"codeVoice","code":"Mixpanel.initialize"},{"type":"text","text":" (EU "},{"type":"codeVoice","code":"serverURL"},{"type":"text","text":", "},{"type":"codeVoice","code":"optOutTrackingByDefault"},{"type":"text","text":", "},{"type":"codeVoice","code":"flushInterval"},{"type":"text","text":", "},{"type":"codeVoice","code":"instanceName"},{"type":"text","text":", "},{"type":"codeVoice","code":"superProperties"},{"type":"text","text":", "},{"type":"codeVoice","code":"useGzipCompression"},{"type":"text","text":", "},{"type":"codeVoice","code":"trackAutomaticEvents"},{"type":"text","text":", "},{"type":"codeVoice","code":"excludeProperties"},{"type":"text","text":", "},{"type":"codeVoice","code":"useUniqueDistinctId"},{"type":"text","text":", "},{"type":"codeVoice","code":"deviceIdProvider"},{"type":"text","text":"), plus "},{"type":"codeVoice","code":"loggingEnabled"},{"type":"text","text":" and "},{"type":"codeVoice","code":"useIPAddressForGeoLocation"},{"type":"text","text":", which the SDK only offers as instance properties. It is identical on every platform. Pick what you need; everything else has a sensible default. See "},{"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","isActive":true},{"type":"text","text":" for the longer treatment."}]},{"text":"Register the plugin with `MixpanelAnalyticsService`","level":2,"type":"heading","anchor":"Register-the-plugin-with-MixpanelAnalyticsService"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass the service to "},{"type":"codeVoice","code":"AnalyticsPlugin"},{"type":"text","text":" in your "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":" factory:"}]},{"code":["import Swidux","import SwiduxAnalytics","import SwiduxMixpanelAnalytics","","extension Store where State == AppState, Action == AppAction {","    static func configured(","        analyticsService: some AnalyticsService,","        onConsentChange: (@Sendable (Bool) async -> Void)? = nil","    ) -> AppStore {","        let plugins = PluginHost<AppState, AppAction>()","","        plugins.register(","            AnalyticsPlugin<AppState, AppAction>(","                state: \\.analytics,","                action: AppAction.analytics,","                extractAction: { if case .analytics(let a) = $0 { return a }; return nil },","                service: analyticsService,","                mapper: analyticsMapper,","                identity: analyticsIdentity,","                onConsentChange: onConsentChange","            )","        )","","        var initialState = AppState()","        initialState.analytics = AnalyticsState(isOptedOut: ConsentStore.isOptedOut)","","        return Store(","            initialState: initialState,","            reducer: AppReducer().reduce,","            plugins: plugins","        )","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"That’s it — the plugin will route mapped events through the service, re-fire "},{"type":"codeVoice","code":"identify"},{"type":"text","text":" whenever the "},{"type":"codeVoice","code":"(userID, userProperties)"},{"type":"text","text":" pair derived from state changes, and flush on your call to "},{"type":"codeVoice","code":"store.analyticsPlugin.flush()"},{"type":"text","text":" from "},{"type":"codeVoice","code":"scenePhase == .background"},{"type":"text","text":"."}]},{"text":"Keep consent in one place","level":2,"type":"heading","anchor":"Keep-consent-in-one-place"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin’s "},{"type":"codeVoice","code":"isOptedOut"},{"type":"text","text":" flag and Mixpanel’s own opt-out must agree. "},{"type":"codeVoice","code":"onConsentChange"},{"type":"text","text":" keeps them in step whenever the app dispatches "},{"type":"codeVoice","code":".analytics(.setOptedOut(_:))"},{"type":"text","text":", but the plugin’s flag starts from whatever "},{"type":"codeVoice","code":"AppState()"},{"type":"text","text":" gives it — "},{"type":"codeVoice","code":"false"},{"type":"text","text":" by default — while "},{"type":"codeVoice","code":"optOutTrackingByDefault: true"},{"type":"text","text":" starts Mixpanel opted out. Left like that, the plugin identifies the user at launch, Mixpanel drops the call, and the plugin never retries it."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"So keep the user’s consent choice in your own storage ("},{"type":"codeVoice","code":"ConsentStore"},{"type":"text","text":" above stands in for it — "},{"type":"codeVoice","code":"UserDefaults"},{"type":"text","text":" is fine), seed "},{"type":"codeVoice","code":"AnalyticsState(isOptedOut:)"},{"type":"text","text":" from it as shown, and dispatch the stored value once at launch — from your root view’s "},{"type":"codeVoice","code":".task"},{"type":"text","text":" — so Mixpanel matches it:"}]},{"code":[".task { store.send(.analytics(.setOptedOut(ConsentStore.isOptedOut))) }"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If Mixpanel’s own record of the choice is enough, seed the flag from the service’s synchronous "},{"type":"codeVoice","code":"isOptedOut"},{"type":"text","text":" instead. The two then agree from the start, and no launch dispatch is needed; see "},{"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","isActive":true},{"type":"text","text":". Consent changes and "},{"type":"codeVoice","code":"reset()"},{"type":"text","text":" do erase Mixpanel’s stored choice for a moment before writing it back. An app killed in that moment starts the next launch from "},{"type":"codeVoice","code":"optOutTrackingByDefault"},{"type":"text","text":". Keeping your own copy and dispatching it at launch, as above, covers that case."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Repeating a consent value is harmless: opting in a user who already consented sends nothing, and opting out an opted-out user does nothing."}]},{"text":"Verify the wiring","level":2,"type":"heading","anchor":"Verify-the-wiring"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Dispatch a screen view from your root view’s "},{"type":"codeVoice","code":".onAppear"},{"type":"text","text":" and confirm the event arrives in Mixpanel’s Live View:"}]},{"code":["struct ContentView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        RootContent()","            .onAppear { store.send(.analytics(.screenView(\"Home\"))) }","    }","}"],"syntax":"swift","type":"codeListing"},{"text":"Next Steps","level":2,"type":"heading","anchor":"Next-Steps"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","type":"reference","isActive":true},{"type":"text","text":" — EU residency, opt-out by default, multiple Mixpanel projects, the "},{"type":"codeVoice","code":"MixpanelInstance"},{"type":"text","text":" escape hatch."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest","type":"reference","isActive":true},{"type":"text","text":" — Drive analytics state from previews and tests using "},{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ValueTranslation","type":"reference","isActive":true},{"type":"text","text":" — How "},{"type":"codeVoice","code":"AnalyticsValue"},{"type":"text","text":" cases map onto Mixpanel "},{"type":"codeVoice","code":"Properties"},{"type":"text","text":"."}],"type":"paragraph"}]}]}]}],"sections":[],"abstract":[{"text":"Add the package, build ","type":"text"},{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"text":" with your token, register the analytics plugin, and start dispatching events.","type":"text"}],"metadata":{"modules":[{"name":"SwiduxMixpanelAnalytics"}],"title":"Getting Started with SwiduxMixpanelAnalytics","role":"article","roleHeading":"Article"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxmixpanelanalytics\/gettingstarted"]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics"]]},"references":{"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/ValueTranslation":{"abstract":[{"text":"How ","type":"text"},{"code":"AnalyticsValue","type":"codeVoice"},{"text":" cases map onto Mixpanel’s ","type":"text"},{"code":"MixpanelType","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Properties","type":"codeVoice"},{"text":".","type":"text"}],"role":"article","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ValueTranslation","title":"Value Translation","url":"\/documentation\/swiduxmixpanelanalytics\/valuetranslation","kind":"article","type":"topic"},"https://heirloomlogic.github.io/Swidux/documentation/swidux/howtoaddanalytics":{"identifier":"https:\/\/heirloomlogic.github.io\/Swidux\/documentation\/swidux\/howtoaddanalytics","title":"Add Analytics","url":"https:\/\/heirloomlogic.github.io\/Swidux\/documentation\/swidux\/howtoaddanalytics","titleInlineContent":[{"text":"Add Analytics","type":"text"}],"type":"link"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics":{"title":"SwiduxMixpanelAnalytics","abstract":[{"type":"text","text":"Mixpanel adapter for Swidux’s "},{"type":"codeVoice","code":"AnalyticsPlugin"},{"text":". Owns the Mixpanel SDK on the app’s behalf — ","type":"text"},{"type":"codeVoice","code":"MixpanelAnalyticsService(token:)"},{"type":"text","text":" calls "},{"type":"codeVoice","code":"Mixpanel.initialize"},{"text":" internally so apps never need to ","type":"text"},{"type":"codeVoice","code":"import Mixpanel"},{"type":"text","text":". Ships a recording mock for previews and tests."}],"type":"topic","role":"collection","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics","url":"\/documentation\/swiduxmixpanelanalytics","kind":"symbol"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/HowToPreviewAndTest":{"title":"How to Preview and Test","abstract":[{"type":"text","text":"Drive "},{"code":"AnalyticsService","type":"codeVoice"},{"type":"text","text":" from SwiftUI previews and Swift Testing suites without touching Mixpanel’s network."}],"type":"topic","role":"article","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest","url":"\/documentation\/swiduxmixpanelanalytics\/howtopreviewandtest","kind":"article"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/HowToImplementService":{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","type":"topic","abstract":[{"type":"text","text":"Configure "},{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"type":"text","text":" to match your privacy, residency, and batching needs — without "},{"code":"import Mixpanel","type":"codeVoice"},{"type":"text","text":" in your app."}],"url":"\/documentation\/swiduxmixpanelanalytics\/howtoimplementservice","title":"How to Implement the Service","kind":"article","role":"article"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MockMixpanelAnalyticsService":{"fragments":[{"kind":"keyword","text":"actor"},{"text":" ","kind":"text"},{"kind":"identifier","text":"MockMixpanelAnalyticsService"}],"navigatorTitle":[{"kind":"identifier","text":"MockMixpanelAnalyticsService"}],"title":"MockMixpanelAnalyticsService","url":"\/documentation\/swiduxmixpanelanalytics\/mockmixpanelanalyticsservice","type":"topic","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService","abstract":[{"text":"Recording ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" for previews and Swift Testing suites.","type":"text"}],"role":"symbol","kind":"symbol"}}}
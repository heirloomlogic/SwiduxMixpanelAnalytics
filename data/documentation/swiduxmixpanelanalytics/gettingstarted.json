{"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"role":"article","title":"Getting Started with SwiduxMixpanelAnalytics","modules":[{"name":"SwiduxMixpanelAnalytics"}],"roleHeading":"Article"},"hierarchy":{"paths":[["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics"]]},"abstract":[{"type":"text","text":"Add the package, build "},{"type":"codeVoice","code":"MixpanelAnalyticsService"},{"type":"text","text":" with your token, register the analytics plugin, and start dispatching events."}],"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This guide is the shortest path from a wired Swidux app with "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" registered to events landing in Mixpanel. It assumes you have already followed Swidux’s "},{"type":"reference","isActive":true,"identifier":"https:\/\/heirloomlogic.github.io\/Swidux\/documentation\/swidux\/howtoaddanalytics"},{"type":"text","text":" guide through Step 5 — that is, your "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":" has an "},{"type":"codeVoice","code":"analytics"},{"type":"text","text":" slice, your "},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":" routes "},{"type":"codeVoice","code":".analytics(_:)"},{"type":"text","text":", and you have an "},{"type":"codeVoice","code":"AnalyticsMapper"},{"type":"text","text":" declared."}]},{"anchor":"Add-the-package","type":"heading","level":2,"text":"Add the package"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Xcode:","type":"text"}]},{"type":"text","text":" File > Add Package Dependencies, paste "},{"type":"codeVoice","code":"https:\/\/github.com\/HeirloomLogic\/SwiduxMixpanelAnalytics"},{"type":"text","text":". Add the "},{"type":"codeVoice","code":"SwiduxMixpanelAnalytics"},{"type":"text","text":" product to your target."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Package.swift:","type":"text"}]}]},{"type":"codeListing","syntax":"swift","code":[".package(url: \"https:\/\/github.com\/HeirloomLogic\/SwiduxMixpanelAnalytics\", from: \"1.0.0\"),"]},{"type":"codeListing","syntax":"swift","code":[".product(name: \"SwiduxMixpanelAnalytics\", package: \"SwiduxMixpanelAnalytics\"),"]},{"anchor":"Build-the-service-at-launch","type":"heading","level":2,"text":"Build the service at launch"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MixpanelAnalyticsService"},{"type":"text","text":" owns "},{"type":"codeVoice","code":"Mixpanel.initialize"},{"type":"text","text":" internally — you do not need to "},{"type":"codeVoice","code":"import Mixpanel"},{"type":"text","text":". Construct the service with your token (and any Mixpanel knobs you care about) before configuring the store:"}]},{"type":"codeListing","syntax":"swift","code":["import SwiduxMixpanelAnalytics","import SwiftUI","","@main","struct MyApp: App {","    @State private var store: AppStore","","    init() {","        let analyticsService = MixpanelAnalyticsService(","            token: \"your-mixpanel-token\",","            optOutTrackingByDefault: true","        )","        _store = State(wrappedValue: AppStore.configured(analyticsService: analyticsService))","    }","","    var body: some Scene {","        WindowGroup { ContentView().environment(store) }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The initializer surfaces every Mixpanel knob the app would otherwise need to set on "},{"type":"codeVoice","code":"Mixpanel.initialize"},{"type":"text","text":" (EU "},{"type":"codeVoice","code":"serverURL"},{"type":"text","text":", "},{"type":"codeVoice","code":"optOutTrackingByDefault"},{"type":"text","text":", "},{"type":"codeVoice","code":"flushInterval"},{"type":"text","text":", "},{"type":"codeVoice","code":"instanceName"},{"type":"text","text":", "},{"type":"codeVoice","code":"superProperties"},{"type":"text","text":", "},{"type":"codeVoice","code":"useGzipCompression"},{"type":"text","text":", "},{"type":"codeVoice","code":"trackAutomaticEvents"},{"type":"text","text":", "},{"type":"codeVoice","code":"excludeProperties"},{"type":"text","text":") and is identical on every platform. Pick what you need; everything else has a sensible default. See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService"},{"type":"text","text":" for the longer treatment."}]},{"anchor":"Register-the-plugin-with-MixpanelAnalyticsService","type":"heading","level":2,"text":"Register the plugin with `MixpanelAnalyticsService`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass the service to "},{"type":"codeVoice","code":"AnalyticsPlugin"},{"type":"text","text":" in your "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":" factory:"}]},{"type":"codeListing","syntax":"swift","code":["import Swidux","import SwiduxAnalytics","import SwiduxMixpanelAnalytics","","extension Store where State == AppState, Action == AppAction {","    static func configured(analyticsService: some AnalyticsService) -> AppStore {","        let plugins = PluginHost<AppState, AppAction>()","","        plugins.register(","            AnalyticsPlugin<AppState, AppAction>(","                state: \\.analytics,","                action: AppAction.analytics,","                extractAction: { if case .analytics(let a) = $0 { return a }; return nil },","                service: analyticsService,","                mapper: analyticsMapper,","                identity: analyticsIdentity","            )","        )","","        return Store(","            initialState: AppState(),","            reducer: AppReducer().reduce,","            plugins: plugins","        )","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"That’s it — the plugin will route mapped events through the service, re-fire "},{"type":"codeVoice","code":"identify"},{"type":"text","text":" whenever the "},{"type":"codeVoice","code":"(userID, userProperties)"},{"type":"text","text":" pair derived from state changes, and flush on your call to "},{"type":"codeVoice","code":"store.analyticsPlugin.flush()"},{"type":"text","text":" from "},{"type":"codeVoice","code":"scenePhase == .background"},{"type":"text","text":"."}]},{"anchor":"Verify-the-wiring","type":"heading","level":2,"text":"Verify the wiring"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Dispatch a screen view from your root view’s "},{"type":"codeVoice","code":".onAppear"},{"type":"text","text":" and confirm the event arrives in Mixpanel’s Live View:"}]},{"type":"codeListing","syntax":"swift","code":["struct ContentView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        RootContent()","            .onAppear { store.send(.analytics(.screenView(\"Home\"))) }","    }","}"]},{"anchor":"Next-Steps","type":"heading","level":2,"text":"Next Steps"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","isActive":true},{"type":"text","text":" — EU residency, opt-out by default, multiple Mixpanel projects, the "},{"type":"codeVoice","code":"MixpanelInstance"},{"type":"text","text":" escape hatch."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest","isActive":true},{"type":"text","text":" — Drive analytics state from previews and tests using "},{"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ValueTranslation","isActive":true},{"type":"text","text":" — How "},{"type":"codeVoice","code":"AnalyticsValue"},{"type":"text","text":" cases map onto Mixpanel "},{"type":"codeVoice","code":"Properties"},{"type":"text","text":"."}],"type":"paragraph"}]}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/GettingStarted","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/swiduxmixpanelanalytics\/gettingstarted"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"kind":"article","references":{"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/HowToImplementService":{"kind":"article","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","title":"How to Implement the Service","abstract":[{"text":"Configure ","type":"text"},{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"text":" to match your privacy, residency, and batching needs — without ","type":"text"},{"code":"import Mixpanel","type":"codeVoice"},{"text":" in your app.","type":"text"}],"type":"topic","url":"\/documentation\/swiduxmixpanelanalytics\/howtoimplementservice","role":"article"},"https://heirloomlogic.github.io/Swidux/documentation/swidux/howtoaddanalytics":{"url":"https:\/\/heirloomlogic.github.io\/Swidux\/documentation\/swidux\/howtoaddanalytics","type":"link","title":"Add Analytics","titleInlineContent":[{"type":"text","text":"Add Analytics"}],"identifier":"https:\/\/heirloomlogic.github.io\/Swidux\/documentation\/swidux\/howtoaddanalytics"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MockMixpanelAnalyticsService":{"abstract":[{"type":"text","text":"Recording "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" for previews and Swift Testing suites."}],"fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MockMixpanelAnalyticsService","kind":"identifier"}],"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService","title":"MockMixpanelAnalyticsService","role":"symbol","url":"\/documentation\/swiduxmixpanelanalytics\/mockmixpanelanalyticsservice","navigatorTitle":[{"text":"MockMixpanelAnalyticsService","kind":"identifier"}],"kind":"symbol","type":"topic"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics":{"title":"SwiduxMixpanelAnalytics","role":"collection","abstract":[{"type":"text","text":"Mixpanel adapter for Swidux’s "},{"code":"AnalyticsPlugin","type":"codeVoice"},{"type":"text","text":". Owns the Mixpanel SDK on the app’s behalf — "},{"code":"MixpanelAnalyticsService(token:)","type":"codeVoice"},{"type":"text","text":" calls "},{"code":"Mixpanel.initialize","type":"codeVoice"},{"type":"text","text":" internally so apps never need to "},{"code":"import Mixpanel","type":"codeVoice"},{"text":". Ships a recording mock for previews and tests.","type":"text"}],"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics","type":"topic","url":"\/documentation\/swiduxmixpanelanalytics","kind":"symbol"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/HowToPreviewAndTest":{"title":"How to Preview and Test","role":"article","abstract":[{"type":"text","text":"Drive "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" from SwiftUI previews and Swift Testing suites without touching Mixpanel’s network."}],"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest","type":"topic","url":"\/documentation\/swiduxmixpanelanalytics\/howtopreviewandtest","kind":"article"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/ValueTranslation":{"kind":"article","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ValueTranslation","title":"Value Translation","abstract":[{"text":"How ","type":"text"},{"code":"AnalyticsValue","type":"codeVoice"},{"text":" cases map onto Mixpanel’s ","type":"text"},{"code":"MixpanelType","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Properties","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic","url":"\/documentation\/swiduxmixpanelanalytics\/valuetranslation","role":"article"}}}
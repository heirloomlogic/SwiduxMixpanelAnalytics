{"kind":"article","primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"text":"This guide is the shortest path from a wired Swidux app with ","type":"text"},{"type":"codeVoice","code":"SwiduxAnalytics"},{"text":" registered to events landing in Mixpanel. It assumes you have already followed Swidux’s ","type":"text"},{"identifier":"https:\/\/heirloomlogic.github.io\/Swidux\/documentation\/swidux\/howtoaddanalytics","type":"reference","isActive":true},{"text":" guide through Step 5 — that is, your ","type":"text"},{"type":"codeVoice","code":"AppState"},{"text":" has an ","type":"text"},{"type":"codeVoice","code":"analytics"},{"text":" slice, your ","type":"text"},{"type":"codeVoice","code":"AppAction"},{"text":" routes ","type":"text"},{"type":"codeVoice","code":".analytics(_:)"},{"text":", and you have an ","type":"text"},{"type":"codeVoice","code":"AnalyticsMapper"},{"text":" declared.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Add-the-package","type":"heading","text":"Add the package"},{"inlineContent":[{"inlineContent":[{"text":"Xcode:","type":"text"}],"type":"strong"},{"text":" File > Add Package Dependencies, paste ","type":"text"},{"type":"codeVoice","code":"https:\/\/github.com\/HeirloomLogic\/SwiduxMixpanelAnalytics"},{"text":". Add the ","type":"text"},{"type":"codeVoice","code":"SwiduxMixpanelAnalytics"},{"text":" product to your target.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Package.swift:","type":"text"}],"type":"strong"}],"type":"paragraph"},{"type":"codeListing","code":[".package(url: \"https:\/\/github.com\/HeirloomLogic\/SwiduxMixpanelAnalytics\", branch: \"main\"),"],"syntax":"swift"},{"type":"codeListing","code":[".product(name: \"SwiduxMixpanelAnalytics\", package: \"SwiduxMixpanelAnalytics\"),"],"syntax":"swift"},{"level":2,"anchor":"Build-the-service-at-launch","type":"heading","text":"Build the service at launch"},{"inlineContent":[{"type":"codeVoice","code":"MixpanelAnalyticsService"},{"text":" owns ","type":"text"},{"type":"codeVoice","code":"Mixpanel.initialize"},{"text":" internally — you do not need to ","type":"text"},{"type":"codeVoice","code":"import Mixpanel"},{"text":". Construct the service with your token (and any Mixpanel knobs you care about) before configuring the store:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["import SwiduxMixpanelAnalytics","import SwiftUI","","@main","struct MyApp: App {","    @State private var store: AppStore","","    init() {","        let analyticsService = MixpanelAnalyticsService(","            token: \"your-mixpanel-token\",","            optOutTrackingByDefault: true","        )","        _store = State(wrappedValue: AppStore.configured(analyticsService: analyticsService))","    }","","    var body: some Scene {","        WindowGroup { ContentView().environment(store) }","    }","}"],"syntax":"swift"},{"inlineContent":[{"text":"The initializer surfaces every Mixpanel knob the app would otherwise need to set on ","type":"text"},{"type":"codeVoice","code":"Mixpanel.initialize"},{"text":" (EU ","type":"text"},{"type":"codeVoice","code":"serverURL"},{"text":", ","type":"text"},{"type":"codeVoice","code":"optOutTrackingByDefault"},{"text":", ","type":"text"},{"type":"codeVoice","code":"flushInterval"},{"text":", ","type":"text"},{"type":"codeVoice","code":"instanceName"},{"text":", ","type":"text"},{"type":"codeVoice","code":"superProperties"},{"text":", ","type":"text"},{"type":"codeVoice","code":"useGzipCompression"},{"text":", and — on non-macOS — ","type":"text"},{"type":"codeVoice","code":"trackAutomaticEvents"},{"text":"). Pick what you need; everything else has a sensible default. See ","type":"text"},{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","type":"reference","isActive":true},{"text":" for the longer treatment.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Register-the-plugin-with-MixpanelAnalyticsService","type":"heading","text":"Register the plugin with `MixpanelAnalyticsService`"},{"inlineContent":[{"text":"Pass the service to ","type":"text"},{"type":"codeVoice","code":"AnalyticsPlugin"},{"text":" in your ","type":"text"},{"type":"codeVoice","code":"Store.configured()"},{"text":" factory:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["import Swidux","import SwiduxAnalytics","import SwiduxMixpanelAnalytics","","extension Store where State == AppState, Action == AppAction {","    static func configured(analyticsService: some AnalyticsService) -> AppStore {","        let plugins = PluginHost<AppState, AppAction>()","","        plugins.register(","            AnalyticsPlugin<AppState, AppAction>(","                state: \\.analytics,","                action: AppAction.analytics,","                extractAction: { if case .analytics(let a) = $0 { return a }; return nil },","                service: analyticsService,","                mapper: analyticsMapper,","                identity: analyticsIdentity","            )","        )","","        return Store(","            initialState: AppState(),","            reducer: AppReducer().reduce,","            plugins: plugins","        )","    }","}"],"syntax":"swift"},{"inlineContent":[{"text":"That’s it — the plugin will route mapped events through the service, re-fire ","type":"text"},{"type":"codeVoice","code":"identify"},{"text":" whenever the ","type":"text"},{"type":"codeVoice","code":"(userID, userProperties)"},{"text":" pair derived from state changes, and flush on your call to ","type":"text"},{"type":"codeVoice","code":"store.analyticsPlugin.flush()"},{"text":" from ","type":"text"},{"type":"codeVoice","code":"scenePhase == .background"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Verify-the-wiring","type":"heading","text":"Verify the wiring"},{"inlineContent":[{"text":"Dispatch a screen view from your root view’s ","type":"text"},{"type":"codeVoice","code":".onAppear"},{"text":" and confirm the event arrives in Mixpanel’s Live View:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["struct ContentView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        RootContent()","            .onAppear { store.send(.analytics(.screenView(\"Home\"))) }","    }","}"],"syntax":"swift"},{"level":2,"anchor":"Next-Steps","type":"heading","text":"Next Steps"},{"items":[{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService"},{"type":"text","text":" — EU residency, opt-out by default, multiple Mixpanel projects, the "},{"type":"codeVoice","code":"MixpanelInstance"},{"type":"text","text":" escape hatch."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest"},{"type":"text","text":" — Drive analytics state from previews and tests using "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ValueTranslation"},{"type":"text","text":" — How "},{"type":"codeVoice","code":"AnalyticsValue"},{"type":"text","text":" cases map onto Mixpanel "},{"type":"codeVoice","code":"Properties"},{"type":"text","text":"."}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swiduxmixpanelanalytics\/gettingstarted"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/GettingStarted"},"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics"]]},"abstract":[{"type":"text","text":"Add the package, build "},{"type":"codeVoice","code":"MixpanelAnalyticsService"},{"type":"text","text":" with your token, register the analytics plugin, and start dispatching events."}],"metadata":{"title":"Getting Started with SwiduxMixpanelAnalytics","modules":[{"name":"SwiduxMixpanelAnalytics"}],"roleHeading":"Article","role":"article"},"references":{"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics":{"title":"SwiduxMixpanelAnalytics","url":"\/documentation\/swiduxmixpanelanalytics","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Mixpanel adapter for Swidux’s "},{"type":"codeVoice","code":"AnalyticsPlugin"},{"type":"text","text":". Owns the Mixpanel SDK on the app’s behalf — "},{"type":"codeVoice","code":"MixpanelAnalyticsService(token:)"},{"type":"text","text":" calls "},{"type":"codeVoice","code":"Mixpanel.initialize"},{"type":"text","text":" internally so apps never need to "},{"type":"codeVoice","code":"import Mixpanel"},{"type":"text","text":". Ships a recording mock for previews and tests."}],"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics","role":"collection"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/HowToImplementService":{"type":"topic","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","abstract":[{"text":"Configure ","type":"text"},{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"text":" to match your privacy, residency, and batching needs — without ","type":"text"},{"code":"import Mixpanel","type":"codeVoice"},{"text":" in your app.","type":"text"}],"url":"\/documentation\/swiduxmixpanelanalytics\/howtoimplementservice","kind":"article","title":"How to Implement the Service","role":"article"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/HowToPreviewAndTest":{"role":"article","abstract":[{"text":"Drive ","type":"text"},{"type":"codeVoice","code":"AnalyticsService"},{"text":" from SwiftUI previews and Swift Testing suites without touching Mixpanel’s network.","type":"text"}],"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest","url":"\/documentation\/swiduxmixpanelanalytics\/howtopreviewandtest","type":"topic","kind":"article","title":"How to Preview and Test"},"https://heirloomlogic.github.io/Swidux/documentation/swidux/howtoaddanalytics":{"identifier":"https:\/\/heirloomlogic.github.io\/Swidux\/documentation\/swidux\/howtoaddanalytics","title":"Add Analytics","titleInlineContent":[{"type":"text","text":"Add Analytics"}],"url":"https:\/\/heirloomlogic.github.io\/Swidux\/documentation\/swidux\/howtoaddanalytics","type":"link"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/ValueTranslation":{"type":"topic","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ValueTranslation","abstract":[{"text":"How ","type":"text"},{"code":"AnalyticsValue","type":"codeVoice"},{"text":" cases map onto Mixpanel’s ","type":"text"},{"code":"MixpanelType","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Properties","type":"codeVoice"},{"text":".","type":"text"}],"url":"\/documentation\/swiduxmixpanelanalytics\/valuetranslation","kind":"article","title":"Value Translation","role":"article"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MockMixpanelAnalyticsService":{"title":"MockMixpanelAnalyticsService","url":"\/documentation\/swiduxmixpanelanalytics\/mockmixpanelanalyticsservice","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Recording "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" for previews and Swift Testing suites."}],"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService","role":"symbol","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MockMixpanelAnalyticsService","kind":"identifier"}],"navigatorTitle":[{"text":"MockMixpanelAnalyticsService","kind":"identifier"}]}}}
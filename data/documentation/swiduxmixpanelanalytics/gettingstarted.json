{"sections":[],"identifier":{"url":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/GettingStarted","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Add the package, build "},{"type":"codeVoice","code":"MixpanelAnalyticsService"},{"type":"text","text":" with your token, register the analytics plugin, and start dispatching events."}],"metadata":{"role":"article","title":"Getting Started with SwiduxMixpanelAnalytics","roleHeading":"Article","modules":[{"name":"SwiduxMixpanelAnalytics"}]},"kind":"article","schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This guide is the shortest path from a wired Swidux app with "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" registered to events landing in Mixpanel. It assumes you have already followed Swidux’s "},{"type":"reference","isActive":true,"identifier":"https:\/\/heirloomlogic.github.io\/Swidux\/documentation\/swidux\/howtoaddanalytics"},{"type":"text","text":" guide through Step 5 — that is, your "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":" has an "},{"type":"codeVoice","code":"analytics"},{"type":"text","text":" slice, your "},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":" routes "},{"type":"codeVoice","code":".analytics(_:)"},{"type":"text","text":", and you have an "},{"type":"codeVoice","code":"AnalyticsMapper"},{"type":"text","text":" declared."}]},{"type":"heading","anchor":"Add-the-package","level":2,"text":"Add the package"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Xcode:"}]},{"type":"text","text":" File > Add Package Dependencies, paste "},{"type":"codeVoice","code":"https:\/\/github.com\/HeirloomLogic\/SwiduxMixpanelAnalytics"},{"type":"text","text":". Add the "},{"type":"codeVoice","code":"SwiduxMixpanelAnalytics"},{"type":"text","text":" product to your target."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Package.swift:"}]}]},{"type":"codeListing","code":[".package(url: \"https:\/\/github.com\/HeirloomLogic\/SwiduxMixpanelAnalytics\", from: \"1.0.0\"),"],"syntax":"swift"},{"type":"codeListing","code":[".product(name: \"SwiduxMixpanelAnalytics\", package: \"SwiduxMixpanelAnalytics\"),"],"syntax":"swift"},{"type":"heading","anchor":"Build-the-service-at-launch","level":2,"text":"Build the service at launch"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MixpanelAnalyticsService"},{"type":"text","text":" owns "},{"type":"codeVoice","code":"Mixpanel.initialize"},{"type":"text","text":" internally — you do not need to "},{"type":"codeVoice","code":"import Mixpanel"},{"type":"text","text":". Construct the service with your token (and any Mixpanel knobs you care about) before configuring the store:"}]},{"type":"codeListing","code":["import SwiduxMixpanelAnalytics","import SwiftUI","","@main","struct MyApp: App {","    @State private var store: AppStore","","    init() {","        let analyticsService = MixpanelAnalyticsService(","            token: \"your-mixpanel-token\",","            optOutTrackingByDefault: true","        )","        _store = State(wrappedValue: AppStore.configured(analyticsService: analyticsService))","    }","","    var body: some Scene {","        WindowGroup { ContentView().environment(store) }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The initializer surfaces every Mixpanel knob the app would otherwise need to set on "},{"type":"codeVoice","code":"Mixpanel.initialize"},{"type":"text","text":" (EU "},{"type":"codeVoice","code":"serverURL"},{"type":"text","text":", "},{"type":"codeVoice","code":"optOutTrackingByDefault"},{"type":"text","text":", "},{"type":"codeVoice","code":"flushInterval"},{"type":"text","text":", "},{"type":"codeVoice","code":"instanceName"},{"type":"text","text":", "},{"type":"codeVoice","code":"superProperties"},{"type":"text","text":", "},{"type":"codeVoice","code":"useGzipCompression"},{"type":"text","text":", "},{"type":"codeVoice","code":"trackAutomaticEvents"},{"type":"text","text":", "},{"type":"codeVoice","code":"excludeProperties"},{"type":"text","text":") and is identical on every platform. Pick what you need; everything else has a sensible default. See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService"},{"type":"text","text":" for the longer treatment."}]},{"type":"heading","anchor":"Register-the-plugin-with-MixpanelAnalyticsService","level":2,"text":"Register the plugin with `MixpanelAnalyticsService`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass the service to "},{"type":"codeVoice","code":"AnalyticsPlugin"},{"type":"text","text":" in your "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":" factory:"}]},{"type":"codeListing","code":["import Swidux","import SwiduxAnalytics","import SwiduxMixpanelAnalytics","","extension Store where State == AppState, Action == AppAction {","    static func configured(analyticsService: some AnalyticsService) -> AppStore {","        let plugins = PluginHost<AppState, AppAction>()","","        plugins.register(","            AnalyticsPlugin<AppState, AppAction>(","                state: \\.analytics,","                action: AppAction.analytics,","                extractAction: { if case .analytics(let a) = $0 { return a }; return nil },","                service: analyticsService,","                mapper: analyticsMapper,","                identity: analyticsIdentity","            )","        )","","        return Store(","            initialState: AppState(),","            reducer: AppReducer().reduce,","            plugins: plugins","        )","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"That’s it — the plugin will route mapped events through the service, re-fire "},{"type":"codeVoice","code":"identify"},{"type":"text","text":" whenever the "},{"type":"codeVoice","code":"(userID, userProperties)"},{"type":"text","text":" pair derived from state changes, and flush on your call to "},{"type":"codeVoice","code":"store.analyticsPlugin.flush()"},{"type":"text","text":" from "},{"type":"codeVoice","code":"scenePhase == .background"},{"type":"text","text":"."}]},{"type":"heading","anchor":"Verify-the-wiring","level":2,"text":"Verify the wiring"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Dispatch a screen view from your root view’s "},{"type":"codeVoice","code":".onAppear"},{"type":"text","text":" and confirm the event arrives in Mixpanel’s Live View:"}]},{"type":"codeListing","code":["struct ContentView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        RootContent()","            .onAppear { store.send(.analytics(.screenView(\"Home\"))) }","    }","}"],"syntax":"swift"},{"type":"heading","anchor":"Next-Steps","level":2,"text":"Next Steps"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","type":"reference","isActive":true},{"type":"text","text":" — EU residency, opt-out by default, multiple Mixpanel projects, the "},{"type":"codeVoice","code":"MixpanelInstance"},{"type":"text","text":" escape hatch."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest","type":"reference","isActive":true},{"type":"text","text":" — Drive analytics state from previews and tests using "},{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService","type":"reference","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ValueTranslation","type":"reference","isActive":true},{"type":"text","text":" — How "},{"type":"codeVoice","code":"AnalyticsValue"},{"type":"text","text":" cases map onto Mixpanel "},{"type":"codeVoice","code":"Properties"},{"type":"text","text":"."}]}]}],"type":"unorderedList"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxmixpanelanalytics\/gettingstarted"]}],"hierarchy":{"paths":[["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics"]]},"references":{"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/HowToImplementService":{"role":"article","title":"How to Implement the Service","type":"topic","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","abstract":[{"type":"text","text":"Configure "},{"type":"codeVoice","code":"MixpanelAnalyticsService"},{"type":"text","text":" to match your privacy, residency, and batching needs — without "},{"type":"codeVoice","code":"import Mixpanel"},{"type":"text","text":" in your app."}],"url":"\/documentation\/swiduxmixpanelanalytics\/howtoimplementservice","kind":"article"},"https://heirloomlogic.github.io/Swidux/documentation/swidux/howtoaddanalytics":{"type":"link","title":"Add Analytics","identifier":"https:\/\/heirloomlogic.github.io\/Swidux\/documentation\/swidux\/howtoaddanalytics","titleInlineContent":[{"type":"text","text":"Add Analytics"}],"url":"https:\/\/heirloomlogic.github.io\/Swidux\/documentation\/swidux\/howtoaddanalytics"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics":{"role":"collection","abstract":[{"type":"text","text":"Mixpanel adapter for Swidux’s "},{"type":"codeVoice","code":"AnalyticsPlugin"},{"type":"text","text":". Owns the Mixpanel SDK on the app’s behalf — "},{"type":"codeVoice","code":"MixpanelAnalyticsService(token:)"},{"type":"text","text":" calls "},{"type":"codeVoice","code":"Mixpanel.initialize"},{"type":"text","text":" internally so apps never need to "},{"type":"codeVoice","code":"import Mixpanel"},{"type":"text","text":". Ships a recording mock for previews and tests."}],"title":"SwiduxMixpanelAnalytics","kind":"symbol","type":"topic","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics","url":"\/documentation\/swiduxmixpanelanalytics"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MockMixpanelAnalyticsService":{"role":"symbol","title":"MockMixpanelAnalyticsService","type":"topic","fragments":[{"kind":"keyword","text":"actor"},{"text":" ","kind":"text"},{"kind":"identifier","text":"MockMixpanelAnalyticsService"}],"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService","abstract":[{"text":"Recording ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" for previews and Swift Testing suites.","type":"text"}],"url":"\/documentation\/swiduxmixpanelanalytics\/mockmixpanelanalyticsservice","kind":"symbol","navigatorTitle":[{"text":"MockMixpanelAnalyticsService","kind":"identifier"}]},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/HowToPreviewAndTest":{"role":"article","title":"How to Preview and Test","type":"topic","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest","abstract":[{"text":"Drive ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" from SwiftUI previews and Swift Testing suites without touching Mixpanel’s network.","type":"text"}],"url":"\/documentation\/swiduxmixpanelanalytics\/howtopreviewandtest","kind":"article"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/ValueTranslation":{"kind":"article","title":"Value Translation","abstrac
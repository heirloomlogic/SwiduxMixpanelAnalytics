{"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"type":"text","text":" is intentionally thin: it wraps a "},{"code":"MixpanelInstance","type":"codeVoice"},{"type":"text","text":" and forwards every "},{"code":"AnalyticsService","type":"codeVoice"},{"type":"text","text":" call. All Mixpanel-specific configuration — region, opt-out defaults, flush interval, automatic events — happens at "},{"code":"Mixpanel.initialize","type":"codeVoice"},{"type":"text","text":" time, before the service is constructed. This keeps the service surface minimal and lets you use any of the SDK’s "},{"code":"initialize","type":"codeVoice"},{"type":"text","text":" overloads."}],"type":"paragraph"},{"anchor":"Default-initialization","level":2,"type":"heading","text":"Default initialization"},{"inlineContent":[{"type":"text","text":"For most apps:"}],"type":"paragraph"},{"syntax":"swift","code":["Mixpanel.initialize(token: \"your-token\", trackAutomaticEvents: false)","let service = MixpanelAnalyticsService()"],"type":"codeListing"},{"inlineContent":[{"code":"MixpanelAnalyticsService()","type":"codeVoice"},{"type":"text","text":" wraps "},{"code":"Mixpanel.mainInstance()","type":"codeVoice"},{"type":"text","text":". It traps if Mixpanel has not been initialized first."}],"type":"paragraph"},{"anchor":"EU--India-data-residency","level":2,"type":"heading","text":"EU \/ India data residency"},{"inlineContent":[{"type":"text","text":"Pass "},{"code":"serverURL:","type":"codeVoice"},{"type":"text","text":" (iOS) when initializing:"}],"type":"paragraph"},{"syntax":"swift","code":["Mixpanel.initialize(","    token: \"your-token\",","    trackAutomaticEvents: false,","    serverURL: \"https:\/\/api-eu.mixpanel.com\"  \/\/ or \"https:\/\/api-in.mixpanel.com\"",")"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The service has no per-event region knob — region is a property of the instance."}],"type":"paragraph"},{"anchor":"Opt-out-by-default","level":2,"type":"heading","text":"Opt-out by default"},{"inlineContent":[{"type":"text","text":"If your jurisdiction requires explicit opt-in, initialize Mixpanel in opted-out mode:"}],"type":"paragraph"},{"syntax":"swift","code":["Mixpanel.initialize(","    token: \"your-token\",","    trackAutomaticEvents: false,","    optOutTrackingByDefault: true",")"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Then pair this with the plugin’s own "},{"code":".analytics(.setOptedOut(false))","type":"codeVoice"},{"type":"text","text":" action when the user opts in. The plugin’s opt-out flag and Mixpanel’s are tracked separately; both must be opted-in for events to be sent."}],"type":"paragraph"},{"anchor":"Flush-interval","level":2,"type":"heading","text":"Flush interval"},{"inlineContent":[{"type":"text","text":"Mixpanel’s default 60-second flush interval is set at initialization:"}],"type":"paragraph"},{"syntax":"swift","code":["Mixpanel.initialize(token: \"your-token\", trackAutomaticEvents: false, flushInterval: 30)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The plugin’s "},{"code":"flush()","type":"codeVoice"},{"type":"text","text":" (called on app shutdown) bypasses this and forces a synchronous drain."}],"type":"paragraph"},{"anchor":"Multiple-instances","level":2,"type":"heading","text":"Multiple instances"},{"inlineContent":[{"type":"text","text":"If your app sends to more than one Mixpanel project, initialize each instance with a name and construct one service per instance:"}],"type":"paragraph"},{"syntax":"swift","code":["let prod = Mixpanel.initialize(","    token: \"prod-token\",","    trackAutomaticEvents: false,","    instanceName: \"prod\"",")","let analytics = Mixpanel.initialize(","    token: \"internal-token\",","    trackAutomaticEvents: false,","    instanceName: \"internal\"",")","","let prodService = MixpanelAnalyticsService(instance: prod)","let analyticsService = MixpanelAnalyticsService(instance: analytics)"],"type":"codeListing"},{"inlineContent":[{"text":"Register one ","type":"text"},{"type":"codeVoice","code":"AnalyticsPlugin"},{"text":" per service. Each plugin owns its own state slice.","type":"text"}],"type":"paragraph"}]}],"sections":[],"kind":"article","hierarchy":{"paths":[["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics"]]},"variants":[{"paths":["\/documentation\/swiduxmixpanelanalytics\/howtoimplementservice"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"SwiduxMixpanelAnalytics"}],"role":"article","title":"How to Implement the Service","roleHeading":"Article"},"identifier":{"url":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","interfaceLanguage":"swift"},"abstract":[{"text":"Configure the underlying ","type":"text"},{"code":"MixpanelInstance","type":"codeVoice"},{"text":" to match your privacy, residency, and batching needs, then hand it to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService"},{"text":".","type":"text"}],"seeAlsoSections":[{"anchor":"Related-Documentation","title":"Related Documentation","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/GettingStarted","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ServiceReference","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ValueTranslation"]},{"generated":true,"anchor":"How-to-Guides","title":"How-to Guides","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest"]}],"references":{"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/ServiceReference":{"abstract":[{"text":"API reference for ","type":"text"},{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService","isActive":true,"type":"reference"},{"text":" — the Mixpanel-backed ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" conformer that the analytics plugin consumes.","type":"text"}],"url":"\/documentation\/swiduxmixpanelanalytics\/servicereference","kind":"article","title":"Service Reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ServiceReference","role":"article","type":"topic"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/HowToPreviewAndTest":{"abstract":[{"text":"Drive ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" from SwiftUI previews and Swift Testing suites without touching Mixpanel’s network.","type":"text"}],"url":"\/documentation\/swiduxmixpanelanalytics\/howtopreviewandtest","kind":"article","title":"How to Preview and Test","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest","role":"article","type":"topic"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/ValueTranslation":{"abstract":[{"text":"How ","type":"text"},{"code":"AnalyticsValue","type":"codeVoice"},{"text":" cases map onto Mixpanel’s ","type":"text"},{"code":"MixpanelType","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Properties","type":"codeVoice"},{"text":".","type":"text"}],"url":"\/documentation\/swiduxmixpanelanalytics\/valuetranslation","kind":"article","title":"Value Translation","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ValueTranslation","role":"article","type":"topic"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/GettingStarted":{"abstract":[{"text":"Add the package, initialize Mixpanel, register the analytics plugin with ","type":"text"},{"code":"MixpanelAnalyticsServic
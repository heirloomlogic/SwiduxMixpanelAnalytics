{"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/GettingStarted","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ServiceReference","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ValueTranslation"],"anchor":"Related-Documentation"},{"generated":true,"title":"How-to Guides","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest"],"anchor":"How-to-Guides"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxmixpanelanalytics\/howtoimplementservice"]}],"abstract":[{"text":"Configure ","type":"text"},{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"text":" to match your privacy, residency, and batching needs — without ","type":"text"},{"code":"import Mixpanel","type":"codeVoice"},{"text":" in your app.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService"},"hierarchy":{"paths":[["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService","isActive":true},{"type":"text","text":" is the configuration boundary: every Mixpanel knob worth setting at launch is a parameter on the initializer, and runtime GDPR \/ diagnostic toggles are methods on the service. The Mixpanel SDK stays a private implementation detail of this package."}]},{"level":2,"text":"Default initialization","type":"heading","anchor":"Default-initialization"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For most apps:"}]},{"code":["let service = MixpanelAnalyticsService(token: \"your-token\")"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Defaults match the Mixpanel SDK: "},{"type":"codeVoice","code":"flushInterval: 60"},{"type":"text","text":", "},{"type":"codeVoice","code":"optOutTrackingByDefault: false"},{"type":"text","text":", gzip off, IDFV-based distinct ID. On iOS \/ tvOS \/ watchOS, "},{"type":"codeVoice","code":"trackAutomaticEvents"},{"type":"text","text":" defaults to "},{"type":"codeVoice","code":"false"},{"type":"text","text":"."}]},{"level":2,"text":"EU \/ India data residency","type":"heading","anchor":"EU--India-data-residency"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass "},{"type":"codeVoice","code":"serverURL:"},{"type":"text","text":":"}]},{"code":["let service = MixpanelAnalyticsService(","    token: \"your-token\",","    serverURL: \"https:\/\/api-eu.mixpanel.com\"  \/\/ or \"https:\/\/api-in.mixpanel.com\"",")"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Region is fixed at construction; the service has no per-event region knob."}]},{"level":2,"text":"Opt-out by default","type":"heading","anchor":"Opt-out-by-default"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If your jurisdiction requires explicit opt-in, construct the service in opted-out mode and flip it at runtime when the user consents:"}]},{"code":["let service = MixpanelAnalyticsService(","    token: \"your-token\",","    optOutTrackingByDefault: true",")","","\/\/ later, when the user opts in:","await service.optInTracking(distinctID: currentUserID)","","\/\/ to opt out again:","await service.optOutTracking()"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"optInTracking"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"optOutTracking"},{"type":"text","text":" \/ "},{"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService\/hasOptedOutTracking()","isActive":true},{"type":"text","text":" cover the GDPR round-trip without forcing the app to touch Mixpanel directly. Pair these with the plugin’s own opt-out flag if you maintain one — both must be opted in for events to be sent."}]},{"level":2,"text":"Flush interval","type":"heading","anchor":"Flush-interval"},{"code":["let service = MixpanelAnalyticsService(token: \"your-token\", flushInterval: 30)"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin’s "},{"type":"codeVoice","code":"flush()"},{"type":"text","text":" (called on app shutdown) bypasses this and forces a synchronous drain."}]},{"level":2,"text":"Diagnostic logging","type":"heading","anchor":"Diagnostic-logging"},{"code":["await service.setLoggingEnabled(true)"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Enables the Mixpanel SDK’s internal logging — useful when verifying integration in development. Disable in release builds."}]},{"level":2,"text":"Geo by IP","type":"heading","anchor":"Geo-by-IP"},{"code":["await service.setUseIPAddressForGeoLocation(false)"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Opt out of server-side IP-based geo resolution when your privacy policy forbids it."}]},{"level":2,"text":"Multiple instances","type":"heading","anchor":"Multiple-instances"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If your app sends to more than one Mixpanel project, give each a unique "},{"type":"codeVoice","code":"instanceName"},{"type":"text","text":":"}]},{"code":["let prodService = MixpanelAnalyticsService(","    token: \"prod-token\",","    instanceName: \"prod\"",")","let internalService = MixpanelAnalyticsService(","    token: \"internal-token\",","    instanceName: \"internal\"",")"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Register one "},{"type":"codeVoice","code":"AnalyticsPlugin"},{"type":"text","text":" per service. Each plugin owns its own state slice."}]},{"level":2,"text":"Escape hatch: build your own `MixpanelInstance`","type":"heading","anchor":"Escape-hatch-build-your-own-MixpanelInstance"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For configuration the initializer does not surface — "},{"type":"codeVoice","code":"ProxyServerConfig"},{"type":"text","text":", custom delegates, anything that requires direct access to "},{"type":"codeVoice","code":"MixpanelInstance"},{"type":"text","text":" — use "},{"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService\/init(instance:)","isActive":true},{"type":"text","text":":"}]},{"code":["import Mixpanel  \/\/ only required for this advanced path","","let instance = Mixpanel.initialize(","    token: \"your-token\",","    trackAutomaticEvents: false,","    proxyServerConfig: myProxyConfig",")","let service = MixpanelAnalyticsService(instance: instance)"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is the only path that requires importing Mixpanel into your app. If you find yourself reaching for it for something common (an SDK knob the initializer should surface), please open an issue — the goal is to keep the happy path Mixpanel-free."}]}]}],"sections":[],"metadata":{"roleHeading":"Article","role":"article","title":"How to Implement the Service","modules":[{"name":"SwiduxMixpanelAnalytics"}]},"kind":"article","references":{"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/GettingStarted":{"role":"article","abstract":[{"type":"text","text":"Add the package, build "},{"type":"codeVoice","code":"MixpanelAnalyticsService"},{"type":"text","text":" with your token, register the analytics plugin, and start dispatching events."}],"type":"topic","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/GettingStarted","title":"Getting Started with SwiduxMixpanelAnalytics","kind":"article","url":"\/documentation\/swiduxmixpanelanalytics\/gettingstarted"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MixpanelAnalyticsService/hasOptedOutTracking()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hasOptedOutTracking","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"role":"symbol","abstract":[{"type":"codeVoice","code":"true"},{"type":"text","text":" if the user has been opted out."}],"type":"topic","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService\/hasOptedOutTracking()","title":"hasOptedOutTracking()","kind":"symbol","url":"\/documentation\/swiduxmixpanelanalytics\/mixpanelanalyticsservice\/hasoptedouttracking()"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MixpanelAnalyticsService/init(instance:)":{"kind":"symbol","url":"\/documentation\/swiduxmixpanelanalytics\/mixpanelanalyticsservice\/init(instance:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"instance","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MixpanelInstance","kind":"typeIdentifier","preciseIdentifier":"s:8Mixpanel0A8InstanceC"},{"kind":"text","text":")"}],"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService\/init(instance:)","title":"init(instance:)","type":"topic","abstract":[{"text":"Escape hatch for apps that need to construct their own ","type":"text"},{"type":"codeVoice","code":"MixpanelInstance"},{"text":" ","type":"text"},{"text":"(for example, to use ","type":"text"},{"code":"ProxyServerConfig","type":"codeVoice"},{"text":"). Most apps should prefer the","type":"text"},{"text":" ","type":"text"},{"text":"token-based initializer above and never ","type":"text"},{"type":"codeVoice","code":"import Mixpanel"},{"text":".","type":"text"}],"role":"symbol"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics":{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics","url":"\/documentation\/swiduxmixpanelanalytics","title":"SwiduxMixpanelAnalytics","type":"topic","role":"collection","abstract":[{"type":"text","text":"Mixpanel adapter for Swidux’s "},{"type":"codeVoice","code":"AnalyticsPlugin"},{"type":"text","text":". Owns the Mixpanel SDK on the app’s behalf — "},{"type":"codeVoice","code":"MixpanelAnalyticsService(token:)"},{"type":"text","text":" calls "},{"type":"codeVoice","code":"Mixpanel.initialize"},{"type":"text","text":" internally so apps never need to "},{"type":"codeVoice","code":"import Mixpanel"},{"type":"text","text":". Ships a recording mock for previews and tests."}],"kind":"symbol"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/ServiceReference":{"role":"article","abstract":[{"type":"text","text":"API reference for "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService"},{"type":"text","text":" — the Mixpanel-backed "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" conformer that the analytics plugin consumes."}],"type":"topic","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ServiceReference","title":"Service Reference","kind":"article","url":"\/documentation\/swiduxmixpanelanalytics\/servicereference"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/ValueTranslation":{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ValueTranslation","url":"\/documentation\/swiduxmixpanelanalytics\/valuetranslation","title":"Value Translation","type":"topic","role":"article","abstract":[{"text":"How ","type":"text"},{"type":"codeVoice","code":"AnalyticsValue"},{"text":" cases map onto Mixpanel’s ","type":"text"},{"type":"codeVoice","code":"MixpanelType"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Properties"},{"text":".","type":"text"}],"kind":"article"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MixpanelAnalyticsService":{"navigatorTitle":[{"text":"MixpanelAnalyticsService","kind":"identifier"}],"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService","url":"\/documentation\/swiduxmixpanelanalytics\/mixpanelanalyticsservice","title":"MixpanelAnalyticsService","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MixpanelAnalyticsService","kind":"identifier"}],"type":"topic","role":"symbol","abstract":[{"type":"codeVoice","code":"AnalyticsService"},{"text":" conformer that owns and forwards to a Mixpanel SDK","type":"text"},{"text":" ","type":"text"},{"text":"instance.","type":"text"}],"kind":"symbol"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/HowToPreviewAndTest":{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest","url":"\/documentation\/swiduxmixpanelanalytics\/howtopreviewandtest","title":"How to Preview and Test","type":"topic","role":"article","abstract":[{"text":"Drive ","type":"text"},{"type":"codeVoice","code":"AnalyticsService"},{"text":" from SwiftUI previews and Swift Testing suites without touching Mixpanel’s network.","type":"text"}],"kind":"article"}}}
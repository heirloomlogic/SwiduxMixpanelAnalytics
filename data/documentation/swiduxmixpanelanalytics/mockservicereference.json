":"article"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MockMixpanelAnalyticsService":{"fragments":[{"kind":"keyword","text":"actor"},{"text":" ","kind":"text"},{"kind":"identifier","text":"MockMixpanelAnalyticsService"}],"navigatorTitle":[{"kind":"identifier","text":"MockMixpanelAnalyticsService"}],"title":"MockMixpanelAnalyticsService","url":"\/documentation\/swiduxmixpanelanalytics\/mockmixpanelanalyticsservice","type":"topic","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService","abstract":[{"text":"Recording ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" for previews and Swift Testing suites.","type":"text"}],"role":"symbol","kind":"symbol"}}}
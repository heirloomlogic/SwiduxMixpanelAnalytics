{"abstract":[{"type":"text","text":"API reference for "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService"},{"type":"text","text":" — a recording "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" for SwiftUI previews and Swift Testing suites."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics"]]},"kind":"article","primaryContentSections":[{"content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MockMixpanelAnalyticsService"},{"type":"text","text":" is an actor that conforms to "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" and records every call it receives. Use it in "},{"type":"codeVoice","code":"#Preview"},{"type":"text","text":" blocks (where you don’t want real network traffic) and in tests (where you want deterministic assertions on what the plugin dispatched)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It has no Mixpanel SDK dependency — it imports "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" only — so previews compile against it without configuring Mixpanel."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For usage examples, see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest"},{"type":"text","text":"."}]},{"type":"heading","text":"Types","anchor":"Types","level":2},{"type":"heading","text":"``doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService``","anchor":"docSwiduxMixpanelAnalyticsdocumentationSwiduxMixpanelAnalyticsMockMixpanelAnalyticsService","level":3},{"type":"codeListing","code":["public actor MockMixpanelAnalyticsService: AnalyticsService {","    public init(optedOut: Bool = false)","","    public func setOptedOut(_ optedOut: Bool) async","","    public private(set) var trackedEvents: [AnalyticsEvent]","    public private(set) var identifyCalls: [IdentifyCall]","    public private(set) var aliasCalls: [AliasCall]","    public private(set) var resetCount: Int","    public private(set) var flushCount: Int","    public private(set) var optOutCount: Int","    public private(set) var optInCalls: [OptInCall]","    public private(set) var optedOut: Bool","    public private(set) var loggingEnabled: Bool?","    public private(set) var useIPAddressForGeoLocation: Bool?","","    public struct IdentifyCall: Sendable, Equatable {","        public init(userID: String, properties: [String: AnalyticsValue] = [:])","        public let userID: String","        public let properties: [String: AnalyticsValue]","    }","","    public struct AliasCall: Sendable, Equatable {","        public init(newID: String, previousID: String? = nil)","        public let newID: String","        public let previousID: String?","    }","","    public struct OptInCall: Sendable, Equatable {","        public init(distinctID: String? = nil, properties: [String: AnalyticsValue]? = nil)","        public let distinctID: String?","        public let properties: [String: AnalyticsValue]?","    }","}"],"syntax":"swift"},{"type":"heading","text":"Recorded state","anchor":"Recorded-state","level":4},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"trackedEvents"},{"type":"text","text":" — every "},{"type":"codeVoice","code":"AnalyticsEvent"},{"type":"text","text":" passed to "},{"type":"codeVoice","code":"track(_:)"},{"type":"text","text":", in dispatch order."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"identifyCalls"},{"type":"text","text":" — every "},{"type":"codeVoice","code":"(userID, properties)"},{"type":"text","text":" pair passed to "},{"type":"codeVoice","code":"identify(userID:properties:)"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"aliasCalls"},{"type":"text","text":" — every "},{"type":"codeVoice","code":"(newID, previousID)"},{"type":"text","text":" pair passed to "},{"type":"codeVoice","code":"alias(newID:previousID:)"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"resetCount"},{"type":"text","text":" — number of times "},{"type":"codeVoice","code":"reset()"},{"type":"text","text":" was called."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"flushCount"},{"type":"text","text":" — number of times "},{"type":"codeVoice","code":"flush()"},{"type":"text","text":" was called."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"optOutCount"},{"type":"text","text":" — number of times "},{"type":"codeVoice","code":"optOutTracking()"},{"type":"text","text":" was called."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"optInCalls"},{"type":"text","text":" — every "},{"type":"codeVoice","code":"(distinctID, properties)"},{"type":"text","text":" pair passed to "},{"type":"codeVoice","code":"optInTracking(distinctID:properties:)"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"optedOut"},{"type":"text","text":" — current tracked opt-out state, also returned from "},{"type":"codeVoice","code":"hasOptedOutTracking()"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"loggingEnabled"},{"type":"text","text":" — last value passed to "},{"type":"codeVoice","code":"setLoggingEnabled(_:)"},{"type":"text","text":", or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if never set."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"useIPAddressForGeoLocation"},{"type":"text","text":" — last value passed to "},{"type":"codeVoice","code":"setUseIPAddressForGeoLocation(_:)"},{"type":"text","text":", or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if never set."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All accessors are "},{"type":"codeVoice","code":"async"},{"type":"text","text":" — wrap reads in "},{"type":"codeVoice","code":"await"},{"type":"text","text":". The record types have public initializers, so tests can build expected values: "},{"type":"codeVoice","code":"#expect(await mock.identifyCalls == [.init(userID: \"user-1\")])"},{"type":"text","text":"."}]},{"type":"heading","text":"Consent","anchor":"Consent","level":4},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"init(optedOut:)"},{"type":"text","text":" stands in for the real service’s "},{"type":"codeVoice","code":"optOutTrackingByDefault"},{"type":"text","text":". "},{"type":"codeVoice","code":"setOptedOut(_:)"},{"type":"text","text":" routes to "},{"type":"codeVoice","code":"optOutTracking()"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"optInTracking()"},{"type":"text","text":" exactly as the real service does, so the same "},{"type":"codeVoice","code":"onConsentChange: { await service.setOptedOut($0) }"},{"type":"text","text":" wiring works against either. The mock flips "},{"type":"codeVoice","code":"optedOut"},{"type":"text","text":" synchronously and records every call; it does not model the real service’s idempotence (a repeated opt-in is recorded again)."}]},{"type":"heading","text":"Determinism","anchor":"Determinism","level":4},{"type":"paragraph","inlineContent":[{"type":"text","text":"The mock holds no buffers and adds no latency: every "},{"type":"codeVoice","code":"track"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"identify"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"alias"},{"type":"text","text":" records synchronously inside the actor. The plugin’s own "},{"type":"codeVoice","code":"flush()"},{"type":"text","text":" is still the right sync point for test assertions, since it drains the plugin’s own fire-and-forget task counter before the mock is queried."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The mock records "},{"type":"emphasis","inlineContent":[{"type":"text","text":"everything"}]},{"type":"text","text":", including calls the real adapter drops — blank-"},{"type":"codeVoice","code":"userID"},{"type":"text","text":" "},{"type":"codeVoice","code":"identify"},{"type":"text","text":" and blank-"},{"type":"codeVoice","code":"newID"},{"type":"text","text":" "},{"type":"codeVoice","code":"alias"},{"type":"text","text":" calls (see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ServiceReference"},{"type":"text","text":"), and calls made while opted out. A recording mock should never lose history; assert consent and validity at the call site, not by the absence of records."}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockServiceReference","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxmixpanelanalytics\/mockservicereference"]}],"metadata":{"role":"article","roleHeading":"Article","modules":[{"name":"SwiduxMixpanelAnalytics"}],"title":"Mock Service Reference"},"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ServiceReference"],"anchor":"Related-Documentation"},{"title":"Reference","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ServiceReference"],"anchor":"Reference","generated":true}
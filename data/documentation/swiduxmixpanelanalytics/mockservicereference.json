{"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"kind":"article","abstract":[{"type":"text","text":"API reference for "},{"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService","isActive":true},{"type":"text","text":" — a recording "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" for SwiftUI previews and Swift Testing suites."}],"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ServiceReference"],"anchor":"Related-Documentation"},{"generated":true,"title":"Reference","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ServiceReference"],"anchor":"Reference"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MockMixpanelAnalyticsService"},{"type":"text","text":" is an actor that conforms to "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" and records every call it receives. Use it in "},{"type":"codeVoice","code":"#Preview"},{"type":"text","text":" blocks (where you don’t want real network traffic) and in tests (where you want deterministic assertions on what the plugin dispatched)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It has no Mixpanel SDK dependency — it imports "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" only — so previews compile against it without configuring Mixpanel."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For usage examples, see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest"},{"type":
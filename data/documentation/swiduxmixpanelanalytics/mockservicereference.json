{"kind":"article","primaryContentSections":[{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"inlineContent":[{"code":"MockMixpanelAnalyticsService","type":"codeVoice"},{"text":" is an actor that conforms to ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" and records every call it receives. Use it in ","type":"text"},{"code":"#Preview","type":"codeVoice"},{"text":" blocks (where you don’t want real network traffic) and in tests (where you want deterministic assertions on what the plugin dispatched).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"It has no Mixpanel SDK dependency — it imports ","type":"text"},{"code":"SwiduxAnalytics","type":"codeVoice"},{"text":" only — so previews compile against it without configuring Mixpanel.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For usage examples, see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Types","level":2,"type":"heading","anchor":"Types"},{"text":"``doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService``","level":3,"type":"heading","anchor":"docSwiduxMixpanelAnalyticsdocumentationSwiduxMixpanelAnalyticsMockMixpanelAnalyticsService"},{"syntax":"swift","type":"codeListing","code":["public actor MockMixpanelAnalyticsService: AnalyticsService {","    public init(optedOut: Bool = false)","","    public func setOptedOut(_ optedOut: Bool) async","","    public private(set) var trackedEvents: [AnalyticsEvent]","    public private(set) var identifyCalls: [IdentifyCall]","    public private(set) var aliasCalls: [AliasCall]","    public private(set) var resetCount: Int","    public private(set) var flushCount: Int","    public private(set) var optOutCount: Int","    public private(set) var optInCalls: [OptInCall]","    public private(set) var optedOut: Bool","    public private(set) var loggingEnabled: Bool?","    public private(set) var useIPAddressForGeoLocation: Bool?","","    public struct IdentifyCall: Sendable, Equatable {","        public init(userID: String, properties: [String: AnalyticsValue] = [:])","        public let userID: String","        public let properties: [String: AnalyticsValue]","    }","","    public struct AliasCall: Sendable, Equatable {","        public init(newID: String, previousID: String? = nil)","        public let newID: String","        public let previousID: String?","    }","","    public struct OptInCall: Sendable, Equatable {","        public init(distinctID: String? = nil, properties: [String: AnalyticsValue]? = nil)","        public let distinctID: String?","        public let properties: [String: AnalyticsValue]?","    }","}"]},{"text":"Recorded state","level":4,"type":"heading","anchor":"Recorded-state"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"trackedEvents","type":"codeVoice"},{"text":" — every ","type":"text"},{"code":"AnalyticsEvent","type":"codeVoice"},{"text":" passed to ","type":"text"},{"code":"track(_:)","type":"codeVoice"},{"text":", in dispatch order.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"identifyCalls","type":"codeVoice"},{"text":" — every ","type":"text"},{"code":"(userID, properties)","type":"codeVoice"},{"text":" pair passed to ","type":"text"},{"code":"identify(userID:properties:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"aliasCalls","type":"codeVoice"},{"text":" — every ","type":"text"},{"code":"(newID, previousID)","type":"codeVoice"},{"text":" pair passed to ","type":"text"},{"code":"alias(newID:previousID:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"resetCount","type":"codeVoice"},{"text":" — number of times ","type":"text"},{"code":"reset()","type":"codeVoice"},{"text":" was called.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"flushCount","type":"codeVoice"},{"text":" — number of times ","type":"text"},{"code":"flush()","type":"codeVoice"},{"text":" was called.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"optOutCount","type":"codeVoice"},{"text":" — number of times ","type":"text"},{"code":"optOutTracking()","type":"codeVoice"},{"text":" was called.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"optInCalls","type":"codeVoice"},{"text":" — every ","type":"text"},{"code":"(distinctID, properties)","type":"codeVoice"},{"text":" pair passed to ","type":"text"},{"code":"optInTracking(distinctID:properties:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"optedOut","type":"codeVoice"},{"text":" — current tracked opt-out state, also returned from ","type":"text"},{"code":"hasOptedOutTracking()","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"loggingEnabled","type":"codeVoice"},{"text":" — last value passed to ","type":"text"},{"code":"setLoggingEnabled(_:)","type":"codeVoice"},{"text":", or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" if never set.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"useIPAddressForGeoLocation","type":"codeVoice"},{"text":" — last value passed to ","type":"text"},{"code":"setUseIPAddressForGeoLocation(_:)","type":"codeVoice"},{"text":", or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" if never set.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"All accessors are ","type":"text"},{"code":"async","type":"codeVoice"},{"text":" — wrap reads in ","type":"text"},{"code":"await","type":"codeVoice"},{"text":". The record types have public initializers, so tests can build expected values: ","type":"text"},{"code":"#expect(await mock.identifyCalls == [.init(userID: \"user-1\")])","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Consent","level":4,"type":"heading","anchor":"Consent"},{"inlineContent":[{"code":"init(optedOut:)","type":"codeVoice"},{"text":" stands in for the real service’s ","type":"text"},{"code":"optOutTrackingByDefault","type":"codeVoice"},{"text":". ","type":"text"},{"code":"setOptedOut(_:)","type":"codeVoice"},{"text":" routes to ","type":"text"},{"code":"optOutTracking()","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"optInTracking()","type":"codeVoice"},{"text":" exactly as the real service does, so the same ","type":"text"},{"code":"onConsentChange: { await service.setOptedOut($0) }","type":"codeVoice"},{"text":" wiring works against either. The mock flips ","type":"text"},{"code":"optedOut","type":"codeVoice"},{"text":" synchronously and records every call; it does not model the real service’s idempotence (a repeated opt-in is recorded again).","type":"text"}],"type":"paragraph"},{"text":"Determinism","level":4,"type":"heading","anchor":"Determinism"},{"inlineContent":[{"text":"The mock holds no buffers and adds no latency: every ","type":"text"},{"code":"track","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"identify","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"alias","type":"codeVoice"},{"text":" records synchronously inside the actor. The plugin’s own ","type":"text"},{"code":"flush()","type":"codeVoice"},{"text":" is still the right sync point for test assertions, since it drains the plugin’s own fire-and-forget task counter before the mock is queried.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The mock records ","type":"text"},{"inlineContent":[{"text":"everything","type":"text"}],"type":"emphasis"},{"text":", including calls the real adapter drops — blank-","type":"text"},{"code":"userID","type":"codeVoice"},{"text":" ","type":"text"},{"code":"identify","type":"codeVoice"},{"text":" and blank-","type":"text"},{"code":"newID","type":"codeVoice"},{"text":" ","type":"text"},{"code":"alias","type":"codeVoice"},{"text":" calls (see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ServiceReference","type":"reference"},{"text":"), and calls made while opted out. A recording mock should never lose history; assert consent and validity at the call site, not by the absence of records.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxmixpanelanalytics\/mockservicereference"]}],"hierarchy":{"paths":[["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics"]]},"metadata":{"role":"article","roleHeading":"Article","title":"Mock Service Reference","modules":[{"name":"SwiduxMixpanelAnalytics"}]},"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"abstract":[{"text":"API reference for ","type":"text"},{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService","isActive":true,"type":"reference"},{"text":" — a recording ","type":"text"},{"type":"codeVoice","code":"AnalyticsService"},{"text":" for SwiftUI previews and Swift Testing suites.","type":"text"}],"seeAlsoSections":[{"anchor":"Related-Documentation","title":"Related Documentation","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ServiceReference"]},{"anchor":"Reference","generated":true,"title":"Reference","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ServiceReference"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockServiceReference"},"references":{"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/ServiceReference":{"kind":"article","title":"Service Reference","type":"topic","abstract":[{"text":"API reference for ","type":"text"},{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService","isActive":true,"type":"reference"},{"text":" — the Mixpanel-backed ","type":"text"},{"type":"codeVoice","code":"AnalyticsService"},{"text":" conformer that the analytics plugin consumes.","type":"text"}],"role":"article","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ServiceReference","url":"\/documentation\/swiduxmixpanelanalytics\/servicereference"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics":{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics","role":"collection","type":"topic","title":"SwiduxMixpanelAnalytics","url":"\/documentation\/swiduxmixpanelanalytics","abstract":[{"type":"text","text":"Mixpanel adapter for Swidux’s "},{"type":"codeVoice","code":"AnalyticsPlugin"},{"text":". Owns the Mixpanel SDK on the app’s behalf — ","type":"text"},{"type":"codeVoice","code":"MixpanelAnalyticsService(token:)"},{"type":"text","text":" calls "},{"type":"codeVoice","code":"Mixpanel.initialize"},{"text":" internally so apps never need to ","type":"text"},{"type":"codeVoice","code":"import Mixpanel"},{"text":". Ships a recording mock for previews and tests.","type":"text"}],"kind":"symbol"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MixpanelAnalyticsService":{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MixpanelAnalyticsService"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MixpanelAnalyticsService"}],"title":"MixpanelA
":"aliasCalls"},{"text":" — every ","type":"text"},{"type":"codeVoice","code":"(newID, previousID)"},{"text":" pair passed to ","type":"text"},{"type":"codeVoice","code":"alias(newID:previousID:)"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"resetCount"},{"text":" — number of times ","type":"text"},{"type":"codeVoice","code":"reset()"},{"text":" was called.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"flushCount"},{"text":" — number of times ","type":"text"},{"type":"codeVoice","code":"flush()"},{"text":" was called.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"optOutCount"},{"text":" — number of times ","type":"text"},{"type":"codeVoice","code":"optOutTracking()"},{"text":" was called.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"optInCalls"},{"text":" — every ","type":"text"},{"type":"codeVoice","code":"(distinctID, properties)"},{"text":" pair passed to ","type":"text"},{"type":"codeVoice","code":"optInTracking(distinctID:properties:)"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"optedOut"},{"text":" — current tracked opt-out state, also returned from ","type":"text"},{"type":"codeVoice","code":"hasOptedOutTracking()"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"loggingEnabled"},{"text":" — last value passed to ","type":"text"},{"type":"codeVoice","code":"setLoggingEnabled(_:)"},{"text":", or ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" if never set.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"useIPAddressForGeoLocation"},{"text":" — last value passed to ","type":"text"},{"type":"codeVoice","code":"setUseIPAddressForGeoLocation(_:)"},{"text":", or ","typ
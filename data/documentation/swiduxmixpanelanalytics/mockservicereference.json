de":"AnalyticsEvent"},{"text":" passed to ","type":"text"},{"code":"track(_:)","type":"codeVoice"},{"type":"text","text":", in dispatch order."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"identifyCalls","type":"codeVoice"},{"type":"text","text":" — every "},{"code":"(userID, properties)","type":"codeVoice"},{"type":"text","text":" pair passed to "},{"code":"identify(userID:properties:)","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"aliasCalls"},{"type":"text","text":" — every "},{"type":"codeVoice","code":"(newID, previousID)"},{"type":"text","text":" pair passed to "},{"code":"alias(newID:previousID:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"resetCount"},{"type":"text","text":" — number of times "},{"type":"codeVoice","code":"reset()"},{"type":"text","text":" was called."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"flushCount","type":"codeVoice"},{"type":"text","text":" — number of times "},{"type":"codeVoice","code":"flush()"},{"type":"text","text":" was called."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"optOutCount"},{"type":"text","text":" — number of times "},{"type":"codeVoice","code":"optOutTracking()"},{"type":"text","text":" was called."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"optInCalls"},{"type":"text","text":" — every "},{"type":"codeVoice","code":"(distinctID, properties)"},{"type":"text","text":" pair passed to "},{"type":"codeVoice","code":"optInTracking(distinctID:properties:)"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"optedOut","type":"codeVoice"},{"type":"text","text":" — current tracked opt-out state, also returned from "},{"type":"codeVoice","code":"hasOptedOutTracking()"},{"type":"text","text":"."}]}]},{"content":
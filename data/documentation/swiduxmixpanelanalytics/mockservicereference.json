{"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"title":"Mock Service Reference","roleHeading":"Article","modules":[{"name":"SwiduxMixpanelAnalytics"}],"role":"article"},"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ServiceReference"],"anchor":"Related-Documentation"},{"title":"Reference","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ServiceReference"],"generated":true,"anchor":"Reference"}],"hierarchy":{"paths":[["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics"]]},"abstract":[{"type":"text","text":"API reference for "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService"},{"type":"text","text":" — a recording "},{"code":"AnalyticsService","type":"codeVoice"},{"type":"text","text":" for SwiftUI previews and Swift Testing suites."}],"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MockMixpanelAnalyticsService"},{"type":"text","text":" is an actor that conforms to "},{"code":"AnalyticsService","type":"codeVoice"},{"text":" and records every call it receives. Use it in ","type":"text"},{"code":"#Preview","type":"codeVoice"},{"text":" blocks (where you don’t want real network traffic) and in tests (where you want deterministic assertions on what the plugin dispatched).","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It has no Mixpanel SDK dependency — it imports "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" only — so previews compile against it without configuring Mixpanel."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For usage examples, see "},{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest","type":"reference","isActive":true},{"text":".","type":"text"}]},{"text":"Types","anchor":"Types","level":2,"type":"heading"},{"level":3,"text":"``doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService``","anchor":"docSwiduxMixpanelAnalyticsdocumentationSwiduxMixpanelAnalyticsMockMixpanelAnalyticsService","type":"heading"},{"syntax":"swift","code":["public actor MockMixpanelAnalyticsService: AnalyticsService {","    public init()","","    public private(set) var trackedEvents: [AnalyticsEvent]","    public private(set) var identifyCalls: [IdentifyCall]","    public private(set) var aliasCalls: [AliasCall]","    public private(set) var resetCount: Int","    public private(set) var flushCount: Int","    public private(set) var optOutCount: Int","    public private(set) var optInCalls: [OptInCall]","    public private(set) var optedOut: Bool","    public private(set) var loggingEnabled: Bool?","    public private(set) var useIPAddressForGeoLocation: Bool?","","    public struct IdentifyCall: Sendable, Equatable {","        public let userID: String","        public let properties: [String: AnalyticsValue]","    }","","    public struct AliasCall: Sendable, Equatable {","        public let newID: String","        public let previousID: String?","    }","","    public struct OptInCall: Sendable, Equatable {","        public let distinctID: String?","        public let properties: [String: AnalyticsValue]?","    }","}"],"type":"codeListing"},{"text":"Recorded state","anchor":"Recorded-state","level":4,"type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"trackedEvents"},{"text":" — every ","type":"text"},{"type":"codeVoice","code":"AnalyticsEvent"},{"text":" passed to ","type":"text"},{"type":"codeVoice","code":"track(_:)"},{"text":", in dispatch order.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"identifyCalls"},{"type":"text","text":" — every "},{"type":"codeVoice","code":"(userID, properties)"},{"type":"text","text":" pair passed to "},{"type":"codeVoice","code":"identify(userID:properties:)"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"aliasCalls"},{"type":"text","text":" — every "},{"type":"codeVoice","code":"(newID, previousID)"},{"type":"text","text":" pair passed to "},{"type":"codeVoice","code":"alias(newID:previousID:)"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"resetCount"},{"type":"text","text":" — number of times "},{"type":"codeVoice","code":"reset()"},{"type":"text","text":" was called."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"flushCount"},{"type":"text","text":" — number of times "},{"type":"codeVoice","code":"flush()"},{"type":"text","text":" was called."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"optOutCount"},{"type":"text","text":" — number of times "},{"type":"codeVoice","code":"optOutTracking()"},{"type":"text","text":" was called."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"optInCalls"},{"type":"text","text":" — every "},{"type":"codeVoice","code":"(distinctID, properties)"},{"type":"text","text":" pair passed to "},{"code":"optInTracking(distinctID:properties:)","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"optedOut"},{"type":"text","text":" — current tracked opt-out state, also returned from "},{"type":"codeVoice","code":"hasOptedOutTracking()"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"loggingEnabled"},{"type":"text","text":" — last value passed to "},{"type":"codeVoice","code":"setLoggingEnabled(_:)"},{"type":"text","text":", or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if never set."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"useIPAddressForGeoLocation"},{"type":"text","text":" — last value passed to "},{"type":"codeVoice","code":"setUseIPAddressForGeoLocation(_:)"},{"type":"text","text":", or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if never set."}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"All accessors are ","type":"text"},{"code":"async","type":"codeVoice"},{"text":" — wrap reads in ","type":"text"},{"code":"await","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Determinism","anchor":"Determinism","type":"heading","level":4},{"inlineContent":[{"text":"The mock holds no buffers and adds no latency: every ","type":"text"},{"code":"track","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"identify","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"alias","type":"codeVoice"},{"text":" records synchronously inside the actor. The plugin’s own ","type":"text"},{"code":"flush()","type":"codeVoice"},{"text":" is still the right sync point for test assertions, since it drains the plugin’s own fire-and-forget task counter before the mock is queried.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The mock records ","type":"text"},{"inlineContent":[{"type":"text","text":"everything"}],"type":"emphasis"},{"text":", including calls the real adapter drops — blank-","type":"text"},{"code":"userID","type":"codeVoice"},{"text":" ","type":"text"},{"code":"identify","type":"codeVoice"},{"text":" and blank-","type":"text"},{"code":"newID","type":"codeVoice"},{"text":" ","type":"text"},{"code":"alias","type":"codeVoice"},{"text":" calls (see ","type":"text"},{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ServiceReference
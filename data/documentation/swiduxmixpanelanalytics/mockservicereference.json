nt":[{"inlineContent":[{"type":"codeVoice","code":"optOutCount"},{"type":"text","text":" — number of times "},{"code":"optOutTracking()","type":"codeVoice"},{"type":"text","text":" was called."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"optInCalls"},{"type":"text","text":" — every "},{"type":"codeVoice","code":"(distinctID, properties)"},{"type":"text","text":" pair passed to "},{"type":"codeVoice","code":"optInTracking(distinctID:properties:)"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"optedOut"},{"text":" — current tracked opt-out state, also returned from ","type":"text"},{"type":"codeVoice","code":"hasOptedOutTracking()"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"loggingEnabled","type":"codeVoice"},{"text":" — last value passed to ","type":"text"},{"code":"setLoggingEnabled(_:)","type":"codeVoice"},{"text":", or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" if never set.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"useIPAddressForGeoLocation"},{"type":"text","text":" — last value passed to "},{"type":"codeVoice","code":"setUseIPAddressForGeoLocation(_:)"},{"type":"text","text":", or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if never set."}]}]}]},{"inlineContent":[{"type":"text","text":"All accessors are "},{"type":"codeVoice","code":"async"},{"type":"text","text":" — wrap reads in "},{"type":"codeVoice","code":"await"},{"type":"text","text":"."}],"type":"paragraph"},{"level":4,"type":"heading","text":"Determinism","anchor":"Determinism"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The mock holds no buffers and adds no latency: every "},{"code":"track","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"identify","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"alias","type":"codeVoice"},{"type":"text","text":" records synchronously inside the actor. The plugin’s own "},{"code":"flush()","type":"codeVoice"},{"type":"text","text":" is still the right sync point for test assertions, since it drains the plugin’s own fire-and-forget task counter before the mock is queried."}]},{"type":"paragraph","inlineContent":[{"text":"The mock records ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"everything","type":"text"}]},{"text":", including calls the real adapter drops — blank-","type":"text"},{"type":"codeVoice","code":"userID"},{"text":" ","type":"text"},{"type":"codeVoice","code":"identify"},{"text":" and blank-","type":"text"},{"type":"codeVoice","code":"newID"},{"text":" ","type":"text"},{"type":"codeVoice","code":"alias"},{"text":" calls (see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ServiceReference"},{"text":"), and calls made while opted out. A recording mock should never lose history; assert consent and validity at the call site, not by the absence of records.","type":"text"}]}],"kind":"content"}],"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxmixpanelanalytics\/mockservicereference"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"abstract":[{"text":"API reference for ","type":"text"},{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService","isActive":true,"type":"reference"},{"text":" — a recording ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" for SwiftUI previews and Swift Testing suites.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics"]]},"metadata":{"roleHeading":"Article","title":"Mock Service Reference","role":"article","modules":[{"name":"SwiduxMixpanelAnalytics"}]},"identifier":{"interfaceLanguage":"s
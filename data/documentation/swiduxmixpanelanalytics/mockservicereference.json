{"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"code":"MockMixpanelAnalyticsService","type":"codeVoice"},{"type":"text","text":" is an actor that conforms to "},{"code":"AnalyticsService","type":"codeVoice"},{"type":"text","text":" and records every call it receives. Use it in "},{"code":"#Preview","type":"codeVoice"},{"type":"text","text":" blocks (where you don’t want real network traffic) and in tests (where you want deterministic assertions on what the plugin dispatched)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It has no Mixpanel SDK dependency — it imports "},{"code":"SwiduxAnalytics","type":"codeVoice"},{"type":"text","text":" only — so previews compile against it without configuring Mixpanel."}]},{"type":"paragraph","inlineContent":[{"text":"For usage examples, see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest"},{"type":"text","text":"."}]},{"type":"heading","level":2,"anchor":"Types","text":"Types"},{"level":3,"anchor":"docSwiduxMixpanelAnalyticsdocumentationSwiduxMixpanelAnalyticsMockMixpanelAnalyticsService","text":"``doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService``","type":"heading"},{"code":["public actor MockMixpanelAnalyticsService: AnalyticsService {","    public init()","","    public private(set) var trackedEvents: [AnalyticsEvent]","    public private(set) var identifyCalls: [IdentifyCall]","    public private(set) var aliasCalls: [AliasCall]","    public private(set) var resetCount: Int","    public private(set) var flushCount: Int","","    public struct IdentifyCall: Sendable, Equatable {","        public let userID: String","        public let properties: [String: AnalyticsValue]","    }","","    public struct AliasCall: Sendable, Equatable {","        public let newID: String","        public let previousID: String?","    }","}"],"type":"codeListing","syntax":"swift"},{"level":4,"anchor":"Recorded-state","text":"Recorded state","type":"heading"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"trackedEvents","type":"codeVoice"},{"text":" — every ","type":"text"},{"code":"AnalyticsEvent","type":"codeVoice"},{"text":" passed to ","type":"text"},{"code":"track(_:)","type":"codeVoice"},{"text":", in dispatch order.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"identifyCalls","type":"codeVoice"},{"text":" — every ","type":"text"},{"code":"(userID, properties)","type":"codeVoice"},{"text":" pair passed to ","type":"text"},{"code":"identify(userID:properties:)","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"aliasCalls","type":"codeVoice"},{"text":" — every ","type":"text"},{"code":"(newID, previousID)","type":"codeVoice"},{"text":" pair passed to ","type":"text"},{"code":"alias(newID:previousID:)","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"resetCount","type":"codeVoice"},{"text":" — number of times ","type":"text"},{"code":"reset()","type":"codeVoice"},{"text":" was called.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"flushCount","type":"codeVoice"},{"text":" — number of times ","type":"text"},{"code":"flush()","type":"codeVoice"},{"text":" was called.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"All accessors are "},{"code":"async","type":"codeVoice"},{"type":"text","text":" — wrap reads in "},{"code":"await","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"heading","level":4,"anchor":"Determinism","text":"Determinism"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The mock holds no buffers and adds no latency: every "},{"code":"track","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"identify","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"alias","type":"codeVoice"},{"type":"text","text":" records synchronously inside the actor. The plugin’s own "},{"code":"flush()","type":"codeVoice"},{"type":"text","text":" is still the right sync point for test assertions, since it drains the plugin’s own fire-and-forget task counter before the mock is queried."}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics"]]},"sections":[],"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxmixpanelanalytics\/mockservicereference"]}],"metadata":{"role":"article","roleHeading":"Article","title":"Mock Service Reference","modules":[{"name":"SwiduxMixpanelAnalytics"}]},"identifier":{"url":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockServiceReference","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"API reference for "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService"},{"type":"text","text":" — a recording "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" for SwiftUI previews and Swift Testing suites."}],"seeAlsoSections":[{"title":"Related Documentation","anchor":"Related-Documentation","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ServiceReference"]},{"title":"Reference","generated":true,"anchor":"Reference","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ServiceReference"]}],"references":{"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MixpanelAnalyticsService":{"abstract"
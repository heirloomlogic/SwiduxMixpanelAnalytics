ems":[{"content":[{"inlineContent":[{"code":"trackedEvents","type":"codeVoice"},{"text":" — every ","type":"text"},{"code":"AnalyticsEvent","type":"codeVoice"},{"text":" passed to ","type":"text"},{"code":"track(_:)","type":"codeVoice"},{"text":", in dispatch order.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"identifyCalls","type":"codeVoice"},{"text":" — every ","type":"text"},{"code":"(userID, properties)","type":"codeVoice"},{"text":" pair passed to ","type":"text"},{"type":"codeVoice","code":"identify(userID:properties:)"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"aliasCalls","type":"codeVoice"},{"text":" — every ","type":"text"},{"code":"(newID, previousID)","type":"codeVoice"},{"text":" pair passed to ","type":"text"},{"code":"alias(newID:previousID:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"resetCount","type":"codeVoice"},{"text":" — number of times ","type":"text"},{"code":"reset()","type":"codeVoice"},{"text":" was called.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"flushCount"},{"type":"text","text":" — number of times "},{"type":"codeVoice","code":"flush()"},{"type":"text","text":" was called."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"optOutCount"},{"type":"text","text":" — number of times "},{"type":"codeVoice","code":"optOutTracking()"},{"type":"text","text":" was called."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"optInCalls"},{"type":"text","text":" — every "},{"type":"codeVoice","code":"(distinctID, properties)"},{"type":"text","text":" pair passed to "},{"type":"codeVoice","code":"optInTracking(distinctID:properties:)"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"optedOut"},{"type":"text","
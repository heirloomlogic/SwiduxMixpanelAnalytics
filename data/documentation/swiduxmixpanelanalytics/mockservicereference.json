{"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockServiceReference"},"abstract":[{"text":"API reference for ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService"},{"text":" — a recording ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" for SwiftUI previews and Swift Testing suites.","type":"text"}],"metadata":{"title":"Mock Service Reference","role":"article","modules":[{"name":"SwiduxMixpanelAnalytics"}],"roleHeading":"Article"},"kind":"article","schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"type":"codeVoice","code":"MockMixpanelAnalyticsService"},{"type":"text","text":" is an actor that conforms to "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" and records every call it receives. Use it in "},{"type":"codeVoice","code":"#Preview"},{"type":"text","text":" blocks (where you don’t want real network traffic) and in tests (where you want deterministic assertions on what the plugin dispatched)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It has no Mixpanel SDK dependency — it imports "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" only — so previews compile against it without configuring Mixpanel."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For usage examples, see "},{"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"text":"Types","type":"heading","anchor":"Types"},{"level":3,"text":"``doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService``","type":"heading","anchor":"docSwiduxMixpanelAnalyticsdocumentationSwiduxMixpanelAnalyticsMockMixpanelAnalyticsService"},{"code":["public actor MockMixpanelAnalyticsService: AnalyticsService {","    public init()","","    public private(set) var trackedEvents: [AnalyticsEvent]","    public private(set) var identifyCalls: [IdentifyCall]","    public private(set) var aliasCalls: [AliasCall]","    public private(set) var resetCount: Int","    public private(set) var flushCount: Int","    public private(set) var optOutCount: Int","    public private(set) var optInCalls: [OptInCall]","    public private(set) var optedOut: Bool","    public private(set) var loggingEnabled: Bool?","    public private(set) var useIPAddressForGeoLocation: Bool?","","    public struct IdentifyCall: Sendable, Equatable {","        public let userID: String","        public let properties: [String: AnalyticsValue]","    }","","    public struct AliasCall: Sendable, Equatable {","        public let newID: String","        public let previousID: String?","    }","","    public struct OptInCall: Sendable, Equatable {","        public let distinctID: String?","        public let properties: [String: AnalyticsValue]?","    }","}"],"syntax":"swift","type":"codeListing"},{"level":4,"text":"Recorded state","type":"heading","anchor":"Recorded-state"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"trackedEvents"},{"type":"text","text":" — every "},{"type":"codeVoice","code":"AnalyticsEvent"},{"type":"text","text":" passed to "},{"type":"codeVoice","code":"track(_:)"},{"type":"text","text":", in dispatch order."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"identifyCalls"},{"type":"text","text":" — every "},{"type":"codeVoice","code":"(userID, properties)"},{"type":"text","text":" pair passed to "},{"type":"codeVoice","code":"identify(userID:properties:)"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"aliasCalls"},{"type":"text","text":" — every "},{"type":"codeVoice","code":"(newID, previousID)"},{"type":"text","text":" pair passed to "},{"type":"codeVoice","code":"alias(newID:previousID:)"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"resetCount"},{"type":"text","text":" — number of times "},{"type":"codeVoice","code":"reset()"},{"type":"text","text":" was called."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"flushCount"},{"type":"text","text":" — number of times "},{"type":"codeVoice","code":"flush()"},{"type":"text","text":" was called."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"optOutCount"},{"type":"text","text":" — number of times "},{"type":"codeVoice","code":"optOutTracking()"},{"type":"text","text":" was called."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"optInCalls"},{"type":"text","text":" — every "},{"type":"codeVoice","code":"(distinctID, properties)"},{"type":"text","text":" pair passed to "},{"type":"codeVoice","code":"optInTracking(distinctID:properties:)"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"optedOut"},{"type":"text","text":" — current tracked opt-out state, also returned from "},{"type":"codeVoice","code":"hasOptedOutTracking()"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"loggingEnabled"},{"type":"text","text":" — last value passed to "},{"type":"codeVoice","code":"setLoggingEnabled(_:)"},{"type":"text","text":", or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if never set."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"useIPAddressForGeoLocation"},{"type":"text","text":" — last value passed to "},{"type":"codeVoice","code":"setUseIPAddressForGeoLocation(_:)"},{"type":"text","text":", or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if never set."}]}]}]},{"inlineContent":[{"type":"text","text":"All accessors are "},{"type":"codeVoice","code":"async"},{"type":"text","text":" — wrap reads in "},{"type":"codeVoice","code":"await"},{"type":"text","text":"."}],"type":"paragraph"},{"level":4,"text":"Determinism","type":"heading","anchor":"Determinism"},{"inlineContent":[{"type":"text","text":"The mock holds no buffers and adds no latency: every "},{"type":"codeVoice","code":"track"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"identify"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"alias"},{"type":"text","text":" records synchronously inside the actor. The plugin’s own "},{"type":"codeVoice","code":"flush()"},{"type":"text","text":" is still the right sync point for test assertions, since it drains the plugin’s own fire-and-forget task counter before the mock is queried."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The mock records "},{"type":"emphasis","inlineContent":[{"type":"text","text":"everything"}]},{"type":"text","text":", including calls the real adapter drops — blank-"},{"type":"codeVoice","code":"userID"},{"type":"text","text":" "},{"type":"codeVoice","code":"identify"},{"type":"text","text":" and blank-"},{"type":"codeVoice","code":"newID"},{"type":"text","text":" "},{"type":"codeVoice","code":"alias"},{"type":"text","text":" calls (see "},{"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ServiceReference","isActive":true},{"type":"text","text":"), and calls made while opted out. A recording mock should never lose history; assert consent and validity at the call site, not by the absence of records."}],"type":"paragraph"}]}],"seeAlsoSections":[{"anchor":"Related-Documentation","title":"Related Documentation","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ServiceReference"]},{"anchor":"Reference","title":"Reference","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ServiceReference"],"generated":true}],"hierarchy":{"paths":[["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics"]]},"variants":[{"paths":["\/documentation\/swiduxmixpanelanalytics\/mockservicereference"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MixpanelAnalyticsService":{"role":"symbol","abstract":[{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" conformer that owns and forwards to a Mixpanel SDK"},{"type":"text","text":" "},{"type":"text","text":"instance."}],"title":"MixpanelAnalyticsService","kind":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"MixpanelAnalyticsService","kind":"identifier"}],"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService","navigatorTitle":[{"kind":"identifier","text":"MixpanelAnalyticsService"}],"url":"\/documentation\/swiduxmixpanelanalytics\/mixpanelanalyticsservice"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics":{"role":"collection","abstract":[{"type":"text","text":"Mixpanel adapter for Swidux’s "},{"type":"codeVoice","code":"AnalyticsPlugin"},{"type":"text","text":". Owns the Mixpanel SDK on the app’s behalf — "},{"type":"codeVoice","code":"MixpanelAnalyticsService(token:)"},{"type":"text","text":" calls "},{"type":"codeVoice","code":"Mixpanel.initialize"},{"type":"text","text":" internally so apps never need to "},{"type":"codeVoice","code":"import Mixpanel"},{"type":"text","text":". Ships a recording mock for previews and tests."}],"title":"SwiduxMixpanelAnalytics","kind":"
operties)","type":"codeVoice"},{"text":" pair passed to ","type":"text"},{"code":"identify(userID:properties:)","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"aliasCalls","type":"codeVoice"},{"text":" — every ","type":"text"},{"code":"(newID, previousID)","type":"codeVoice"},{"text":" pair passed to ","type":"text"},{"code":"alias(newID:previousID:)","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"resetCount","type":"codeVoice"},{"type":"text","text":" — number of times "},{"type":"codeVoice","code":"reset()"},{"type":"text","text":" was called."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"flushCount","type":"codeVoice"},{"type":"text","text":" — number of times "},{"code":"flush()","type":"codeVoice"},{"type":"text","text":" was called."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"optOutCount","type":"codeVoice"},{"type":"text","text":" — number of times "},{"code":"optOutTracking()","type":"codeVoice"},{"text":" was called.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"optInCalls","type":"codeVoice"},{"type":"text","text":" — every "},{"code":"(distinctID, properties)","type":"codeVoice"},{"text":" pair passed to ","type":"text"},{"code":"optInTracking(distinctID:properties:)","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"optedOut","type":"codeVoice"},{"type":"text","text":" — current tracked opt-out state, also returned from "},{"code":"hasOptedOutTracking()","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"code":"loggingEnabled","type":"codeVoice"},{"type":"text","text":" — last value passed to "},{"code":"setLoggingEnabled(_:)","type":"codeVoice"},{"type":"text","text":", or "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" if never set."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"useIPAddressForGeoLocation","type":"codeVoice"},{"type":"text","text":" — last value passed to "},{"code":"setUseIPAddressForGeoLocation(_:)","type":"codeVoice"},{"type":"text","text":", or "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" if never set."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All accessors are "},{"type":"codeVoice","code":"async"},{"type":"text","text":" — wrap reads in "},{"type":"codeVoice","code":"await"},{"type":"text","text":"."}]},{"type":"heading","level":4,"anchor":"Determinism","text":"Determinism"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The mock holds no buffers and adds no latency: every "},{"code":"track","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"identify","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"alias","type":"codeVoice"},{"text":" records synchronously inside the actor. The plugin’s own ","type":"text"},{"code":"flush()","type":"codeVoice"},{"type":"text","text":" is still the right sync point for test assertions, since it drains the plugin’s own fire-and-forget task counter before the mock is queried."}]},{"inlineContent":[{"type":"text","text":"The mock records "},{"type":"emphasis","inlineContent":[{"type":"text","text":"everything"}]},{"type":"text","text":", including calls the real adapter drops — blank-"},{"type":"codeVoice","code":"userID"},{"type":"text","text":" "},{"type":"codeVoice","code":"identify"},{"type":"text","text":" and blank-"},{"type":"codeVoice","code":"newID"},{"type":"text","text":" "},{"type":"codeVoice","code":"alias"},{"type":"text","text":" calls (see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ServiceReference"},{"type":"text","text":"), and calls made while opted out. A recording mock should never lose history; assert consent and validity at the call site, 
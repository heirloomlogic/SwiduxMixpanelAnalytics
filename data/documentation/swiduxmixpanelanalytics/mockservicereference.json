{"kind":"article","identifier":{"url":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockServiceReference","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"SwiduxMixpanelAnalytics"}],"title":"Mock Service Reference"},"variants":[{"paths":["\/documentation\/swiduxmixpanelanalytics\/mockservicereference"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"API reference for ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService","type":"reference"},{"text":" — a recording ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" for SwiftUI previews and Swift Testing suites.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"MockMixpanelAnalyticsService"},{"type":"text","text":" is an actor that conforms to "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" and records every call it receives. Use it in "},{"type":"codeVoice","code":"#Preview"},{"type":"text","text":" blocks (where you don’t want real network traffic) and in tests (where you want deterministic assertions on what the plugin dispatched)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It has no Mixpanel SDK dependency — it imports "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" only — so previews compile against it without configuring Mixpanel."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For usage examples, see "},{"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Types","level":2,"anchor":"Types","type":"heading"},{"text":"``doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService``","level":3,"anchor":"docSwiduxMixpanelAnalyticsdocumentationSwiduxMixpanelAnalyticsMockMixpanelAnalyticsService","type":"heading"},{"code":["public actor MockMixpanelAnalyticsService: AnalyticsService {","    public init()","","    public private(set) var trackedEvents: [AnalyticsEvent]","    public private(set) var identifyCalls: [IdentifyCall]","    public private(set) var aliasCalls: [AliasCall]","    public private(set) var resetCount: Int","    public private(set) var flushCount: Int","    public private(set) var optOutCount: Int","    public private(set) var optInCalls: [OptInCall]","    public private(set) var optedOut: Bool","    public private(set) var loggingEnabled: Bool?","    public private(set) var useIPAddressForGeoLocation: Bool?","","    public struct IdentifyCall: Sendable, Equatable {","        public let userID: String","        public let properties: [String: AnalyticsValue]","    }","","    public struct AliasCall: Sendable, Equatable {","        public let newID: String","        public let previousID: String?","    }","","    public struct OptInCall: Sendable, Equatable {","        public let distinctID: String?","        public let properties: [String: AnalyticsValue]?","    }","}"],"syntax":"swift","type":"codeListing"},{"text":"Recorded state","level":4,"anchor":"Recorded-state","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"trackedEvents","type":"codeVoice"},{"type":"text","text":" — every "},{"code":"AnalyticsEvent","type":"codeVoice"},{"type":"text","text":" passed to "},{"code":"track(_:)","type":"codeVoice"},{"type":"text","text":", in dispatch order."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"identifyCalls","type":"codeVoice"},{"type":"text","text":" — every "},{"code":"(userID, properties)","type":"codeVoice"},{"type":"text","text":" pair passed to "},{"code":"identify(userID:properties:)","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"aliasCalls","type":"codeVoice"},{"type":"text","text":" — every "},{"code":"(newID, previousID)","type":"codeVoice"},{"type":"text","text":" pair passed to "},{"code":"alias(newID:previousID:)","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"resetCount","type":"codeVoice"},{"type":"text","text":" — number of times "},{"code":"reset()","type":"codeVoice"},{"type":"text","text":" was called."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"flushCount","type":"codeVoice"},{"type":"text","text":" — number of times "},{"code":"flush()","type":"codeVoice"},{"type":"text","text":" was called."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"optOutCount","type":"codeVoice"},{"type":"text","text":" — number of times "},{"code":"optOutTracking()","type":"codeVoice"},{"type":"text","text":" was called."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"optInCalls","type":"codeVoice"},{"type":"text","text":" — every "},{"code":"(distinctID, properties)","type":"codeVoice"},{"type":"text","text":" pair passed to "},{"code":"optInTracking(distinctID:properties:)","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"optedOut","type":"codeVoice"},{"type":"text","text":" — current tracked opt-out state, also returned from "},{"code":"hasOptedOutTracking()","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"loggingEnabled","type":"codeVoice"},{"type":"text","text":" — last value passed to "},{"code":"setLoggingEnabled(_:)","type":"codeVoice"},{"type":"text","text":", or "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" if never set."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"useIPAddressForGeoLocation","type":"codeVoice"},{"type":"text","text":" — last value passed to "},{"code":"setUseIPAddressForGeoLocation(_:)","type":"codeVoice"},{"type":"text","text":", or "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" if never set."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"All accessors are "},{"type":"codeVoice","code":"async"},{"type":"text","text":" — wrap reads in "},{"type":"codeVoice","code":"await"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Determinism","level":4,"anchor":"Determinism","type":"heading"},{"inlineContent":[{"type":"text","text":"The mock holds no buffers and adds no latency: every "},{"type":"codeVoice","code":"track"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"identify"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"alias"},{"type":"text","text":" records synchronously inside the actor. The plugin’s own "},{"type":"codeVoice","code":"flush()"},{"type":"text","text":" is still the right sync point for test assertions, since it drains the plugin’s own fire-and-forget task counter before the mock is queried."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The mock records "},{"type":"emphasis","inlineContent":[{"type":"text","text":"everything"}]},{"type":"text","text":", including calls the real adapter drops — blank-"},{"type":"codeVoice","code":"userID"},{"type":"text","text":" "},{"type":"codeVoice","code":"identify"},{"type":"text","text":" and blank-"},{"type":"codeVoice","code":"newID"},{"type":"text","text":" "},{"type":"codeVoice","code":"alias"},{"type":"text","text":" calls (see "},{"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ServiceReference","isActive":true},{"type":"text","text":"), and calls made while opted out. A recording mock should never lose history; assert consent and validity at the call site, not by the absence of records."}],"type":"paragraph"}]}],"seeAlsoSections":[{"title":"Related Documentation","
{"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"code":"MockMixpanelAnalyticsService","type":"codeVoice"},{"text":" is an actor that conforms to ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" and records every call it receives. Use it in ","type":"text"},{"code":"#Preview","type":"codeVoice"},{"text":" blocks (where you don’t want real network traffic) and in tests (where you want deterministic assertions on what the plugin dispatched).","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"It has no Mixpanel SDK dependency — it imports ","type":"text"},{"code":"SwiduxAnalytics","type":"codeVoice"},{"text":" only — so previews compile against it without configuring Mixpanel.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For usage examples, see "},{"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest","isActive":true},{"type":"text","text":"."}]},{"type":"heading","level":2,"text":"Types","anchor":"Types"},{"type":"heading","level":3,"text":"``doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService``","anchor":"docSwiduxMixpanelAnalyticsdocumentationSwiduxMixpanelAnalyticsMockMixpanelAnalyticsService"},{"type":"codeListing","syntax":"swift","code":["public actor MockMixpanelAnalyticsService: AnalyticsService {","    public init()","","    public private(set) var trackedEvents: [AnalyticsEvent]","    public private(set) var identifyCalls: [IdentifyCall]","    public private(set) var aliasCalls: [AliasCall]","    public private(set) var resetCount: Int","    public private(set) var flushCount: Int","    public private(set) var optOutCount: Int","    public private(set) var optInCalls: [OptInCall]","    public private(set) var optedOut: Bool","    public private(set) var loggingEnabled: Bool?
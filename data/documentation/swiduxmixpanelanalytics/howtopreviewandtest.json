{"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"kind":"article","abstract":[{"type":"text","text":"Drive "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" from SwiftUI previews and Swift Testing suites without touching Mixpanel’s network."}],"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/GettingStarted","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockServiceReference"],"anchor":"Related-Documentation"},{"title":"How-to Guides","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService"],"anchor":"How-to-Guides","generated":true}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MixpanelAnalyticsService"},{"type":"text","text":" calls into a real "},{"type":"codeVoice","code":"MixpanelInstance"},{"type":"text","text":". For previews and tests, swap it for "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService"},{"text":" — an actor that records every call and exposes its history for assertions. The mock has no Mixpanel dependency and runs offline.","type":"text"}]},{"type":"heading","level":2,"anchor":"In-a-SwiftUI-preview","text":"In a SwiftUI preview"},{"type":"paragraph","inlineContent":[{"text":"Inject a mock-backed store and the analytics work flows without spinning up the SDK:","type":"text"}]},{"type":"codeListing","code":["#Preview {","    let store = AppStore.configured(analyticsService: MockMixpanelAnalyticsService())","    return ContentView().environment(store)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This requires that "},{"type":"codeVoice","code":"AppStore.configured"},{"type":"text","text":" accepts an injected "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":". See Swidux’s "},{"type":"reference","identifier":"https:\/\/heirloomlogic.github.io\/Swidux\/documentation\/swidux\/howtoaddanalytics","isActive":true},{"text":" guide for the factory pattern.","type":"text"}]},{"type":"heading","level":2,"anchor":"In-a-Swift-Testing-suite","text":"In a Swift Testing suite"},{"type":"paragraph","inlineContent":[{"text":"Use the mock to verify mapper behavior. Await the plugin’s ","type":"text"},{"code":"flush()","type":"codeVoice"},{"text":" to make assertions deterministic:","type":"text"}]},{"type":"codeListing","code":["import SwiduxMixpanelAnalytics","import Testing","","@Test","func incrementMapsToCounterAdded() async {","    let mock = MockMixpanelAnalyticsService()","    let store = AppStore.configured(analyticsService: mock)","","    store.send(.counter(.increment(5)))","    await store.analyticsPlugin.flush()","","    let events = await mock.trackedEvents","    #expect(events.first?.name == \"counter_added\")","    #expect(events.first?.properties[\"amount\"] == .int(5))","}"],"syntax":"swift"},{"type":"heading","level":2,"anchor":"Asserting-on-identify-and-alias","text":"Asserting on identify and alias"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The mock records identify and alias calls in order:"}]},{"type":"codeListing","code":["@Test","func userSignInIdentifies() async {","    let mock = MockMixpanelAnalyticsService()","    let store = AppStore.configured(analyticsService: mock)","","    store.send(.auth(.signIn(userID: \"user-1\")))","    await store.analyticsPlugin.flush()","","    let calls = await mock.identifyCalls","    #expect(calls == [.init(userID: \"user-1\", properties: [\"tier\": .string(\"free\")])])","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"MockMixpanelAnalyticsService","type":"codeVoice"},{"type":"text","text":" is an actor, so its accessors are async — wrap them in "},{"type":"codeVoice","code":"await"},{"type":"text","text":"."}]}]}],"hierarchy":{"paths":[["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest"},"metadata":{"roleHeading":"Article","modules":[{"name":"SwiduxMixpanelAnalytics"}],"role":"article","title":"How to Preview and Test"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxmixpanelanalytics\/howtopreviewandtest"]}],"references":{"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/HowToImplementService":{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","kind":"article","abstract":[{"text":"Configure ","type":"text"},{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"text":" to match your privacy, residency, and batching needs — without ","type":"text"},{"code":"import Mixpanel","type":"codeVoice"},{"text":" in your app.","type":"text"}],"title":"How to Implement the Service","type":"topic","url":"\/documentation\/swiduxmixpanelanalytics\/howtoimplementservice","role":"article"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MockMixpanelAnalyticsService":{"kind":"symbol","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MockMixpanelAnalyticsService"}],"title":"MockMixpanelAnalyticsService","role":"symbol","url":"\/documentation\/swiduxmixpanelanalytics\/mockmixpanelanalyticsservice","abstract":[{"type":"text","text":"Recording "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" for previews and Swift Testing suites."}],"fragments":[{"text":"actor","kind":"keyword"},{"kind":"text","text":" "},{"text":"MockMixpanelAnalyticsService","kind":"identifier"}]},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics":{"type":"topic","kind":"symbol","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics","title":"SwiduxMixpanelAnalytics","role":"collection","url":"\/documentation\/swiduxmixpanelanalytics","abstract":[{"type":"text","text":"Mixpanel adapter for Swidux’s "},{"type":"codeVoice","code":"AnalyticsPlugin"},{"type":"text","text":". Owns the Mixpanel SDK on the app’s behalf — "},{"type":"codeVoice","code":"MixpanelAnalyticsService(token:)"},{"type":"text","text":" calls "},{"code":"Mixpanel.initialize","type":"codeVoice"},{"type":"text","text":" internally so apps never need to "},{"code":"import Mixpanel","type":"codeVoice"},{"type":"text","text":". Ships a recording mock for previews and tests."}]},"https://heirloomlogic.github.io/Swidux/documentation/swidux/howtoaddanalytics":{"type":"link","identifier":"https:\/\/heirloomlogic.github.io\/Swidux\/documentation\/swidux\/howtoaddanalytics","title":"Add Analytics","titleInlineContent":[{"text":"Add Analytics","type":"text"}],"url":"https:\/\/heirloomlogic.github.io\/Swidux\/documentation\/swidux\/howtoaddanalytics"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MockServiceReference":{"abstract":[{"type":"text","text":"API reference for "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService"},{"type":"text","text":" — a recording "},{"code":"AnalyticsService","type":"codeVoice"},{"type":"text","text":" for SwiftUI previews and Swift Testing suites."}],"kind":"article","type":"topic","url":"\/documentation\/swiduxmixpanelanalytics\/mockservicereference","title":"Mock Service Reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockServiceReference","role":"article"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/G
ytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","abstract":[{"text":"Configure ","type":"text"},{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"text":" to match your privacy, residency, and batching needs — without ","type":"text"},{"code":"import Mixpanel","type":"codeVoice"},{"text":" in your app.","type":"text"}],"title":"How to Implement the Service","url":"\/documentation\/swiduxmixpanelanalytics\/howtoimplementservice","kind":"article","type":"topic","role":"article"}}}
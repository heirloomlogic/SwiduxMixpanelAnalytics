{"kind":"article","hierarchy":{"paths":[["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest"},"metadata":{"modules":[{"name":"SwiduxMixpanelAnalytics"}],"title":"How to Preview and Test","roleHeading":"Article","role":"article"},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"type":"text","text":" calls into a real "},{"code":"MixpanelInstance","type":"codeVoice"},{"type":"text","text":". For previews and tests, swap it for "},{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService","isActive":true,"type":"reference"},{"type":"text","text":" — an actor that records every call and exposes its history for assertions. The mock has no Mixpanel dependency and runs offline."}]},{"anchor":"In-a-SwiftUI-preview","type":"heading","level":2,"text":"In a SwiftUI preview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Inject a mock-backed store and the analytics work flows without spinning up the SDK:"}]},{"syntax":"swift","type":"codeListing","code":["#Preview {","    let store = AppStore.configured(analyticsService: MockMixpanelAnalyticsService())","    return ContentView().environment(store)","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This requires that "},{"code":"AppStore.configured","type":"codeVoice"},{"type":"text","text":" accepts an injected "},{"code":"AnalyticsService","type":"codeVoice"},{"type":"text","text":". See Swidux’s "},{"identifier":"https:\/\/heirloomlogic.github.io\/Swidux\/documentation\/swidux\/howtoaddanalytics","isActive":true,"type":"reference"},{"type":"text","text":" guide for the factory pattern."}]},{"anchor":"In-a-Swift-Testing-suite","type":"heading","level":2,"text":"In a Swift Testing suite"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the mock to verify mapper behavior. Await the plugin’s "},{"code":"flush()","type":"codeVoice"},{"type":"text","text":" to make assertions deterministic:"}]},{"syntax":"swift","type":"codeListing","code":["import SwiduxMixpanelAnalytics","import Testing","","@Test","func incrementMapsToCounterAdded() async {","    let mock = MockMixpanelAnalyticsService()","    let store = AppStore.configured(analyticsService: mock)","","    store.send(.counter(.increment(5)))","    await store.analyticsPlugin.flush()","","    let events = await mock.trackedEvents","    #expect(events.first?.name == \"counter_added\")","    #expect(events.first?.properties[\"amount\"] == .int(5))","}"]},{"anchor":"Asserting-on-identify-and-alias","type":"heading","level":2,"text":"Asserting on identify and alias"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The mock records identify and alias calls in order:"}]},{"syntax":"swift","type":"codeListing","code":["@Test","func userSignInIdentifies() async {","    let mock = MockMixpanelAnalyticsService()","    let store = AppStore.configured(analyticsService: mock)","","    store.send(.auth(.signIn(userID: \"user-1\")))","    await store.analyticsPlugin.flush()","","    let calls = await mock.identifyCalls","    #expect(calls == [.init(userID: \"user-1\", properties: [\"tier\": .string(\"free\")])])","}"]},{"type":"paragraph","inlineContent":[{"code":"MockMixpanelAnalyticsService","type":"codeVoice"},{"type":"text","text":" is an actor, so its accessors are async — wrap them in "},{"code":"await","type":"codeVoice"},{"type":"text","text":"."}]}]}],"seeAlsoSections":[{"anchor":"Related-Documentation","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/GettingStarted","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockServiceReference"],"title":"Related Documentation"},{"anchor":"How-to-Guides","generated":true,"identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService"],"title":"How-to Guides"}],"abstract":[{"type":"text","text":"Drive "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" from SwiftUI previews and Swift Testing suites without touching Mixpanel’s network."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxmixpanelanalytics\/howtopreviewandtest"]}],"references":{"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics":{"kind":"symbol","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics","type":"topic","title":"SwiduxMixpanelAnalytics","url":"\/documentation\/swiduxmixpanelanalytics","abstract":[{"type":"text","text":"Mixpanel adapter for Swidux’s "},{"code":"AnalyticsPlugin","type":"codeVoice"},{"type":"text","text":". Implements "},{"code":"AnalyticsService","type":"codeVoice"},{"type":"text","text":" against "},{"code":"Mixpanel.mainInstance()","type":"codeVoice"},{"type":"text","text":" and ships a recording mock for previews and tests."}],"role":"collection"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/GettingStarted":{"kind":"article","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/GettingStarted","type":"topic","title":"Getting Started with SwiduxMixpanelAnalytics","url":"\/documentation\/swiduxmixpanelanalytics\/gettingstarted","abstract":[{"text":"Add the package, initialize Mixpanel, register the analytics plugin with ","type":"text"},{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"text":", and start dispatching events.","type":"text"}],"role":"article"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MockServiceReference":{"kind":"article","identifier":"doc:\/\/Swi
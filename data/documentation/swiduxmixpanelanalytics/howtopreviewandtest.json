{"metadata":{"role":"article","roleHeading":"Article","modules":[{"name":"SwiduxMixpanelAnalytics"}],"title":"How to Preview and Test"},"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/GettingStarted","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockServiceReference"],"anchor":"Related-Documentation"},{"title":"How-to Guides","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService"],"anchor":"How-to-Guides","generated":true}],"identifier":{"url":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Drive "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" from SwiftUI previews and Swift Testing suites without touching Mixpanel’s network."}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MixpanelAnalyticsService"},{"type":"text","text":" calls into a real "},{"type":"codeVoice","code":"MixpanelInstance"},{"type":"text","text":". For previews and tests, swap it for "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService"},{"type":"text","text":" — an actor that records every call and exposes its history for assertions. The mock has no Mixpanel dependency and runs offline."}]},{"type":"heading","text":"In a SwiftUI preview","anchor":"In-a-SwiftUI-preview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Inject a mock-backed store and the analytics work flows without spinning up the SDK:"}]},{"type":"codeListing","code":["#Preview {","    let store = AppStore.configured(analyticsService: MockMixpanelAnalyticsService())","    return ContentView().environment(store)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This requires that "},{"type":"codeVoice","code":"AppStore.configured"},{"type":"text","text":" accepts an injected "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":". See Swidux’s "},{"type":"reference","isActive":true,"identifier":"https:\/\/heirloomlogic.github.io\/Swidux\/documentation\/swidux\/howtoaddanalytics"},{"type":"text","text":" guide for the factory pattern."}]},{"type":"heading","text":"In a Swift Testing suite","anchor":"In-a-Swift-Testing-suite","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the mock to verify mapper behavior. Await the plugin’s "},{"type":"codeVoice","code":"flush()"},{"type":"text","text":" to make assertions deterministic:"}]},{"type":"codeListing","code":["import SwiduxMixpanelAnalytics","import Testing","","@Test","func incrementMapsToCounterAdded() async {","    let mock = MockMixpanelAnalyticsService()","    let store = AppStore.configured(analyticsService: mock)","","    store.send(.counter(.increment(5)))","    await store.analyticsPlugin.flush()","","    let events = await mock.trackedEvents","    #expect(events.first?.name == \"counter_added\")","    #expect(events.first?.properties[\"amount\"] == .int(5))","}"],"syntax":"swift"},{"type":"heading","text":"Asserting on identify and alias","anchor":"Asserting-on-identify-and-alias","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The mock records identify and alias calls in order:"}]},{"type":"codeListing","code":["@Test","func userSignInIdentifies() async {","    let mock = MockMixpanelAnalyticsService()","    let store = AppStore.configured(analyticsService: mock)","","    store.send(.auth(.signIn(userID: \"user-1\")))","    await store.analyticsPlugin.flush()","","    let calls = await mock.identifyCalls","    #expect(calls == [.init(userID: \"user-1\", properties: [\"tier\": .string(\"free\")])])","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MockMixpanelAnalyticsService"},{"type":"text","text":" is an actor, so its accessors are async — wrap them in "},{"type":"codeVoice","code":"await"},{"type":"text","text":"."}]}]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics"]]},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxmixpanelanalytics\/howtopreviewandtest"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/GettingStarted":{"title":"Getting Started with SwiduxMixpanelAnalytics","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/GettingStarted","kind":"article","type":"topic","abstract":[{"type":"text","text":"Add the package, build "},{"type":"codeVoice","code":"MixpanelAnalyticsService"},{"type":"text","text":" with your token, register the analytics plugin, and start dispatching events."}],"url":"\/documentation\/swiduxmixpanelanalytics\/gettingstarted","role":"article"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MockServiceReference":{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockServiceReference","abstract":[{"type":"text","text":"API reference for "},{"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService","isActive":true},{"type":"text","text":" — a recording "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" for SwiftUI previews and Swift Testing suites."}],"url":"\/documentation\/swiduxmixpanelanalytics\/mockservicereference","role":"article","kind":"article","title":"Mock Service Reference","type":"topic"},"https://heirloomlogic.github.io/Swidux/documentation/swidux/howtoaddanalytics":{"type":"link","title":"Add Analytics","titleInlineContent":[{"type":"text","text":"Add Analytics"}],"url":"https:\/\/heirloomlogic.github.io\/Swidux\/documentation\/swidux\/howtoaddanalytics","identifier":"https:\/\/heirloomlogic.github.io\/Swidux\/documentation\/swidux\/howtoaddanalytics"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MockMixpanelAnalyticsService":{"type":"topic","title":"MockMixpanelAnalyticsService","url":"\/documentation\/swiduxmixpanelanalytics\/mockmixpanelanalyticsservice","abstract":[{"type":"text","text":"Recording "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" for previews and Swift Testing suites."}],"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService","navigatorTitle":[{"kind":"identifier","text":"MockMixpanelAnalyticsService"}],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"MockMixpanelAnalyticsService"}]},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/HowToImplementService":{"type":"topic","title":"How to Implement the Service","url":"\/documentation\/swiduxmixpanelanalytics\/howtoimplementservice","abstract":[{"type":"text","text":"Configure "},{"type":"codeVoice","code":"MixpanelAnalyticsService"},{"type":"text","text":" to match your privacy, residency, and batching needs — without "},{"type":"codeVoice","code":"import Mixpanel"},{"type":"text","text":" in your app."}],"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","kind":"article","role":"article"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics":{"type":"topic","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics","title":"SwiduxMixpanelAnalytics","url":"\/documentation\/swiduxmixpanelanalytics","abstract":[{"type":"text","text":"Mixpanel adapter for Swidux’s "},{"type":"codeVoice","code":"AnalyticsPlugin"},{"type":"text","text":". Owns the Mixpanel SDK on the app’s behalf — "},{"type":"codeVoice","code":"MixpanelAnalyticsService(token:)"},{"type":"text","text":" calls "},{"type":"codeVoice","code":"Mixpanel.initialize"},{"type":"text","text":" internally so apps never need to "},{"type":"codeVoice","code":"import Mixpanel"},{"type":"text","text":". Ships a recording mock for previews and tests."}],"kind":"symbol","role":"collection"}}}
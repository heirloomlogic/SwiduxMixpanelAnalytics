{"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"title":"How to Preview and Test","roleHeading":"Article","modules":[{"name":"SwiduxMixpanelAnalytics"}],"role":"article"},"seeAlsoSections":[{"anchor":"Related-Documentation","title":"Related Documentation","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/GettingStarted","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockServiceReference"]},{"anchor":"How-to-Guides","title":"How-to Guides","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService"],"generated":true}],"hierarchy":{"paths":[["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics"]]},"abstract":[{"type":"text","text":"Drive "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" from SwiftUI previews and Swift Testing suites without touching Mixpanel’s network."}],"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"type":"text","text":" calls into a real "},{"code":"MixpanelInstance","type":"codeVoice"},{"type":"text","text":". For previews and tests, swap it for "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService"},{"type":"text","text":" — an actor that records every call and exposes its history for assertions. The mock has no Mixpanel dependency and runs offline."}]},{"type":"heading","text":"In a SwiftUI preview","level":2,"anchor":"In-a-SwiftUI-preview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Inject a mock-backed store and the analytics work flows without spinning up the SDK:"}]},{"type":"codeListing","code":["#Preview {","    let store = AppStore.configured(analyticsService: MockMixpanelAnalyticsService())","    return ContentView().environment(store)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This requires that "},{"code":"AppStore.configured","type":"codeVoice"},{"type":"text","text":" accepts an injected "},{"code":"AnalyticsService","type":"codeVoice"},{"type":"text","text":". See Swidux’s "},{"type":"reference","isActive":true,"identifier":"https:\/\/heirloomlogic.github.io\/Swidux\/documentation\/swidux\/howtoaddanalytics"},{"type":"text","text":" guide for the factory pattern."}]},{"type":"heading","text":"In a Swift Testing suite","level":2,"anchor":"In-a-Swift-Testing-suite"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the mock to verify mapper behavior. Await the plugin’s "},{"code":"flush()","type":"codeVoice"},{"type":"text","text":" to make assertions deterministic:"}]},{"type":"codeListing","code":["import SwiduxMixpanelAnalytics","import Testing","","@Test","func incrementMapsToCounterAdded() async {","    let mock = MockMixpanelAnalyticsService()","    let store = AppStore.configured(analyticsService: mock)","","    store.send(.counter(.increment(5)))","    await store.analyticsPlugin.flush()","","    let events = await mock.trackedEvents","    #expect(events.first?.name == \"counter_added\")","    #expect(events.first?.properties[\"amount\"] == .int(5))","}"],"syntax":"swift"},{"type":"heading","text":"Asserting on identify and alias","level":2,"anchor":"Asserting-on-identify-and-alias"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The mock records identify and alias calls in order:"}]},{"type":"codeListing","code":["@Test","func userSignInIdentifies() async {","    let mock = MockMixpanelAnalyticsService()","    let store = AppStore.configured(analyticsService: mock)","","    store.send(.auth(.signIn(userID: \"user-1\")))","    await store.analyticsPlugin.flush()","","    let calls = await mock.identifyCalls","    #expect(calls == [.init(userID: \"user-1\", properties: [\"tier\": .string(\"free\")])])","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"MockMixpanelAnalyticsService","type":"codeVoice"},{"type":"text","text":" is an actor, so its accessors are async — wrap them in "},{"code":"await","type":"codeVoice"},{"type":"text","text":"."}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest"},"variants":[{"paths":["\/documentation\/swiduxmixpanelanalytics\/howtopreviewandtest"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"kind":"article","references":{"https://heirloomlogic.github.io/Swidux/documentation/swidux/howtoaddanalytics":{"identifier":"https:\/\/heirloomlogic.github.io\/Swidux\/documentation\/swidux\/howtoaddanalytics","title":"Add Analytics","titleInlineContent":[{"type":"text","text":"Add Analytics"}],"url":"https:\/\/heirloomlogic.github.io\/Swidux\/documentation\/swidux\/howtoaddanalytics","type":"link"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/GettingStarted":{"title":"Getting Started with SwiduxMixpanelAnalytics","role":"article","abstract":[{"type":"text","text":"Add the package, build "},{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"text":" with your token, register the analytics plugin, and start dispatching events.","type":"text"}],"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/GettingStarted","type":"topic","url":"\/documentation\/swiduxmixpanelanalytics\/gettingstarted","kind":"article"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/HowToImplementService":{"kind":"article","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","title":"How to Implement the Service","abstract":[{"text":"Configure ","type":"text"},{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"text":" to match your privacy, residency, and batching needs — without ","type":"text"},{"code":"import Mixpanel","type":"codeVoice"},{"text":" in your app.","type":"text"}],"type":"topic","url":"\/documentation\/swiduxmixpanelanalytics\/howtoimplementservice","role":"article"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MockMixpanelAnalyticsService":{"abstract":[{"type":"text","text":"Recording "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" for previews and Swift Testing suites."}],"fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MockMixpanelAnalyticsService","kind":"identifier"}],"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService","title":"MockMixpanelAnalyticsService","role":"symbol","url":"\/documentation\/swiduxmixpanelanalytics\/mockmixpanelanalyticsservice","navigatorTitle":[{"text":"MockMixpanelAnalyticsService","kind":"identifier"}],"kind":"symbol","type":"topic"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics":{"title":"SwiduxMixpanelAnalytics","role":"collection","abstract":[{"type":"text","text":"Mixpanel adapter for Swidux’s "},{"code":"AnalyticsPlugin","type":"codeVoice"},{"type":"text","text":". Owns the Mixpanel SDK on the app’s behalf — "},{"code":"MixpanelAnalyticsService(token:)","type":"codeVoice"},{"type":"text","text":" calls "},{"code":"Mixpanel.initialize","type":"codeVoice"},{"type":"text","text":" internally so apps never need to "},{"code":"import Mixpanel","type":"codeVoice"},{"text":". Ships a recording mock for previews and tests.","type":"text"}],"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics","type":"topic","url":"\/documentation\/swiduxmixpanelanalytics","kind":"symbol"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MockServiceReference":{"title":"Mock Service Reference","role":"article","abstract":[{"type":"text","text":"API reference for "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService"},{"type":"text","text":" — a recording "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" for SwiftUI previews and Swift Testing suites."}],"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockServiceReference","type":"topic","url":"\/documentation\/swiduxmixpanelanalytics\/mockservicereference","kind":"article"}}}
{"abstract":[{"type":"text","text":"Drive "},{"code":"AnalyticsService","type":"codeVoice"},{"type":"text","text":" from SwiftUI previews and Swift Testing suites without touching Mixpanel’s network."}],"hierarchy":{"paths":[["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest"},"seeAlsoSections":[{"title":"Related Documentation","anchor":"Related-Documentation","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/GettingStarted","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockServiceReference"]},{"title":"How-to Guides","anchor":"How-to-Guides","generated":true,"identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService"]}],"sections":[],"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"text":" calls into a real ","type":"text"},{"type":"codeVoice","code":"MixpanelInstance"},{"type":"text","text":". For previews and tests, swap it for "},{"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService","isActive":true},{"type":"text","text":" — an actor that records every call and exposes its history for assertions. The mock has no Mixpanel dependency and runs offline."}]},{"type":"heading","anchor":"In-a-SwiftUI-preview","text":"In a SwiftUI preview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Inject a mock-backed store and the analytics work flows without spinning up the SDK:"}]},{"code":["#Preview {","    let store = AppStore.configured(analyticsService: MockMixpanelAnalyticsService())","    return ContentView().environment(store)","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"This requires that ","type":"text"},{"code":"AppStore.configured","type":"codeVoice"},{"text":" accepts an injected ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"type":"text","text":". See Swidux’s "},{"identifier":"https:\/\/heirloomlogic.github.io\/Swidux\/documentation\/swidux\/howtoaddanalytics","isActive":true,"type":"reference"},{"text":" guide for the factory pattern.","type":"text"}],"type":"paragraph"},{"anchor":"In-a-Swift-Testing-suite","level":2,"type":"heading","text":"In a Swift Testing suite"},{"inlineContent":[{"type":"text","text":"Use the mock to verify mapper behavior. Await the plugin’s "},{"type":"codeVoice","code":"flush()"},{"type":"text","text":" to make assertions deterministic:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import SwiduxMixpanelAnalytics","import Testing","","@Test","func incrementMapsToCounterAdded() async {","    let mock = MockMixpanelAnalyticsService()","    let store = AppStore.configured(analyticsService: mock)","","    store.send(.counter(.increment(5)))","    await store.analyticsPlugin.flush()","","    let events = await mock.trackedEvents","    #expect(events.first?.name == \"counter_added\")","    #expect(events.first?.properties[\"amount\"] == .int(5))","}"]},{"level":2,"text":"Asserting on identify and alias","anchor":"Asserting-on-identify-and-alias","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The mock records identify and alias calls in order:"}]},{"code":["@Test","func userSignInIdentifies() async {","    let mock = MockMixpanelAnalyticsService()","    let store = AppStore.configured(analyticsService: mock)","","    store.send(.auth(.signIn(userID: \"user-1\")))","    await store.analyticsPlugin.flush()","","    let calls = await mock.identifyCalls","    #expect(calls == [.init(userID: \"user-1\", properties: [\"tier\": .string(\"free\")])])","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"code":"MockMixpanelAnalyticsService","type":"codeVoice"},{"type":"text","text":" is an actor, so its accessors are async — wrap them in "},{"code":"await","type":"codeVoice"},{"text":".","type":"text"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxmixpanelanalytics\/howtopreviewandtest"]}],"kind":"article","metadata":{"modules":[{"name":"SwiduxMixpanelAnalytics"}],"role":"article","roleHeading":"Article","title":"How to Preview and Test"},"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/HowToImplementService":{"role":"article","kind":"article","title":"How to Implement the Service","type":"topic","url":"\/documentation\/swiduxmixpanelanalytics\/howtoimplementservice","abstract":[{"type":"text","text":"Configure "},{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"text":" to match your privacy, residency, and batching needs — without ","type":"text"},{"code":"import Mixpanel","type":"codeVoice"},{"text":" in your app.","type":"text"}],"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MockServiceReference":{"kind":"article","abstract":[{"type":"text","text":"API reference for "},{"isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService","type":"reference"},{"text":" — a recording ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" for SwiftUI previews and Swift Testing suites.","type":"text"}],"role":"article","title":"Mock Service Reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockServiceReference","url":"\/documentation\/swiduxmixpanelanalytics\/mockservicereference","type":"topic"},"https:
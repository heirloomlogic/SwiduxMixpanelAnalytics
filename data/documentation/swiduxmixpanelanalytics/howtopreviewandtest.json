{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxmixpanelanalytics\/howtopreviewandtest"]}],"sections":[],"identifier":{"url":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest","interfaceLanguage":"swift"},"seeAlsoSections":[{"identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/GettingStarted","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockServiceReference"],"title":"Related Documentation","anchor":"Related-Documentation"},{"identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService"],"generated":true,"title":"How-to Guides","anchor":"How-to-Guides"}],"abstract":[{"text":"Drive ","type":"text"},{"type":"codeVoice","code":"AnalyticsService"},{"text":" from SwiftUI previews and Swift Testing suites without touching Mixpanel’s network.","type":"text"}],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"type":"codeVoice","code":"MixpanelAnalyticsService"},{"type":"text","text":" calls into a real "},{"type":"codeVoice","code":"MixpanelInstance"},{"type":"text","text":". For previews and tests, swap it for "},{"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService","isActive":true},{"type":"text","text":" — an actor that records every call and exposes its history for assertions. The mock has no Mixpanel dependency and runs offline."}],"type":"paragraph"},{"level":2,"text":"In a SwiftUI preview","type":"heading","anchor":"In-a-SwiftUI-preview"},{"inlineContent":[{"type":"text","text":"Inject a mock-backed store and the analytics work flows without spinning up the SDK:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["#Preview {","    let store = AppStore.configured(analyticsService: MockMixpanelAnalyticsService())","    return ContentView().environment(store)","}"]},{"inlineContent":[{"type":"text","text":"This requires that "},{"type":"codeVoice","code":"AppStore.configured"},{"type":"text","text":" accepts an injected "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":". See Swidux’s "},{"type":"reference","identifier":"https:\/\/heirloomlogic.github.io\/Swidux\/documentation\/swidux\/howtoaddanalytics","isActive":true},{"type":"text","text":" guide for the factory pattern."}],"type":"paragraph"},{"level":2,"anchor":"In-a-Swift-Testing-suite","type":"heading","text":"In a Swift Testing suite"},{"type":"paragraph","inlineContent":[{"text":"Use the mock to verify mapper behavior. Await the plugin’s ","type":"text"},{"type":"codeVoice","code":"flush()"},{"text":" to make assertions deterministic:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import SwiduxMixpanelAnalytics","import Testing","","@Test","func incrementMapsToCounterAdded() async {","    let mock = MockMixpanelAnalyticsService()","    let store = AppStore.configured(analyticsService: mock)","","    store.send(.counter(.increment(5)))","    await store.analyticsPlugin.flush()","","    let events = await mock.trackedEvents","    #expect(events.first?.name == \"counter_added\")","    #expect(events.first?.properties[\"amount\"] == .int(5))","}"]},{"level":2,"anchor":"Asserting-on-identify-and-alias","type":"heading","text":"Asserting on identify and alias"},{"type":"paragraph","inlineContent":[{"text":"The mock records identify and alias calls in order:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["@Test","func userSignInIdentifies() async {","    let mock = MockMixpanelAnalyticsService()","    let store = AppStore.configured(analyticsService: mock)","","    store.send(.auth(.signIn(userID: \"user-1\")))","    await store.analyticsPlugin.flush()","","    let calls = await mock.identifyCalls","    #expect(calls == [.init(userID: \"user-1\", properties: [\"tier\": .string(\"free\")])])","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MockMixpanelAnalyticsService"},{"type":"text","text":" is an actor, so its accessors are async — wrap them in "},{"type":"codeVoice","code":"await"},{"type":"text","text":"."}]}],"kind":"content"}],"metadata":{"modules":[{"name":"SwiduxMixpanelAnalytics"}],"title":"How to Preview and Test","roleHeading":"Article","role":"article"},"kind":"article","schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics"]]},"references":{"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/GettingStarted":{"title":"Getting Started with SwiduxMixpanelAnalytics","abstract":[{"type":"text","text":"Add the package, build "},{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"type":"text","text":" with your token, register the analytics plugin, and start dispatching events."}],"type":"topic","role":"article","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/GettingStarted","url":"\/documentation\/swiduxmixpanelanalytics\/gettingstarted","kind":"article"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MockMixpanelAnalyticsService":{"fragments":[{"kind":"keyword","text":"actor"},{"text":" ","kind":"text"},{"kind":"identifier","text":"MockMixpanelAnalyticsService"}],"navigatorTitle":[{"kind":"identifier","text":"MockMixpanelAnalyticsService"}],"title":"MockMixpanelAnalyticsService","url":"\/documentation\/swiduxmixpanelanalytics\/mockmixpanelanalyticsservice","type":"topic","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService","abstract":[{"text":"Recording ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" for previews and Swift Testing suites.","type":"text"}],"role":"symbol","kind":"symbol"},"doc://SwiduxMixpanelAnalytics/document
{"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxmixpanelanalytics\/howtopreviewandtest"]}],"kind":"article","metadata":{"role":"article","modules":[{"name":"SwiduxMixpanelAnalytics"}],"title":"How to Preview and Test","roleHeading":"Article"},"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest"},"abstract":[{"text":"Drive ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" from SwiftUI previews and Swift Testing suites without touching Mixpanel’s network.","type":"text"}],"seeAlsoSections":[{"identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/GettingStarted","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockServiceReference"],"title":"Related Documentation","anchor":"Related-Documentation"},{"generated":true,"identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService"],"title":"How-to Guides","anchor":"How-to-Guides"}],"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"type":"text","text":" calls into a real "},{"code":"MixpanelInstance","type":"codeVoice"},{"type":"text","text":". For previews and tests, swap it for "},{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService","type":"reference","isActive":true},{"type":"text","text":" — an actor that records every call and exposes its history for assertions. The mock has no Mixpanel dependency and runs offline."}],"type":"paragraph"},{"level":2,"anchor":"In-a-SwiftUI-preview","text":"In a SwiftUI preview","type":"heading"},{"inlineContent":[{"type":"text","text":"Inject a mock-backed store and the analytics work flows without spinning up the SDK:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["#Preview {","    let store = AppStore.configured(analyticsService: MockMixpanelAnalyticsService())","    return ContentView().environment(store)","}"]},{"inlineContent":[{"type":"text","text":"This requires that "},{"code":"AppStore.configured","type":"codeVoice"},{"type":"text","text":" accepts an injected "},{"code":"AnalyticsService","type":"codeVoice"},{"type":"text","text":". See Swidux’s "},{"identifier":"https:\/\/heirloomlogic.github.io\/Swidux\/documentation\/swidux\/howtoaddanalytics","type":"reference","isActive":true},{"type":"text","text":" guide for the factory pattern."}],"type":"paragraph"},{"level":2,"anchor":"In-a-Swift-Testing-suite","text":"In a Swift Testing suite","type":"heading"},{"inlineContent":[{"type":"text","text":"Use the mock to verify mapper behavior. Await the plugin’s "},{"code":"flush()","type":"codeVoice"},{"type":"text","text":" to make assertions deterministic:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import SwiduxMixpanelAnalytics","import Testing","","@Test","func incrementMapsToCounterAdded() async {","    let mock = MockMixpanelAnalyticsService()","    let store = AppStore.configured(analyticsService: mock)","","    store.send(.counter(.increment(5)))","    await store.analyticsPlugin.flush()","","    let events = await mock.trackedEvents","    #expect(events.first?.name == \"counter_added\")","    #expect(events.first?.properties[\"amount\"] == .int(5))","}"]},{"level":2,"anchor":"Asserting-on-identify-and-alias","text":"Asserting on identify and alias","type":"heading"},{"inlineContent":[{"type":"text","text":"The mock records identify and alias calls in order:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["@Test","func userSignInIdentifies() async {","    let mock = MockMixpanelAnalyticsService()","    let store = AppStore.configured(analyticsService: mock)","","    store.send(.auth(.signIn(userID: \"user-1\")))","    await store.analyticsPlugin.flush()","","    let calls = await mock.identifyCalls","    #expect(calls == [.init(userID: \"user-1\", properties: [\"tier\": .string(\"free\")])])","}"]},{"inlineContent":[{"type":"codeVoice","code":"MockMixpanelAnalyticsService"},{"type":"text","text":" is an actor, so its accessors are async — wrap them in "},{"type":"codeVoice","code":"await"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MockMixpanelAnalyticsService":{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService","title":"MockMixpanelAnalyticsService","type":"topic","role":"symbol","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MockMixpanelAnalyticsService","kind":"identifier"}],"navigatorTitle":[{"text":"MockMixpanelAnalyticsService","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"Recording ","type":"text"},{"type":"codeVoice","code":"AnalyticsService"},{"text":" for previews and Swift Testing suites.","type":"text"}],"url":"\/documentation\/swiduxmixpanelanalytics\/mockmixpanelanalyticsservice"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics":{"abstract":[{"text":"Mixpanel adapter for Swidux’s ","type":"text"},{"code":"AnalyticsPlugin","type":"codeVoice"},{"text":". Owns the Mixpanel SDK on the app’s behalf — ","type":"text"},{"code":"MixpanelAnalyticsService(token:)","type":"codeVoice"},{"text":" calls ","type":"text"},{"code":"Mixpanel.initialize","type":"codeVoice"},{"text":" internally so apps never need to ","type":"text"},{"code":"import Mixpanel","type":"codeVoice"},{"text":". Ships a recording mock for previews and tests.","type":"text"}],"url":"\/documentation\/swiduxmixpanelanalytics","type":"topic","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics","title":"SwiduxMixpanelAnalytics","role":"collection","kind":"symbol"},"https://heirloomlogic.github.io/Swidux/documentation/swidux/howtoaddanalytics":{"title":"Add Analytics","identifier":"https:\/\/heirloomlogic.github.io\/Swidux\/documentation\/swidux\/howtoaddanalytics","titleInlineContent":[{"type":"text","text":"Add Analytics"}],"type":"link","url":"https:\/\/heirloomlogic.github.io\/Swidux\/documentation\/swidux\/howtoaddanalytics"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/GettingStarted":{"title":"Getting Started with SwiduxMixpanelAnalytics","role":"article","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/GettingStarted","url":"\/documentation\/swiduxmixpanelanalytics\/gettingstarted","abstract":[{"text":"Add the package, build ","type":"text"},{"type":"codeVoice","code":"MixpanelAnalyticsService"},{"text":" with your token, register the analytics plugin, and start dispatching events.","type":"text"}],"type":"topic","kind":"article"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/HowToImplementService":{"type":"topic","kind":"article","title":"How to Implement the Service","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","url":"\/documentation\/swiduxmixpanelanalytics\/howtoimplementservice","abstract":[{"text":"Configure ","type":"text"},{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"text":" to match your privacy, residency, and batching needs — without ","type":"text"},{"code":"import Mixpanel","type":"codeVoice"},{"text":" in your app.","type":"text"}],"role":"article"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MockServiceReference":{"kind":"article","type":"topic","title":"Mock Service Reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockServiceReference","url":"\/documentation\/swiduxmixpanelanalytics\/mockservicereference","abstract":[{"text":"API reference for ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService","type":"reference"},{"text":" — a recording ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" for SwiftUI previews and Swift Testing suites.","type":"text"}],"role":"article"}}}
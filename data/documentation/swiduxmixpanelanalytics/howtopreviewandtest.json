{"abstract":[{"text":"Drive ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" from SwiftUI previews and Swift Testing suites without touching Mixpanel’s network.","type":"text"}],"sections":[],"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"MixpanelAnalyticsService"},{"type":"text","text":" calls into a real "},{"type":"codeVoice","code":"MixpanelInstance"},{"type":"text","text":". For previews and tests, swap it for "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService"},{"type":"text","text":" — an actor that records every call and exposes its history for assertions. The mock has no Mixpanel dependency and runs offline."}],"type":"paragraph"},{"text":"In a SwiftUI preview","anchor":"In-a-SwiftUI-preview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Inject a mock-backed store and the analytics work flows without spinning up the SDK:"}],"type":"paragraph"},{"code":["#Preview {","    let store = AppStore.configured(analyticsService: MockMixpanelAnalyticsService())","    return ContentView().environment(store)","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"This requires that "},{"type":"codeVoice","code":"AppStore.configured"},{"type":"text","text":" accepts an injected "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":". See Swidux’s "},{"type":"reference","isActive":true,"identifier":"https:\/\/heirloomlogic.github.io\/Swidux\/documentation\/swidux\/howtoaddanalytics"},{"type":"text","text":" guide for the factory pattern."}],"type":"paragraph"},{"text":"In a Swift Testing suite","anchor":"In-a-Swift-Testing-suite","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Use the mock to verify mapper behavior. Await the plugin’s "},{"type":"codeVoice","code":"flush()"},{"type":"text","text":" to make assertions deterministic:"}],"type":"paragraph"},{"code":["import SwiduxMixpanelAnalytics","import Testing","","@Test","func incrementMapsToCounterAdded() async {","    let mock = MockMixpanelAnalyticsService()","    let store = AppStore.configured(analyticsService: mock)","","    store.send(.counter(.increment(5)))","    await store.analyticsPlugin.flush()","","    let events = await mock.trackedEvents","    #expect(events.first?.name == \"counter_added\")","    #expect(events.first?.properties[\"amount\"] == .int(5))","}"],"type":"codeListing","syntax":"swift"},{"text":"Asserting on identify and alias","anchor":"Asserting-on-identify-and-alias","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The mock records identify and alias calls in order:"}],"type":"paragraph"},{"code":["@Test","func userSignInIdentifies() async {","    let mock = MockMixpanelAnalyticsService()","    let store = AppStore.configured(analyticsService: mock)","","    store.send(.auth(.signIn(userID: \"user-1\")))","    await store.analyticsPlugin.flush()","","    let calls = await mock.identifyCalls","    #expect(calls == [.init(userID: \"user-1\", properties: [\"tier\": .string(\"free\")])])","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"codeVoice","code":"MockMixpanelAnalyticsService"},{"type":"text","text":" is an actor, so its accessors are async — wrap them in "},{"type":"codeVoice","code":"await"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest"},"seeAlsoSections":[{"anchor":"Related-Documentation","title":"Related Documentation","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/GettingStarted","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockServiceReference"]},{"generated":true,"anchor":"How-to-Guides","title":"How-to Guides","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxmixpanelanalytics\/howtopreviewandtest"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics"]]},"metadata":{"roleHeading":"Article","title":"How to Preview and Test","modules":[{"name":"SwiduxMixpanelAnalytics"}],"role":"article"},"kind":"article","references":{"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/HowToImplementService":{"type":"topic","abstract":[{"text":"Configure ","type":"text"},{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"text":" to match your privacy, residency, and batching needs — without ","type":"text"},{"code":"import Mixpanel","type":"codeVoice"},{"text":" in your app.","type":"text"}],"role":"article","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","title":"How to Implement the Service","url":"\/documentation\/swiduxmixpanelanalytics\/howtoimplementservice","kind":"article"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/GettingStarted":{"type":"topic","abstract":[{"text":"Add the package, build ","type":"text"},{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"type":"text","text":" with your token, register the analytics plugin, and start dispatching events."}],"role":"article","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/GettingStarted","title":"Getting Started with SwiduxMixpanelAnalytics","url":"\/documentation\/swiduxmixpanelanalytics\/gettingstarted","kind":"article"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MockServiceReference":{"type":"topic","abstract":[{"type":"text","text":"API reference for "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService"},{"type":"text","text":" — a recording "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" for SwiftUI previews and Swift Testing suites."}],"role":"article","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockServiceReference","title":"Mock Service Reference","url":"\/documentation\/swiduxmixpanelanalytics\/mockservicereference","kind":"article"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MockMixpanelAnalyticsService":{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"MockMixpanelAnalyticsService"}],"kind":"symbol","abstract":[{"text":"Recording ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" for previews and Swift Testing suites.","type":"text"}],"url":"\/documentation\/swiduxmixpanelanalytics\/mockmixpanelanalyticsservice","role":"symbol","title":"MockMixpanelAnalyticsService","navigatorTitle":[{"kind":"identifier","text":"MockMixpanelAnalyticsService"}],"type":"topic"},"https://heirloomlogic.github.io/Swidux/documentation/swidux/howtoaddanalytics":{"titleInlineContent":[{"type":"text","text":"Add Analytics"}],"identifier":"https:\/\/heirloomlogic.github.io\/Swidux\/documentation\/swidux\/howtoaddanalytics","title":"Add Analytics","type":"link","url":"https:\/\/heirloomlogic.github.io\/Swidux\/documentation\/swidux\/howtoaddanalytics"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics":{"kind":"symbol","role":"collection","title":"SwiduxMixpanelAnalytics","abstract":[{"text":"Mixpanel adapter for Swidux’s ","type":"text"},{"code":"AnalyticsPlugin","type":"codeVoice"},{"text":". Owns the Mixpanel SDK on the app’s behalf — ","type":"text"},{"code":"MixpanelAnalyticsService(token:)","type":"codeVoice"},{"text":" calls ","type":"text"},{"type":"codeVoice","code":"Mixpanel.initialize"},{"type":"text","text":" internally so apps never need to "},{"type":"codeVoice","code":"import Mixpanel"},{"type":"text","text":". Ships a recording mock for previews and tests."}],"url":"\/documentation\/swiduxmixpanelanalytics","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics","type":"topic"}}}
{"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MixpanelAnalyticsService"},{"text":" calls into a real ","type":"text"},{"type":"codeVoice","code":"MixpanelInstance"},{"text":". For previews and tests, swap it for ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService"},{"text":" — an actor that records every call and exposes its history for assertions. The mock has no Mixpanel dependency and runs offline.","type":"text"}]},{"type":"heading","level":2,"anchor":"In-a-SwiftUI-preview","text":"In a SwiftUI preview"},{"type":"paragraph","inlineContent":[{"text":"Inject a mock-backed store and the analytics work flows without spinning up the SDK:","type":"text"}]},{"type":"codeListing","code":["#Preview {","    let store = AppStore.configured(analyticsService: MockMixpanelAnalyticsService())","    return ContentView().environment(store)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"This requires that ","type":"text"},{"type":"codeVoice","code":"AppStore.configured"},{"text":" accepts an injected ","type":"text"},{"type":"codeVoice","code":"AnalyticsService"},{"text":". See Swidux’s ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/heirloomlogic.github.io\/Swidux\/documentation\/swidux\/howtoaddanalytics"},{"text":" guide for the factory pattern.","type":"text"}]},{"type":"heading","level":2,"anchor":"In-a-Swift-Testing-suite","text":"In a Swift Testing suite"},{"type":"paragraph","inlineContent":[{"text":"Use the mock to verify mapper behavior. Await the plugin’s ","type":"text"},{"type":"codeVoice","code":"flush()"},{"text":" to make assertions deterministic:","type":"text"}]},{"type":"codeListing","code":["import SwiduxMixpanelAnalytics","
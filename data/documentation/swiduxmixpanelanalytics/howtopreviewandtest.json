{"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest"},"abstract":[{"type":"text","text":"Drive "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" from SwiftUI previews and Swift Testing suites without touching Mixpanel’s network."}],"metadata":{"title":"How to Preview and Test","role":"article","modules":[{"name":"SwiduxMixpanelAnalytics"}],"roleHeading":"Article"},"kind":"article","schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MixpanelAnalyticsService"},{"text":" calls into a real ","type":"text"},{"type":"codeVoice","code":"MixpanelInstance"},{"text":". For previews and tests, swap it for ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService"},{"text":" — an actor that records every call and exposes its history for assertions. The mock has no Mixpanel dependency and runs offline.","type":"text"}]},{"type":"heading","text":"In a SwiftUI preview","level":2,"anchor":"In-a-SwiftUI-preview"},{"inlineContent":[{"type":"text","text":"Inject a mock-backed store and the analytics work flows without spinning up the SDK:"}],"type":"paragraph"},{"type":"codeListing","code":["#Preview {","    let store = AppStore.configured(analyticsService: MockMixpanelAnalyticsService())","    return ContentView().environment(store)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This requires that "},{"type":"codeVoice","code":"AppStore.configured"},{"text":" accepts an injected ","type":"text"},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":". See Swidux’s "},{"isActive":true,"type":"reference","identifier":"https:\/\/heirloomlogic.github.io\/Swidux\/documentation\/swidux\/howtoaddanalytics"},{"text":" guide for the factory pattern.","type":"text"}]},{"level":2,"text":"In a Swift Testing suite","type":"heading","anchor":"In-a-Swift-Testing-suite"},{"inlineContent":[{"type":"text","text":"Use the mock to verify mapper behavior. Await the plugin’s "},{"type":"codeVoice","code":"flush()"},{"text":" to make assertions deterministic:","type":"text"}],"type":"paragraph"},{"code":["import SwiduxMixpanelAnalytics","import Testing","","@Test","func incrementMapsToCounterAdded() async {","    let mock = MockMixpanelAnalyticsService()","    let store = AppStore.configured(analyticsService: mock)","","    store.send(.counter(.increment(5)))","    await store.analyticsPlugin.flush()","","    let events = await mock.trackedEvents","    #expect(events.first?.name == \"counter_added\")","    #expect(events.first?.properties[\"amount\"] == .int(5))","}"],"syntax":"swift","type":"codeListing"},{"text":"Asserting on identify and alias","type":"heading","level":2,"anchor":"Asserting-on-identify-and-alias"},{"inlineContent":[{"text":"The mock records identify and alias calls in order:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["@Test","func userSignInIdentifies() async {","    let mock = MockMixpanelAnalyticsService()","    let store = AppStore.configured(analyticsService: mock)","","    store.send(.auth(.signIn(userID: \"user-1\")))","    await store.analyticsPlugin.flush()","","    let calls = await mock.identifyCalls","    #expect(calls == [.init(userID: \"user-1\", properties: [\"tier\": .string(\"free\")])])","}"]},{"type":"paragraph","inlineContent":[{"code":"MockMixpanelAnalyticsService","type":"codeVoice"},{"text":" is an actor, so its accessors are async — wrap them in ","type":"text"},{"code":"await","type":"codeVoice"},{"text":".","type":"text"}]}]}],"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/GettingStarted","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockServiceReference"],"anchor":"Related-Documentation"},{"generated":true,"title":"How-to Guides","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService"],"anchor":"How-to-Guides"}],"hierarchy":{"paths":[["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics"]]},"variants":[{"paths":["\/documentation\/swiduxmixpanelanalytics\/howtopreviewandtest"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MockServiceReference":{"role":"article","title":"Mock Service Reference","type":"topic","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockServiceReference","abstract":[{"type":"text","text":"API reference for "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService"},{"type":"text","text":" — a recording "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" for SwiftUI previews and Swift Testing suites."}],"url":"\/documentation\/swiduxmixpanelanalytics\/mockservicereference","kind":"article"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/GettingStarted":{"role":"article","title":"Getting Started with SwiduxMixpanelAnalytics","type":"topic","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/GettingStarted","abstract":[{"text":"Add the package, build ","type":"text"},{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"text":" with your token, register the analytics plugin, and start dispatching events.","type":"text"}],"url":"\/documentation\/swiduxmixpanelanalytics\/gettingstarted","kind":"article"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/HowToImplementService":{"role":"article","title":"How to Implement the Service","type":"topic","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","abstract":[{"type":"text","text":"Configure "},{"type":"codeVoice","code":"MixpanelAnalyticsService"},{"type":"text","text":" to match your privacy, residency, and batching needs — without "},{"type":"codeVoice","code":"import Mixpanel"},{"type":"text","text":" in your app."}],"url":"\/documentation\/swiduxmixpanelanalytics\/howtoimplementservice","kind":"article"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics":{"role":"collection","abstract":[{"type":"text","text":"Mixpanel adapter for Swidux’s "},{"type":"codeVoice","code":"AnalyticsPlugin"},{"type":"text","text":". Owns the Mixpanel SDK on the app’s behalf — "},{"type":"codeVoice","code":"MixpanelAnalyticsService(token:)"},{"type":"text","text":" calls "},{"type":"codeVoice","code":"Mixpanel.initialize"},{"type":"text","text":" internally so apps never need to "},{"type":"codeVoice","code":"import Mixpanel"},{"type":"text","text":". Ships a recording mock for previews and tests."}],"title":"SwiduxMixpanelAnalytics","kind":"symbol","type":"topic","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics","url":"\/documentation\/swiduxmixpanelanalytics"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MockMixpanelAnalyticsService":{"role":"symbol","title":"MockMixpanelAnalyticsService","type":"topic","fragments":[{"kind":"keyword","text":"actor"},{"text":" ","kind":"text"},{"kind":"identifier","text":"MockMixpanelAnalyticsService"}],"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService","abstract":[{"text":"Recording ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" for previews and Swift Testing suites.","type":"text"}],"url":"\/documentation\/swiduxmixpanelanalytics\/mockmixpanelanalyticsservice","kind":"symbol","navigatorTitle":[{"text":"MockMixpanelAnalyticsService","kind":"identifier"}]},"https://heirloomlogic.github.io/Swidux/documentation/swidux/howtoaddanalytics":{"type":"link","title":"Add Analytics","identifier":"https:\/\/heirloomlogic.github.io\/Swidux\/documentation\/swidux\/howtoaddanalytics","titleInlineContent":[{"type":"text","text":"Add Analytics"}],"url":"https:\/\/heirloomlogic.github.io\/Swidux\/documentation\/swidux\/howtoaddanalytics"}}}
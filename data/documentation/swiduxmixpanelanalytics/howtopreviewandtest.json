{"kind":"article","primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"text":" calls into a real ","type":"text"},{"code":"MixpanelInstance","type":"codeVoice"},{"text":". For previews and tests, swap it for ","type":"text"},{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService","isActive":true,"type":"reference"},{"text":" — an actor that records every call and exposes its history for assertions. The mock has no Mixpanel dependency and runs offline.","type":"text"}],"type":"paragraph"},{"text":"In a SwiftUI preview","anchor":"In-a-SwiftUI-preview","type":"heading","level":2},{"inlineContent":[{"text":"Inject a mock-backed store and the analytics work flows without spinning up the SDK:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["#Preview {","    let store = AppStore.configured(analyticsService: MockMixpanelAnalyticsService())","    return ContentView().environment(store)","}"]},{"inlineContent":[{"text":"This requires that ","type":"text"},{"code":"AppStore.configured","type":"codeVoice"},{"text":" accepts an injected ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":". See Swidux’s ","type":"text"},{"identifier":"https:\/\/heirloomlogic.github.io\/Swidux\/documentation\/swidux\/howtoaddanalytics","isActive":true,"type":"reference"},{"text":" guide for the factory pattern.","type":"text"}],"type":"paragraph"},{"text":"In a Swift Testing suite","anchor":"In-a-Swift-Testing-suite","type":"heading","level":2},{"inlineContent":[{"text":"Use the mock to verify mapper behavior. Await the plugin’s ","type":"text"},{"code":"flush()","type":"codeVoice"},{"text":" to make assertions deterministic:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import SwiduxMixpanelAnalytics","import Testing","","@Test","func incrementMapsToCounterAdded() async {","    let mock = MockMixpanelAnalyticsService()","    let store = AppStore.configured(analyticsService: mock)","","    store.send(.counter(.increment(5)))","    await store.analyticsPlugin.flush()","","    let events = await mock.trackedEvents","    #expect(events.first?.name == \"counter_added\")","    #expect(events.first?.properties[\"amount\"] == .int(5))","}"]},{"text":"Asserting on identify and alias","anchor":"Asserting-on-identify-and-alias","type":"heading","level":2},{"inlineContent":[{"text":"The mock records identify and alias calls in order:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["@Test","func userSignInIdentifies() async {","    let mock = MockMixpanelAnalyticsService()","    let store = AppStore.configured(analyticsService: mock)","","    store.send(.auth(.signIn(userID: \"user-1\")))","    await store.analyticsPlugin.flush()","","    let calls = await mock.identifyCalls","    #expect(calls == [.init(userID: \"user-1\", properties: [\"tier\": .string(\"free\")])])","}"]},{"inlineContent":[{"code":"MockMixpanelAnalyticsService","type":"codeVoice"},{"text":" is an actor, so its accessors are async — wrap them in ","type":"text"},{"code":"await","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxmixpanelanalytics\/howtopreviewandtest"]}],"hierarchy":{"paths":[["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics"]]},"metadata":{"roleHeading":"Article","title":"How to Preview and Test","modules":[{"name":"SwiduxMixpanelAnalytics"}],"role":"article"},"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"Drive "},{"code":"AnalyticsService","type":"codeVoice"},{"type":"text","text":" from SwiftUI previews and Swift Testing suites without touching Mixpanel’s network."}],"seeAlsoSections":[{"anchor":"Related-Documentation","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/GettingStarted","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockServiceReference"],"title":"Related Documentation"},{"generated":true,"anchor":"How-to-Guides","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService"],"title":"How-to Guides"}],"identifier":{"url":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToPreviewAndTest","interfaceLanguage":"swift"},"references":{"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics":{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics","role":"collection","type":"topic","title":"SwiduxMixpanelAnalytics","url":"\/documentation\/swiduxmixpanelanalytics","abstract":[{"type":"text","text":"Mixpanel adapter for Swidux’s "},{"type":"codeVoice","code":"AnalyticsPlugin"},{"text":". Owns the Mixpanel SDK on the app’s behalf — ","type":"text"},{"type":"codeVoice","code":"MixpanelAnalyticsService(token:)"},{"type":"text","text":" calls "},{"type":"codeVoice","code":"Mixpanel.initialize"},{"text":" internally so apps never need to ","type":"text"},{"type":"codeVoice","code":"import Mixpanel"},{"text":". Ships a recording mock for previews and tests.","type":"text"}],"kind":"symbol"},"https://heirloomlogic.github.io/Swidux/documentation/swidux/howtoaddanalytics":{"url":"https:\/\/heirloomlogic.github.io\/Swidux\/documentation\/swidux\/howtoaddanalytics","type":"link","identifier":"https:\/\/heirloomlogic.github.io\/Swidux\/documentation\/swidux\/howtoaddanalytics","title":"Add Analytics","titleInlineContent":[{"text":"Add Analytics","type":"text"}]},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/GettingStarted":{"kind":"article","title":"Getting Started with SwiduxMixpanelAnalytics","type":"topic","abstract":[{"type":"text","text":"Add the package, build "},{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"type":"text","text":" with your token, register the analytics plugin, and start dispatching events."}],"role":"article","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/GettingStarted","url":"\/documentation\/swiduxmixpanelanalytics\/gettingstarted"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/HowToImplementService":{"url":"\/documentation\/swiduxmixpanelanalytics\/howtoimplementservice","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","type":"topic","kind":"article","abstract":[{"text":"Configure ","type":"text"},{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"text":" to match your privacy, residency, and batching needs — without ","type":"text"},{"code":"import Mixpanel","type":"codeVoice"},{"text":" in your app.","type":"text"}],"title":"How to Implement the Service","role":"article"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MockMixpanelAnalyticsService":{"kind":"symbol","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MockMixpanelAnalyticsService","kind":"identifier"}],"title":"MockMixpanelAnalyticsService","type":"topic","abstract":[{"type":"text","text":"Recording "},{"type":"codeVoice","code":"AnalyticsService"},{"text":" for previews and Swift Testing suites.","type":"text"}],"navigatorTitle":[{"text":"MockMixpanelAnalyticsService","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService","url":"\/documentation\/swiduxmixpanelanalytics\/mockmixpanelanalyticsservice"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MockServiceReference":{"url":"\/documentation\/swiduxmixpanelanalytics\/mockservicereference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documen
nelOptions"},{"type":"text","text":" and calls"},{"type":"text","text":" "},{"type":"codeVoice","code":"Mixpanel.initialize(options:)"},{"type":"text","text":"."}]},{"syntax":"swift","type":"codeListing","code":["let service = MixpanelAnalyticsService(","    token: Secrets.mixpanelAPIKey,","    optOutTrackingByDefault: true",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK applies most calls later, on its own serial queue, while checking"},{"type":"text","text":" "},{"type":"text","text":"the opt-out flag on the caller’s thread. The adapter papers over the gaps"},{"type":"text","text":" "},{"type":"text","text":"that leaves: consent changes take effect before their "},{"code":"async","type":"codeVoice"},{"type":"text","text":" call"},{"type":"text","text":" "},{"type":"text","text":"returns, "},{"code":"flush()","type":"codeVoice"},{"type":"text","text":" drains the whole queue, "},{"code":"reset()","type":"codeVoice"},{"type":"text","text":" keeps both queued"},{"type":"text","text":" "},{"type":"text","text":"events and the user’s consent choice, and opting out deletes the queue"},{"type":"text","text":" "},{"type":"text","text":"instead of leaving it to be sent later."}]},{"type":"paragraph","inlineContent":[{"text":"The struct is ","type":"text"},{"code":"@unchecked Sendable","type":"codeVoice"},{"text":": ","type":"text"},{"code":"MixpanelInstance","type":"codeVoice"},{"text":" serializes its","type":"text"},{"text":" ","type":"text"},{"text":"tracking work on internal queues, and every copy of the service shares one","type":"text"},{"text":" ","type":"text"},{"text":"SDK instance. The exceptions are ","type":"text"},{"code":"loggingEnabled","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"useIPAddressForGeoLocation","type":"codeVoice"},{"text":": the initializer writes them to SDK","type":"text"},{"text":" ","type":"text"},{"text":"properties that are not synchronized, while the SDK’s queues may still be","type":"text"},{"text":" ","type":"text"},{"text":"running work for the instance. When the SDK is compiled for Debug,","type":"text"},{"text":" ","type":"text"},{"text":"turning logging on reads the instance’s super properties without the","type":"text"},{"text":" ","type":"text"},{"text":"lock its tracking queue writes them under, and the work","type":"text"},{"text":" ","type":"text"},{"code":"Mixpanel.initialize","type":"codeVoice"},{"text":" queues writes them when there are super properties","type":"text"},{"text":" ","type":"text"},{"text":"or a default opt-out to apply. Flushes read the geolocation setting on","type":"text"},{"text":" ","type":"text"},{"text":"the SDK’s network queue, so a second service with the same name can","type":"text"},{"text":" ","type":"text"},{"text":"write it during a flush.","type":"text"}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics"]]},"metadata":{"role":"symbol","title":"MixpanelAnalyticsService","symbolKind":"struct","roleHeading":"Structure","modules":[{"name":"SwiduxMixpanelAnalytics"}],"externalID":"s:23SwiduxMixpanelAnalytics0bC7ServiceV","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MixpanelAnalyticsService"}],"navigatorTitle":[{"text":"MixpanelAnalyticsService","kind":"identifier"}]},"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","references":{"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MixpanelAnalyticsService/alias(newID:previousID:)":{"title":"alias(newID:previousID:)","role":"symbol","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService\/alias(newID:previousID:)","url":"\/documentation\/swiduxmixpanelanalytics\/mixpanelanalyticsservice\/alias(newid:previousid:)","abstract":[{"type":"text","text":"Records "},{"type":"codeVoice","code":"newID"},{"type":"text","text":" as an alias of "}
{"abstract":[{"type":"text","text":"How "},{"type":"codeVoice","code":"AnalyticsValue"},{"type":"text","text":" cases map onto Mixpanel’s "},{"code":"MixpanelType","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Properties","type":"codeVoice"},{"type":"text","text":"."}],"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics"]]},"kind":"article","primaryContentSections":[{"content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"code":"SwiduxAnalytics.AnalyticsValue","type":"codeVoice"},{"type":"text","text":" is a closed enum so service adapters can translate deterministically into native SDK types without runtime "},{"code":"Any","type":"codeVoice"},{"type":"text","text":" surprises. This page documents the mapping "},{"type":"codeVoice","code":"MixpanelAnalyticsService"},{"type":"text","text":" uses."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Mixpanel’s "},{"code":"MixpanelType","type":"codeVoice"},{"type":"text","text":" accepts "},{"code":"String","type":"codeVoice"},{"type":"text","text":", "},{"code":"Int","type":"codeVoice"},{"type":"text","text":", "},{"code":"UInt","type":"codeVoice"},{"type":"text","text":", "},{"code":"Double","type":"codeVoice"},{"type":"text","text":", "},{"code":"Float","type":"codeVoice"},{"type":"text","text":", "},{"code":"Bool","type":"codeVoice"},{"type":"text","text":", "},{"code":"Date","type":"codeVoice"},{"type":"text","text":", "},{"code":"URL","type":"codeVoice"},{"type":"text","text":", "},{"code":"NSNull","type":"codeVoice"},{"type":"text","text":", "},{"code":"[MixpanelType]","type":"codeVoice"},{"type":"text","text":", and "},{"code":"[String: MixpanelType]","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"heading","level":2,"anchor":"Mapping-table","text":"Mapping table"},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"code":"AnalyticsValue","type":"codeVoice"},{"type":"text","text":" case"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Mixpanel value"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".string(s)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"s","type":"codeVoice"},{"type":"text","text":" (as "},{"code":"String","type":"codeVoice"},{"type":"text","text":")"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".int(n)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"n","type":"codeVoice"},{"type":"text","text":" (as "},{"code":"Int","type":"codeVoice"},{"type":"text","text":")"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".double(d)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"d","type":"codeVoice"},{"type":"text","text":" (as "},{"code":"Double","type":"codeVoice"},{"type":"text","text":"); omitted if NaN or infinite"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".bool(b)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"b"},{"type":"text","text":" (as "},{"type":"codeVoice","code":"Bool"},{"type":"text","text":")"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".date(d)"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"d"},{"type":"text","text":" (as "},{"type":"codeVoice","code":"Date"},{"type":"text","text":")"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".array(values)"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"[MixpanelType]"},{"type":"text","text":" (each element recursively mapped; nulls omitted)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".dict(entries)"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"[String: MixpanelType]"},{"type":"text","text":" (each value recursively mapped; nulls omitted)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".null"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"omitted"}]}]]]},{"type":"heading","anchor":"Behavior-notes","level":2,"text":"Behavior notes"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"Int"},{"type":"text","text":" vs "},{"type":"codeVoice","code":"Double"},{"type":"text","text":" are preserved."}]},{"type":"text","text":" "},{"type":"codeVoice","code":"AnalyticsValue.int(5)"},{"type":"text","text":" becomes "},{"type":"codeVoice","code":"Int"},{"type":"text","text":"; "},{"type":"codeVoice","code":".double(5)"},{"type":"text","text":" becomes "},{"type":"codeVoice","code":"Double"},{"type":"text","text":". Mixpanel’s UI may render them similarly, but the wire types differ."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Nulls are omitted."}]},{"type":"text","text":" The Mixpanel SDK cannot send a JSON "},{"type":"codeVoice","code":"null"},{"type":"text","text":": it re-serializes queued data when flushing and turns every "},{"type":"codeVoice","code":"NSNull"},{"type":"text","text":" into the string "},{"type":"codeVoice","code":"\"<null>\""},{"type":"text","text":". So "},{"type":"codeVoice","code":".null"},{"type":"text","text":" values — at the top level, in arrays, and in dictionaries — are left out rather than arriving as that string. On a user profile, "},{"type":"codeVoice","code":"identify"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"unsets"}]},{"type":"text","text":" a property whose value is null."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Non-finite doubles count as null."}]},{"type":"text","text":" NaN and ±infinity make the SDK assert (a crash in Debug builds) and otherwise arrive as the strings "},{"type":"codeVoice","code":"\"nan\""},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"\"inf\""},{"type":"text","text":", so they are omitted like "},{"type":"codeVoice","code":".null"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Empty event properties"}]},{"type":"text","text":" (no keys) are forwarded as "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" rather than an empty dictionary, mirroring Mixpanel’s "},{"type":"codeVoice","code":"track(event:properties:)"},{"type":"text","text":" convention."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Nested structures"}]},{"type":"text","text":" flatten correctly: "},{"type":"codeVoice","code":".dict([.array([.int(1), .int(2)])])"},{"type":"text","text":" translates to "},{"type":"codeVoice","code":"[String: [MixpanelType]]"},{"type":"text","text":" with primitive elements intact."}]}]}]},{"type":"heading","anchor":"Public-API","level":2,"text":"Public API"},{"type":"codeListing","syntax":"swift","code":["extension AnalyticsValue {","    public func toMixpanelType() -> any MixpanelType  \/\/ `NSNull()` for null and non-finite values","}","","extension Dictionary where Key == String, Value == AnalyticsValue {","    public func toMixpanelProperties() -> Properties  \/\/ null entries omitted","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You typically don’t call these directly — "},{"type":"codeVoice","code":"MixpanelAnalyticsService"},{"type":"text","text":" invokes them on every "},{"type":"codeVoice","code":"track"},{"type":"text","text":" and "},{"type":"codeVoice","code":"identify"},{"type":"text","text":". They are exposed for tests, debugging, or for callers who construct Mixpanel events outside the plugin."}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ValueTranslation","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxmixpanelanalytics\/valuetranslation"]}],"metadata":{"modules":[{"name":"SwiduxMixpanelAnalytics"}],"title":"Value Translation","roleHeading":"Article","role":"article"},"seeAlsoSections":[{"anchor":"Related-Documentation","title":"Related Documentation","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ServiceReference","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService"]}],"references":{"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/HowToImplementService":{"type":"topic","title":"How to Implement the Service","url":"\/documentation\/swiduxmixpanelanalytics\/howtoimplementservice","abstract":[{"type":"text","text":"Configure "},{"type":"codeVoice","code":"MixpanelAnalyticsService"},{"type":"text","text":" to match your privacy, residency, and batching needs — without "},{"type":"codeVoice","code":"import Mixpanel"},{"type":"text","text":" in your app."}],"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","kind":"article","role":"article"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MixpanelAnalyticsService":{"type":"topic","title":"MixpanelAnalyticsService","url":"\/documentation\/swiduxmixpanelanalytics\/mixpanelanalyticsservice","abstract":[{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" conformer that owns and forwards to a Mixpanel SDK"},{"type":"text","text":" "},{"type":"text","text":"instance."}],"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService","navigatorTitle":[{"kind":"identifier","text":"MixpanelAnalyticsService"}],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MixpanelAnalyticsService"}]},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/ServiceReference":{"type":"topic","title":"Service Reference","url":"\/documentation\/swiduxmixpanelanalytics\/servicereference","abstract":[{"type":"text","text":"API reference for "},{"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService","isActive":true},{"type":"text","text":" — the Mixpanel-backed "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" conformer that the analytics plugin consumes."}],"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ServiceReference","kind":"article","role":"article"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics":{"type":"topic","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics","title":"SwiduxMixpanelAnalytics","url":"\/documentation\/swiduxmixpanelanalytics","abstract":[{"type":"text","text":"Mixpanel adapter for Swidux’s "},{"type":"codeVoice","code":"AnalyticsPlugin"},{"type":"text","text":". Owns the Mixpanel SDK on the app’s behalf — "},{"type":"codeVoice","code":"MixpanelAnalyticsService(token:)"},{"type":"text","text":" calls "},{"type":"codeVoice","code":"Mixpanel.initialize"},{"type":"text","text":" internally so apps never need to "},{"type":"codeVoice","code":"import Mixpanel"},{"type":"text","text":". Ships a recording mock for previews and tests."}],"kind":"symbol","role":"collection"}}}
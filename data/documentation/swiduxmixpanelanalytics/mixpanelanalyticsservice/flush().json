{"metadata":{"role":"symbol","title":"flush()","externalID":"s:23SwiduxMixpanelAnalytics0bC7ServiceV5flushyyYaF","modules":[{"name":"SwiduxMixpanelAnalytics"}],"symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"flush"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"}],"roleHeading":"Instance Method"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"flush"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK sends one request per 50 records, each bounded at 120 s, and"},{"type":"text","text":" "},{"type":"text","text":"stops a queue at the first failure — so a hung server can hold this"},{"type":"text","text":" "},{"type":"text","text":"for minutes; prefer the plugin’s "},{"type":"codeVoice","code":"flush(timeout:)"},{"type":"text","text":" on shutdown paths. The"},{"type":"text","text":" "},{"type":"text","text":"completion is delivered on the main queue, so never block the main"},{"type":"text","text":" "},{"type":"text","text":"thread waiting for it."}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService\/flush()","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Sends every queued event and People update via"},{"type":"text","text":" "},{"type":"codeVoice","code":"MixpanelInstance.flush(performFullFlush:completion:)"},{"type":"text","text":", and returns once"},{"type":"text","text":" "},{"type":"text","text":"the SDK reports completion — not just the first 50-record batch the"},{"type":"text","text":" "},{"type":"text","text":"SDK’s default flush sends."}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService"]]},"sections":[],"variants":[{"paths":["\/documentation\/swiduxmixpanelanalytics\/mixpanelanalyticsservice\/flush()"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics":{"type":"topic","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics","title":"SwiduxMixpanelAnalytics","url":"\/documentation\/swiduxmixpanelanalytics","abstract":[{"type":"text","text":"Mixpanel adapter for Swidux’s "},{"type":"codeVoice","code":"AnalyticsPlugin"},{"type":"text","text":". Owns the Mixpanel SDK on the app’s behalf — "},{"type":"codeVoice","code":"MixpanelAnalyticsService(token:)"},{"type":"text","text":" calls "},{"type":"codeVoice","code":"Mixpanel.initialize"},{"type":"text","text":" internally so apps never need to "},{"type":"codeVoice","code":"import Mixpanel"},{"type":"text","text":". Ships a recording mock for previews and tests."}],"kind":"symbol","role":"collection"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MixpanelAnalyticsService/flush()":{"abstract":[{"type":"text","text":"Sends every queued event and People update via"},{"type":"text","text":" "},{"type":"codeVoice","code":"MixpanelInstance.flush(performFullFlush:completion:)"},{"type":"text","text":", and returns once"},{"type":"text","text":" "},{"type":"text","text":"the SDK reports completion — not just the first 50-record batch the"},{"type":"text","text":" "},{"type":"text","text":"SDK’s default flush sends."}],"role":"symbol","kind":"symbol","url":"\/documentation\/swiduxmixpanelanalytics\/mixpanelanalyticsservice\/flush()","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnaly
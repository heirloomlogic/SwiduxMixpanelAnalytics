 completion — not just the first 50-record batch the","type":"text"},{"text":" ","type":"text"},{"text":"SDK’s default flush sends.","type":"text"}],"type":"topic","role":"symbol","kind":"symbol"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics":{"title":"SwiduxMixpanelAnalytics","abstract":[{"type":"text","text":"Mixpanel adapter for Swidux’s "},{"type":"codeVoice","code":"AnalyticsPlugin"},{"text":". Owns the Mixpanel SDK on the app’s behalf — ","type":"text"},{"type":"codeVoice","code":"MixpanelAnalyticsService(token:)"},{"type":"text","text":" calls "},{"type":"codeVoice","code":"Mixpanel.initialize"},{"text":" internally so apps never need to ","type":"text"},{"type":"codeVoice","code":"import Mixpanel"},{"type":"text","text":". Ships a recording mock for previews and tests."}],"type":"topic","role":"collection","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics","url":"\/documentation\/swiduxmixpanelanalytics","kind":"symbol"}}}
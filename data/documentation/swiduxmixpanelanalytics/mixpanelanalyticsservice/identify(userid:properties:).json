{"hierarchy":{"paths":[["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"identify","kind":"identifier"},{"text":"(","kind":"text"},{"text":"userID","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"properties","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:15SwiduxAnalytics0B5ValueO","text":"AnalyticsValue","kind":"typeIdentifier"},{"text":"]) ","kind":"text"},{"text":"async","kind":"keyword"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"A key left out of a later call is not sent, so its saved value stays.","type":"text"},{"text":" ","type":"text"},{"text":"To delete a saved property, pass it as ","type":"text"},{"code":".null","type":"codeVoice"},{"text":"; for example,","type":"text"},{"text":" ","type":"text"},{"code":"[\"plan\": .null]","type":"codeVoice"},{"text":" unsets ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":". Each value is sent whole and replaces","type":"text"},{"text":" ","type":"text"},{"text":"the saved one. A null nested inside an array or dictionary is dropped","type":"text"},{"text":" ","type":"text"},{"text":"before sending, so it deletes nothing by itself, but the rest of that","type":"text"},{"text":" ","type":"text"},{"text":"value replaces the saved value: identifying with","type":"text"},{"text":" ","type":"text"},{"code":"[\"prefs\": .dict([\"theme\": .null])]","type":"codeVoice"},{"text":" sends ","type":"text"},{"code":"prefs","type":"codeVoice"},{"text":" as ","type":"text"},{"code":"{}","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Every ","type":"text"},{"code":"$set","type":"codeVoice"},{"text":" also carries the SDK’s automatic people properties (for","type":"text"},{"text":" ","type":"text"},{"text":"example ","type":"text"},{"code":"$ios_device_model","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"$swift_lib_version","type":"codeVoice"},{"text":"), except any listed","type":"text"},{"text":" ","type":"text"},{"text":"in ","type":"text"},{"code":"excludeProperties","type":"codeVoice"},{"text":". A call whose properties are empty or all null","type":"text"},{"text":" ","type":"text"},{"text":"sends no ","type":"text"},{"code":"$set","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Empty ","type":"text"},{"code":"userID","type":"codeVoice"},{"text":"s are dropped entirely: the SDK rejects blank distinct","type":"text"},{"text":" ","type":"text"},{"text":"IDs, and forwarding the people update anyway would attribute it to the","type":"text"},{"text":" ","type":"text"},{"text":"previous identity. Calls made while opted out are dropped too.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"When the user changes, everything queued for the previous user is sent","type":"text"},{"text":" ","type":"text"},{"text":"first, and this waits for it — the SDK attributes queued People updates","type":"text"},{"text":" ","type":"text"},{"text":"to whoever is identified when they are sent, not when they were made.","type":"text"}]}],"kind":"content"}],"kind":"symbol","abstract":[{"type":"text","text":"Sets the active Mixpanel distinct ID and updates the user’s profile:"},{"text":" ","type":"text"},{"code":"properties","type":"codeVoice"},{"type":"text","text":" are set via "},{"type":"codeVoice","code":"instance.people.set"},{"text":", except those that","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"translate to null ("},{"type":"codeVoice","code":".null"},{"type":"text","text":", NaN, infinity), which are unset."}],"variants":[{"paths":["\/documentation\/swiduxmixpanelanalytics\/mixpanelanalyticsservice\/identify(userid:properties:)"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"identify"},{"kind":"text","text":"("},{"text":"userID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"properties","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":" : ","kind":"text"},{"text":"AnalyticsValue","kind":"typeIdentifier","preciseIdentifier":"s:15SwiduxAnalytics0B5ValueO"},{"text":"]) ","kind":"text"},{"text":"async","kind":"keyword"}],"modules":[{"name":"SwiduxMixpanelAnalytics"}],"roleHeading":"Instance Method","role":"symbol","externalID":"s:23SwiduxMixpanelAnalytics0bC7ServiceV8identify6userID10propertiesySS_SDySS0aC00C5ValueOGtYaF","title":"identify(userID:properties:)"},"identifier":{"url":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService\/identify(userID:properties:)","interfaceLanguage":"swift"},"references":{"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MixpanelAnalyticsService":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MixpanelAnalyticsService"}],"navigatorTitle":[{"kind":"identifier","text":"MixpanelAnalyticsService"}],"title":"MixpanelAnalyticsService","url":"\/documentation\/swiduxmixpanelanalytics\/mixpanelanalyticsservice","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/docume
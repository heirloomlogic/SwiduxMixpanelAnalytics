{"variants":[{"paths":["\/documentation\/swiduxmixpanelanalytics\/mixpanelanalyticsservice\/optouttracking()"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"title":"optOutTracking()","role":"symbol","externalID":"s:23SwiduxMixpanelAnalytics0bC7ServiceV14optOutTrackingyyYaF","modules":[{"name":"SwiduxMixpanelAnalytics"}],"symbolKind":"method","roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"optOutTracking"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"}]},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService\/optOutTracking()"},"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"Opts the user out of all tracking, and returns once the SDK has"},{"type":"text","text":" "},{"type":"text","text":"applied it: from then on "},{"type":"codeVoice","code":"track"},{"type":"text","text":", "},{"type":"codeVoice","code":"identify"},{"type":"text","text":", and "},{"type":"codeVoice","code":"alias"},{"type":"text","text":" are dropped"},{"type":"text","text":" "},{"type":"text","text":"until "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService\/optInTracking(distinctID:properties:)"},{"type":"text","text":". Does nothing if the"},{"type":"text","text":" "},{"type":"text","text":"user is already opted out. The choice persists across launches."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"optOutTracking"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Queued events and People updates are deleted, not sent, and the local"},{"type":"text","text":" "},{"type":"text","text":"identity is reset. This does not wait for the network."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An upload already in progress is not cancelled. The SDK checks consent"},{"type":"text","text":" "},{"type":"text","text":"when a flush starts and before it moves from events to People updates,"},{"type":"text","text":" "},{"type":"text","text":"but not between requests. A flush that is already sending events"},{"type":"text","text":" "},{"type":"text","text":"therefore still sends every event it had read: for a full flush such"},{"type":"text","text":" "},{"type":"text","text":"as "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService\/flush()"},{"type":"text","text":", that is the whole event queue, 50 per request."}]},{"name":"Important","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"This does not delete the user’s Mixpanel profile or data."},{"type":"text","text":" "},{"type":"text","text":"The SDK’s own opt-out queues a profile deletion but never sends it —"},{"type":"text","text":" "},{"type":"text","text":"the leftover request would later delete the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"next"}]},{"type":"text","text":" identified user’s"},{"type":"text","text":" "},{"type":"text","text":"profile instead — so the adapter discards it with the rest of the"},{"type":"text","text":" "},{"type":"text","text":"queue. To erase a user’s data, use Mixpanel’s GDPR deletion API from"},{"type":"text","text":" "},{"type":"text","text":"your server."}]}],"style":"important"}],"kind":"content"}],"references":{"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics":{"type":"topic","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics","title":"SwiduxMixpanelAnalytics","url":"\/documentation\/swiduxmixpanelanalytics","abstract":[{"type":"text","text":"Mixpanel adapter for Swidux’s "},{"type":"codeVoice","code":"AnalyticsPlugin"},{"type":"text","text":". Owns the Mixpanel SDK on the app’s behalf — "},{"type":"codeVoice","code":"MixpanelAnalyticsService(token:)"},{"type":"text","text":" calls "},{"type":"codeVoice","code":"Mixpanel.initialize"},{"type":"text","text":" internally so apps never need to "},{"type":"codeVoice","code":"import Mixpanel"},{"type":"text","text":". Ships a recording mock for previews and tests."}],"kind":"symbol","role":"collection"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MixpanelAnalyticsService":{"type":"topic","title":"MixpanelAnalyticsService","url":"\/documentation\/swiduxmixpanelanalytics\/mixpanelanalyticsservice","abstract":[{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" conformer that owns and forwards to a Mixpanel SDK"},{"type":"text","text":" "},{"type":"text","text":"instance."}],"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService","navigatorTitle":[{"text":"MixpanelAnalyticsService","kind":"identifier"}],"kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MixpanelAnalyticsService","kind":"identifier"}]},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MixpanelAnalyticsService/optInTracking(distinctID:properties:)":{"abstract":[{"type":"text","text":"Opts the user back into tracking and returns once the SDK has applied"},{"type":"text","text":" "},{"type":"text","text":"it, so an "},{"type":"codeVoice","code":"identify"},{"type":"text","text":" issued straight afterwards is honored."}],"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService\/optInTracking(distinctID:properties:)","url":"\/documentation\/swiduxmixpanelanalytics\/mixpanelanalyticsservice\/optintracking(distinctid:properties:)","role":"symbol","kind":"symbol","title":"optInTracking(distinctID:properties:)","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"optInTracking"},{"kind":"text","text":"("},{"kind":"externalParam","text":"distinctID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"properties"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"AnalyticsValue","preciseIdentifier":"s:15SwiduxAnalytics0B5ValueO"},{"kind":"text","text":"]?) "},{"kind":"keyword","text":"async"}]},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MixpanelAnalyticsService/flush()":{"abstract":[{"type":"text","text":"Sends every queued event and People update via"},{"type":"text","text":" "},{"type":"codeVoice","code":"MixpanelInstance.flush(performFullFlush:completion:)"},{"type":"text","text":", and returns once"},{"type":"text","text":" "},{"type":"text","text":"the SDK reports completion — not just the first 50-record batch the"},{"type":"text","text":" "},{"type":"text","text":"SDK’s default flush sends."}],"role":"symbol","kind":"symbol","url":"\/documentation\/swiduxmixpanelanalytics\/mixpanelanalyticsservice\/flush()","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService\/flush()","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"flush","kind":"identifier"},{"text":"() ","kind":"text"},{"kind":"keyword","text":"async"}],"title":"flush()"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MixpanelAnalyticsService/optOutTracking()":{"abstract":[{"type":"text","text":"Opts the user out of all tracking, and returns once the SDK has"},{"type":"text","text":" "},{"type":"text","text":"applied it: from then on "},{"type":"codeVoice","code":"track"},{"type":"text","text":", "},{"type":"codeVoice","code":"identify"},{"type":"text","text":", and "},{"type":"codeVoice","code":"alias"},{"type":"text","text":" are dropped"},{"type":"text","text":" "},{"type":"text","text":"until "},{"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService\/optInTracking(distinctID:properties:)","isActive":true},{"type":"text","text":". Does nothing if the"},{"type":"text","text":" "},{"type":"text","text":"user is already opted out. The choice persists across launches."}],"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService\/optOutTracking()","url":"\/documentation\/swiduxmixpanelanalytics\/mixpanelanalyticsservice\/optouttracking()","role":"symbol","kind":"symbol","title":"optOutTracking()","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"optOutTracking"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"}]}}}
{"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"optOutTracking","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Queued events and People updates are deleted, not sent, and the local"},{"type":"text","text":" "},{"type":"text","text":"identity is reset. This does not wait for the network."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"An upload already in progress is not cancelled. The SDK checks consent"},{"type":"text","text":" "},{"type":"text","text":"when a flush starts and before it moves from events to People updates,"},{"type":"text","text":" "},{"type":"text","text":"but not between requests. A flush that is already sending events"},{"type":"text","text":" "},{"type":"text","text":"therefore still sends every event it had read: for a full flush such"},{"type":"text","text":" "},{"type":"text","text":"as "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService\/flush()"},{"type":"text","text":", that is the whole event queue, 50 per request."}],"type":"paragraph"},{"style":"important","name":"Important","content":[{"inlineContent":[{"type":"text","text":"This does not delete the user’s Mixpanel profile or data."},{"type":"text","text":" "},{"type":"text","text":"The SDK’s own opt-out queues a profile deletion but never sends it —"},{"type":"text","text":" "},{"type":"text","text":"the leftover request would later delete the "},{"inlineContent":[{"type":"text","text":"next"}],"type":"emphasis"},{"type":"text","text":" identified user’s"},{"type":"text","text":" "},{"type":"text","text":"profile instead — so the adapter discards it with the rest of the"},{"type":"text","text":" "},{"type":"text","text":"queue. To erase a user’s data, use Mixpanel’s GDPR deletion API from"},{"type":"text","text":" "},{"type":"text","text":"your server."}],"type":"paragraph"}],"type":"aside"}],"kind":"content"}],"metadata":{"symbolKind":"method","roleHeading":"Instance Method","title":"optOutTracking()","externalID":"s:23SwiduxMixpanelAnalytics0bC7ServiceV14optOutTrackingyyYaF","modules":[{"name":"SwiduxMixpanelAnalytics"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"optOutTracking","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"}],"role":"symbol"},"hierarchy":{"paths":[["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService"]]},"identifier":{"url":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService\/optOutTracking()","interfaceLanguage":"swift"},"abstract":[{"text":"Opts the user out of all tracking, and returns once the SDK has","type":"text"},{"text":" ","type":"text"},{"text":"applied it: from then on ","type":"text"},{"code":"track","type":"codeVoice"},{"text":", ","type":"text"},{"code":"identify","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"alias","type":"codeVoice"},{"text":" are dropped","type":"text"},{"text":" ","type":"text"},{"text":"until ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService\/optInTracking(distinctID:properties:)","isActive":true},{"text":". Does nothing if the","type":"text"},{"text":" ","type":"text"},{"text":"user is already opted out. The choice persists across launches.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxmixpanelanalytics\/mixpanelanalyticsservice\/optouttracking()"]}],"references":{"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MixpanelAnalyticsService/optOutTracking()":{"title":"optOutTracking()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"optOutTracking","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"}],"url":"\/documentation\/swiduxmixpanelanalytics\/mixpanelanalyticsservice\/optouttracking()","kind":"symbol","role":"symbol","abstract":[{"text":"Opts the user out of all tracking, and returns once the SDK has","type":"text"},{"text":" ","type":"text"},{"text":"applied it: from then on ","type":"text"},{"code":"track","type":"codeVoice"},{"text":", ","type":"text"},{"code":"identify","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"alias","type":"codeVoice"},{"text":" are dropped","type":"text"},{"text":" ","type":"text"},{"text":"until ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService\/optInTracking(distinctID:properties:)","isActive":true},{"text":". Does nothing if the","type":"text"},{"text":" ","type":"text"},{"text":"user is already opted out. The choice persists across launches.","type":"text"}],"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService\/optOutTracking()","type":"topic"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MixpanelAnalyticsService/flush()":{"kind":"symbol","title":"flush()","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService\/flush()","role":"symbol","url":"\/documentation\/swiduxmixpanelanalytics\/mixpanelanalyticsservice\/flush()","abstract":[{"type":"text","text":"Sends every queued event and People update via"},{"type":"text","text":" "},{"type":"codeVoice","code":"MixpanelInstance.flush(performFullFlush:completion:)"},{"type":"text","text":", and returns once"},{"type":"text","text":" "},{"type":"text","text":"the SDK reports completion — not just the first 50-record batch the"},{"type":"text","text":" "},{"type":"text","text":"SDK’s default flush sends."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"flush"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"}],"type":"topic"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MixpanelAnalyticsService":{"navigatorTitle":[{"text":"MixpanelAnalyticsService","kind":"identifier"}],"title":"MixpanelAnalyticsService","type":"topic","kind":"symbol","role":"symbol","abstract":[{"code":"AnalyticsService","type":"codeVoice"},{"text":" conformer that owns and forwards to a Mixpanel SDK","type":"text"},{"text":" ","type":"text"},{"text":"instance.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MixpanelAnalyticsService"}],"url":"\/documentation\/swiduxmixpanelanalytics\/mixpanelanalyticsservice","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MixpanelAnalyticsService/optInTracking(distinctID:properties:)":{"kind":"symbol","type":"topic","title":"optInTracking(distinctID:properties:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"optInTracking","kind":"identifier"},{"text":"(","kind":"text"},{"text":"distinctID","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"properties"},{"kind":"text","text":": ["},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"kind":"text","text":" : "},{"text":"AnalyticsValue","preciseIdentifier":"s:15SwiduxAnalytics0B5
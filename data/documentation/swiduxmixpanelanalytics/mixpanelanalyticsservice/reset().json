{"metadata":{"role":"symbol","title":"reset()","externalID":"s:23SwiduxMixpanelAnalytics0bC7ServiceV5resetyyYaF","modules":[{"name":"SwiduxMixpanelAnalytics"}],"symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reset"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"}],"roleHeading":"Instance Method"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reset"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Everything still queued is sent first, and this waits for it: the"},{"type":"text","text":" "},{"type":"text","text":"SDK’s own "},{"type":"codeVoice","code":"reset()"},{"type":"text","text":" sends one 50-record batch and deletes the rest."},{"type":"text","text":" "},{"type":"text","text":"Anything the network then fails to take is discarded, as the SDK does."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"While opted out this only forgets the adapter’s record of the user."},{"type":"text","text":" "},{"type":"text","text":"Opting out has already cleared the SDK’s identity and queue, and the"},{"type":"text","text":" "},{"type":"text","text":"SDK’s "},{"type":"codeVoice","code":"reset()"},{"type":"text","text":" would also erase the persisted opt-out — the user"},{"type":"text","text":" "},{"type":"text","text":"would be tracked again from the next launch. If the user opts out while"},{"type":"text","text":" "},{"type":"text","text":"this is still sending, the opt-out is written back after the SDK’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"reset()"},{"type":"text","text":" erases it."}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService\/reset()","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Clears the local identity, super properties, and timed events via"},{"type":"text","text":" "},{"type":"codeVoice","code":"MixpanelInstance.reset(completion:)"},{"type":"text","text":", and returns once that is done."},{"type":"text","text":" "},{"type":"text","text":"Init-time super properties are then re-applied."}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService"]]},"sections":[],"variants":[{"paths":["\/documentation\/swiduxmixpanelanalytics\/mixpanelanalyticsservice\/reset()"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MixpanelAnalyticsService/reset()":{"title":"reset()","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService\/reset()","kind":"symbol","type":"topic","url":"\/documentation\/swiduxmixpanelanalytics\/mixpanelanalyticsservice\/reset()","abstract":[{"type":"text","text":"Clears the local identity, super properties, and timed events via"},{"type":"text","text":" "},{"type":"codeVoice","code":"MixpanelInstance.reset(completion:)"},{"type":"text","text":", and returns once that is done."},{"type":"text","text":" "},{"type":"text","text":"Init-time super properties are then re-applied."}],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reset"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"}]},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics":{"type":"topic","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics","title":"SwiduxMixpanelAnalytics","url":"\/documentation\/swiduxmixpanelanalytics","abstract":[{"type":"text","text":"Mixpanel adapter for Swidux’s "},{"type":"codeVoice","code":"AnalyticsPlugin"},{"type":"text","text":". Owns the Mixpanel SDK on the app’s behalf — "},{"type":"codeVoice","code":"MixpanelAnalyticsService(token:)"},{"type":"text","text":" calls "},{"type":"codeVoice","code":"Mixpanel.initialize"},{"type":"text","text":" internally so apps never need to "},{"type":"codeVoice","code":"import Mixpanel"},{"type":"text","text":". Ships a recording mock for previews and tests."}],"kind":"symbol","role":"collection"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MixpanelAnalyticsService":{"type":"topic","title":"MixpanelAnalyticsService","url":"\/documentation\/swiduxmixpanelanalytics\/mixpanelanalyticsservice","abstract":[{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" conformer that owns and forwards to a Mixpanel SDK"},{"type":"text","text":" "},{"type":"text","text":"instance."}],"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService","navigatorTitle":[{"text":"MixpanelAnalyticsService","kind":"identifier"}],"kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MixpanelAnalyticsService","kind":"identifier"}]}}}
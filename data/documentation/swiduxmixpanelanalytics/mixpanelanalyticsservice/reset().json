{"abstract":[{"text":"Clears the local identity, super properties, and timed events via","type":"text"},{"text":" ","type":"text"},{"code":"MixpanelInstance.reset(completion:)","type":"codeVoice"},{"text":", and returns once that is done.","type":"text"},{"text":" ","type":"text"},{"text":"Init-time super properties are then re-applied.","type":"text"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"paths":["\/documentation\/swiduxmixpanelanalytics\/mixpanelanalyticsservice\/reset()"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService\/reset()"},"metadata":{"roleHeading":"Instance Method","modules":[{"name":"SwiduxMixpanelAnalytics"}],"symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reset","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"}],"externalID":"s:23SwiduxMixpanelAnalytics0bC7ServiceV5resetyyYaF","title":"reset()","role":"symbol"},"sections":[],"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reset","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Everything still queued is sent first, and this waits for it: the"},{"type":"text","text":" "},{"type":"text","text":"SDK’s own "},{"type":"codeVoice","code":"reset()"},{"type":"text","text":" sends one 50-record batch and deletes the rest."},{"type":"text","text":" "},{"type":"text","text":"Anything the network then fails to take is discarded, as the SDK does."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The SDK’s "},{"type":"codeVoice","code":"reset()"},{"type":"text","text":" also erases the persisted consent choice, which"},{"type":"text","text":" "},{"type":"text","text":"would put the user back on the default from the next launch. The"},{"type":"text","text":" "},{"type":"text","text":"adapter writes the choice back: a user who opted in stays opted in,"},{"type":"text","text":" "},{"type":"text","text":"one who opted out stays opted out, and one who never chose is left"},{"type":"text","text":" "},{"type":"text","text":"on the default. No "},{"type":"codeVoice","code":"$opt_in"},{"type":"text","text":" event is sent."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"While opted out this only forgets the adapter’s record of the user;"},{"type":"text","text":" "},{"type":"text","text":"opting out has already cleared the SDK’s identity and queue. If"},{"type":"text","text":" "},{"type":"text","text":"consent changes through this service while the queue is being sent,"},{"type":"text","text":" "},{"type":"text","text":"the latest choice is the one kept."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MixpanelAnalyticsService/reset()":{"title":"reset()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reset","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"}],"url":"\/documentation\/swiduxmixpanelanalytics\/mixpanelanalyticsservice\/reset()","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"Clears the local identity, super properties, and timed events via"},{"type":"text","text":" "},{"type":"codeVoice","code":"MixpanelInstance.reset(completion:)"},{"type":"text","text":", and returns once that is done."},{"type":"text","text":" "},{"type":"text","text":"Init-time super properties are then re-applied."}],"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService\/reset()","type":"topic"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MixpanelAnalyticsService":{"navigatorTitle":[{"text":"MixpanelAnalyticsService","kind":"identifier"}],"title":"MixpanelAnalyticsService","type":"topic","kind":"symbol","role":"symbol","abstract":[{"code":"AnalyticsService","type":"codeVoice"},{"text":" conformer that owns and forwards to a Mixpanel SDK","type":"text"},{"text":" ","type":"text"},{"text":"instance.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MixpanelAnalyticsService"}],"url":"\/documentation\/swiduxmixpanelanalytics\/mixpanelanalyticsservice","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics":{"abstract":[{"text":"Mixpanel adapter for Swidux’s ","type":"text"},{"code":"AnalyticsPlugin","type":"codeVoice"},{"text":". Owns the Mixpanel SDK on the app’s behalf — ","type":"text"},{"code":"MixpanelAnalyticsService(token:)","type":"codeVoice"},{"text":" calls ","type":"text"},{"code":"Mixpanel.initialize","type":"codeVoice"},{"text":" internally so apps never need to ","type":"text"},{"code":"import Mixpanel","type":"codeVoice"},{"text":". Ships a recording mock for previews and tests.","type":"text"}],"url":"\/documentation\/swiduxmixpanelanalytics","type":"topic","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics","title":"SwiduxMixpanelAnalytics","role":"collection","kind":"symbol"}}}
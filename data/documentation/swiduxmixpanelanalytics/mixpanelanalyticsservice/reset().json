{"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"reset","kind":"identifier"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Everything still queued is sent first, and this waits for it: the","type":"text"},{"text":" ","type":"text"},{"text":"SDK’s own ","type":"text"},{"code":"reset()","type":"codeVoice"},{"text":" sends one 50-record batch and deletes the rest.","type":"text"},{"text":" ","type":"text"},{"text":"Anything the network then fails to take is discarded, as the SDK does.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The SDK’s ","type":"text"},{"code":"reset()","type":"codeVoice"},{"text":" also erases the persisted consent choice, which","type":"text"},{"text":" ","type":"text"},{"text":"would put the user back on the default from the next launch. The","type":"text"},{"text":" ","type":"text"},{"text":"adapter writes the choice back: a user who opted in stays opted in,","type":"text"},{"text":" ","type":"text"},{"text":"one who opted out stays opted out, and one who never chose is left","type":"text"},{"text":" ","type":"text"},{"text":"on the default. No ","type":"text"},{"code":"$opt_in","type":"codeVoice"},{"type":"text","text":" event is sent."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"While opted out this only forgets the adapter’s record of the user;"},{"type":"text","text":" "},{"type":"text","text":"opting out has already cleared the SDK’s identity and queue. If"},{"type":"text","text":" "},{"type":"text","text":"consent changes through this service while the queue is being sent,"},{"type":"text","text":" "},{"type":"text","text":"the latest choice is the one kept."}]}]}],"identifier":{"url":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService\/reset()","interfaceLanguage":"swift"},"sections":[],"abstract":[{"text":"Clears the local identity, super properties, and timed events via","type":"text"},{"text":" ","type":"text"},{"code":"MixpanelInstance.reset(completion:)","type":"codeVoice"},{"text":", and returns once that is done.","type":"text"},{"text":" ","type":"text"},{"text":"Init-time super properties are then re-applied.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxmixpanelanalytics\/mixpanelanalyticsservice\/reset()"]}],"metadata":{"roleHeading":"Instance Method","title":"reset()","externalID":"s:23SwiduxMixpanelAnalytics0bC7ServiceV5resetyyYaF","role":"symbol","modules":[{"name":"SwiduxMixpanelAnalytics"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reset","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"}],"symbolKind":"method"},"kind":"symbol","references":{"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MixpanelAnalyticsService/reset()":{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService\/reset()","type":"topic","abstract":[{"type":"text","text":"Clears the local identity, super properties, and timed events via"},{"type":"text","text":" "},{"code":"MixpanelInstance.reset(completion:)","type":"codeVoice"},{"type":"text","text":", and returns once that is done."},{"type":"text","text":" "},{"type":"text","text":"Init-time super properties are then re-applied."}],"url":"\/documentation\/swiduxmixpanelanalytics\/mixpanelanalyticsservice\/reset()","title":"reset()","kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reset","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"}]},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics":{"title":"SwiduxMixpanelAnalytics","abstract":[{"type":"text","text":"Mixpanel adapter for Swidux’s "},{"type":"codeVoice","code":"AnalyticsPlugin"},{"text":". Owns the Mixpanel SDK on the app’s behalf — ","type":"text"},{"type":"codeVoice","code":"MixpanelAnalyticsService(token:)"},{"type":"text","text":" calls "},{"type":"codeVoice","code":"Mixpanel.initialize"},{"text":" internally so apps never need to ","type":"text"},{"type":"codeVoice","code":"import Mixpanel"},{"type":"text","text":". Ships a recording mock for previews and tests."}],"type":"topic","role":"collection","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics","url":"\/documentation\/swiduxmixpanelanalytics","kind":"symbol"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MixpanelAnalyticsService":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MixpanelAnalyticsService"}],"navigatorTitle":[{"kind":"identifier","text":"MixpanelAnalyticsService"}],"title":"MixpanelAnalyticsService","url":"\/documentation\/swiduxmixpanelanalytics\/mixpanelanalyticsservice","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService","abstract":[{"code":"AnalyticsService","type":"codeVoice"},{"type":"text","text":" conformer that owns and forwards to a Mixpanel SDK"},{"type":"text","text":" "},{"text":"instance.","type":"text"}],"type":"topic","role":"symbol","kind":"symbol"}}}
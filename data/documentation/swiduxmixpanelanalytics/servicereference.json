{"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"type":"text","text":" owns the Mixpanel SDK on the app’s behalf. The token-taking initializer calls "},{"code":"Mixpanel.initialize","type":"codeVoice"},{"type":"text","text":" internally; runtime GDPR \/ diagnostic toggles are methods on the service. The app never needs to "},{"code":"import Mixpanel","type":"codeVoice"},{"type":"text","text":" on the happy path."}],"type":"paragraph"},{"inlineContent":[{"text":"For a step-by-step integration walkthrough, see ","type":"text"},{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","type":"reference","isActive":true},{"text":". For value-mapping rules, see ","type":"text"},{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ValueTranslation","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Library-target","text":"Library target","type":"heading","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Product: ","type":"text"},{"code":"SwiduxMixpanelAnalytics","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Import: ","type":"text"},{"code":"import SwiduxMixpanelAnalytics","type":"codeVoice"}]}]}]},{"inlineContent":[{"code":"Package.swift","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":[".product(name: \"SwiduxMixpanelAnalytics\", package: \"SwiduxMixpanelAnalytics\"),"],"type":"codeListing","syntax":"swift"},{"anchor":"Types","text":"Types","type":"heading","level":2},{"anchor":"docSwiduxMixpanelAnalyticsdocumentationSwiduxMixpanelAnalyticsMixpanelAnalyticsService","text":"``doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService``","type":"heading","level":3},{"code":["public struct MixpanelAnalyticsService: AnalyticsService, @unchecked Sendable {","    \/\/ Identical on every platform.","    public init(","        token: String,","        trackAutomaticEvents: Bool = false,","        flushInterval: Double = 60,","        instanceName: String? = nil,","        optOutTrackingByDefault: Bool = false,","        useUniqueDistinctId: Bool = false,","        deviceIdProvider: (@Sendable () -> String?)? = nil,","        superProperties: [String: AnalyticsValue]? = nil,","        serverURL: String? = nil,","        useGzipCompression: Bool = true,","        excludeProperties: Set<String> = []","    )","","    public init(instance: MixpanelInstance)","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Value type holding a single reference to a ","type":"text"},{"type":"codeVoice","code":"MixpanelInstance"},{"type":"text","text":". "},{"type":"codeVoice","code":"@unchecked Sendable"},{"type":"text","text":" is justified by Mixpanel’s documented thread-safety. Cheap to pass into "},{"type":"codeVoice","code":"AnalyticsPlugin"},{"type":"text","text":"."}],"type":"paragraph"},{"level":4,"text":"Initializers","type":"heading","anchor":"Initializers"},{"code":["public init(token: String, ...)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Builds a ","type":"text"},{"type":"codeVoice","code":"MixpanelOptions"},{"text":" and calls ","type":"text"},{"type":"codeVoice","code":"Mixpanel.initialize(options:)"},{"text":" internally, retaining the resulting instance. Parameters mirror ","type":"text"},{"type":"codeVoice","code":"MixpanelOptions"},{"text":" — including its ","type":"text"},{"type":"codeVoice","code":"useGzipCompression: true"},{"text":" default; ","type":"text"},{"type":"codeVoice","code":"superProperties"},{"text":" takes ","type":"text"},{"type":"codeVoice","code":"[String: AnalyticsValue]"},{"text":" so the app does not need to reference ","type":"text"},{"type":"codeVoice","code":"MixpanelType"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"deviceIdProvider"},{"text":" supplies a custom stable device ID (see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","type":"reference"},{"text":" for the contract: cached value only, no inline I\/O).","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The Mixpanel SDK keys instances by ","type":"text"},{"code":"instanceName","type":"codeVoice"},{"text":" (falling back to ","type":"text"},{"code":"token","type":"codeVoice"},{"text":"); constructing a second service with the same name returns the existing SDK instance and silently ignores the new options.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["public init(instance: MixpanelInstance)"]},{"type":"paragraph","inlineContent":[{"text":"Escape hatch for apps that need to build their own ","type":"text"},{"code":"MixpanelInstance","type":"codeVoice"},{"text":" (for example, to use ","type":"text"},{"code":"ProxyServerConfig","type":"codeVoice"},{"text":"). Most apps should prefer the token initializer; this is the only path that requires ","type":"text"},{"code":"import Mixpanel","type":"codeVoice"},{"text":" in your app.","type":"text"}]},{"type":"heading","level":4,"anchor":"track-async","text":"`track(_:) async`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Forwards to "},{"type":"codeVoice","code":"MixpanelInstance.track(event:properties:)"},{"type":"text","text":". Empty "},{"type":"codeVoice","code":"properties"},{"type":"text","text":" are passed as "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" rather than an empty dictionary. Returns immediately; Mixpanel batches and flushes on its own schedule."}]},{"type":"heading","level":4,"anchor":"identifyuserIDproperties-async","text":"`identify(userID:properties:) async`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Forwards to "},{"code":"MixpanelInstance.identify(distinctId:)","type":"codeVoice"},{"type":"text","text":", then — if "},{"code":"properties","type":"codeVoice"},{"type":"text","text":" is non-empty — calls "},{"code":"instance.people.set(properties:)","type":"codeVoice"},{"type":"text","text":" to update people-level properties. Empty "},{"code":"userID","type":"codeVoice"},{"type":"text","text":"s are dropped entirely: the SDK rejects blank distinct IDs, and forwarding the people update anyway would attribute it to the previous identity."}]},{"type":"heading","level":4,"anchor":"aliasnewIDpreviousID-async","text":"`alias(newID:previousID:) async`"},{"inlineContent":[{"type":"text","text":"Forwards to "},{"type":"codeVoice","code":"MixpanelInstance.createAlias(_:distinctId:)"},{"type":"text","text":". When "},{"type":"codeVoice","code":"previousID"},{"type":"text","text":" is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", the call uses "},{"type":"codeVoice","code":"instance.distinctId"},{"type":"text","text":" as the source ID, matching Mixpanel’s recommended anonymous-to-identified aliasing flow. Empty "},{"type":"codeVoice","code":"newID"},{"type":"text","text":"s are dropped, mirroring the SDK’s blank-alias rejection."}],"type":"paragraph"},{"level":4,"anchor":"reset-async","text":"`reset() async`","type":"heading"},{"inlineContent":[{"text":"Forwards to ","type":"text"},{"code":"MixpanelInstance.reset(completion:)","type":"codeVoice"},{"text":" and awaits its callback. Clears Mixpanel’s local distinct ID, super properties, and identity.","type":"text"}],"type":"paragraph"},{"level":4,"anchor":"flush-async","text":"`flush() async`","type":"heading"},{"inlineContent":[{"text":"Forwards to ","type":"text"},{"code":"MixpanelInstance.flush(completion:)","type":"codeVoice"},{"text":" and awaits its callback. The plugin’s own ","type":"text"},{"code":"flush()","type":"codeVoice"},{"text":" is the deterministic sync point in tests — it awaits all pending fire-and-forget tracking tasks and then calls this.","type":"text"}],"type":"paragraph"},{"level":4,"anchor":"optOutTracking-async","text":"`optOutTracking() async`","type":"heading"},{"inlineContent":[{"type":"text","text":"Forwards to "},{"type":"codeVoice","code":"MixpanelInstance.optOutTracking()"},{"type":"text","text":". Subsequent "},{"type":"codeVoice","code":"track"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"identify"},{"type":"text","text":" calls are dropped until "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService\/optInTracking(distinctID:properties:)"},{"type":"text","text":" is called. Also clears the existing people profile and charges."}],"type":"paragraph"},{"level":4,"anchor":"optInTrackingdistinctIDproperties-async","text":"`optInTracking(distinctID:properties:) async`","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Forwards to ","type":"text"},{"code":"MixpanelInstance.optInTracking(distinctId:properties:)","type":"codeVoice"},{"text":". Optionally identifies the user and records people-profile properties as part of opting in.","type":"text"}]},{"type":"heading","text":"`hasOptedOutTracking() async -> Bool`","anchor":"hasOptedOutTracking-async-%3E-Bool","level":4},{"type":"paragraph","inlineContent":[{"type":"text","text":"Forwards to "},{"type":"codeVoice","code":"MixpanelInstance.hasOptedOutTracking()"},{"type":"text","text":"."}]},{"type":"heading","text":"`setLoggingEnabled(_:) async`","anchor":"setLoggingEnabled-async","level":4},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"code":"MixpanelInstance.loggingEnabled","type":"codeVoice"},{"type":"text","text":". Useful during development; disable in release."}]},{"type":"heading","text":"`setUseIPAddressForGeoLocation(_:) async`","anchor":"setUseIPAddressForGeoLocation-async","level":4},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"MixpanelInstance.useIPAddressForGeoLocation"},{"type":"text","text":". Disable when your privacy policy forbids IP-based geo resolution."}]}]}],"kind":"article","variants":[{"paths":["\/documentation\/swiduxmixpanelanalytics\/servicereference"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"abstract":[{"type":"text","text":"API reference for "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService"},{"type":"text","text":" — the Mixpanel-backed "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" conformer that the analytics plugin consumes."}],"hierarchy":{"paths":[["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics"]]},"metadata":{"role":"article","title":"Service Reference","roleHeading":"Article","modules":[{"name":"SwiduxMixpanelAnalytics"}]},"identifier":{"url":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ServiceReference","interfaceLanguage":"swift"},"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ValueTranslation","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockServiceReference","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService"],"anchor":"Related-Documentation"},{"generated":true,"identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockServiceReference"],"title":"Reference","anchor":"Reference"}],"references":{"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics":{"url":"\/documentation\/swiduxmixpanelanalytics","title":"SwiduxMixpanelAnalytics","t
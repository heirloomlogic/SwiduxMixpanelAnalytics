{"sections":[],"abstract":[{"type":"text","text":"API reference for "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService"},{"type":"text","text":" — the Mixpanel-backed "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" conformer that the analytics plugin consumes."}],"kind":"article","primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"MixpanelAnalyticsService"},{"text":" adapts a ","type":"text"},{"type":"codeVoice","code":"MixpanelInstance"},{"text":" to the ","type":"text"},{"type":"codeVoice","code":"AnalyticsService"},{"text":" protocol that ","type":"text"},{"type":"codeVoice","code":"SwiduxAnalytics.AnalyticsPlugin"},{"text":" requires. It does one job: forward ","type":"text"},{"type":"codeVoice","code":"AnalyticsEvent"},{"text":", identify, alias, reset, and flush calls to the underlying SDK while translating ","type":"text"},{"type":"codeVoice","code":"AnalyticsValue"},{"text":" into Mixpanel’s ","type":"text"},{"type":"codeVoice","code":"Properties"},{"text":" payload. Configuration of the Mixpanel SDK itself remains the caller’s responsibility.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For a step-by-step integration walkthrough, see ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService"},{"text":". For value-mapping rules, see ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ValueTranslation"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Library-target","text":"Library target","type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"Product: ","type":"text"},{"code":"Swid
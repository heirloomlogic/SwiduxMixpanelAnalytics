{"metadata":{"role":"article","modules":[{"name":"SwiduxMixpanelAnalytics"}],"title":"Service Reference","roleHeading":"Article"},"abstract":[{"type":"text","text":"API reference for "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService"},{"type":"text","text":" — the Mixpanel-backed "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" conformer that the analytics plugin consumes."}],"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"paths":["\/documentation\/swiduxmixpanelanalytics\/servicereference"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"inlineContent":[{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"type":"text","text":" owns the Mixpanel SDK on the app’s behalf. The token-taking initializer calls "},{"code":"Mixpanel.initialize","type":"codeVoice"},{"type":"text","text":" internally; runtime GDPR \/ diagnostic toggles are methods on the service. The app never needs to "},{"code":"import Mixpanel","type":"codeVoice"},{"type":"text","text":" on the happy path."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For a step-by-step integration walkthrough, see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService"},{"type":"text","text":". For value-mapping rules, see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ValueTranslation"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Library target","anchor":"Library-target"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Product: "},{"type":"codeVoice","code":"SwiduxMixpanelAnalytics"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Import: ","type":"text"},{"type":"codeVoice","code":"import SwiduxMixpanelAnalytics"}]}]}]},{"inlineContent":[{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":[".product(name: \"SwiduxMixpanelAnalytics\", package: \"SwiduxMixpanelAnalytics\"),"]},{"text":"Types","anchor":"Types","type":"heading","level":2},{"text":"``doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService``","anchor":"docSwiduxMixpanelAnalyticsdocumentationSwiduxMixpanelAnalyticsMixpanelAnalyticsService","type":"heading","level":3},{"type":"codeListing","syntax":"swift","code":["public struct MixpanelAnalyticsService: AnalyticsService, @unchecked Sendable {","    \/\/ Identical on every platform.","    public init(","        token: String,","        trackAutomaticEvents: Bool = false,","        flushInterval: Double = 60,","        instanceName: String? = nil,","        optOutTrackingByDefault: Bool = false,","        useUniqueDistinctId: Bool = false,","        deviceIdProvider: (@Sendable () -> String?)? = nil,","        superProperties: [String: AnalyticsValue]? = nil,","        serverURL: String? = nil,","        useGzipCompression: Bool = true,","        excludeProperties: Set<String> = []","    )","","    public init(instance: MixpanelInstance)","}"]},{"inlineContent":[{"type":"text","text":"Value type holding a single reference to a "},{"type":"codeVoice","code":"MixpanelInstance"},{"type":"text","text":". "},{"type":"codeVoice","code":"@unchecked Sendable"},{"type":"text","text":" is justified by Mixpanel’s documented thread-safety. Cheap to pass into "},{"type":"codeVoice","code":"AnalyticsPlugin"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Initializers","anchor":"Initializers","type":"heading","level":4},{"type":"codeListing","syntax":"swift","code":["public init(token: String, ...)"]},{"inlineContent":[{"type":"text","text":"Builds a "},{"type":"codeVoice","code":"MixpanelOptions"},{"type":"text","text":" and calls "},{"type":"codeVoice","code":"Mixpanel.initialize(options:)"},{"type":"text","text":" internally, retaining the resulting instance. Parameters mirror "},{"type":"codeVoice","code":"MixpanelOptions"},{"type":"text","text":" — including its "},{"type":"codeVoice","code":"useGzipCompression: true"},{"type":"text","text":" default; "},{"type":"codeVoice","code":"superProperties"},{"type":"text","text":" takes "},{"type":"codeVoice","code":"[String: AnalyticsValue]"},{"type":"text","text":" so the app does not need to reference "},{"type":"codeVoice","code":"MixpanelType"},{"type":"text","text":", and "},{"type":"codeVoice","code":"deviceIdProvider"},{"text":" supplies a custom stable device ID (see ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","isActive":true},{"type":"text","text":" for the contract: cached value only, no inline I\/O)."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The Mixpanel SDK keys instances by ","type":"text"},{"type":"codeVoice","code":"instanceName"},{"text":" (falling back to ","type":"text"},{"type":"codeVoice","code":"token"},{"text":"); constructing a second service with the same name returns the existing SDK instance and silently ignores the new options.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["public init(instance: MixpanelInstance)"]},{"type":"paragraph","inlineContent":[{"text":"Escape hatch for apps that need to build their own ","type":"text"},{"type":"codeVoice","code":"MixpanelInstance"},{"text":" (for example, to use ","type":"text"},{"type":"codeVoice","code":"ProxyServerConfig"},{"text":"). Most apps should prefer the token initializer; this is the only path that requires ","type":"text"},{"type":"codeVoice","code":"import Mixpanel"},{"text":" in your app.","type":"text"}]},{"level":4,"anchor":"track-async","type":"heading","text":"`track(_:) async`"},{"type":"paragraph","inlineContent":[{"text":"Forwards to ","type":"text"},{"type":"codeVoice","code":"MixpanelInstance.track(event:properties:)"},{"text":". Empty ","type":"text"},{"type":"codeVoice","code":"properties"},{"text":" are passed as ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" rather than an empty dictionary. Returns immediately; Mixpanel batches and flushes on its own schedule.","type":"text"}]},{"level":4,"anchor":"identifyuserIDproperties-async","type":"heading","text":"`identify(userID:properties:) async`"},{"type":"paragraph","inlineContent":[{"text":"Forwards to ","type":"text"},{"type":"codeVoice","code":"MixpanelInstance.identify(distinctId:)"},{"text":", then — if ","type":"text"},{"type":"codeVoice","code":"properties"},{"text":" is non-empty — calls ","type":"text"},{"type":"codeVoice","code":"instance.people.set(properties:)"},{"text":" to update people-level properties. Empty ","type":"text"},{"type":"codeVoice","code":"userID"},{"text":"s are dropped entirely: the SDK rejects blank distinct IDs, and forwarding the people update anyway would attribute it to the previous identity.","type":"text"}]},{"level":4,"anchor":"aliasnewIDpreviousID-async","type":"heading","text":"`alias(newID:previousID:) async`"},{"type":"paragraph","inlineContent":[{"text":"Forwards to ","type":"text"},{"type":"codeVoice","code":"MixpanelInstance.createAlias(_:distinctId:)"},{"text":". When ","type":"text"},{"type":"codeVoice","code":"previousID"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":", the call uses ","type":"text"},{"type":"codeVoice","code":"instance.distinctId"},{"text":" as the source ID, matching Mixpanel’s recommended anonymous-to-identified aliasing flow. Empty ","type":"text"},{"type":"codeVoice","code":"newID"},{"text":"s are dropped, mirroring the SDK’s blank-alias rejection.","type":"text"}]},{"level":4,"anchor":"reset-async","type":"heading","text":"`reset() async`"},{"type":"paragraph","inlineContent":[{"text":"Forwards to ","type":"text"},{"type":"codeVoice","code":"MixpanelInstance.reset(completion:)"},{"text":" and awaits its callback. Clears Mixpanel’s local distinct ID, super properties, and identity.","type":"text"}]},{"level":4,"anchor":"flush-async","type":"heading","text":"`flush() async`"},{"type":"paragraph","inlineContent":[{"text":"Forwards to ","type":"text"},{"type":"codeVoice","code":"MixpanelInstance.flush(completion:)"},{"text":" and awaits its callback. The plugin’s own ","type":"text"},{"type":"codeVoice","code":"flush()"},{"text":" is the deterministic sync point in tests — it awaits all pending fire-and-forget tracking tasks and then calls this.","type":"text"}]},{"level":4,"anchor":"optOutTracking-async","type":"heading","text":"`optOutTracking() async`"},{"type":"paragraph","inlineContent":[{"text":"Forwards to ","type":"text"},{"type":"codeVoice","code":"MixpanelInstance.optOutTracking()"},{"text":". Subsequent ","type":"text"},{"type":"codeVoice","code":"track"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"identify"},{"text":" calls are dropped until ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService\/optInTracking(distinctID:properties:)","type":"reference"},{"text":" is called. Also clears the existing people profile and charges.","type":"text"}]},{"level":4,"anchor":"optInTrackingdistinctIDproperties-async","type":"heading","text":"`optInTracking(distinctID:properties:) async`"},{"type":"paragraph","inlineContent":[{"text":"Forwards to ","type":"text"},{"type":"codeVoice","code":"MixpanelInstance.optInTracking(distinctId:properties:)"},{"text":". Optionally identifies the user and records people-profile properties as part of opting in.","type":"text"}]},{"level":4,"anchor":"hasOptedOutTracking-async-%3E-Bool","type":"heading","text":"`hasOptedOutTracking() async -> Bool`"},{"type":"paragraph","inlineContent":[{"text":"Forwards to ","type":"text"},{"type":"codeVoice","code":"MixpanelInstance.hasOptedOutTracking()"},{"text":".","type":"text"}]},{"level":4,"anchor":"setLoggingEnabled-async","type":"heading","text":"`setLoggingEnabled(_:) async`"},{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"type":"codeVoice","code":"MixpanelInstance.loggingEnabled"},{"text":". Useful during development; disable in release.","type":"text"}]},{"level":4,"anchor":"setUseIPAddressForGeoLocation-async","type":"heading","text":"`setUseIPAddressForGeoLocation(_:) async`"},{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"type":"codeVoice","code":"MixpanelInstance.useIPAddressForGeoLocation"},{"text":". Disable when your privacy policy forbids IP-based geo resolution.","type":"text"}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ServiceReference","interfaceLanguage":"swift"},"seeAlsoSections":[{"title":"Related Documentation","anchor":"Related-Documentation","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ValueTranslation","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockServiceReference","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService"]},{"title":"Reference","anchor":"Reference","generated":true,"identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockServiceReference"]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics"]]},"kind":"article","references":{"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MixpanelAnalyticsService":{"title":"MixpanelAnalyticsService","kind":"symbol","navigato
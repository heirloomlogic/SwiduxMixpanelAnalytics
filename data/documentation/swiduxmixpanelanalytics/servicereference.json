" on the happy path.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For a step-by-step integration walkthrough, see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService"},{"text":". For value-mapping rules, see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ValueTranslation"},{"text":".","type":"text"}]},{"text":"Library target","type":"heading","level":2,"anchor":"Library-target"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Product: "},{"type":"codeVoice","code":"SwiduxMixpanelAnalytics"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Import: "},{"type":"codeVoice","code":"import SwiduxMixpanelAnalytics"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Package.swift"},{"text":":","type":"text"}]},{"syntax":"swift","type":"codeListing","code":[".product(name: \"SwiduxMixpanelAnalytics\", package: \"SwiduxMixpanelAnalytics\"),"]},{"text":"Types","type":"heading","level":2,"anchor":"Types"},{"text":"``doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService``","type":"heading","level":3,"anchor":"docSwiduxMixpanelAnalyticsdocumentationSwiduxMixpanelAnalyticsMixpanelAnalyticsService"},{"syntax":"swift","type":"codeListing","code":["public struct MixpanelAnalyticsService: AnalyticsService, @unchecked Sendable {","    \/\/ iOS \/ tvOS \/ watchOS","    public init(","        token: String,","        trackAutomaticEvents: Bool = false,","        flushInterval: Double = 60,","        instanceName: String? = nil,","        optOutTrackingByDefault: Bool = false,","        useUniqueDistinctId: Bool = false,","        superProperties: [String: AnalyticsValue]? = nil,","        serverURL: String? = nil,","        useGzipCompression: Bool = false","    )","","    \/\/ macOS — same as above, minus `trackAutomaticEvents`.","    public init(","        token: String,","        flushInterval: Double = 60,","        instanceName: String? = nil,","        optOutTrackingByDefault: Bool = false,","        useUniqueDistinctId: Bool = false,","        superProperties: [String: AnalyticsValue]? = nil,","        serverURL: String? = nil,","        useGzipCompression: Bool = false","    )","","    public init(instance: MixpanelInstance)","}"]},{"type":"paragraph","inlineContent":[{"text":"Value type holding a single reference to a ","type":"text"},{"type":"codeVoice","code":"MixpanelInstance"},{"text":". ","type":"text"},{"type":"codeVoice","code":"@unchecked Sendable"},{"text":" is justified by Mixpanel’s documented thread-safety. Cheap to pass into ","type":"text"},{"type":"codeVoice","code":"AnalyticsPlugin"},{"text":".","type":"text"}]},{"text":"Initializers","type":"heading","level":4,"anchor":"Initializers"},{"syntax":"swift","type":"codeListing","code":["public init(token: String, ...)"]},{"type":"paragraph","inlineContent":[{"text":"Calls ","type":"text"},{"type":"codeVoice","code":"Mixpanel.initialize(token:...)"},{"text":" internally and retains the resulting instance. Parameters mirror the Mixpanel SDK; ","type":"text"},{"type":"codeVoice","code":"superProperties"},{"text":" takes ","type":"text"},{"type":"codeVoice","code":"[String: AnalyticsValue]"},{"text":" so the app does not need to reference ","type":"text"},{"type":"codeVoice","code":"MixpanelType"},{"text":". On macOS, ","type":"text"},{"type":"codeVoice","code":"trackAutomaticEvents"},{"text":" is omitted (the SDK does not accept it there).","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["public init(instance: MixpanelInstance)"]},{"type":"paragraph","inlineContent":[{"text":"Escape hatch for apps that need to build their own ","type":"text"},{"type":"codeVoice","code":"MixpanelInstance"},{"text":" (for example, to use ","type":"text"},{"type":"codeVoice","code":"ProxyServerConfig"},{"text":"). Most apps should prefer the token initializer; this is the only path that requires ","type":"text"},{"type":"codeVoice","code":"import Mixpanel"},{"text":" in your app.","type":"text"}]},{"text":"`track(_:) async`","type":"heading","level":4,"anchor":"track-async"},{"type":"paragraph","inlineContent":[{"text":"Forwards to ","type":"text"},{"type":"codeVoice","code":"MixpanelInstance.track(event:properties:)"},{"text":". Empty ","type":"text"},{"type":"codeVoice","code":"properties"},{"text":" are passed as ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" rather than an empty dictionary. Returns immediately; Mixpanel batches and flushes on its own schedule.","type":"text"}]},{"text":"`identify(userID:properties:) async`","type":"heading","level":4,"anchor":"identifyuserIDproperties-async"},{"type":"paragraph","inlineContent":[{"text":"Forwards to ","type":"text"},{"type":"codeVoice","code":"MixpanelInstance.identify(distinctId:)"},{"text":", then — if ","type":"text"},{"type":"codeVoice","code":"properties"},{"text":" is non-empty — calls ","type":"text"},{"type":"codeVoice","code":"instance.people.set(properties:)"},{"text":" to update people-level properties.","type":"text"}]},{"text":"`alias(newID:previousID:) async`","type":"heading","level":4,"anchor":"aliasnewIDpreviousID-async"},{"type":"paragraph","inlineContent":[{"text":"Forwards to ","type":"text"},{"type":"codeVoice","code":"MixpanelInstance.createAlias(_:distinctId:)"},{"text":". When ","type":"text"},{"type":"codeVoice","code":"previousID"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":", the call uses ","type":"text"},{"type":"codeVoice","code":"instance.distinctId"},{"text":" as the source ID, matching Mixpanel’s recommended anonymous-to-identified aliasing flow.","type":"text"}]},{"text":"`reset() async`","type":"heading","level":4,"anchor":"reset-async"},{"type":"para
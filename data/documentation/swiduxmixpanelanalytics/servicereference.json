{"kind":"article","metadata":{"modules":[{"name":"SwiduxMixpanelAnalytics"}],"roleHeading":"Article","title":"Service Reference","role":"article"},"abstract":[{"type":"text","text":"API reference for "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService"},{"type":"text","text":" — the Mixpanel-backed "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" conformer that the analytics plugin consumes."}],"variants":[{"paths":["\/documentation\/swiduxmixpanelanalytics\/servicereference"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MixpanelAnalyticsService"},{"type":"text","text":" owns the Mixpanel SDK on the app’s behalf. The token-taking initializer calls "},{"type":"codeVoice","code":"Mixpanel.initialize"},{"type":"text","text":" internally; runtime GDPR \/ diagnostic toggles are methods on the service. The app never needs to "},{"type":"codeVoice","code":"import Mixpanel"},{"type":"text","text":" on the happy path."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For a step-by-step integration walkthrough, see "},{"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","isActive":true},{"type":"text","text":". For value-mapping rules, see "},{"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ValueTranslation","isActive":true},{"type":"text","text":"."}]},{"type":"heading","level":2,"text":"Library target","anchor":"Library-target"},{"items":[{"content":[{"inlineContent":[{"text":"Product: ","type":"text"},{"code":"SwiduxMixpanelAnalytics","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Import: ","type":"text"},{"code":"import SwiduxMixpanelAnalytics","type":"codeVoice"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":[".product(name: \"SwiduxMixpanelAnalytics\", package: \"SwiduxMixpanelAnalytics\"),"]},{"type":"heading","level":2,"text":"Types","anchor":"Types"},{"type":"heading","level":3,"text":"``doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService``","anchor":"docSwiduxMixpanelAnalyticsdocumentationSwiduxMixpanelAnalyticsMixpanelAnalyticsService"},{"syntax":"swift","type":"codeListing","code":["public struct MixpanelAnalyticsService: AnalyticsService, @unchecked Sendable {","    \/\/ Identical on every platform.","    public init(","        token: String,","        trackAutomaticEvents: Bool = false,","        flushInterval: Double = 60,","        instanceName: String? = nil,","        optOutTrackingByDefault: Bool = false,","        useUniqueDistinctId: Bool = false,","        deviceIdProvider: (@Sendable () -> String?)? = nil,","        superProperties: [String: AnalyticsValue]? = nil,","        serverURL: String? = nil,","        useGzipCompression: Bool = true,","        excludeProperties: Set<String> = []","    )","","    public init(instance: MixpanelInstance)","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Value type holding a single reference to a "},{"type":"codeVoice","code":"MixpanelInstance"},{"type":"text","text":". "},{"type":"codeVoice","code":"@unchecked Sendable"},{"type":"text","text":" is justified by Mixpanel’s documented thread-safety. Cheap to pass into "},{"type":"codeVoice","code":"AnalyticsPlugin"},{"type":"text","text":"."}]},{"type":"heading","level":4,"text":"Initializers","anchor":"Initializers"},{"syntax":"swift","type":"codeListing","code":["public init(token: String, ...)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Builds a "},{"type":"codeVoice","code":"MixpanelOptions"},{"type":"text","text":" and calls "},{"type":"codeVoice","code":"Mixpanel.initialize(options:)"},{"type":"text","text":" internally, retaining the resulting instance. Parameters mirror "},{"type":"codeVoice","code":"MixpanelOptions"},{"type":"text","text":" — including its "},{"type":"codeVoice","code":"useGzipCompression: true"},{"type":"text","text":" default; "},{"type":"codeVoice","code":"superProperties"},{"type":"text","text":" takes "},{"type":"codeVoice","code":"[String: AnalyticsValue]"},{"type":"text","text":" so the app does not need to reference "},{"type":"codeVoice","code":"MixpanelType"},{"text":", and ","type":"text"},{"code":"deviceIdProvider","type":"codeVoice"},{"text":" supplies a custom stable device ID (see ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","isActive":true},{"type":"text","text":" for the contract: cached value only, no inline I\/O)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Mixpanel SDK keys instances by "},{"type":"codeVoice","code":"instanceName"},{"type":"text","text":" (falling back to "},{"type":"codeVoice","code":"token"},{"type":"text","text":"); constructing a second service with the same name returns the existing SDK instance and silently ignores the new options."}]},{"type":"codeListing","syntax":"swift","code":["public init(instance: MixpanelInstance)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Escape hatch for apps that need to build their own "},{"type":"codeVoice","code":"MixpanelInstance"},{"type":"text","text":" (for example, to use "},{"type":"codeVoice","code":"ProxyServerConfig"},{"type":"text","text":"). Most apps should prefer the token initializer; this is the only path that requires "},{"type":"codeVoice","code":"import Mixpanel"},{"type":"text","text":" in your app."}]},{"type":"heading","anchor":"track-async","level":4,"text":"`track(_:) async`"},{"type":"paragraph","inlineContent":[{"text":"Forwards to ","type":"text"},{"code":"MixpanelInstance.track(event:properties:)","type":"codeVoice"},{"text":". Empty ","type":"text"},{"type":"codeVoice","code":"properties"},{"text":" are passed as ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" rather than an empty dictionary. Returns immediately; Mixpanel batches and flushes on its own schedule.","type":"text"}]},{"level":4,"anchor":"identifyuserIDproperties-async","type":"heading","text":"`identify(userID:properties:) async`"},{"inlineContent":[{"type":"text","text":"Forwards to "},{"type":"codeVoice","code":"MixpanelInstance.identify(distinctId:)"},{"text":", then — if ","type":"text"},{"code":"properties","type":"codeVoice"},{"type":"text","text":" is non-empty — calls "},{"code":"instance.people.set(properties:)","type":"codeVoice"},{"type":"text","text":" to update people-level properties. Empty "},{"code":"userID","type":"codeVoice"},{"type":"text","text":"s are dropped entirely: the SDK rejects blank distinct IDs, and forwarding the people update anyway would attribute it to the previous identity."}],"type":"paragraph"},{"level":4,"anchor":"aliasnewIDpreviousID-async","type":"heading","text":"`alias(newID:previousID:) async`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Forwards to "},{"code":"MixpanelInstance.createAlias(_:distinctId:)","type":"codeVoice"},{"text":". When ","type":"text"},{"type":"codeVoice","code":"previousID"},{"type":"text","text":" is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", the call uses "},{"type":"codeVoice","code":"instance.distinctId"},{"type":"text","text":" as the source ID, matching Mixpanel’s recommended anonymous-to-identified aliasing flow. Empty "},{"type":"codeVoice","code":"newID"},{"type":"text","text":"s are dropped, mirroring the SDK’s blank-alias rejection."}]},{"type":"heading","level":4,"text":"`reset() async`","anchor":"reset-async"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Forwards to "},{"type":"codeVoice","code":"MixpanelInstance.reset(completion:)"},{"type":"text","text":" and awaits its callback. Clears Mixpanel’s local distinct ID, super properties, and identity."}]},{"type":"heading","anchor":"flush-async","level":4,"text":"`flush() async`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Forwards to "},{"type":"codeVoice","code":"MixpanelInstance.flush(completion:)"},{"type":"text","text":" and awaits its callback. The plugin’s own "},{"type":"codeVoice","code":"flush()"},{"type":"text","text":" is the deterministic sync point in tests — it awaits all pending fire-and-forget tracking tasks and then calls this."}]},{"level":4,"anchor":"optOutTracking-async","type":"heading","text":"`optOutTracking() async`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Forwards to "},{"type":"codeVoice","code":"MixpanelInstance.optOutTracking()"},{"type":"text","text":". Subsequent "},{"type":"codeVoice","code":"track"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"identify"},{"type":"text","text":" calls are dropped until "},{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService\/optInTracking(distinctID:properties:)","type":"reference","isActive":true},{"type":"text","text":" is called. Also clears the existing people profile and charges."}]},{"type":"heading","level":4,"text":"`optInTracking(distinctID:properties:) async`","anchor":"optInTrackingdistinctIDproperties-async"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Forwards to "},{"type":"codeVoice","code":"MixpanelInstance.optInTracking(distinctId:properties:)"},{"type":"text","text":". Optionally identifies the user and records people-profile properties as part of opting in."}]},{"type":"heading","level":4,"text":"`hasOptedOutTracking() async -> Bool`","anchor":"hasOptedOutTracking-async-%3E-Bool"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Forwards to "},{"type":"codeVoice","code":"MixpanelInstance.hasOptedOutTracking()"},{"type":"text","text":"."}]},{"type":"heading","level":4,"text":"`setLoggingEnabled(_:) async`","anchor":"setLoggingEnabled-async"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"MixpanelInstance.loggingEnabled"},{"type":"text","text":". Useful during development; disable in release."}]},{"level":4,"type":"heading","text":"`setUseIPAddressForGeoLocation(_:) async`","anchor":"setUseIPAddressForGeoLocation-async"},{"inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"MixpanelInstance.useIPAddressForGeoLocation"},{"type":"text","text":". Disable when your privacy policy forbids IP-based geo resolution."}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ServiceReference","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics"]]},"seeAlsoSections":[{"identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ValueTranslation","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockServiceReference","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService"],"anchor":"Related-Documentation","title":"Related Documentation"},{"identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockServiceReference"],"anchor":"Reference","title":"Reference","generated":true}],"references":{"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MixpanelAnalyticsService/optInTracking(distinctID:properties:)":{"kind":"symbol","abstr
{"metadata":{"modules":[{"name":"SwiduxMixpanelAnalytics"}],"roleHeading":"Article","title":"Service Reference","role":"article"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"MixpanelAnalyticsService"},{"type":"text","text":" owns the Mixpanel SDK on the app’s behalf. The token-taking initializer calls "},{"type":"codeVoice","code":"Mixpanel.initialize"},{"type":"text","text":" internally; runtime GDPR \/ diagnostic toggles are methods on the service. The app never needs to "},{"type":"codeVoice","code":"import Mixpanel"},{"type":"text","text":" on the happy path."}],"type":"paragraph"},{"inlineContent":[{"text":"For a step-by-step integration walkthrough, see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService"},{"text":". For value-mapping rules, see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ValueTranslation"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Library-target","level":2,"text":"Library target","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Product: "},{"type":"codeVoice","code":"SwiduxMixpanelAnalytics"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Import: "},{"type":"codeVoice","code":"import SwiduxMixpanelAnalytics"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":[".product(name: \"SwiduxMixpanelAnalytics\", package: \"SwiduxMixpanelAnalytics\"),"]},{"type":"heading","level":2,"text":"Types","anchor":"Types"},{"type":"heading","level":3,"text":"``doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService``","anchor":"docSwiduxMixpanelAnalyticsdocumentationSwiduxMixpanelAnalyticsMixpanelAnalyticsService"},{"type":"codeListing","syntax":"swift","code":["public struct MixpanelAnalyticsService: AnalyticsService, @unchecked Sendable {","    \/\/ Identical on every platform.","    public init(","        token: String,","        trackAutomaticEvents: Bool = false,","        flushInterval: Double = 60,","        instanceName: String? = nil,","        optOutTrackingByDefault: Bool = false,","        useUniqueDistinctId: Bool = false,","        superProperties: [String: AnalyticsValue]? = nil,","        serverURL: String? = nil,","        useGzipCompression: Bool = true,","        excludeProperties: Set<String> = []","    )","","    public init(instance: MixpanelInstance)","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Value type holding a single reference to a "},{"code":"MixpanelInstance","type":"codeVoice"},{"type":"text","text":". "},{"code":"@unchecked Sendable","type":"codeVoice"},{"type":"text","text":" is justified by Mixpanel’s documented thread-safety. Cheap to pass into "},{"code":"AnalyticsPlugin","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"heading","level":4,"text":"Initializers","anchor":"Initializers"},{"type":"codeListing","syntax":"swift","code":["public init(token: String, ...)"]},{"type":"paragraph","inlineContent":[{"text":"Builds a ","type":"text"},{"code":"MixpanelOptions","type":"codeVoice"},{"text":" and calls ","type":"text"},{"code":"Mixpanel.initialize(options:)","type":"codeVoice"},{"text":" internally, retaining the resulting instance. Parameters mirror ","type":"text"},{"code":"MixpanelOptions","type":"codeVoice"},{"text":" — including its ","type":"text"},{"code":"useGzipCompression: true","type":"codeVoice"},{"text":" default; ","type":"text"},{"code":"superProperties","type":"codeVoice"},{"text":" takes ","type":"text"},{"code":"[String: AnalyticsValue]","type":"codeVoice"},{"text":" so the app does not need to reference ","type":"text"},{"code":"MixpanelType","type":"codeVoice"},{"text":".","type":"text"}]},{"code":["public init(instance: MixpanelInstance)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Escape hatch for apps that need to build their own "},{"type":"codeVoice","code":"MixpanelInstance"},{"type":"text","text":" (for example, to use "},{"type":"codeVoice","code":"ProxyServerConfig"},{"type":"text","text":"). Most apps should prefer the token initializer; this is the only path that requires "},{"type":"codeVoice","code":"import Mixpanel"},{"type":"text","text":" in your app."}],"type":"paragraph"},{"level":4,"type":"heading","text":"`track(_:) async`","anchor":"track-async"},{"inlineContent":[{"type":"text","text":"Forwards to "},{"type":"codeVoice","code":"MixpanelInstance.track(event:properties:)"},{"type":"text","text":". Empty "},{"type":"codeVoice","code":"properties"},{"type":"text","text":" are passed as "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" rather than an empty dictionary. Returns immediately; Mixpanel batches and flushes on its own schedule."}],"type":"paragraph"},{"level":4,"type":"heading","text":"`identify(userID:properties:) async`","anchor":"identifyuserIDproperties-async"},{"inlineContent":[{"type":"text","text":"Forwards to "},{"type":"codeVoice","code":"MixpanelInstance.identify(distinctId:)"},{"type":"text","text":", then — if "},{"type":"codeVoice","code":"properties"},{"type":"text","text":" is non-empty — calls "},{"type":"codeVoice","code":"instance.people.set(properties:)"},{"type":"text","text":" to update people-level properties."}],"type":"paragraph"},{"level":4,"type":"heading","text":"`alias(newID:previousID:) async`","anchor":"aliasnewIDpreviousID-async"},{"inlineContent":[{"type":"text","text":"Forwards to "},{"type":"codeVoice","code":"MixpanelInstance.createAlias(_:distinctId:)"},{"type":"text","text":". When "},{"type":"codeVoice","code":"previousID"},{"type":"text","text":" is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", the call uses "},{"code":"instance.distinctId","type":"codeVoice"},{"type":"text","text":" as the source ID, matching Mixpanel’s recommended anonymous-to-identified aliasing flow."}],"type":"paragraph"},{"type":"heading","level":4,"anchor":"reset-async","text":"`reset() async`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Forwards to "},{"type":"codeVoice","code":"MixpanelInstance.reset(completion:)"},{"type":"text","text":" and awaits its callback. Clears Mixpanel’s local distinct ID, super properties, and identity."}]},{"type":"heading","level":4,"anchor":"flush-async","text":"`flush() async`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Forwards to "},{"type":"codeVoice","code":"MixpanelInstance.flush(completion:)"},{"type":"text","text":" and awaits its callback. The plugin’s own "},{"type":"codeVoice","code":"flush()"},{"type":"text","text":" is the deterministic sync point in tests — it awaits all pending fire-and-forget tracking tasks and then calls this."}]},{"type":"heading","level":4,"anchor":"optOutTracking-async","text":"`optOutTracking() async`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Forwards to "},{"type":"codeVoice","code":"MixpanelInstance.optOutTracking()"},{"type":"text","text":". Subsequent "},{"type":"codeVoice","code":"track"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"identify"},{"type":"text","text":" calls are dropped until "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService\/optInTracking(distinctID:properties:)"},{"type":"text","text":" is called. Also clears the existing people profile and charges."}]},{"type":"heading","level":4,"anchor":"optInTrackingdistinctIDproperties-async","text":"`optInTracking(distinctID:properties:) async`"},{"type":"paragraph","inlineContent":[{"text":"Forwards to ","type":"text"},{"code":"MixpanelInstance.optInTracking(distinctId:properties:)","type":"codeVoice"},{"text":". Optionally identifies the user and records people-profile properties as part of opting in.","type":"text"}]},{"type":"heading","level":4,"anchor":"hasOptedOutTracking-async-%3E-Bool","text":"`hasOptedOutTracking() async -> Bool`"},{"type":"paragraph","inlineContent":[{"text":"Forwards to ","type":"text"},{"type":"codeVoice","code":"MixpanelInstance.hasOptedOutTracking()"},{"type":"text","text":"."}]},{"text":"`setLoggingEnabled(_:) async`","anchor":"setLoggingEnabled-async","level":4,"type":"heading"},{"inlineContent":[{"text":"Sets ","type":"text"},{"code":"MixpanelInstance.loggingEnabled","type":"codeVoice"},{"text":". Useful during development; disable in release.","type":"text"}],"type":"paragraph"},{"text":"`setUseIPAddressForGeoLocation(_:) async`","anchor":"setUseIPAddressForGeoLocation-async","level":4,"type":"heading"},{"inlineContent":[{"text":"Sets ","type":"text"},{"code":"MixpanelInstance.useIPAddressForGeoLocation","type":"codeVoice"},{"text":". Disable when your privacy policy forbids IP-based geo resolution.","type":"text"}],"type":"paragraph"}]}],"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxmixpanelanalytics\/servicereference"]}],"sections":[],"abstract":[{"text":"API reference for ","type":"text"},{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService","isActive":true,"type":"reference"},{"text":" — the Mixpanel-backed ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" conformer that the analytics plugin consumes.","type":"text"}],"identifier":{"url":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ServiceReference","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"major":0,"patch":0},"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux
{"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"kind":"article","abstract":[{"type":"text","text":"API reference for "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService"},{"type":"text","text":" — the Mixpanel-backed "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" conformer that the analytics plugin consumes."}],"seeAlsoSections":[{"identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ValueTranslation","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockServiceReference","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService"],"title":"Related Documentation","anchor":"Related-Documentation"},{"identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockServiceReference"],"title":"Reference","anchor":"Reference","generated":true}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"type":"text","text":" owns the Mixpanel SDK on the app’s behalf. The token-taking initializer calls "},{"code":"Mixpanel.initialize","type":"codeVoice"},{"type":"text","text":" internally; runtime GDPR \/ diagnostic toggles are methods on the service. The app never needs to "},{"code":"import Mixpanel","type":"codeVoice"},{"type":"text","text":" on the happy path."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For a step-by-step integration walkthrough, see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService"},{"type":"text","text":". For value-mapping rules, see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ValueTranslation"},{"type":"text","text":"."}]},{"type":"heading","level":2,"anchor":"Library-target","text":"Library target"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Product: "},{"type":"codeVoice","code":"SwiduxMixpanelAnalytics"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Import: "},{"type":"codeVoice","code":"import SwiduxMixpanelAnalytics"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"code":"Package.swift","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","code":[".product(name: \"SwiduxMixpanelAnalytics\", package: \"SwiduxMixpanelAnalytics\"),"],"syntax":"swift"},{"type":"heading","level":2,"anchor":"Types","text":"Types"},{"type":"heading","level":3,"anchor":"docSwiduxMixpanelAnalyticsdocumentationSwiduxMixpanelAnalyticsMixpanelAnalyticsService","text":"``doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService``"},{"type":"codeListing","code":["public struct MixpanelAnalyticsService: AnalyticsService, @unchecked Sendable {","    \/\/ Identical on every platform.","    public init(","        token: String,","        trackAutomaticEvents: Bool = false,","        flushInterval: Double = 60,","        instanceName: String? = nil,","        optOutTrackingByDefault: Bool = false,","        useUniqueDistinctId: Bool = false,","        deviceIdProvider: (@Sendable () -> String?)? = nil,","        superProperties: [String: AnalyticsValue]? = nil,","        serverURL: String? = nil,","        useGzipCompression: Bool = true,","        excludeProperties: Set<String> = []","    )","","    public init(instance: MixpanelInstance)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Value type holding a single reference to a "},{"code":"MixpanelInstance","type":"codeVoice"},{"type":"text","text":". "},{"code":"@unchecked Sendable","type":"codeVoice"},{"type":"text","text":" is justified by Mixpanel’s documented thread-safety. Cheap to pass into "},{"code":"AnalyticsPlugin","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"heading","level":4,"anchor":"Initializers","text":"Initializers"},{"type":"codeListing","code":["public init(token: String, ...)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Builds a "},{"code":"MixpanelOptions","type":"codeVoice"},{"type":"text","text":" and calls "},{"code":"Mixpanel.initialize(options:)","type":"codeVoice"},{"type":"text","text":" internally, retaining the resulting instance. Parameters mirror "},{"code":"MixpanelOptions","type":"codeVoice"},{"type":"text","text":" — including its "},{"code":"useGzipCompression: true","type":"codeVoice"},{"type":"text","text":" default; "},{"code":"superProperties","type":"codeVoice"},{"type":"text","text":" takes "},{"code":"[String: AnalyticsValue]","type":"codeVoice"},{"type":"text","text":" so the app does not need to reference "},{"code":"MixpanelType","type":"codeVoice"},{"type":"text","text":", and "},{"code":"deviceIdProvider","type":"codeVoice"},{"type":"text","text":" supplies a custom stable device ID (see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService"},{"type":"text","text":" for the contract: cached value only, no inline I\/O)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Mixpanel SDK keys instances by "},{"code":"instanceName","type":"codeVoice"},{"type":"text","text":" (falling back to "},{"code":"token","type":"codeVoice"},{"type":"text","text":"); constructing a second service with the same name returns the existing SDK instance and silently ignores the new options."}]},{"type":"codeListing","code":["public init(instance: MixpanelInstance)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Escape hatch for apps that need to build their own "},{"code":"MixpanelInstance","type":"codeVoice"},{"type":"text","text":" (for example, to use "},{"code":"ProxyServerConfig","type":"codeVoice"},{"type":"text","text":"). Most apps should prefer the token initializer; this is the only path that requires "},{"code":"import Mixpanel","type":"codeVoice"},{"type":"text","text":" in your app."}]},{"type":"heading","level":4,"anchor":"track-async","text":"`track(_:) async`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Forwards to "},{"code":"MixpanelInstance.track(event:properties:)","type":"codeVoice"},{"type":"text","text":". Empty "},{"code":"properties","type":"codeVoice"},{"type":"text","text":" are passed as "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" rather than an empty dictionary. Returns immediately; Mixpanel batches and flushes on its own schedule."}]},{"type":"heading","level":4,"anchor":"identifyuserIDproperties-async","text":"`identify(userID:properties:) async`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Forwards to "},{"code":"MixpanelInstance.identify(distinctId:)","type":"codeVoice"},{"type":"text","text":", then — if "},{"code":"properties","type":"codeVoice"},{"type":"text","text":" is non-empty — calls "},{"code":"instance.people.set(properties:)","type":"codeVoice"},{"type":"text","text":" to update people-level properties. Empty "},{"code":"userID","type":"codeVoice"},{"type":"text","text":"s are dropped entirely: the SDK rejects blank distinct IDs, and forwarding the people update anyway would attribute it to the previous identity."}]},{"type":"heading","level":4,"anchor":"aliasnewIDpreviousID-async","text":"`alias(newID:previousID:) async`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Forwards to "},{"code":"MixpanelInstance.createAlias(_:distinctId:)","type":"codeVoice"},{"type":"text","text":". When "},{"code":"previousID","type":"codeVoice"},{"type":"text","text":" is "},{"code":"nil","type":"codeVoice"},{"type":"text","text":", the call uses "},{"code":"instance.distinctId","type":"codeVoice"},{"type":"text","text":" as the source ID, matching Mixpanel’s recommended anonymous-to-identified aliasing flow. Empty "},{"code":"newID","type":"codeVoice"},{"type":"text","text":"s are dropped, mirroring the SDK’s blank-alias rejection."}]},{"type":"heading","level":4,"anchor":"reset-async","text":"`reset() async`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Forwards to "},{"code":"MixpanelInstance.reset(completion:)","type":"codeVoice"},{"type":"text","text":" and awaits its callback. Clears Mixpanel’s local distinct ID, super properties, and identity."}]},{"type":"heading","level":4,"anchor":"flush-async","text":"`flush() async`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Forwards to "},{"code":"MixpanelInstance.flush(completion:)","type":"codeVoice"},{"type":"text","text":" and awaits its callback. The plugin’s own "},{"code":"flush()","type":"codeVoice"},{"type":"text","text":" is the deterministic sync point in tests — it awaits all pending fire-and-forget tracking tasks and then calls this."}]},{"type":"heading","level":4,"anchor":"optOutTracking-async","text":"`optOutTracking() async`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Forwards to "},{"code":"MixpanelInstance.optOutTracking()","type":"codeVoice"},{"type":"text","text":". Subsequent "},{"code":"track","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"identify","type":"codeVoice"},{"type":"text","text":" calls are dropped until "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService\/optInTracking(distinctID:properties:)"},{"type":"text","text":" is called. Also clears the existing people profile and charges."}]},{"type":"heading","level":4,"anchor":"optInTrackingdistinctIDproperties-async","text":"`optInTracking(distinctID:properties:) async`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Forwards to "},{"code":"MixpanelInstance.optInTracking(distinctId:properties:)","type":"codeVoice"},{"type":"text","text":". Optionally identifies the user and records people-profile properties as part of opting in."}]},{"type":"heading","level":4,"anchor":"hasOptedOutTracking-async-%3E-Bool","text":"`hasOptedOutTracking() async -> Bool`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Forwards to "},{"code":"MixpanelInstance.hasOptedOutTracking()","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"heading","level":4,"anchor":"setLoggingEnabled-async","text":"`setLoggingEnabled(_:) async`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"code":"MixpanelInstance.loggingEnabled","type":"codeVoice"},{"type":"text","text":". Useful during development; disable in release."}]},{"type":"heading","level":4,"anchor":"setUseIPAddressForGeoLocation-async","text":"`setUseIPAddressForGeoLocation(_:) async`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"code":"MixpanelInstance.useIPAddressForGeoLocation","type":"codeVoice"},{"type":"text","text":". Disable when your privacy policy forbids IP-based geo resolution."}]}]}],"hierarchy":{"paths":[["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics"]]},"identifier":{"url":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ServiceReference","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Article","modules":[{"name":"SwiduxMixpanelAnalytics"}],"role":"article","title":"Service Reference"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxmixpanelanalytics\/servicereference"]}],"references":{"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MockServiceReference":{"abstract":[{"type":"text","text":"API reference for "},{"type":
{"identifier":{"url":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ServiceReference","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"article","seeAlsoSections":[{"anchor":"Related-Documentation","title":"Related Documentation","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ValueTranslation","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockServiceReference","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService"]},{"generated":true,"title":"Reference","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockServiceReference"],"anchor":"Reference"}],"sections":[],"abstract":[{"type":"text","text":"API reference for "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService"},{"type":"text","text":" — the Mixpanel-backed "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" conformer that the analytics plugin consumes."}],"metadata":{"roleHeading":"Article","modules":[{"name":"SwiduxMixpanelAnalytics"}],"title":"Service Reference","role":"article"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"type":"codeVoice","code":"MixpanelAnalyticsService"},{"type":"text","text":" owns the Mixpanel SDK on the app’s behalf. The token-taking initializer calls "},{"type":"codeVoice","code":"Mixpanel.initialize"},{"type":"text","text":" internally; runtime GDPR \/ diagnostic toggles are methods on the service. The app never needs to "},{"type":"codeVoice","code":"import Mixpanel"},{"type":"text","text":" on the happy path."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For a step-by-step integration walkthrough, see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService"},{"type":"text","text":". For value-mapping rules, see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ValueTranslation"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"anchor":"Library-target","type":"heading","text":"Library target"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Product: "},{"type":"codeVoice","code":"SwiduxMixpanelAnalytics"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Import: "},{"type":"codeVoice","code":"import SwiduxMixpanelAnalytics"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":[".product(name: \"SwiduxMixpanelAnalytics\", package: \"SwiduxMixpanelAnalytics\"),"]},{"level":2,"anchor":"Types","type":"heading","text":"Types"},{"level":3,"anchor":"docSwiduxMixpanelAnalyticsdocumentationSwiduxMixpanelAnalyticsMixpanelAnalyticsService","type":"heading","text":"``doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService``"},{"type":"codeListing","syntax":"swift","code":["public struct MixpanelAnalyticsService: AnalyticsService, @unchecked Sendable {","    \/\/ Identical on every platform.","    public init(","        token: String,","        trackAutomaticEvents: Bool = false,","        flushInterval: Double = 60,","        instanceName: String? = nil,","        optOutTrackingByDefault: Bool = false,","        useUniqueDistinctId: Bool = false,","        deviceIdProvider: (@Sendable () -> String?)? = nil,","        superProperties: [String: AnalyticsValue]? = nil,","        serverURL: String? = nil,","        useGzipCompression: Bool = true,","        excludeProperties: Set<String> = []","    )","","    public init(instance: MixpanelInstance)","","    public func setOptedOut(_ optedOut: Bool) async","    public func optOutTracking() async","    public func optInTracking(distinctID: String? = nil, properties: [String: AnalyticsValue]? = nil) async","    public func hasOptedOutTracking() async -> Bool","    public func setLoggingEnabled(_ enabled: Bool) async","    public func setUseIPAddressForGeoLocation(_ enabled: Bool) async","}"]},{"inlineContent":[{"type":"text","text":"Value type holding a reference to a "},{"type":"codeVoice","code":"MixpanelInstance"},{"type":"text","text":"; every copy shares the instance. It is "},{"type":"codeVoice","code":"@unchecked Sendable"},{"type":"text","text":" because the SDK serializes its tracking work on internal queues. The diagnostic setters are the exception — they write properties the SDK doesn’t synchronize, so call them once at launch. Cheap to pass into "},{"type":"codeVoice","code":"AnalyticsPlugin"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The SDK applies most calls later, on its own serial queue, while checking consent on the caller’s thread. The adapter closes the gaps that leaves; each method below says how."}],"type":"paragraph"},{"level":4,"anchor":"Initializers","type":"heading","text":"Initializers"},{"type":"codeListing","syntax":"swift","code":["public init(token: String, ...)"]},{"inlineContent":[{"type":"text","text":"Builds a "},{"type":"codeVoice","code":"MixpanelOptions"},{"type":"text","text":" and calls "},{"type":"codeVoice","code":"Mixpanel.initialize(options:)"},{"type":"text","text":" internally, retaining the resulting instance. Parameters mirror "},{"type":"codeVoice","code":"MixpanelOptions"},{"type":"text","text":" — including its "},{"type":"codeVoice","code":"useGzipCompression: true"},{"type":"text","text":" default; "},{"type":"codeVoice","code":"superProperties"},{"type":"text","text":" takes "},{"type":"codeVoice","code":"[String: AnalyticsValue]"},{"type":"text","text":" so the app does not need to reference "},{"type":"codeVoice","code":"MixpanelType"},{"type":"text","text":", and "},{"type":"codeVoice","code":"deviceIdProvider"},{"type":"text","text":" supplies a custom stable device ID (see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService"},{"type":"text","text":" for the contract: cached value only, no inline I\/O)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The Mixpanel SDK keys instances by "},{"type":"codeVoice","code":"instanceName"},{"type":"text","text":" (falling back to "},{"type":"codeVoice","code":"token"},{"type":"text","text":"); constructing a second service with the same name returns the existing SDK instance and silently ignores the new options. Services for different projects can safely be built concurrently: the adapter looks its instance up by name, working around an SDK race that could otherwise hand one service the other’s instance. "},{"type":"codeVoice","code":"superProperties"},{"type":"text","text":" are re-applied after "},{"type":"codeVoice","code":"reset()"},{"type":"text","text":" and after opting back in, since the SDK drops them at both points and ignores them while opted out."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["public init(instance: MixpanelInstance)"]},{"inlineContent":[{"type":"text","text":"Escape hatch for apps that need to build their own "},{"type":"codeVoice","code":"MixpanelInstance"},{"type":"text","text":" (for example, to use "},{"type":"codeVoice","code":"ProxyServerConfig"},{"type":"text","text":"). Most apps should prefer the token initializer; this is the only path that requires "},{"type":"codeVoice","code":"import Mixpanel"},{"type":"text","text":" in your app. Super properties registered on such an instance are the app’s to manage."}],"type":"paragraph"},{"level":4,"anchor":"track-async","type":"heading","text":"`track(_:) async`"},{"inlineContent":[{"type":"text","text":"Forwards to "},{"type":"codeVoice","code":"MixpanelInstance.track(event:properties:)"},{"type":"text","text":". Empty "},{"type":"codeVoice","code":"properties"},{"type":"text","text":" are passed as "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" rather than an empty dictionary, and properties that translate to null are omitted (see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ValueTranslation"},{"type":"text","text":"). Returns immediately; Mixpanel batches and flushes on its own schedule."}],"type":"paragraph"},{"level":4,"anchor":"identifyuserIDproperties-async","type":"heading","text":"`identify(userID:properties:) async`"},{"inlineContent":[{"type":"text","text":"Forwards to "},{"type":"codeVoice","code":"MixpanelInstance.identify(distinctId:)"},{"type":"text","text":", then sets "},{"type":"codeVoice","code":"properties"},{"type":"text","text":" on the user’s profile with "},{"type":"codeVoice","code":"instance.people.set(properties:)"},{"type":"text","text":"; properties that translate to null are unset instead. Empty "},{"type":"codeVoice","code":"userID"},{"type":"text","text":"s are dropped entirely: the SDK rejects blank distinct IDs, and forwarding the people update anyway would attribute it to the previous identity. Calls made while opted out are dropped."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When the user changes, everything queued for the previous user is sent first, and "},{"type":"codeVoice","code":"identify"},{"type":"text","text":" waits for it — the SDK attributes queued profile updates to whoever is identified when they are sent."}],"type":"paragraph"},{"level":4,"anchor":"aliasnewIDpreviousID-async","type":"heading","text":"`alias(newID:previousID:) async`"},{"inlineContent":[{"type":"text","text":"Forwards to "},{"type":"codeVoice","code":"MixpanelInstance.createAlias(_:distinctId:andIdentify:)"},{"type":"text","text":" with "},{"type":"codeVoice","code":"andIdentify: false"},{"type":"text","text":", so the alias never changes who is identified locally — the SDK default would re-identify the device as "},{"type":"codeVoice","code":"previousID"},{"type":"text","text":", undoing a preceding sign-in. When "},{"type":"codeVoice","code":"previousID"},{"type":"text","text":" is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", the anonymous distinct ID the device’s events were sent under is used. The SDK sends its queue after every alias, and "},{"type":"codeVoice","code":"alias"},{"type":"text","text":" waits for that so the send can’t overlap the next flush and duplicate rows. Empty "},{"type":"codeVoice","code":"newID"},{"type":"text","text":"s are dropped, mirroring the SDK’s blank-alias rejection. Projects on Mixpanel’s Simplified ID Merge ignore aliases; see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService"},{"type":"text","text":"."}],"type":"paragraph"},{"level":4,"anchor":"reset-async","type":"heading","text":"`reset() async`"},{"inlineContent":[{"type":"text","text":"Sends everything queued and waits for it, then forwards to "},{"type":"codeVoice","code":"MixpanelInstance.reset(completion:)"},{"type":"text","text":" and awaits its callback — the SDK’s own "},{"type":"codeVoice","code":"reset()"},{"type":"text","text":" sends one 50-record batch and deletes the rest. Clears Mixpanel’s local distinct ID, super properties, and timed events, then re-applies the initializer’s super properties. While opted out it leaves the SDK alone: its "},{"type":"codeVoice","code":"reset()"},{"type":"text","text":" would also erase the persisted opt-out, and the user would be tracked again from the next launch."}],"type":"paragraph"},{"level":4,"anchor":"flush-async","type":"heading","text":"`flush() async`"},{"inlineContent":[{"type":"text","text":"Forwards to "},{"type":"codeVoice","code":"MixpanelInstance.flush(performFullFlush: true, completion:)"},{"type":"text","text":" and awaits its callback, so the whole queue is sent rather than the SDK’s default 50-record batch. The SDK sends one request per 50 records, each bounded at 120 seconds, and stops at the first failure, so a hung server can hold this for minutes — use the plugin’s "},{"type":"codeVoice","code":"flush(timeout:)"},{"type":"text","text":" on shutdown paths. The SDK delivers the callback on the main queue; never block the main thread waiting for it. The plugin’s own "},{"type":"codeVoice","code":"flush()"},{"type":"text","text":" is the deterministic sync point in tests — it awaits all pending fire-and-forget tracking tasks and then calls this."}],"type":"paragraph"},{"level":4,"anchor":"setOptedOut-async","type":"heading","text":"`setOptedOut(_:) async`"},{"inlineContent":[{"type":"text","text":"Calls "},{"type":"codeVoice","code":"optOutTracking()"},{"type":"text","text":" for "},{"type":"codeVoice","code":"true"},{"type":"text","text":" and "},{"type":"codeVoice","code":"optInTracking()"},{"type":"text","text":" for "},{"type":"codeVoice","code":"false"},{"type":"text","text":". Shaped for the plugin’s "},{"type":"codeVoice","code":"onConsentChange"},{"type":"text","text":" hook: "},{"type":"codeVoice","code":"onConsentChange: { await service.setOptedOut($0) }"},{"type":"text","text":"."}],"type":"paragraph"},{"level":4,"anchor":"optOutTracking-async","type":"heading","text":"`optOutTracking() async`"},{"inlineContent":[{"type":"text","text":"Sends everything queued, resets the local identity, then forwards to "},{"type":"codeVoice","code":"MixpanelInstance.optOutTracking()"},{"type":"text","text":" and returns once the SDK has applied it. From then on "},{"type":"codeVoice","code":"track"},{"type":"text","text":", "},{"type":"codeVoice","code":"identify"},{"type":"text","text":", and "},{"type":"codeVoice","code":"alias"},{"type":"text","text":" are dropped until "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService\/optInTracking(distinctID:properties:)"},{"type":"text","text":". Does nothing when already opted out. Persists across launches."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It does "},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"type":"text","text":" delete the user’s Mixpanel profile. The SDK’s own opt-out queues a "},{"type":"codeVoice","code":"$delete"},{"type":"text","text":" that is never sent and that would later delete the next identified user’s profile; resetting the identity first stops it being queued. Use Mixpanel’s GDPR deletion API from your server to erase data."}],"type":"paragraph"},{"level":4,"anchor":"optInTrackingdistinctIDproperties-async","type":"heading","text":"`optInTracking(distinctID:properties:) async`"},{"inlineContent":[{"type":"text","text":"Forwards to "},{"type":"codeVoice","code":"MixpanelInstance.optInTracking(distinctId:properties:)"},{"type":"text","text":" and returns once the SDK has applied it, so an "},{"type":"codeVoice","code":"identify"},{"type":"text","text":" issued straight afterwards is honored. The SDK identifies the user as "},{"type":"codeVoice","code":"distinctID"},{"type":"text","text":" (when non-empty) and records a "},{"type":"codeVoice","code":"$opt_in"},{"type":"text","text":" event carrying "},{"type":"codeVoice","code":"properties"},{"type":"text","text":" — they are event properties, not profile properties. The event is queued a moment after the opt-in takes effect, so a "},{"type":"codeVoice","code":"flush()"},{"type":"text","text":" issued straight away may leave it for the next one. When the user is already opted in, no "},{"type":"codeVoice","code":"$opt_in"},{"type":"text","text":" is sent and only the "},{"type":"codeVoice","code":"distinctID"},{"type":"text","text":" identify happens. Before opting in, anything the SDK kept queued while opted out is discarded — only a stale profile deletion or unattributed leftovers can be there. The wait for the SDK is bounded at 30 seconds; hitting the bound logs a fault."}],"type":"paragraph"},{"level":4,"anchor":"hasOptedOutTracking-async-%3E-Bool","type":"heading","text":"`hasOptedOutTracking() async -> Bool`"},{"inlineContent":[{"type":"text","text":"Forwards to "},{"type":"codeVoice","code":"MixpanelInstance.hasOptedOutTracking()"},{"type":"text","text":". On a first launch with "},{"type":"codeVoice","code":"optOutTrackingByDefault"},{"type":"text","text":", it first waits for the SDK to apply the default — until it does, the SDK reports the user as opted in. (Not with "},{"type":"codeVoice","code":"init(instance:)"},{"type":"text","text":", which doesn’t know the instance’s options.)"}],"type":"paragraph"},{"level":4,"anchor":"setLoggingEnabled-async","type":"heading","text":"`setLoggingEnabled(_:) async`"},{"inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"MixpanelInstance.loggingEnabled"},{"type":"text","text":". Useful during development; disable in release. Set it once at launch."}],"type":"paragraph"},{"level":4,"anchor":"setUseIPAddressForGeoLocation-async","type":"heading","text":"`setUseIPAddressForGeoLocation(_:) async`"},{"inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"MixpanelInstance.useIPAddressForGeoLocation"},{"type":"text","text":". Disable when your privacy policy forbids IP-based geo resolution. Set it once at launch."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxmixpanelanalytics\/servicereference"]}],"hierarchy":{"paths":[["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics"]]},"references":{"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MixpanelAnalyticsService/optInTracking(distinctID:properties:)":{"type":"topic","abstract":[{"text":"Opts the user back into tracking and returns once the SDK has applied","type":"text"},{"text":" ","type":"text"},{"text":"it, so an ","type":"text"},{"code":"identify","type":"codeVoice"},{"text":" issued straight afterwards is honored.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"optInTracking"},{"kind":"text","text":"("},{"kind":"externalParam","text":"distinctID"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"properties"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:15SwiduxAnalytics0B5ValueO","kind":"typeIdentifier","text":"AnalyticsValue"},{"kind":"text","text":"]?) "},{"kind":"keyword","text":"async"}],"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService\/optInTracking(distinctID:properties:)","title":"optInTracking(distinctID:properties:)","url":"\/documentation\/swiduxmixpanelanalytics\/mixpanelanalyticsservice\/optintracking(distinctid:properties:)","kind":"symbol"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/HowToImplementService":{"type":"topic","abstract":[{"text":"Configure ","type":"text"},{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"text":" to match your privacy, residency, and batching needs — without ","type":"text"},{"code":"import Mixpanel","type":"codeVoice"},{"text":" in your app.","type":"text"}],"role":"article","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","title":"How to Implement the Service","url":"\/documentation\/swiduxmixpanelanalytics\/howtoimplementservice","kind":"article"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/ValueTranslation":{"type":"topic","abstract":[{"text":"How ","type":"text"},{"code":"AnalyticsValue","type":"codeVoice"},{"text":" cases map onto Mixpanel’s ","type":"text"},{"code":"MixpanelType","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Properties","type":"codeVoice"},{"text":".","type":"text"}],"role":"article","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ValueTranslation","title":"Value Translation","url":"\/documentation\/swiduxmixpanelanalytics\/valuetranslation","kind":"article"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics":{"kind":"symbol","role":"collection","title":"SwiduxMixpanelAnalytics","abstract":[{"text":"Mixpanel adapter for Swidux’s ","type":"text"},{"code":"AnalyticsPlugin","type":"codeVoice"},{"text":". Owns the Mixpanel SDK on the app’s behalf — ","type":"text"},{"code":"MixpanelAnalyticsService(token:)","type":"codeVoice"},{"text":" calls ","type":"text"},{"type":"codeVoice","code":"Mixpanel.initialize"},{"type":"text","text":" internally so apps never need to "},{"type":"codeVoice","code":"import Mixpanel"},{"type":"text","text":". Ships a recording mock for previews and tests."}],"url":"\/documentation\/swiduxmixpanelanalytics","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics","type":"topic"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MockServiceReference":{"type":"topic","abstract":[{"type":"text","text":"API reference for "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService"},{"type":"text","text":" — a recording "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" for SwiftUI previews and Swift Testing suites."}],"role":"article","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockServiceReference","title":"Mock Service Reference","url":"\/documentation\/swiduxmixpanelanalytics\/mockservicereference","kind":"article"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MockMixpanelAnalyticsService":{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"MockMixpanelAnalyticsService"}],"kind":"symbol","abstract":[{"text":"Recording ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" for previews and Swift Testing suites.","type":"text"}],"url":"\/documentation\/swiduxmixpanelanalytics\/mockmixpanelanalyticsservice","role":"symbol","title":"MockMixpanelAnalyticsService","navigatorTitle":[{"kind":"identifier","text":"MockMixpanelAnalyticsService"}],"type":"topic"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MixpanelAnalyticsService":{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MixpanelAnalyticsService"}],"kind":"symbol","abstract":[{"code":"AnalyticsService","type":"codeVoice"},{"text":" conformer that owns and forwards to a Mixpanel SDK","type":"text"},{"text":" ","type":"text"},{"text":"instance.","type":"text"}],"url":"\/documentation\/swiduxmixpanelanalytics\/mixpanelanalyticsservice","role":"symbol","title":"MixpanelAnalyticsService","navigatorTitle":[{"kind":"identifier","text":"MixpanelAnalyticsService"}],"type":"topic"}}}
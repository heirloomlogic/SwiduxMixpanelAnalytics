{"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ServiceReference","interfaceLanguage":"swift"},"metadata":{"role":"article","title":"Service Reference","modules":[{"name":"SwiduxMixpanelAnalytics"}],"roleHeading":"Article"},"kind":"article","seeAlsoSections":[{"anchor":"Related-Documentation","title":"Related Documentation","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ValueTranslation","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockServiceReference","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService"]},{"anchor":"Reference","title":"Reference","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockServiceReference"],"generated":true}],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"type":"codeVoice","code":"MixpanelAnalyticsService"},{"type":"text","text":" owns the Mixpanel SDK on the app’s behalf. The token-taking initializer calls "},{"type":"codeVoice","code":"Mixpanel.initialize"},{"type":"text","text":" internally; runtime GDPR \/ diagnostic toggles are methods on the service. The app never needs to "},{"type":"codeVoice","code":"import Mixpanel"},{"type":"text","text":" on the happy path."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For a step-by-step integration walkthrough, see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService"},{"type":"text","text":". For value-mapping rules, see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ValueTranslation"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"text":"Library target","type":"heading","anchor":"Library-target"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Product: "},{"type":"codeVoice","code":"SwiduxMixpanelAnalytics"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Import: "},{"type":"codeVoice","code":"import SwiduxMixpanelAnalytics"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":[".product(name: \"SwiduxMixpanelAnalytics\", package: \"SwiduxMixpanelAnalytics\"),"],"type":"codeListing"},{"level":2,"text":"Types","type":"heading","anchor":"Types"},{"level":3,"text":"``doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService``","type":"heading","anchor":"docSwiduxMixpanelAnalyticsdocumentationSwiduxMixpanelAnalyticsMixpanelAnalyticsService"},{"syntax":"swift","code":["public struct MixpanelAnalyticsService: AnalyticsService, @unchecked Sendable {","    \/\/ iOS \/ tvOS \/ watchOS","    public init(","        token: String,","        trackAutomaticEvents: Bool = false,","        flushInterval: Double = 60,","        instanceName: String? = nil,","        optOutTrackingByDefault: Bool = false,","        useUniqueDistinctId: Bool = false,","        superProperties: [String: AnalyticsValue]? = nil,","        serverURL: String? = nil,","        useGzipCompression: Bool = false","    )","","    \/\/ macOS — same as above, minus `trackAutomaticEvents`.","    public init(","        token: String,","        flushInterval: Double = 60,","        instanceName: String? = nil,","        optOutTrackingByDefault: Bool = false,","        useUniqueDistinctId: Bool = false,","        superProperties: [String: AnalyticsValue]? = nil,","        serverURL: String? = nil,","        useGzipCompression: Bool = false","    )","","    public init(instance: MixpanelInstance)","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Value type holding a single reference to a "},{"type":"codeVoice","code":"MixpanelInstance"},{"type":"text","text":". "},{"type":"codeVoice","code":"@unchecked Sendable"},{"type":"text","text":" is justified by Mixpanel’s documented thread-safety. Cheap to pass into "},{"type":"codeVoice","code":"AnalyticsPlugin"},{"type":"text","text":"."}],"type":"paragraph"},{"level":4,"text":"Initializers","type":"heading","anchor":"Initializers"},{"syntax":"swift","type":"codeListing","code":["public init(token: String, ...)"]},{"inlineContent":[{"type":"text","text":"Calls "},{"code":"Mixpanel.initialize(token:...)","type":"codeVoice"},{"type":"text","text":" internally and retains the resulting instance. Parameters mirror the Mixpanel SDK; "},{"code":"superProperties","type":"codeVoice"},{"text":" takes ","type":"text"},{"code":"[String: AnalyticsValue]","type":"codeVoice"},{"text":" so the app does not need to reference ","type":"text"},{"code":"MixpanelType","type":"codeVoice"},{"text":". On macOS, ","type":"text"},{"code":"trackAutomaticEvents","type":"codeVoice"},{"type":"text","text":" is omitted (the SDK does not accept it there)."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["public init(instance: MixpanelInstance)"]},{"type":"paragraph","inlineContent":[{"text":"Escape hatch for apps that need to build their own ","type":"text"},{"code":"MixpanelInstance","type":"codeVoice"},{"text":" (for example, to use ","type":"text"},{"code":"ProxyServerConfig","type":"codeVoice"},{"text":"). Most apps should prefer the token initializer; this is the only path that requires ","type":"text"},{"code":"import Mixpanel","type":"codeVoice"},{"text":" in your app.","type":"text"}]},{"type":"heading","level":4,"text":"`track(_:) async`","anchor":"track-async"},{"type":"paragraph","inlineContent":[{"text":"Forwards to ","type":"text"},{"code":"MixpanelInstance.track(even
{"kind":"article","schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MixpanelAnalyticsService"},{"type":"text","text":" owns the Mixpanel SDK on the app’s behalf. The token-taking initializer calls "},{"type":"codeVoice","code":"Mixpanel.initialize"},{"type":"text","text":" internally; runtime GDPR \/ diagnostic toggles are methods on the service. The app never needs to "},{"type":"codeVoice","code":"import Mixpanel"},{"type":"text","text":" on the happy path."}]},{"inlineContent":[{"type":"text","text":"For a step-by-step integration walkthrough, see "},{"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","isActive":true},{"type":"text","text":". For value-mapping rules, see "},{"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ValueTranslation","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Library target","anchor":"Library-target"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Product: ","type":"text"},{"code":"SwiduxMixpanelAnalytics","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Import: "},{"type":"codeVoice","code":"import SwiduxMixpanelAnalytics"}]}]}]},{"type":"paragraph","inlineContent":[{"code":"Package.swift","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","code":[".product(name: \"SwiduxMixpanelAnalytics\", package: \"SwiduxMixpanelAnalytics\"),"],"syntax":"swift"},{"type":"heading","level":2,"text":"Types","anchor":"Types"},{"type":"heading","level":3,"text":"``doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService``","anchor":"docSwiduxMixpanelAnalyticsdocumentationSwiduxMixpanelAnalyticsMixpanelAnalyticsService"},{"syntax":"swift","code":["public struct MixpanelAnalyticsService: AnalyticsService, @unchecked Sendable {","    \/\/ Identical on every platform.","    public init(","        token: String,","        trackAutomaticEvents: Bool = false,","        flushInterval: Double = 60,","        instanceName: String? = nil,","        optOutTrackingByDefault: Bool = false,","        useUniqueDistinctId: Bool = false,","        deviceIdProvider: (@Sendable () -> String?)? = nil,","        superProperties: [String: AnalyticsValue]? = nil,","        serverURL: String? = nil,","        useGzipCompression: Bool = true,","        excludeProperties: Set<String> = []","    )","","    public init(instance: MixpanelInstance)","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Value type holding a single reference to a "},{"type":"codeVoice","code":"MixpanelInstance"},{"type":"text","text":". "},{"type":"codeVoice","code":"@unchecked Sendable"},{"type":"text","text":" is justified by Mixpanel’s documented thread-safety. Cheap to pass into "},{"type":"codeVoice","code":"AnalyticsPlugin"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Initializers","anchor":"Initializers","level":4,"type":"heading"},{"code":["public init(token: String, ...)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Builds a "},{"type":"codeVoice","code":"MixpanelOptions"},{"type":"text","text":" and calls "},{"type":"codeVoice","code":"Mixpanel.initialize(options:)"},{"type":"text","text":" internally, retaining the resulting instance. Parameters mirror "},{"type":"codeVoice","code":"MixpanelOptions"},{"type":"text","text":" — including its "},{"type":"codeVoice","code":"useGzipCompression: true"},{"type":"text","text":" default; "},{"type":"codeVoice","code":"superProperties"},{"type":"text","text":" takes "},{"type":"codeVoice","code":"[String: AnalyticsValue]"},{"type":"text","text":" so the app does not need to reference "},{"type":"codeVoice","code":"MixpanelType"},{"type":"text","text":", and "},{"type":"codeVoice","code":"deviceIdProvider"},{"type":"text","text":" supplies a custom stable device ID (see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService"},{"type":"text","text":" for the contract: cached value only, no inline I\/O)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The Mixpanel SDK keys instances by "},{"type":"codeVoice","code":"instanceName"},{"type":"text","text":" (falling back to "},{"code":"token","type":"codeVoice"},{"text":"); constructing a second service with the same name returns the existing SDK instance and silently ignores the new options.","type":"text"}],"type":"paragraph"},{"code":["public init(instance: MixpanelInstance)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Escape hatch for apps that need to build their own "},{"type":"codeVoice","code":"MixpanelInstance"},{"type":"text","text":" (for example, to use "},{"type":"codeVoice","code":"ProxyServerConfig"},{"type":"text","text":"). Most apps should prefer the token initializer; this is the only path that requires "},{"type":"codeVoice","code":"import Mixpanel"},{"type":"text","text":" in your app."}],"type":"paragraph"},{"text":"`track(_:) async`","anchor":"track-async","level":4,"type":"heading"},{"inlineContent":[{"type":"text","text":"Forwards to "},{"type":"codeVoice","code":"MixpanelInstance.track(event:properties:)"},{"type":"text","text":". Empty "},{"type":"codeVoice","code":"properties"},{"type":"text","text":" are passed as "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" rather than an empty dictionary. Returns immediately; Mixpanel batches and flushes on its own schedule."}],"type":"paragraph"},{"text":"`identify(userID:properties:) async`","anchor":"identifyuserIDproperties-async","level":4,"type":"heading"},{"inlineContent":[{"type":"text","text":"Forwards to "},{"type":"codeVoice","code":"MixpanelInstance.identify(distinctId:)"},{"type":"text","text":", then — if "},{"type":"codeVoice","code":"properties"},{"type":"text","text":" is non-empty — calls "},{"type":"codeVoice","code":"instance.people.set(properties:)"},{"type":"text","text":" to update people-level properties. Empty "},{"type":"codeVoice","code":"userID"},{"type":"text","text":"s are dropped entirely: the SDK rejects blank distinct IDs, and forwarding the people update anyway would attribute it to the previous identity."}],"type":"paragraph"},{"text":"`alias(newID:previousID:) async`","anchor":"aliasnewIDpreviousID-async","level":4,"type":"heading"},{"inlineContent":[{"type":"text","text":"Forwards to "},{"type":"codeVoice","code":"MixpanelInstance.createAlias(_:distinctId:)"},{"type":"text","text":". When "},{"type":"codeVoice","code":"previousID"},{"type":"text","text":" is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", the call uses "},{"type":"codeVoice","code":"instance.distinctId"},{"type":"text","text":" as the source ID, matching Mixpanel’s recommended anonymous-to-identified aliasing flow. Empty "},{"type":"codeVoice","code":"newID"},{"type":"text","text":"s are dropped, mirroring the SDK’s blank-alias rejection."}],"type":"paragraph"},{"text":"`reset() async`","anchor":"reset-async","level":4,"type":"heading"},{"inlineContent":[{"type":"text","text":"Forwards to "},{"type":"codeVoice","code":"MixpanelInstance.reset(completion:)"},{"type":"text","text":" and awaits its callback. Clears Mixpanel’s local distinct ID, super properties, and identity."}],"type":"paragraph"},{"text":"`flush() async`","anchor":"flush-async","level":4,"type":"heading"},{"inlineContent":[{"type":"text","text":"Forwards to "},{"type":"codeVoice","code":"MixpanelInstance.flush(completion:)"},{"type":"text","text":" and awaits its callback. The plugin’s own "},{"type":"codeVoice","code":"flush()"},{"type":"text","text":" is the deterministic sync point in tests — it awaits all pending fire-and-forget tracking tasks and then calls this."}],"type":"paragraph"},{"text":"`optOutTracking() async`","anchor":"optOutTracking-async","level":4,"type":"heading"},{"inlineContent":[{"type":"text","text":"Forwards to "},{"type":"codeVoice","code":"MixpanelInstance.optOutTracking()"},{"type":"text","text":". Subsequent "},{"type":"codeVoice","code":"track"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"identify"},{"type":"text","text":" calls are dropped until "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService\/optInTracking(distinctID:properties:)"},{"type":"text","text":" is called. Also clears the existing people profile and charges."}],"type":"paragraph"},{"text":"`optInTracking(distinctID:properties:) async`","anchor":"optInTrackingdistinctIDproperties-async","level":4,"type":"heading"},{"inlineContent":[{"type":"text","text":"Forwards to "},{"type":"codeVoice","code":"MixpanelInstance.optInTracking(distinctId:properties:)"},{"type":"text","text":". Optionally identifies the user and records people-profile properties as part of opting in."}],"type":"paragraph"},{"text":"`hasOptedOutTracking() async -> Bool`","anchor":"hasOptedOutTracking-async-%3E-Bool","level":4,"type":"heading"},{"inlineContent":[{"type":"text","text":"Forwards to "},{"type":"codeVoice","code":"MixpanelInstance.hasOptedOutTracking()"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"`setLoggingEnabled(_:) async`","anchor":"setLoggingEnabled-async","level":4,"type":"heading"},{"inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"MixpanelInstance.loggingEnabled"},{"type":"text","text":". Useful during development; disable in release."}],"type":"paragraph"},{"text":"`setUseIPAddressForGeoLocation(_:) async`","anchor":"setUseIPAddressForGeoLocation-async","level":4,"type":"heading"},{"inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"MixpanelInstance.useIPAddressForGeoLocation"},{"type":"text","text":". Disable when your privacy policy forbids IP-based geo resolution."}],"type":"paragraph"}],"kind":"content"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics"]]},"identifier":{"url":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ServiceReference","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"API reference for "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService"},{"type":"text","text":" — the Mixpanel-backed "},{"type":"codeVoice","code":"AnalyticsService"},{"text":" conformer that the analytics plugin consumes.","type":"text"}],"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ValueTranslation","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockServiceReference","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService"],"anchor":"Related-Documentation"},{"title":"Reference","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockServiceReference"],"generated":true,"anchor":"Reference"}],"variants":[{"paths":["\/documentation\/swiduxmixpanelanalytics\/servicereference"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"title":"Service Reference","modules":[{"name":"SwiduxMixpanelAnalytics"}],"roleHeading":"Article","role":"article"},"references":{"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/HowToImplementService":{"kind":"article","identifier":"doc:\/\/SwiduxMixpanelAnalytics\
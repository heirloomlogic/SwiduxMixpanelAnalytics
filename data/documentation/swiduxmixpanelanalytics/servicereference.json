{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxmixpanelanalytics\/servicereference"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"MixpanelAnalyticsService"},{"type":"text","text":" owns the Mixpanel SDK on the app’s behalf. The token-taking initializer calls "},{"type":"codeVoice","code":"Mixpanel.initialize"},{"type":"text","text":" internally; runtime GDPR \/ diagnostic toggles are methods on the service. The app never needs to "},{"type":"codeVoice","code":"import Mixpanel"},{"type":"text","text":" on the happy path."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For a step-by-step integration walkthrough, see "},{"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","isActive":true},{"type":"text","text":". For value-mapping rules, see "},{"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ValueTranslation","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Library-target","level":2,"text":"Library target","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Product: "},{"type":"codeVoice","code":"SwiduxMixpanelAnalytics"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Import: "},{"type":"codeVoice","code":"import SwiduxMixpanelAnalytics"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"code":"Package.swift","type":"codeVoice"},{"text":":","type":"text"}]},{"syntax":"swift","type":"codeListing","code":[".product(name: \"SwiduxMixpanelAnalytics\", package: \"SwiduxMixpanelAnalytics\"),"]},{"type":"heading","level":2,"text":"Types","anchor":"Types"},{"type":"heading","level":3,"text":"``doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService``","anchor":"docSwiduxMixpanelAnalyticsdocumentationSwiduxMixpanelAnalyticsMixpanelAnalyticsService"},{"syntax":"swift","type":"codeListing","code":["public struct MixpanelAnalyticsService: AnalyticsService, @unchecked Sendable {","    \/\/ Identical on every platform.","    public init(","        token: String,","        trackAutomaticEvents: Bool = false,","        flushInterval: Double = 60,","        instanceName: String? = nil,","        optOutTrackingByDefault: Bool = false,","        useUniqueDistinctId: Bool = false,","        deviceIdProvider: (@Sendable () -> String?)? = nil,","        superProperties: [String: AnalyticsValue]? = nil,","        serverURL: String? = nil,","        useGzipCompression: Bool = true,","        excludeProperties: Set<String> = []","    )","","    public init(instance: MixpanelInstance)","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Value type holding a single reference to a "},{"code":"MixpanelInstance","type":"codeVoice"},{"type":"text","text":". "},{"type":"codeVoice","code":"@unchecked Sendable"},{"type":"text","text":" is justified by Mixpanel’s documented thread-safety. Cheap to pass into "},{"type":"codeVoice","code":"AnalyticsPlugin"},{"text":".","type":"text"}]},{"type":"heading","level":4,"text":"Initializers","anchor":"Initializers"},{"syntax":"swift","type":"codeListing","code":["public init(token: String, ...)"]},{"type":"paragraph","inlineContent":[{"text":"Builds a ","type":"text"},{"type":"codeVoice","code":"MixpanelOptions"},{"text":" and calls ","type":"text"},{"type":"codeVoice","code":"Mixpanel.initialize(options:)"},{"text":" internally, retaining the resulting instance. Parameters mirror ","type":"text"},{"type":"codeVoice","code":"MixpanelOptions"},{"type":"text","text":" — including its "},{"type":"codeVoice","code":"useGzipCompression: true"},{"type":"text","text":" default; "},{"type":"codeVoice","code":"superProperties"},{"text":" takes ","type":"text"},{"type":"codeVoice","code":"[String: AnalyticsValue]"},{"text":" so the app does not need to reference ","type":"text"},{"code":"MixpanelType","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"deviceIdProvider","type":"codeVoice"},{"text":" supplies a custom stable device ID (see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService"},{"text":" for the contract: cached value only, no inline I\/O).","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Mixpanel SDK keys instances by "},{"type":"codeVoice","code":"instanceName"},{"type":"text","text":" (falling back to "},{"type":"codeVoice","code":"token"},{"type":"text","text":"); constructing a second service with the same name returns the existing SDK instance and silently ignores the new options."}]},{"syntax":"swift","type":"codeListing","code":["public init(instance: MixpanelInstance)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Escape hatch for apps that need to build their own "},{"type":"codeVoice","code":"MixpanelInstance"},{"type":"text","text":" (for example, to use "},{"type":"codeVoice","code":"ProxyServerConfig"},{"type":"text","text":"). Most apps should prefer the token initializer; this is the only path that requires "},{"type":"codeVoice","code":"import Mixpanel"},{"type":"text","text":" in your app."}]},{"type":"heading","level":4,"text":"`track(_:) async`","anchor":"track-async"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Forwards to "},{"type":"codeVoice","code":"MixpanelInstance.track(event:properties:)"},{"type":"text","text":". Empty "},{"type":"codeVoice","code":"properties"},{"type":"text","text":" are passed as "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" rather than an empty dictionary. Returns immediately; Mixpanel batches and flushes on its own schedule."}]},{"type":"heading","level":4,"text":"`identify(userID:properties:) async`","anchor":"identifyuserIDproperties-async"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Forwards to "},{"type":"codeVoice","code":"MixpanelInstance.identify(distinctId:)"},{"type":"text","text":", then — if "},{"type":"codeVoice","code":"properties"},{"type":"text","text":" is non-empty — calls "},{"type":"codeVoice","code":"instance.people.set(properties:)"},{"type":"text","text":" to update people-level properties. Empty "},{"type":"codeVoice","code":"userID"},{"type":"text","text":"s are dropped entirely: the SDK rejects blank distinct IDs, and forwarding the people update anyway would attribute it to the previous identity."}]},{"level":4,"type":"heading","anchor":"aliasnewIDpreviousID-async","text":"`alias(newID:previousID:) async`"},{"inlineContent":[{"text":"Forwards to ","type":"text"},{"type":"codeVoice","code":"MixpanelInstance.createAlias(_:distinctId:)"},{"text":". When ","type":"text"},{"type":"codeVoice","code":"previousID"},{"type":"text","text":" is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", the call uses "},{"type":"codeVoice","code":"instance.distinctId"},{"type":"text","text":" as the source ID, matching Mixpanel’s recommended anonymous-to-identified aliasing flow. Empty "},{"type":"codeVoice","code":"newID"},{"type":"text","text":"s are dropped, mirroring the SDK’s blank-alias rejection."}],"type":"paragraph"},{"level":4,"type":"heading","text":"`reset() async`","anchor":"reset-async"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Forwards to "},{"type":"codeVoice","code":"MixpanelInstance.reset(completion:)"},{"type":"text","text":" and awaits its callback. Clears Mixpanel’s local distinct ID, super properties, and identity."}]},{"level":4,"type":"heading","text":"`flush() async`","anchor":"flush-async"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Forwards to "},{"type":"codeVoice","code":"MixpanelInstance.flush(completion:)"},{"type":"text","text":" and awaits its callback. The plugin’s own "},{"type":"codeVoice","code":"flush()"},{"type":"text","text":" is the deterministic sync point in tests — it awaits all pending fire-and-forget tracking tasks and then calls this."}]},{"level":4,"type":"heading","text":"`optOutTracking() async`","anchor":"optOutTracking-async"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Forwards to "},{"type":"codeVoice","code":"MixpanelInstance.optOutTracking()"},{"type":"text","text":". Subsequent "},{"type":"codeVoice","code":"track"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"identify"},{"type":"text","text":" calls are dropped until "},{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService\/optInTracking(distinctID:properties:)","type":"reference","isActive":true},{"type":"text","text":" is called. Also clears the existing people profile and charges."}]},{"level":4,"type":"heading","text":"`optInTracking(distinctID:properties:) async`","anchor":"optInTrackingdistinctIDproperties-async"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Forwards to "},{"type":"codeVoice","code":"MixpanelInstance.optInTracking(distinctId:properties:)"},{"type":"text","text":". Optionally identifies the user and records people-profile properties as part of opting in."}]},{"level":4,"type":"heading","text":"`hasOptedOutTracking() async -> Bool`","anchor":"hasOptedOutTracking-async-%3E-Bool"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Forwards to "},{"type":"codeVoice","code":"MixpanelInstance.hasOptedOutTracking()"},{"type":"text","text":"."}]},{"level":4,"type":"heading","text":"`setLoggingEnabled(_:) async`","anchor":"setLoggingEnabled-async"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"MixpanelInstance.loggingEnabled"},{"type":"text","text":". Useful during development; disable in release."}]},{"level":4,"type":"heading","text":"`setUseIPAddressForGeoLocation(_:) async`","anchor":"setUseIPAddressForGeoLocation-async"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"MixpanelInstance.useIPAddressForGeoLocation"},{"type":"text","text":". Disable when your privacy policy forbids IP-based geo resolution."}]}],"kind":"content"}],"abstract":[{"text":"API reference for ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService"},{"text":" — the Mixpanel-backed ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" conformer that the analytics plugin consumes.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics"]]},"metadata":{"roleHeading":"Article","modules":[{"name":"SwiduxMixpanelAnalytics"}],"role":"article","title":"Service Reference"},"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ValueTranslation","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockServiceReference","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService"],"anchor":"Related-Documentation"},{"title":"Reference","generated":true,"identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockServiceReference"],"anchor":"Reference"}],"identifier":{"url":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ServiceReference","interfaceLanguage":"swift"},"sections":[],"kind":"article","references":{"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MixpanelAnalyticsService":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ",
{"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"type":"text","text":" owns the Mixpanel SDK on the app’s behalf. The token-taking initializer calls "},{"code":"Mixpanel.initialize","type":"codeVoice"},{"type":"text","text":" internally; runtime GDPR \/ diagnostic toggles are methods on the service. The app never needs to "},{"code":"import Mixpanel","type":"codeVoice"},{"type":"text","text":" on the happy path."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For a step-by-step integration walkthrough, see "},{"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","isActive":true},{"type":"text","text":". For value-mapping rules, see "},{"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ValueTranslation","isActive":true},{"type":"text","text":"."}]},{"type":"heading","anchor":"Library-target","level":2,"text":"Library target"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Product: "},{"type":"codeVoice","code":"SwiduxMixpanelAnalytics"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Import: "},{"type":"codeVoice","code":"import SwiduxMixpanelAnalytics"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"code":"Package.swift","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":[".product(name: \"SwiduxMixpanelAnalytics\", package: \"SwiduxMixpanelAnalytics\"),"]},{"type":"heading","anchor":"Types","level":2,"text":"Types"},{"type":"heading","anchor":"docSwiduxMixpanelAnalyticsdocumentationSwiduxMixpanelAnalyticsMixpanelAnalyticsService","level":3,"text":"``doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService``"},{"type":"codeListing","syntax":"swift","code":["public struct MixpanelAnalyticsService: AnalyticsService, @unchecked Sendable {","    \/\/ Identical on every platform.","    public init(","        token: String,","        trackAutomaticEvents: Bool = false,","        flushInterval: Double = 60,","        instanceName: String? = nil,","        optOutTrackingByDefault: Bool = false,","        useUniqueDistinctId: Bool = false,","        deviceIdProvider: (@Sendable () -> String?)? = nil,","        superProperties: [String: AnalyticsValue]? = nil,","        serverURL: String? = nil,","        useGzipCompression: Bool = true,","        excludeProperties: Set<String> = []","    )","","    public init(instance: MixpanelInstance)","","    public func setOptedOut(_ optedOut: Bool) async","    public func optOutTracking() async","    public func optInTracking(distinctID: String? = nil, properties: [String: AnalyticsValue]? = nil) async","    public func hasOptedOutTracking() async -> Bool","    public func setLoggingEnabled(_ enabled: Bool) async","    public func setUseIPAddressForGeoLocation(_ enabled: Bool) async","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Value type holding a reference to a "},{"code":"MixpanelInstance","type":"codeVoice"},{"type":"text","text":"; every copy shares the instance. It is "},{"code":"@unchecked Sendable","type":"codeVoice"},{"type":"text","text":" because the SDK serializes its tracking work on internal queues. The diagnostic setters are the exception — they write properties the SDK doesn’t synchronize, so call them once at launch. Cheap to pass into "},{"code":"AnalyticsPlugin","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK applies most calls later, on its own serial queue, while checking consent on the caller’s thread. The adapter closes the gaps that leaves; each method below says how."}]},{"type":"heading","anchor":"Initializers","level":4,"text":"Initializers"},{"type":"codeListing","syntax":"swift","code":["public init(token: String, ...)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Builds a "},{"code":"MixpanelOptions","type":"codeVoice"},{"type":"text","text":" and calls "},{"code":"Mixpanel.initialize(options:)","type":"codeVoice"},{"type":"text","text":" internally, retaining the resulting instance. Parameters mirror "},{"code":"MixpanelOptions","type":"codeVoice"},{"type":"text","text":" — including its "},{"code":"useGzipCompression: true","type":"codeVoice"},{"type":"text","text":" default; "},{"code":"superProperties","type":"codeVoice"},{"type":"text","text":" takes "},{"code":"[String: AnalyticsValue]","type":"codeVoice"},{"type":"text","text":" so the app does not need to reference "},{"code":"MixpanelType","type":"codeVoice"},{"type":"text","text":", and "},{"code":"deviceIdProvider","type":"codeVoice"},{"type":"text","text":" supplies a custom stable device ID (see "},{"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","isActive":true},{"type":"text","text":" for the contract: cached value only, no inline I\/O)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Mixpanel SDK keys instances by "},{"code":"instanceName","type":"codeVoice"},{"type":"text","text":" (falling back to "},{"code":"token","type":"codeVoice"},{"type":"text","text":"); constructing a second service with the same name returns the existing SDK instance and silently ignores the new options. Services for different projects can safely be built concurrently: the adapter looks its instance up by name, working around an SDK race that could otherwise hand one service the other’s instance. "},{"code":"superProperties","type":"codeVoice"},{"type":"text","text":" are re-applied after "},{"code":"reset()","type":"codeVoice"},{"type":"text","text":" and after opting back in, since the SDK drops them at both points and ignores them while opted out."}]},{"type":"codeListing","syntax":"swift","code":["public init(instance: MixpanelInstance)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Escape hatch for apps that need to build their own "},{"code":"MixpanelInstance","type":"codeVoice"},{"type":"text","text":" (for example, to use "},{"code":"ProxyServerConfig","type":"codeVoice"},{"type":"text","text":"). Most apps should prefer the token initializer; this is the only path that requires "},{"code":"import Mixpanel","type":"codeVoice"},{"type":"text","text":" in your app. Super properties registered on such an instance are the app’s to manage."}]},{"type":"heading","anchor":"track-async","level":4,"text":"`track(_:) async`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Forwards to "},{"code":"MixpanelInstance.track(event:properties:)","type":"codeVoice"},{"type":"text","text":". Empty "},{"code":"properties","type":"codeVoice"},{"type":"text","text":" are passed as "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" rather than an empty dictionary, and properties that translate to null are omitted (see "},{"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ValueTranslation","isActive":true},{"type":"text","text":"). Returns immediately; Mixpanel batches and flushes on its own schedule."}]},{"type":"heading","anchor":"identifyuserIDproperties-async","level":4,"text":"`identify(userID:properties:) async`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Forwards to "},{"code":"MixpanelInstance.identify(distinctId:)","type":"codeVoice"},{"type":"text","text":", then sets "},{"code":"properties","type":"codeVoice"},{"type":"text","text":" on the user’s profile with "},{"code":"instance.people.set(properties:)","type":"codeVoice"},{"type":"text","text":"; properties that translate to null are unset instead. Empty "},{"code":"userID","type":"codeVoice"},{"type":"text","text":"s are dropped entirely: the SDK rejects blank distinct IDs, and forwarding the people update anyway would attribute it to the previous identity. Calls made while opted out are dropped."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the user changes, everything queued for the previous user is sent first, and "},{"code":"identify","type":"codeVoice"},{"type":"text","text":" waits for it — the SDK attributes queued profile updates to whoever is identified when they are sent."}]},{"type":"heading","anchor":"aliasnewIDpreviousID-async","level":4,"text":"`alias(newID:previousID:) async`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Forwards to "},{"code":"MixpanelInstance.createAlias(_:distinctId:andIdentify:)","type":"codeVoice"},{"type":"text","text":" with "},{"code":"andIdentify: false","type":"codeVoice"},{"type":"text","text":", so the alias never changes who is identified locally — the SDK default would re-identify the device as "},{"code":"previousID","type":"codeVoice"},{"type":"text","text":", undoing a preceding sign-in. When "},{"code":"previousID","type":"codeVoice"},{"type":"text","text":" is "},{"code":"nil","type":"codeVoice"},{"type":"text","text":", the anonymous distinct ID the device’s events were sent under is used. The SDK sends its queue after every alias, and "},{"code":"alias","type":"codeVoice"},{"type":"text","text":" waits for that so the send can’t overlap the next flush and duplicate rows. Empty "},{"code":"newID","type":"codeVoice"},{"type":"text","text":"s are dropped, mirroring the SDK’s blank-alias rejection. Projects on Mixpanel’s Simplified ID Merge ignore aliases; see "},{"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","isActive":true},{"type":"text","text":"."}]},{"type":"heading","anchor":"reset-async","level":4,"text":"`reset() async`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sends everything queued and waits for it, then forwards to "},{"code":"MixpanelInstance.reset(completion:)","type":"codeVoice"},{"type":"text","text":" and awaits its callback — the SDK’s own "},{"code":"reset()","type":"codeVoice"},{"type":"text","text":" sends one 50-record batch and deletes the rest. Clears Mixpanel’s local distinct ID, super properties, and timed events, then re-applies the initializer’s super properties. While opted out it leaves the SDK alone: its "},{"code":"reset()","type":"codeVoice"},{"type":"text","text":" would also erase the persisted opt-out, and the user would be tracked again from the next launch."}]},{"type":"heading","anchor":"flush-async","level":4,"text":"`flush() async`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Forwards to "},{"code":"MixpanelInstance.flush(performFullFlush: true, completion:)","type":"codeVoice"},{"type":"text","text":" and awaits its callback, so the whole queue is sent rather than the SDK’s default 50-record batch. The SDK sends one request per 50 records, each bounded at 120 seconds, and stops at the first failure, so a hung server can hold this for minutes — use the plugin’s "},{"code":"flush(timeout:)","type":"codeVoice"},{"type":"text","text":" on shutdown paths. The SDK delivers the callback on the main queue; never block the main thread waiting for it. The plugin’s own "},{"code":"flush()","type":"codeVoice"},{"type":"text","text":" is the deterministic sync point in tests — it awaits all pending fire-and-forget tracking tasks and then calls this."}]},{"type":"heading","anchor":"setOptedOut-async","level":4,"text":"`setOptedOut(_:) async`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Calls "},{"code":"optOutTracking()","type":"codeVoice"},{"type":"text","text":" for "},{"code":"true","type":"codeVoice"},{"type":"text","text":" and "},{"code":"optInTracking()","type":"codeVoice"},{"type":"text","text":" for "},{"code":"false","type":"codeVoice"},{"type":"text","text":". Shaped for the plugin’s "},{"code":"onConsentChange","type":"codeVoice"},{"type":"text","text":" hook: "},{"code":"onConsentChange: { await service.setOptedOut($0) }","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"heading","anchor":"optOutTracking-async","level":4,"text":"`optOutTracking() async`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Forwards to "},{"code":"MixpanelInstance.optOutTracking()","type":"codeVoice"},{"type":"text","text":", then deletes everything queued and resets the local identity with "},{"code":"MixpanelInstance.reset(completion:)","type":"codeVoice"},{"type":"text","text":", and returns once the SDK has applied it. Nothing queued is sent, and the call does not wait for the network. From then on "},{"code":"track","type":"codeVoice"},{"type":"text","text":", "},{"code":"identify","type":"codeVoice"},{"type":"text","text":", and "},{"code":"alias","type":"codeVoice"},{"type":"text","text":" are dropped until "},{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService\/optInTracking(distinctID:properties:)","type":"reference","isActive":true},{"type":"text","text":". Does nothing when already opted out. Persists across launches: the SDK’s "},{"code":"reset()","type":"codeVoice"},{"type":"text","text":" erases the persisted opt-out, so the adapter opts out a second time to write it back."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An upload already in progress is not cancelled. The SDK checks consent when a flush starts and before it moves from events to profile updates, but not between requests. A flush that is already sending events still sends every event it had read; for a full flush such as "},{"type":"codeVoice","code":"flush()"},{"type":"text","text":", that is the whole event queue, 50 events per request. Profile updates that flush had read are not sent."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It does "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" delete the user’s Mixpanel profile. The SDK’s own opt-out queues a "},{"type":"codeVoice","code":"$delete"},{"type":"text","text":" that is never sent and that would later delete the next identified user’s profile; the adapter deletes it with the rest of the queue. Use Mixpanel’s GDPR deletion API from your server to erase data."}]},{"type":"heading","anchor":"optInTrackingdistinctIDproperties-async","level":4,"text":"`optInTracking(distinctID:properties:) async`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Forwards to "},{"type":"codeVoice","code":"MixpanelInstance.optInTracking(distinctId:properties:)"},{"type":"text","text":" and returns once the SDK has applied it, so an "},{"type":"codeVoice","code":"identify"},{"type":"text","text":" issued straight afterwards is honored. The SDK identifies the user as "},{"type":"codeVoice","code":"distinctID"},{"type":"text","text":" (when non-empty) and records a "},{"type":"codeVoice","code":"$opt_in"},{"type":"text","text":" event carrying "},{"type":"codeVoice","code":"properties"},{"type":"text","text":" — they are event properties, not profile properties. The event is queued a moment after the opt-in takes effect, so a "},{"type":"codeVoice","code":"flush()"},{"type":"text","text":" issued straight away may leave it for the next one. When the user is already opted in, no "},{"type":"codeVoice","code":"$opt_in"},{"type":"text","text":" is sent and only the "},{"type":"codeVoice","code":"distinctID"},{"type":"text","text":" identify happens. Before opting in, anything the SDK kept queued while opted out is discarded — only a stale profile deletion or unattributed leftovers can be there. The wait for the SDK is bounded at 30 seconds; hitting the bound logs a fault."}]},{"anchor":"hasOptedOutTracking-async-%3E-Bool","type":"heading","level":4,"text":"`hasOptedOutTracking() async -> Bool`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Forwards to "},{"code":"MixpanelInstance.hasOptedOutTracking()","type":"codeVoice"},{"text":". On a first launch with ","type":"text"},{"code":"optOutTrackingByDefault","type":"codeVoice"},{"text":", it first waits for the SDK to apply the default — until it does, the SDK reports the user as opted in. (Not with ","type":"text"},{"code":"init(instance:)","type":"codeVoice"},{"text":", which doesn’t know the instance’s options.)","type":"text"}]},{"type":"heading","anchor":"setLoggingEnabled-async","level":4,"text":"`setLoggingEnabled(_:) async`"},{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"type":"codeVoice","code":"MixpanelInstance.loggingEnabled"},{"text":". Useful during development; disable in release. Set it once at launch.","type":"text"}]},{"type":"heading","text":"`setUseIPAddressForGeoLocation(_:) async`","level":4,"anchor":"setUseIPAddressForGeoLocation-async"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"MixpanelInstance.useIPAddressForGeoLocation"},{"type":"text","text":". Disable when your privacy policy forbids IP-based geo resolution. Set it once at launch."}]}]}],"sections":[],"abstract":[{"type":"text","text":"API reference for "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService"},{"type":"text","text":" — the Mixpanel-backed "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" conformer that the analytics plugin consumes."}],"seeAlsoSections":[{"identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ValueTranslation","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockServiceReference","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService"],"anchor":"Related-Documentation","title":"Related Documentation"},{"identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockServiceReference"],"anchor":"Reference","generated":true,"title":"Reference"}],"hierarchy":{"paths":[["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics"]]},"identifier":{"url":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ServiceReference","interfaceLanguage":"swift"},"kind":"article","metadata":{"modules":[{"name":"SwiduxMixpanelAnalytics"}],"title":"Service Reference","roleHeading":"Article","role":"article"},"variants":[{"paths":["\/documentation\/swiduxmixpanelanalytics\/servicereference"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MockServiceReference":{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockServiceReference","abstract":[{"type":"text","text":"API reference for "},{"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService","isActive":true},{"type":"text","text":" — a recording "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" for SwiftUI previews and Swift Testing suites."}],"url":"\/documentation\/swiduxmixpanelanalytics\/mockservicereference","role":"article","kind":"article","title":"Mock Service Reference","type":"topic"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MixpanelAnalyticsService/optInTracking(distinctID:properties:)":{"abstract":[{"type":"text","text":"Opts the user back into tracking and returns once the SDK has applied"},{"type":"text","text":" "},{"type":"text","text":"it, so an "},{"type":"codeVoice","code":"identify"},{"type":"text","text":" issued straight afterwards is honored."}],"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService\/optInTracking(distinctID:properties:)","url":"\/documentation\/swiduxmixpanelanalytics\/mixpanelanalyticsservice\/optintracking(distinctid:properties:)","role":"symbol","kind":"symbol","title":"optInTracking(distinctID:properties:)","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"optInTracking"},{"kind":"text","text":"("},{"kind":"externalParam","text":"distinctID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"properties"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"AnalyticsValue","preciseIdentifier":"s:15SwiduxAnalytics0B5ValueO"},{"kind":"text","text":"]?) "},{"kind":"keyword","text":"async"}]},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MixpanelAnalyticsService":{"type":"topic","title":"MixpanelAnalyticsService","url":"\/documentation\/swiduxmixpanelanalytics\/mixpanelanalyticsservice","abstract":[{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" conformer that owns and forwards to a Mixpanel SDK"},{"type":"text","text":" "},{"type":"text","text":"instance."}],"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService","navigatorTitle":[{"text":"MixpanelAnalyticsService","kind":"identifier"}],"kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MixpanelAnalyticsService","kind":"identifier"}]},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/ValueTranslation":{"type":"topic","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ValueTranslation","title":"Value Translation","kind":"article","abstract":[{"type":"text","text":"How "},{"code":"AnalyticsValue","type":"codeVoice"},{"type":"text","text":" cases map onto Mixpanel’s "},{"code":"MixpanelType","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Properties","type":"codeVoice"},{"type":"text","text":"."}],"url":"\/documentation\/swiduxmixpanelanalytics\/valuetranslation","role":"article"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MockMixpanelAnalyticsService":{"type":"topic","title":"MockMixpanelAnalyticsService","url":"\/documentation\/swiduxmixpanelanalytics\/mockmixpanelanalyticsservice","abstract":[{"type":"text","text":"Recording "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" for previews and Swift Testing suites."}],"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockMixpanelAnalyticsService","navigatorTitle":[{"kind":"identifier","text":"MockMixpanelAnalyticsService"}],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"MockMixpanelAnalyticsService"}]},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics":{"type":"topic","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics","title":"SwiduxMixpanelAnalytics","url":"\/documentation\/swiduxmixpanelanalytics","abstract":[{"type":"text","text":"Mixpanel adapter for Swidux’s "},{"type":"codeVoice","code":"AnalyticsPlugin"},{"type":"text","text":". Owns the Mixpanel SDK on the app’s behalf — "},{"type":"codeVoice","code":"MixpanelAnalyticsService(token:)"},{"type":"text","text":" calls "},{"type":"codeVoice","code":"Mixpanel.initialize"},{"type":"text","text":" internally so apps never need to "},{"type":"codeVoice","code":"import Mixpanel"},{"type":"text","text":". Ships a recording mock for previews and tests."}],"kind":"symbol","role":"collection"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/HowToImplementService":{"type":"topic","title":"How to Implement the Service","url":"\/documentation\/swiduxmixpanelanalytics\/howtoimplementservice","abstract":[{"type":"text","text":"Configure "},{"type":"codeVoice","code":"MixpanelAnalyticsService"},{"type":"text","text":" to match your privacy, residency, and batching needs — without "},{"type":"codeVoice","code":"import Mixpanel"},{"type":"text","text":" in your app."}],"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","kind":"article","role":"article"}}}
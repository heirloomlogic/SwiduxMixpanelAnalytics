xMixpanelAnalytics/MixpanelAnalyticsService/optInTracking(distinctID:properties:)":{"abstract":[{"type":"text","text":"Opts the user back into tracking and, if "},{"code":"distinctID","type":"codeVoice"},{"type":"text","text":" is provided,"},{"type":"text","text":" "},{"type":"text","text":"identifies them. Optional "},{"code":"properties","type":"codeVoice"},{"type":"text","text":" are recorded against the user"},{"type":"text","text":" "},{"type":"text","text":"profile; empty properties are passed as "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"."}],"kind":"symbol","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"optInTracking","kind":"identifier"},{"text":"(","kind":"text"},{"text":"distinctID","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"properties","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:15SwiduxAnalytics0B5ValueO","text":"AnalyticsValue","kind":"typeIdentifier"},{"text":"]?) ","kind":"text"},{"text":"async","kind":"keyword"}],"url":"\/documentation\/swiduxmixpanelanalytics\/mixpanelanalyticsservice\/optintracking(distinctid:properties:)","title":"optInTracking(distinctID:properties:)","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService\/optInTracking(distinctID:properties:)","role":"symbol"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/HowToImplementService":{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","kind":"article","abstract":[{"text":"Configure ","type":"text"},{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"text":" to match your privacy, residency, and batching needs — without ","type":"text"},{"code":"import Mixpanel","type":"codeVoice"},{"text":" in your app.","type":"text"}],"title":"How to Implement the Service","type":"topic","url":"\/documentation\/swiduxmixpanelanalytics\/howtoimplementservice","role":"article"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/MixpanelAnalyticsService":{"navigatorTitle":[{"text":"MixpanelAnalyticsService","kind":"identifier"}],"abstract":[{"code":"AnalyticsService","type":"codeVoice"},{"type":"text","text":" conformer that owns and forwards to a Mixpanel SDK"},{"type":"text","text":" "},{"type":"text","text":"instance."}],"kind":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MixpanelAnalyticsService","kind":"identifier"}],"url":"\/documentation\/swiduxmixpanelanalytics\/mixpanelanalyticsservice","title":"MixpanelAnalyticsService","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService","role":"symbol"},"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics":{"type":"topic","kind":"symbol","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics","title":"SwiduxMixpanelAnalytics","role":"collection","url":"\/documentation\/swiduxmixpanelanalytics","abstract":[{"type":"text","text":"Mixpanel adapter for Swidux’s "},{"type":"codeVoice","code":"AnalyticsPlugin"},{"type":"text","text":". Owns the Mixpanel SDK on the app’s behalf — "},{"type":"codeVoice","code":"MixpanelAnalyticsService(token:)"},{"type":"text","text":" calls "},{"code":"Mixpanel.initialize","type":"codeVoice"},{"type":"text","text":" internally so apps never need to "},{"code":"import Mixpanel","type":"codeVoice"},{"type":"text","text":". Ships a recording mock for previews and tests."}]}}}
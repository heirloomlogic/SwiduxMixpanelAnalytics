 init(token: String, ...)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Calls ","type":"text"},{"type":"codeVoice","code":"Mixpanel.initialize(token:...)"},{"text":" internally and retains the resulting instance. Parameters mirror the Mixpanel SDK; ","type":"text"},{"type":"codeVoice","code":"superProperties"},{"text":" takes ","type":"text"},{"type":"codeVoice","code":"[String: AnalyticsValue]"},{"text":" so the app does not need to reference ","type":"text"},{"type":"codeVoice","code":"MixpanelType"},{"text":". On macOS, ","type":"text"},{"type":"codeVoice","code":"trackAutomaticEvents"},{"text":" is omitted (the SDK does not accept it there).","type":"text"}],"type":"paragraph"},{"code":["public init(instance: MixpanelInstance)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Escape hatch for apps that need to build their own ","type":"text"},{"type":"codeVoice","code":"MixpanelInstance"},{"text":" (for example, to use ","type":"text"},{"type":"codeVoice","code":"ProxyServerConfig"},{"text":"). Most apps should prefer the token initializer; this is the only path that requires ","type":"text"},{"type":"codeVoice","code":"import Mixpanel"},{"text":" in your app.","type":"text"}],"type":"paragraph"},{"level":4,"text":"`track(_:) async`","type":"heading","anchor":"track-async"},{"inlineContent":[{"text":"Forwards to ","type":"text"},{"type":"codeVoice","code":"MixpanelInstance.track(event:properties:)"},{"text":". Empty ","type":"text"},{"type":"codeVoice","code":"properties"},{"text":" are passed as ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" rather than an empty dictionary. Returns immediately; Mixpanel batches and flushes on its own schedule.","type":"text"}],"type":"paragraph"},{"level":4,"text":"`identify(userID:properties:) async`","type":"heading","anchor":"identifyuserIDproperties-async"},{"inlineContent":[{"text":"Forwards to ","type":"text"},{"type":"codeVoice","code":"MixpanelInstance.identify(distinctId:)"},{"text":", then — if ","type":"text"},{"type":"codeVoice","code":"properties"},{"text":" is non-empty — calls ","type":"text"},{"type":"codeVoice","code":"instance.people.set(properties:)"},{"text":" to update people-level properties.","type":"text"}],"type":"paragraph"},{"level":4,"text":"`alias(newID:previousID:) async`","type":"heading","anchor":"aliasnewIDpreviousID-async"},{"inlineContent":[{"text":"Forwards to ","type":"text"},{"type":"codeVoice","code":"MixpanelInstance.createAlias(_:distinctId:)"},{"text":". When ","type":"text"},{"type":"codeVoice","code":"previousID"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":", the call uses ","type":"text"},{"type":"codeVoice","code":"instance.distinctId"},{"text":" as the source ID, matching Mixpanel’s recommended anonymous-to-identified aliasing flow.","type":"text"}],"type":"paragraph"},{"level":4,"text":"`reset() async`","type":"heading","anchor":"reset-async"},{"inlineContent":[{"text":"Forwards to ","type":"text"},{"type":"codeVoice","code":"MixpanelInstance.reset(completion:)"},{"text":" and awaits its callback. Clears Mixpanel’s local distinct ID, super properties, and identity.","type":"text"}],"type":"paragraph"},{"level":4,"text":"`flush() async`","type":"heading","anchor":"flush-async"},{"inlineContent":[{"text":"Forwards to ","type":"text"},{"type":"codeVoice","code":"MixpanelInstance.flush(completion:)"},{"text":" and awaits its callback. The plugin’s own ","type":"text"},{"type":"codeVoice","code":"flush()"},{"text":" is the deterministic sync point in tests — it awaits all pending fire-and-forget tracking tasks and then calls this.","type":"text"}],"type":"paragraph"},{"level":4,"text":"`optOutTracking() async`","type":"heading","anchor":"optOutTracking-async"},{"inlineContent":[{"text":"Forwards to ","type":"text"},{"type":"codeVoice","code":"MixpanelInstance.optOutTracking()"},{"text":". Subsequent ","type":"text"},{"type":"codeVoice","code":"track"},{"text":" \/ 
{"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics"]]},"abstract":[{"text":"API reference for ","type":"text"},{"identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService","isActive":true,"type":"reference"},{"text":" — the Mixpanel-backed ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" conformer that the analytics plugin consumes.","type":"text"}],"identifier":{"url":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ServiceReference","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"SwiduxMixpanelAnalytics"}],"title":"Service Reference"},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"codeVoice","code":"MixpanelAnalyticsService"},{"type":"text","text":" adapts a "},{"type":"codeVoice","code":"MixpanelInstance"},{"type":"text","text":" to the "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" protocol that "},{"type":"codeVoice","code":"SwiduxAnalytics.AnalyticsPlugin"},{"type":"text","text":" requires. It does one job: forward "},{"type":"codeVoice","code":"AnalyticsEvent"},{"type":"text","text":", identify, alias, reset, and flush calls to the underlying SDK while translating "},{"type":"codeVoice","code":"AnalyticsValue"},{"type":"text","text":" into Mixpanel’s "},{"type":"codeVoice","code":"Properties"},{"type":"text","text":" payload. Configuration of the Mixpanel SDK itself remains the caller’s responsibility."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For a step-by-step integration walkthrough, see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService"},{"type":"text","text":". For value-mapping rules, see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ValueTranslation"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Library-target","text":"Library target","type":"heading","level":2},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Product: "},{"code":"SwiduxMixpanelAnalytics","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Import: "},{"code":"import SwiduxMixpanelAnalytics","type":"codeVoice"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":":"}],"type":"paragraph"},{"code":[".product(name: \"SwiduxMixpanelAnalytics\", package: \"SwiduxMixpanelAnalytics\"),"],"type":"codeListing","syntax":"swift"},{"anchor":"Types","text":"Types","type":"heading","level":2},{"anchor":"docSwiduxMixpanelAnalyticsdocumentationSwiduxMixpanelAnalyticsMixpanelAnalyticsService","text":"``doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService``","type":"heading","level":3},{"code":["public struct MixpanelAnalyticsService: AnalyticsService, @unchecked Sendable {","    public init()","    public init(instance: MixpanelInstance)","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Value type holding a single reference to a "},{"type":"codeVoice","code":"MixpanelInstance"},{"type":"text","text":". "},{"type":"codeVoice","code":"@unchecked Sendable"},{"type":"text","text":" is justified by Mixpanel’s documented thread-safety. Cheap to pass into "},{"type":"codeVoice","code":"AnalyticsPlugin"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Initializers","text":"Initializers","type":"heading","level":4},{"code":["public init()"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Wraps "},{"type":"codeVoice","code":"Mixpanel.mainInstance()"},{"type":"text","text":". You must call "},{"type":"codeVoice","code":"Mixpanel.initialize(token:trackAutomaticEvents:)"},{"type":"text","text":" (or a macOS-equivalent overload) before constructing the service — "},{"type":"codeVoice","code":"Mixpanel.mainInstance()"},{"type":"text","text":" traps when uninitialized."}],"type":"paragraph"},{"code":["public init(instance: MixpanelInstance)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Wraps an explicitly-provided instance. Use this when the app runs multiple Mixpanel projects under named instances."}],"type":"paragraph"},{"anchor":"track-async","text":"`track(_:) async`","type":"heading","level":4},{"inlineContent":[{"type":"text","text":"Forwards to "},{"type":"codeVoice","code":"MixpanelInstance.track(event:properties:)"},{"type":"text","text":". Empty "},{"type":"codeVoice","code":"properties"},{"type":"text","text":" are passed as "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" rather than an empty dictionary. Returns immediately; Mixpanel batches and flushes on its own schedule."}],"type":"paragraph"},{"anchor":"identifyuserIDproperties-async","text":"`identify(userID:properties:) async`","type":"heading","level":4},{"inlineContent":[{"type":"text","text":"Forwards to "},{"type":"codeVoice","code":"MixpanelInstance.identify(distinctId:)"},{"type":"text","text":", then — if "},{"type":"codeVoice","code":"properties"},{"type":"text","text":" is non-empty — calls "},{"type":"codeVoice","code":"instance.people.set(properties:)"},{"type":"text","text":" to update people-level properties."}],"type":"paragraph"},{"anchor":"aliasnewIDpreviousID-async","text":"`alias(newID:previousID:) async`","type":"heading","level":4},{"inlineContent":[{"type":"text","text":"Forwards to "},{"type":"codeVoice","code":"MixpanelInstance.createAlias(_:distinctId:)"},{"type":"text","text":". When "},{"type":"codeVoice","code":"previousID"},{"type":"text","text":" is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", the call uses "},{"type":"codeVoice","code":"instance.distinctId"},{"type":"text","text":" as the source ID, matching Mixpanel’s recommended anonymous-to-identified aliasing flow."}],"type":"paragraph"},{"anchor":"reset-async","text":"`reset() async`","type":"heading","level":4},{"inlineContent":[{"type":"text","text":"Forwards to "},{"type":"codeVoice","code":"MixpanelInstance.reset(completion:)"},{"type":"text","text":" and awaits its callback. Clears Mixpanel’s local distinct ID, super properties, and identity."}],"type":"paragraph"},{"anchor":"flush-async","text":"`flush() async`","type":"heading","level":4},{"inlineContent":[{"type":"text","text":"Forwards to "},{"type":"codeVoice","code":"MixpanelInstance.flush(completion:)"},{"type":"text","text":" and awaits its callback. The plugin’s own "},{"type":"codeVoice","code":"flush()"},{"type":"text","text":" is the deterministic sync point in tests — it awaits all pending fire-and-forget tracking tasks and then calls this."}],"type":"paragraph"}],"kind":"content"}],"seeAlsoSections":[{"anchor":"Related-Documentation","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/HowToImplementService","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/ValueTranslation","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockServiceReference","doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MixpanelAnalyticsService"],"title":"Related Documentation"},{"generated":true,"anchor":"Reference","identifiers":["doc:\/\/SwiduxMixpanelAnalytics\/documentation\/SwiduxMixpanelAnalytics\/MockServiceReference"],"title":"Reference"}],"variants":[{"paths":["\/documentation\/swiduxmixpanelanalytics\/servicereference"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","references":{"doc://SwiduxMixpanelAnalytics/documentation/SwiduxMixpanelAnalytics/HowToImplementService":{"iden